-- =========================================================
-- BUILD A BOAT - ULTIMATE SLOW & SAFE FARMER
-- =========================================================

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("BABFT - Full Safe Mode", "DarkTheme")

-- DATA & SERVICES
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Data = LocalPlayer:WaitForChild("OtherData")
local Claim = workspace:WaitForChild("ClaimRiverResultsGold")
local StartGold = LocalPlayer.Data.Gold.Value
local GainedGold = 0
local Chests = 0
local StartTime = os.time()
local AutoFarmActive = false 

-- MOBILE UI BUTTON
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local ToggleBtn = Instance.new("TextButton", ScreenGui)
ToggleBtn.Size = UDim2.new(0, 80, 0, 35)
ToggleBtn.Position = UDim2.new(0, 10, 0, 300)
ToggleBtn.Text = "MENU"
ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 205, 50)
ToggleBtn.TextColor3 = Color3.new(1,1,1)
ToggleBtn.MouseButton1Click:Connect(function() Library:ToggleUI() end)

-- SEKMELER
local MainTab = Window:NewTab("Farming")
local StatusSection = MainTab:NewSection("Status Dashboard")

-- SAYAÇLAR (TETİKLİ)
local goldLabel = StatusSection:NewLabel("Current Gold: " .. StartGold)
local gainedLabel = StatusSection:NewLabel("Gained Gold: 0")
local chestLabel = StatusSection:NewLabel("Chest Collected: 0")
local timeLabel = StatusSection:NewLabel("Total Time Farming: 00:00:00")

-- FULL YAVAŞ FARM DÖNGÜSÜ
local function SlowFarm()
    while AutoFarmActive do
        local Char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local Root = Char:WaitForChild("HumanoidRootPart")
        local Stages = workspace.BoatStages.NormalStages
        
        -- 1'den 10'a kadar her bölümde 4 saniye bekle (Full Yavaş)
        for i = 1, 10 do
            if not AutoFarmActive then break end
            
            local Target = Stages[`CaveStage{i}`].DarknessPart
            Root.CFrame = Target.CFrame
            Root.Velocity = Vector3.zero
            
            -- Bölüm geçtiğini bildir
            task.spawn(function() Claim:FireServer() end)
            
            -- Gerçekçi bekleme süresi
            task.wait(4.0) 
        end

        -- 11. BÖLÜM (SANDIK)
        if AutoFarmActive then
            local EndStage = Stages.TheEnd.GoldenChest
            Root.CFrame = EndStage.Trigger.CFrame
            task.wait(2) -- Sandık başında bekleme
            
            -- Sandığa dokunma simülasyonu
            EndStage.Trigger.CFrame = Root.CFrame
            task.wait(1.5)
            
            -- Sayaç Güncelle
            Chests = Chests + 1
            chestLabel:UpdateLabel("Chest Collected: " .. Chests)
            
            -- Başa dönmeden önce dinlenme
            Char:BreakJoints()
            task.wait(8) 
        end
    end
end

-- KONTROL BUTONLARI
StatusSection:NewToggle("Auto Farm Başlat", "Açınca yavaşça farm yapar", function(state)
    AutoFarmActive = state
    if state then
        Library:Notify("Sistem", "Farm Başladı (Güvenli Mod)", "Default")
        task.spawn(SlowFarm)
    else
        Library:Notify("Sistem", "Farm Durduruldu", "Default")
    end
end)

StatusSection:NewButton("Double Gold (X2) Aktif Et", "DEX: TRUE / Bypasslı", function()
    if not LocalPlayer:FindFirstChild("GoldPass") then
        local gp = Instance.new("BoolValue", LocalPlayer)
        gp.Name = "GoldPass"
        Library:Notify("Bypass", "X2 Gold Özelliği Tetiklendi!", "Success")
    end
end)

-- CANLI TAKİP SİSTEMİ
task.spawn(function()
    while task.wait(1) do
        -- Zaman Sayacı
        local diff = os.time() - StartTime
        local h, m, s = math.floor(diff/3600), math.floor((diff%3600)/60), diff%60
        timeLabel:UpdateLabel("Total Time Farming: " .. string.format("%02d:%02d:%02d", h, m, s))
        
        -- Altın Verisi (Data üzerinden anlık)
        local cur = LocalPlayer.Data.Gold.Value
        goldLabel:UpdateLabel("Current Gold: " .. cur)
        gainedLabel:UpdateLabel("Gained Gold: " .. (cur - StartGold))
    end
end)
