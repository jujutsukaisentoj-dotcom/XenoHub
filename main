-- =========================================================
-- rqccc CORE - GOD MODE & DEX TRUE HYBRID (V13)
-- =========================================================

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("BABFT - rqccc God Hub", "Midnight")

-- SERVICES
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Data = LocalPlayer:WaitForChild("OtherData")
local Claim = workspace:WaitForChild("ClaimRiverResultsGold")
local Stages = workspace.BoatStages.NormalStages
local Chest = Stages.TheEnd.GoldenChest.Trigger

-- CONFIGS
local AutoFarmEnabled = false
local WaterWalk = false
local NoClip = false
local WS = 16
local JP = 50

-- DEX TRUE ENJECTOR (Tüm Özellikler)
local function InjectDex()
    local p = {"GoldPass", "VIP", "Member", "DoubleGold", "DoubleMoney", "ExtraBoatSlot"}
    for _, n in pairs(p) do
        local v = Instance.new("BoolValue", LocalPlayer)
        v.Name = n
        v.Value = true
    end
    Library:Notify("SİSTEM", "Tüm Gamepasslar Aktif! (Dex: True)", "Success")
end

-- TABS
local Main = Window:NewTab("Farm & Dex")
local Player = Window:NewTab("Player Mods")
local FarmSec = Main:NewSection("rqccc Farm Control")
local ModSec = Player:NewSection("God & Movement")

-- =========================================================
-- rqccc's ORIGINAL FARM LOGIC (INTEGRATED INTO BUTTON)
-- =========================================================
local function ExecuteRQCCCFarm()
    if not AutoFarmEnabled then return end
    
    local Char = LocalPlayer.Character
    if not Char then return end
    local Root = Char:WaitForChild("HumanoidRootPart")

    local NewChar = false
    task.spawn(function()
        LocalPlayer.CharacterAdded:Once(function() NewChar = true end)
    end)

    -- 1'den 10'a rqccc Döngüsü
    for _ = 1, 10 do
        if not AutoFarmEnabled or NewChar then break end
        
        local TargetPart = Stages[`CaveStage{_}`].DarknessPart
        local Teleporting = true

        task.spawn(function()
            while Teleporting and AutoFarmEnabled do
                Root.CFrame = TargetPart.CFrame
                for _, BodyPart in Char:GetChildren() do
                    if BodyPart:IsA("BasePart") then
                        BodyPart.Velocity = Vector3.zero
                        BodyPart.RotVelocity = Vector3.zero
                    end
                end
                task.wait()
            end
        end)

        -- rqccc Special Chest Stage Check
        if _ == 3 then -- Orijinal kodundaki ChestStage = 3
            task.spawn(function()
                Chest.CFrame = Root.CFrame
                task.wait()
                Chest.CFrame = CFrame.new(0, 9e9, 0)
                task.wait(0.2)
                if AutoFarmEnabled then
                    local val = Data[`Stage{_}`]
                    if not val then val:GetPropertyChangedSignal("Value"):Wait() end
                    Claim:FireServer()
                end
            end)
        elseif _ ~= 10 then
            local val = Data[`Stage{_}`]
            if not val then val:GetPropertyChangedSignal("Value"):Wait() end
            Claim:FireServer()
        end

        if _ == 10 then
            Char:BreakJoints()
            task.spawn(function()
                task.wait(1)
                Claim:FireServer()
            end)
        else
            repeat task.wait(0.5) until (Data[`Stage{_}`].Value ~= "" and Data[`Stage{_}`].Value) or NewChar or not AutoFarmEnabled
        end
        Teleporting = false
    end
end

-- UI CONTROLS
FarmSec:NewToggle("AUTO FARM (rqccc)", "Dex True + rqccc Logic", function(state)
    AutoFarmEnabled = state
    if state then
        InjectDex()
        ExecuteRQCCCFarm()
    end
end)

-- PLAYER MODS LOGIC
RunService.Stepped:Connect(function()
    local Char = LocalPlayer.Character
    if Char and Char:FindFirstChild("Humanoid") then
        Char.Humanoid.WalkSpeed = WS
        Char.Humanoid.JumpPower = JP
        
        if NoClip then
            for _, p in pairs(Char:GetChildren()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
        
        if WaterWalk and workspace:FindFirstChild("Water") then
            workspace.Water.CanCollide = true
            workspace.Water.Size = Vector3.new(1000, 20, 1000)
        end
    end
end)

ModSec:NewToggle("Suda Yürüme", "Su seni öldürmez, üstünde yürürsün", function(s) WaterWalk = s end)
ModSec:NewToggle("Hoclip (NoClip)", "Duvarlardan geç", function(s) NoClip = s end)
ModSec:NewSlider("Hız (Speed)", "Hız ayarı", 500, 16, function(s) WS = s end)
ModSec:NewSlider("Zıplama (Jump)", "Zıplama ayarı", 500, 50, function(s) JP = s end)

ModSec:NewButton("God Mode", "Ölümsüzlük (Can Yeniler)", function()
    if LocalPlayer.Character then
        LocalPlayer.Character.Humanoid.MaxHealth = 100000
        LocalPlayer.Character.Humanoid.Health = 100000
    end
end)

-- AUTO-RESTART
LocalPlayer.CharacterAdded:Connect(function()
    if AutoFarmEnabled then
        task.wait(5)
        ExecuteRQCCCFarm()
    end
end)

-- MOBILE TOGGLE
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local Btn = Instance.new("TextButton", ScreenGui)
Btn.Size, Btn.Position = UDim2.new(0,80,0,30), UDim2.new(0,10,0,150)
Btn.Text = "MENU"
Btn.BackgroundColor3 = Color3.fromRGB(45,45,45)
Btn.TextColor3 = Color3.new(1,1,1)
Btn.Draggable = true
Btn.MouseButton1Click:Connect(function() Library:ToggleUI() end)
