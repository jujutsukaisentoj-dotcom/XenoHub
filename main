local Items = NewTab("🎒 Eşyalar")
local function SafeTriggerTool(tool)
    pcall(function()
        local re = ReplicatedStorage:FindFirstChild("RE")
        local event = re and re:FindFirstChild("1Playe1rTrigge1rEven1t")
        if event then event:FireServer("AcceptedToolToServer", tool, lp) end
    end)
end

