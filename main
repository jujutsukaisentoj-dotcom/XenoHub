--[[ 
    XENOHUB PRO V3 - BUILD A BOAT & GAMEPASS CONTROLLER
    Özellikler: 
    - Master Gold Farm (Bypass + Stage Sync)
    - Gamepass Emulator (Reklam ödül sistemini tetikler)
    - Anti-Cheat Nullifier (Fiziksel veri temizleme)
    Kısayol: Menü için 'F' tuşuna basınız.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local lp = Players.LocalPlayer
local targetParent = (gethui and gethui()) or CoreGui

-- ============================================================================== --
-- KONTROL PANELİ VE AYARLAR
-- ============================================================================== --
_G.Settings = {
    AutoFarm = false,
    InstantBypass = true,
    EmulateAdReward = false,
    TeleportSpeed = 0.5,
    AutoChest = true
}

-- Oyun içi Remote ve Modüller (Dosyalardan analiz edilen yollar)
local Remotes = ReplicatedStorage:FindFirstChild("Packages") and ReplicatedStorage.Packages:FindFirstChild("Remotes")
local ClaimGold = workspace:FindFirstChild("ClaimRiverResultsGold")
local Stages = workspace:WaitForChild("BoatStages"):WaitForChild("NormalStages")

-- ============================================================================== --
-- CORE FONKSİYONLAR (BYPASS & EMULATION)
-- ============================================================================== --

-- Karakterin hız verilerini sıfırlar (Hile koruması için kritik)
local function NullifyPhysics(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and _G.Settings.InstantBypass then
        hrp.Velocity = Vector3.new(0,0,0)
        hrp.RotVelocity = Vector3.new(0,0,0)
    end
end

-- AdController analizi sonrası eklenen 'Sahte Ödül' tetikleyicisi
local function TriggerAdBypass(gamepassId)
    -- Bu kısım decompile edilen AdvertisementsController.txt mantığına dayanır
    -- Oyunun reklam izlendi sanmasını sağlayan sinyalleri simüle eder
    pcall(function()
        local rewardRemote = ReplicatedStorage:FindFirstChild("IncentivizedAds") 
        if rewardRemote then
            rewardRemote:FireServer(gamepassId, "VideoAd")
        end
    end)
end

-- Master Farm Döngüsü
local function StartProFarm()
    task.spawn(function()
        while _G.Settings.AutoFarm do
            local char = lp.Character or lp.CharacterAdded:Wait()
            local root = char:WaitForChild("HumanoidRootPart")
            local hum = char:WaitForChild("Humanoid")
            
            if hum.Health <= 0 then task.wait(2) continue end

            for i = 1, 10 do
                if not _G.Settings.AutoFarm or hum.Health <= 0 then break end
                
                local stage = Stages:FindFirstChild("CaveStage" .. i)
                if stage and stage:FindFirstChild("DarknessPart") then
                    -- Yumuşak geçiş ve sürekli fiziksel sıfırlama
                    local tween = TweenService:Create(root, TweenInfo.new(_G.Settings.TeleportSpeed, Enum.EasingStyle.Linear), {
                        CFrame = stage.DarknessPart.CFrame * CFrame.new(0, 50, 0)
                    })
                    
                    local active = true
                    task.spawn(function()
                        while active do
                            NullifyPhysics(char)
                            if _G.Settings.EmulateAdReward then TriggerAdBypass("GoldPass") end
                            task.wait()
                        end
                    end)
                    
                    tween:Play()
                    tween.Completed:Wait()
                    active = false
                    
                    -- Altın alımı
                    if ClaimGold then ClaimGold:FireServer() end
                    task.wait(0.1)
                end
            end

            -- Final ve Reset
            if _G.Settings.AutoFarm and hum.Health > 0 then
                if _G.Settings.AutoChest then
                    local endPoint = Stages:FindFirstChild("TheEnd")
                    if endPoint then
                        root.CFrame = endPoint.GoldenChest.Trigger.CFrame
                        task.wait(0.5)
                    end
                end
                char:BreakJoints() -- Reset loop
            end
            task.wait(3)
        end
    end)
end

-- ============================================================================== --
-- UI (KULLANICI ARAYÜZÜ)
-- ============================================================================== --

if targetParent:FindFirstChild("XenoV3") then targetParent.XenoV3:Destroy() end

local ScreenGui = Instance.new("ScreenGui", targetParent)
ScreenGui.Name = "XenoV3"

local Main = Instance.new("Frame", ScreenGui)
Main.Size = UDim2.new(0, 260, 0, 300)
Main.Position = UDim2.new(0.5, -130, 0.5, -150)
Main.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
Main.BorderSizePixel = 0
Instance.new("UICorner", Main)

local Header = Instance.new("Frame", Main)
Header.Size = UDim2.new(1, 0, 0, 40)
Header.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
Header.BorderSizePixel = 0
Instance.new("UICorner", Header)

local Title = Instance.new("TextLabel", Header)
Title.Size = UDim2.new(1, 0, 1, 0)
Title.Text = "XENOHUB V3 [PREMIUM]"
Title.TextColor3 = Color3.fromRGB(0, 160, 255)
Title.Font = Enum.Font.GothamBold
Title.BackgroundTransparency = 1

local List = Instance.new("ScrollingFrame", Main)
List.Position = UDim2.new(0, 10, 0, 50)
List.Size = UDim2.new(1, -20, 1, -60)
List.BackgroundTransparency = 1
List.CanvasSize = UDim2.new(0,0,0,350)
List.ScrollBarThickness = 0

local UIList = Instance.new("UIListLayout", List)
UIList.Padding = UDim.new(0, 8)

local function AddToggle(text, field)
    local b = Instance.new("TextButton", List)
    b.Size = UDim2.new(1, 0, 0, 40)
    b.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    b.Text = text .. ": KAPALI"
    b.TextColor3 = Color3.new(0.7, 0.7, 0.7)
    b.Font = Enum.Font.Gotham
    Instance.new("UICorner", b)
    
    b.MouseButton1Click:Connect(function()
        _G.Settings[field] = not _G.Settings[field]
        local active = _G.Settings[field]
        b.Text = text .. ": " .. (active and "AÇIK" or "KAPALI")
        b.TextColor3 = active and Color3.fromRGB(0, 255, 120) or Color3.new(0.7, 0.7, 0.7)
        
        if field == "AutoFarm" and active then StartProFarm() end
    end)
end

AddToggle("Otomatik Altın Farmı", "AutoFarm")
AddToggle("Gelişmiş Bypass", "InstantBypass")
AddToggle("Ad-Reward Emulasyonu", "EmulateAdReward")
AddToggle("Hazineyi Otomatik Al", "AutoChest")

-- Sürükleme Özelliği
Main.Active = true
Main.Draggable = true

-- Kısayol (F tuşu)
UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.F then
        Main.Visible = not Main.Visible
    end
end)

print("XenoHub V3 Yüklendi. Dosya analizleri uygulandı.")
