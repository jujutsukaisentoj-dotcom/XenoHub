local Lib = loadstring(game:HttpGet("https://raw.githubusercontent.com/tbao143/Library-ui/refs/heads/main/Redzhubui"))()

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local lp = Players.LocalPlayer
local char = lp.Character or lp.CharacterAdded:Wait()
local hum = char:WaitForChild("Humanoid")

-- ============================================================================== --
-- AYARLAR & DEĞİŞKENLER
-- ============================================================================== --
local XenoSettings = {
    Fly = false,
    FlySpeed = 50,
    Noclip = false,
    InfJump = false,
    Spectating = nil
}

-- ============================================================================== --
-- FONKSİYONLAR
-- ============================================================================== --

-- Noclip Döngüsü
RunService.Stepped:Connect(function()
    if XenoSettings.Noclip and lp.Character then
        for _, v in pairs(lp.Character:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end
end)

-- Infinite Jump
game:GetService("UserInputService").JumpRequest:Connect(function()
    if XenoSettings.InfJump and lp.Character:FindFirstChildOfClass("Humanoid") then
        lp.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
    end
end)

-- Fly Sistemi
local function ToggleFly(state)
    XenoSettings.Fly = state
    if state then
        local bv = Instance.new("BodyVelocity")
        local bg = Instance.new("BodyGyro")
        bv.Name = "XenoFlyV"
        bg.Name = "XenoFlyG"
        bv.MaxForce = Vector3.new(1e8, 1e8, 1e8)
        bv.Velocity = Vector3.new(0, 0, 0)
        bg.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
        bg.P = 90000
        bv.Parent = lp.Character.HumanoidRootPart
        bg.Parent = lp.Character.HumanoidRootPart
        
        spawn(function()
            while XenoSettings.Fly do
                local cam = workspace.CurrentCamera
                local moveDir = Vector3.new(0,0,0)
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.W) then moveDir += cam.CFrame.LookVector end
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.S) then moveDir -= cam.CFrame.LookVector end
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.A) then moveDir -= cam.CFrame.RightVector end
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.D) then moveDir += cam.CFrame.RightVector end
                bv.Velocity = moveDir * XenoSettings.FlySpeed
                bg.CFrame = cam.CFrame
                task.wait()
            end
            bv:Destroy()
            bg:Destroy()
        end)
    end
end

-- ============================================================================== --
-- UI OLUŞTURMA
-- ============================================================================== --

local Window = Lib:MakeWindow({
    Title = "XenoHub Ultimate v11",
    SubTitle = "Brookhaven Mega Script",
    SideColor = Color3.fromRGB(145, 90, 230)
})

-- ANA SAYFA
local Home = Window:MakeTab("Ana Sayfa", "home")

Home:AddButton({
    Name = "⚡ CMDR ADMIN BYPASS (F2)",
    Callback = function()
        pcall(function()
            local CmdrPermPath = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Shared"):WaitForChild("Cmdr"):WaitForChild("CmdrPermissions")
            require(CmdrPermPath).hasCmdrAccess = function() return true end
            require(CmdrPermPath).hasCommandAccess = function() return true end
            local Cmdr = require(ReplicatedStorage:WaitForChild("CmdrClient"))
            Cmdr:SetActivationKeys({Enum.KeyCode.F2, Enum.KeyCode.ButtonL3})
            Cmdr:Toggle()
        end)
    end
})

Home:AddButton({
    Name = "📺 FULL ADSTORE AKTİF ET",
    Callback = function()
        pcall(function()
            local AdsController = require(ReplicatedStorage.Modules.Client.Ads.AdvertisementsController)
            AdsController.RequestRewardedVideoAd("XenoBypass_PremiumItem", "rbxassetid://0", 0, "Item Refresh", "Item Refresh", false, false)
        end)
    end
})

Home:AddButton({
    Name = "🔥 YANGIN TETİKLE",
    Callback = function()
        pcall(function()
            local Game8 = require(game:GetService("StarterGui").Player8Handler.Game8Settings)
            Game8.PlayersHouse:FireServer("PlayerWantsFire")
        end)
    end
})

-- OYUNCU AYARLARI
local PlayerTab = Window:MakeTab("Oyuncu", "user")

PlayerTab:AddSlider({
    Name = "Yürüme Hızı (Speed)",
    Min = 16,
    Max = 300,
    Default = 16,
    Callback = function(v) lp.Character.Humanoid.WalkSpeed = v end
})

PlayerTab:AddSlider({
    Name = "Zıplama Gücü (Jump)",
    Min = 50,
    Max = 500,
    Default = 50,
    Callback = function(v) lp.Character.Humanoid.JumpPower = v end
})

PlayerTab:AddToggle({
    Name = "Uçma (Fly)",
    Default = false,
    Callback = function(state) ToggleFly(state) end
})

PlayerTab:AddToggle({
    Name = "Duvarlardan Geçme (Noclip)",
    Default = false,
    Callback = function(state) XenoSettings.Noclip = state end
})

PlayerTab:AddToggle({
    Name = "Sonsuz Zıplama (Inf Jump)",
    Default = false,
    Callback = function(state) XenoSettings.InfJump = state end
})

-- İZLEME VE GÖRÜNÜM
local ViewTab = Window:MakeTab("İzleme & Görüş", "eye")

local PlayerList = {}
for _, p in pairs(Players:GetPlayers()) do table.insert(PlayerList, p.Name) end

local SpectateDrop = ViewTab:AddDropdown({
    Name = "Oyuncu İzle (Spectate)",
    Options = PlayerList,
    Default = lp.Name,
    Callback = function(val)
        local target = Players:FindFirstChild(val)
        if target and target.Character then
            workspace.CurrentCamera.CameraSubject = target.Character.Humanoid
        end
    end
})

ViewTab:AddButton({
    Name = "❌ İZLEMEYİ KAPAT / RESET VIEW",
    Callback = function()
        workspace.CurrentCamera.CameraSubject = lp.Character.Humanoid
    end
})

ViewTab:AddSlider({
    Name = "Görüş Açısı (FOV)",
    Min = 70,
    Max = 120,
    Default = 70,
    Callback = function(v) workspace.CurrentCamera.FieldOfView = v end
})

-- EŞYALAR
local ItemsTab = Window:MakeTab("Eşyalar", "package")
local tools = {
    {"MoneyGun", "Para Tabancası"}, {"Glider", "Planör"}, {"Chainsaw", "Testere"},
    {"Scythe", "Tırpan"}, {"UraniumRod", "Uranyum"}, {"AgencyBook", "Ajans Kitabı"}
}

for _, t in pairs(tools) do
    ItemsTab:AddButton({
        Name = "Al: " .. t[2],
        Callback = function()
            pcall(function()
                ReplicatedStorage.RE["1Playe1rTrigge1rEven1t"]:FireServer("AcceptedToolToServer", t[1], lp)
            end)
        end
    })
end

-- AYARLAR & KAPATMA
local SettingsTab = Window:MakeTab("Ayarlar", "settings")

SettingsTab:AddButton({
    Name = "❌ SCRİPTİ TAMAMEN KAPAT",
    Callback = function()
        pcall(function()
            XenoSettings.Fly = false
            XenoSettings.Noclip = false
            Lib:Destroy() -- Kütüphaneyi kapatır
        end)
    end
})

Lib:SelectTab(Home)
