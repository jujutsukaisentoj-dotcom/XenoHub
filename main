        XenoSettings.PremiumEnabled = true
        local gpc = require(ReplicatedStorage.Modules.Client.UI.GamepassUnlockController)
        gpc.OwnsGamepass = function() return true end
        gpc.IsPremium = function() return true end
        
        -- Metatable Hooking for Dex checks
        if getrawmetatable then
            local old; old = hookmetamethod(game, "__index", function(self, key)
                if tostring(key) == "Premium" or tostring(key) == "IsPremium" then return true end
                return old(self, key)
            end)
        end
        SendNotif("XenoHub", "Premium Dex & Metatable Full Aktif! ✅")
    end)
end, Color3.fromRGB(145, 90, 230))

AddBtn(Home, "🏦 BANKA KASASINI PATLAT", function()
    pcall(function()
