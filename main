-- ===============================================================
-- 👑 GEMINI HUB V7 - ULTIMATE BUILD A BOAT FARM
-- 🚀 11 STAGE + 2X GOLD BYPASS + MULTI-FEATURE GUI
-- ===============================================================

local Settings = {
    FarmEnabled = false,
    DoubleGold = true,
    AntiWater = true,
    ChestStage = 11,
    TeleportSpeed = 0.01,
    AutoClaim = true
}

-- Servisler
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Data = LocalPlayer:WaitForChild("OtherData")
local Claim = Workspace:WaitForChild("ClaimRiverResultsGold")
local Stages = Workspace:WaitForChild("BoatStages"):WaitForChild("NormalStages")

-- [ 2X GOLD & DATA BYPASS ]
-- Dex Explorer üzerinden bakıldığında görünen "DoubleGold" değerini zorlar
local function EnableDoubleGold()
    if Settings.DoubleGold then
        pcall(function()
            if Data:FindFirstChild("DoubleGold") then
                Data.DoubleGold.Value = true
            end
            -- Bazı sürümlerde ReplicatedStorage üzerinden tetikleme gerekebilir
            if ReplicatedStorage:FindFirstChild("DoubleGoldGamepass") then
                ReplicatedStorage.DoubleGoldGamepass:FireServer(true)
            end
        end)
    end
end

-- [ GUI OLUŞTURMA ]
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "Gemini_V7"
ScreenGui.Parent = (gethui and gethui()) or (game:GetService("CoreGui")) or LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
MainFrame.Size = UDim2.new(0, 220, 0, 240)
MainFrame.Position = UDim2.new(0.05, 0, 0.3, 0)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 10)
UICorner.Parent = MainFrame

local Title = Instance.new("TextLabel")
Title.Parent = MainFrame
Title.Size = UDim2.new(1, 0, 0, 40)
Title.Text = "GEMINI HUB V7 👑"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 16
Title.BackgroundColor3 = Color3.fromRGB(35, 35, 45)

local Corner2 = Instance.new("UICorner")
Corner2.CornerRadius = UDim.new(0, 10)
Corner2.Parent = Title

-- [ BUTONLAR ]
local function CreateButton(name, pos, text, callback)
    local Btn = Instance.new("TextButton")
    Btn.Name = name
    Btn.Parent = MainFrame
    Btn.Position = pos
    Btn.Size = UDim2.new(0.9, 0, 0, 35)
    Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    Btn.Text = text
    Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    Btn.Font = Enum.Font.GothamMedium
    Btn.TextSize = 13
    Btn.BorderSizePixel = 0
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Btn
    
    Btn.Activated:Connect(function()
        callback(Btn)
    end)
    return Btn
end

-- Farm Butonu
local FarmBtn = CreateButton("FarmBtn", UDim2.new(0.05, 0, 0.22, 0), "AUTO FARM: KAPALI", function(self)
    Settings.FarmEnabled = not Settings.FarmEnabled
    if Settings.FarmEnabled then
        self.Text = "AUTO FARM: AÇIK"
        self.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        self.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        self.Text = "AUTO FARM: KAPALI"
        self.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        self.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end)

-- Double Gold Butonu
local GoldBtn = CreateButton("GoldBtn", UDim2.new(0.05, 0, 0.40, 0), "DOUBLE GOLD: AKTİF", function(self)
    Settings.DoubleGold = not Settings.DoubleGold
    if Settings.DoubleGold then
        self.Text = "DOUBLE GOLD: AKTİF"
        self.BackgroundColor3 = Color3.fromRGB(200, 160, 0)
        EnableDoubleGold()
    else
        self.Text = "DOUBLE GOLD: PASİF"
        self.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    end
end)
GoldBtn.BackgroundColor3 = Color3.fromRGB(200, 160, 0)

-- Anti Water Butonu
CreateButton("WaterBtn", UDim2.new(0.05, 0, 0.58, 0), "ANTİ-SU: AKTİF", function(self)
    Settings.AntiWater = not Settings.AntiWater
    self.Text = Settings.AntiWater and "ANTİ-SU: AKTİF" or "ANTİ-SU: PASİF"
end)

-- [ FONKSİYONLAR ]

local function HasStage(Num)
    local val = Data:FindFirstChild(`Stage{Num}`)
    return val and val.Value ~= "" and val.Value
end

local function FarmLoop()
    while true do
        if Settings.FarmEnabled then
            local Char = LocalPlayer.Character
            local Root = Char and Char:FindFirstChild("HumanoidRootPart")
            
            if Root then
                EnableDoubleGold()
                
                -- Anti-Gravity & Velocity Fix
                local BV = Instance.new("BodyVelocity", Root)
                BV.Velocity = Vector3.new(0,0,0)
                
                for i = 1, Settings.ChestStage do
                    if not Settings.FarmEnabled then break end
                    
                    local Stage = Stages:FindFirstChild(`CaveStage{i}`)
                    if Stage and Stage:FindFirstChild("DarknessPart") then
                        Root.CFrame = Stage.DarknessPart.CFrame
                        Claim:FireServer()
                        task.wait(Settings.TeleportSpeed)
                    end
                end
                
                -- Sandık Sonu
                if Settings.FarmEnabled then
                    local Chest = Stages.TheEnd.GoldenChest.Trigger
                    Root.CFrame = Chest.CFrame
                    if firetouchinterest then
                        firetouchinterest(Root, Chest, 0)
                        task.wait(0.1)
                        firetouchinterest(Root, Chest, 1)
                    else
                        -- Backup CFrame Touch
                        Chest.CFrame = Root.CFrame
                        task.wait(0.2)
                    end
                    task.wait(1)
                    Char:BreakJoints()
                end
                BV:Destroy()
            end
        end
        task.wait(1)
    end
end

-- Anti Water Logic
RunService.Stepped:Connect(function()
    if Settings.AntiWater and LocalPlayer.Character then
        pcall(function()
            for _, v in pairs(LocalPlayer.Character:GetChildren()) do
                if v:IsA("BasePart") then v.CanTouch = false end
            end
        end)
    end
end)

-- Başlat
task.spawn(FarmLoop)
print("🚀 Gemini Hub V7 Loaded!")
