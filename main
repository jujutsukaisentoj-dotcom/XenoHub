local function SendNotif(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title;
            Text = text;
            Duration = 5;
        })
    end)
end

-- ============================================================================== --
-- 2. ANA REMOTE TETİKLEYİCİLER (BYPASS)
-- ============================================================================== --

local function SafeTrigger(mode, ...)
    local args = {...}
    pcall(function()
        local re = ReplicatedStorage:FindFirstChild("RE")
        local mainEvent = re and re:FindFirstChild("1Playe1rTrigge1rEven1t")
        
        if mode == "House" then
            mainEvent:FireServer("HouseSettings", unpack(args))
        elseif mode == "Tool" then
            mainEvent:FireServer("AcceptedToolToServer", args[1], lp)
        elseif mode == "Avatar" then
            mainEvent:FireServer("AvatarSettings", unpack(args))
        end
    end)
end

