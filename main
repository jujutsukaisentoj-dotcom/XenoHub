-- =========================================================
-- BABFT - FULL DEX TRUE & rqccc HYBRID V8 (FINAL)
-- =========================================================

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("BABFT - Full Dex True v8", "Midnight")

-- SERVICES & DATA
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Data = LocalPlayer:WaitForChild("OtherData")
local Claim = workspace:WaitForChild("ClaimRiverResultsGold")
local Stages = workspace.BoatStages.NormalStages
local Chest = Stages.TheEnd.GoldenChest.Trigger

-- VARIABLES
local StartGold = LocalPlayer.Data.Gold.Value
local ChestCount = 0
local StartTime = os.time()
local AutoFarmActive = false

-- DEX TRUE / GAMEPASS BYPASS (Hepsini Aktif Eder)
local function ActivateDexTrue()
    local passList = {"GoldPass", "VIP", "Member", "ExtraBoatSlot", "DoubleGold"}
    for _, pass in pairs(passList) do
        if not LocalPlayer:FindFirstChild(pass) then
            local val = Instance.new("BoolValue", LocalPlayer)
            val.Name = pass
            val.Value = true
        end
    end
end

-- UI LABELS
local MainTab = Window:NewTab("Farming")
local StatusSection = MainTab:NewSection("Anlık Stats & Dex: True")

local goldLabel = StatusSection:NewLabel("Current Gold: " .. StartGold)
local gainedLabel = StatusSection:NewLabel("Gained Gold: 0")
local chestLabel = StatusSection:NewLabel("Chest Collected: 0")
local stageLabel = StatusSection:NewLabel("Statü: Bekleniyor...")

-- rqccc LOGIC FUNCTIONS
local function HasStage(Num)
    return Data[`Stage{Num}`].Value ~= "" and Data[`Stage{Num}`].Value
end

local function ClaimStage(Num)
    task.spawn(function()
        local Value = Data[`Stage{Num}`]
        if not Value then
            Value:GetPropertyChangedSignal("Value"):Wait()
        end
        Claim:FireServer()
    end)
end

-- FULL SLOW FARM LOOP (rqccc + Final Chest)
local function ExecuteFarm()
    while AutoFarmActive do
        local Char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local Root = Char:WaitForChild("HumanoidRootPart")
        
        -- Bölümleri Tek Tek Geç (1-10)
        for i = 1, 10 do
            if not AutoFarmActive then break end
            
            stageLabel:UpdateLabel("Bölüm Geçiliyor: " .. i .. " / 11")
            local TargetPart = Stages[`CaveStage{i}`].DarknessPart
            local Teleporting = true

            -- rqccc Bypass Teleport (Hız Sıfırlama)
            task.spawn(function()
                while Teleporting and AutoFarmActive do
                    Root.CFrame = TargetPart.CFrame
                    for _, BodyPart in Char:GetChildren() do
                        if BodyPart:IsA("BasePart") then
                            BodyPart.Velocity = Vector3.zero
                            BodyPart.RotVelocity = Vector3.zero
                        end
                    end
                    task.wait()
                end
            end)

            task.wait(4.5) -- Güvenli Yavaşlık
            ClaimStage(i)
            
            -- Stage Onayı Bekle
            repeat task.wait(0.5) until HasStage(i) or not AutoFarmActive
            Teleporting = false
        end

        -- 11. BÖLÜM (FINAL CHEST)
        if AutoFarmActive then
            stageLabel:UpdateLabel("Durum: SON SANDIK ALINIYOR")
            Root.CFrame = Chest.CFrame
            task.wait(2)
            
            -- Chest Tetikleyici
            Chest.CFrame = Root.CFrame
            task.wait(2)
            
            ChestCount = ChestCount + 1
            chestLabel:UpdateLabel("Chest Collected: " .. ChestCount)
            
            -- Reset ve Yeni Tur
            stageLabel:UpdateLabel("Durum: Tur Bitti, Resetleniyor...")
            Char:BreakJoints()
            task.wait(8)
        end
    end
end

-- UI CONTROLS
StatusSection:NewToggle("Auto Farm (Yavaş & Tetikli)", "Bölüm bölüm geçer, sandığı alır", function(state)
    AutoFarmActive = state
    if state then
        ActivateDexTrue() -- Farm başlarken Dex True yapar
        Library:Notify("Sistem", "Farm ve Dex: True Aktif!", "Default")
        task.spawn(ExecuteFarm)
    else
        stageLabel:UpdateLabel("Statü: DURDURULDU")
    end
end)

StatusSection:NewButton("Manual Dex: True Yap", "Tüm Gamepassleri Enjekte Eder", function()
    ActivateDexTrue()
    Library:Notify("Bypass", "Tüm özellikler DEX: TRUE yapıldı!", "Success")
end)

-- STATS AUTO-UPDATE
task.spawn(function()
    while task.wait(1) do
        local cur = LocalPlayer.Data.Gold.Value
        goldLabel:UpdateLabel("Current Gold: " .. cur)
        gainedLabel:UpdateLabel("Gained Gold: " .. (cur - StartGold))
    end
end)

-- MOBILE UI BUTTON
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local ToggleBtn = Instance.new("TextButton", ScreenGui)
ToggleBtn.Size = UDim2.new(0, 80, 0, 35)
ToggleBtn.Position = UDim2.new(0, 10, 0, 200)
ToggleBtn.Text = "MENÜ"
ToggleBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
ToggleBtn.TextColor3 = Color3.new(1,1,1)
ToggleBtn.MouseButton1Click:Connect(function() Library:ToggleUI() end)
