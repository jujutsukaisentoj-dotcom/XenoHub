-- ---> TAB: PREMIUM & BYPASS
local PremiumTab = Window:MakeTab({"Premium ⭐", "rbxassetid://127904742940104"})

PremiumTab:AddSection({"Sistem Bypassları"})

PremiumTab:AddButton({
    Title = "🔓 FULL PREMIUM BYPASS (Client)",
    Callback = function()
        Notify("Premium", "UI Kilitleri açılıyor...")
        -- UI Manipülasyonu
        local PlayerGui = player:WaitForChild("PlayerGui")
        for _, gui in pairs(PlayerGui:GetDescendants()) do
            if gui:IsA("ImageButton") or gui:IsA("TextButton") then
                if gui.Name:lower():find("lock") or gui.Name:lower():find("premium") then
                    gui.Visible = false
                end
            end
        end
        -- Gamepass Controller Hook
        pcall(function()
            local GC = require(ReplicatedStorage.Modules.Client.UI.GamepassUnlockController)
            GC.OwnsGamepass = function() return true end
        end)
        Notify("Başarılı", "Premium butonları açıldı!")
    end
})

PremiumTab:AddButton({
    Title = "🏠 Evleri Yak (House Fire)",
    Callback = function()
        local r = ReplicatedStorage:FindFirstChild("RE") or ReplicatedStorage:FindFirstChild("Remotes")
        if r then
            -- Olası tüm yangın tetikleyicilerini dene
            pcall(function() r.RemoteEvent:FireServer("HouseSettings", "Fire", true) end)
            pcall(function() r.RemoteEvent:FireServer("HouseEvent", "Fire", true) end)
        end
        Notify("Troll", "Ev yakma komutu gönderildi!")
    end
})

PremiumTab:AddButton({
    Title = "🚫 Ban Hammer (Eşya)",
    Callback = function() GetBrookhavenItem("BanHammer") end
})

