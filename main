--[[ 
    XENOHUB - BUILD A BOAT FOR TREASURE (V2 PRO LOOP)
    Özellikler: Dex Kontrollü Teleport, Tetikli Bypass, Master Farm Loop, Modern UI.
    Kısayol: Menüyü açıp kapatmak için 'F' tuşunu kullanın.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local lp = Players.LocalPlayer
local targetParent = (gethui and gethui()) or CoreGui

-- ============================================================================== --
-- AYARLAR VE DURUM (CONFIG)
-- ============================================================================== --
local Config = {
    AutoFarm = false,
    TouchChest = true,
    ChestStage = 10,
    TeleportSpeed = 0.5, -- Bölümler arası geçiş hızı
    BypassActive = true,
    AntiAfk = true
}

local Stages = workspace:WaitForChild("BoatStages"):WaitForChild("NormalStages")
local ClaimRemote = workspace:WaitForChild("ClaimRiverResultsGold")
local GoldenChestTrigger = Stages:WaitForChild("TheEnd"):WaitForChild("GoldenChest"):WaitForChild("Trigger")
local OtherData = lp:WaitForChild("OtherData")

-- ============================================================================== --
-- YARDIMCI SİSTEMLER (BYPASS & TELEPORT)
-- ============================================================================== --

local function Notify(title, text)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = title;
        Text = text;
        Duration = 3;
    })
end

-- Dex Kontrolü: Bölümün geçildiğini doğrular (Server-Side Sync)
local function HasStage(Num)
    local stageVal = OtherData:FindFirstChild("Stage" .. Num)
    return stageVal and stageVal.Value ~= "" and stageVal.Value
end

-- Tetikli Bypass: Fiziksel hız verilerini sıfırlayarak kicklenmeyi önler
local function ApplyBypass(Char)
    if not Config.BypassActive then return end
    local hrp = Char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Velocity = Vector3.new(0, 0, 0)
        hrp.RotVelocity = Vector3.new(0, 0, 0)
    end
    for _, part in pairs(Char:GetChildren()) do
        if part:IsA("BasePart") then
            part.Velocity = Vector3.new(0, 0, 0)
        end
    end
end

-- ============================================================================== --
-- ANA MASTER FARM DÖNGÜSÜ
-- ============================================================================== --

local function StartFarm()
    task.spawn(function()
        while Config.AutoFarm do
            local Char = lp.Character or lp.CharacterAdded:Wait()
            local Root = Char:WaitForChild("HumanoidRootPart")
            local Hum = Char:WaitForChild("Humanoid")
            
            local isDead = false
            local deathConn
            deathConn = Hum.Died:Connect(function()
                isDead = true
                deathConn:Disconnect()
            end)

            -- Karakteri sabitle (Bypass desteği)
            Root.Anchored = false 
            
            for i = 1, 10 do
                if not Config.AutoFarm or isDead then break end
                
                local stageName = "CaveStage" .. i
                local targetStage = Stages:FindFirstChild(stageName)
                
                if targetStage and targetStage:FindFirstChild("DarknessPart") then
                    local targetPart = targetStage.DarknessPart
                    
                    -- Dex Kontrollü Yumuşak Teleport
                    local tween = TweenService:Create(Root, TweenInfo.new(Config.TeleportSpeed, Enum.EasingStyle.Linear), {
                        CFrame = targetPart.CFrame * CFrame.new(0, 60, 0)
                    })
                    
                    -- Hareket süresince sürekli bypass tetikle
                    local moving = true
                    task.spawn(function()
                        while moving and not isDead do
                            ApplyBypass(Char)
                            task.wait()
                        end
                    end)

                    tween:Play()
                    tween.Completed:Wait()
                    moving = false

                    -- Claim ve Hazine İşlemi
                    if i == Config.ChestStage and Config.TouchChest then
                        GoldenChestTrigger.CFrame = Root.CFrame
                        task.wait(0.3)
                        ClaimRemote:FireServer()
                    else
                        ClaimRemote:FireServer()
                    end

                    -- Bölüm Doğrulaması (Sync)
                    if i < 10 then
                        local timeout = 0
                        repeat 
                            task.wait(0.1) 
                            timeout = timeout + 1
                        until HasStage(i) or isDead or timeout > 25
                    end
                end
            end

            -- Tur Sonu: Karakteri sıfırla ve yeniden başla
            if Config.AutoFarm and not isDead then
                task.wait(1.2)
                Char:BreakJoints()
            end
            
            -- Yeniden doğuşu bekle
            repeat task.wait() until lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            task.wait(2) 
        end
    end)
end

-- ============================================================================== --
-- MODERN UI TASARIMI
-- ============================================================================== --

if targetParent:FindFirstChild("XenoHub_GoldV2") then targetParent.XenoHub_GoldV2:Destroy() end

local ScreenGui = Instance.new("ScreenGui", targetParent)
ScreenGui.Name = "XenoHub_GoldV2"

local Main = Instance.new("Frame", ScreenGui)
Main.Name = "Main"
Main.Size = UDim2.new(0, 260, 0, 320)
Main.Position = UDim2.new(0.5, -130, 0.5, -160)
Main.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
Main.BorderSizePixel = 0
Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 10)

-- Başlık Çubuğu
local Header = Instance.new("Frame", Main)
Header.Size = UDim2.new(1, 0, 0, 45)
Header.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
Header.BorderSizePixel = 0
Instance.new("UICorner", Header)

local Title = Instance.new("TextLabel", Header)
Title.Size = UDim2.new(1, 0, 1, 0)
Title.BackgroundTransparency = 1
Title.Text = "XENOHUB | AUTO GOLD"
Title.TextColor3 = Color3.fromRGB(0, 170, 255)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 16

-- İçerik Alanı
local Content = Instance.new("Frame", Main)
Content.Position = UDim2.new(0, 10, 0, 55)
Content.Size = UDim2.new(1, -20, 1, -65)
Content.BackgroundTransparency = 1

local Layout = Instance.new("UIListLayout", Content)
Layout.Padding = UDim.new(0, 10)
Layout.SortOrder = Enum.SortOrder.LayoutOrder

local function MakeToggle(name, callback)
    local btn = Instance.new("TextButton", Content)
    btn.Size = UDim2.new(1, 0, 0, 45)
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    btn.Text = "  " .. name .. ": KAPALI"
    btn.TextColor3 = Color3.new(0.8, 0.8, 0.8)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", btn)
    
    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        btn.Text = "  " .. name .. ": " .. (active and "AÇIK" or "KAPALI")
        btn.TextColor3 = active and Color3.fromRGB(0, 255, 140) or Color3.new(0.8, 0.8, 0.8)
        btn.BackgroundColor3 = active and Color3.fromRGB(30, 40, 35) or Color3.fromRGB(25, 25, 35)
        callback(active)
    end)
end

MakeToggle("Otomatik Altın Farmı", function(state)
    Config.AutoFarm = state
    if state then StartFarm() end
end)

MakeToggle("Gelişmiş Bypass", function(state)
    Config.BypassActive = state
end)

MakeToggle("Hazineye Dokunma", function(state)
    Config.TouchChest = state
end)

local ResetBtn = Instance.new("TextButton", Content)
ResetBtn.Size = UDim2.new(1, 0, 0, 45)
ResetBtn.BackgroundColor3 = Color3.fromRGB(50, 20, 20)
ResetBtn.Text = "Karakteri Sıfırla"
ResetBtn.TextColor3 = Color3.new(1, 0.4, 0.4)
ResetBtn.Font = Enum.Font.GothamBold
ResetBtn.TextSize = 13
Instance.new("UICorner", ResetBtn)
ResetBtn.MouseButton1Click:Connect(function() 
    if lp.Character then lp.Character:BreakJoints() end 
end)

-- Sürükleme ve Kontroller
Main.Active = true
Main.Draggable = true

UserInputService.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.F then
        Main.Visible = not Main.Visible
    end
end)

-- Anti-AFK Desteği
if Config.AntiAfk then
    lp.Idled:Connect(function()
        game:GetService("VirtualUser"):CaptureController()
        game:GetService("VirtualUser"):ClickButton2(Vector2.new())
    end)
end

Notify("XenoHub", "Script Başlatıldı! (F tuşu menüyü açar)")
