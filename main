-- =========================================================
-- rqccc x Gemini Hybrid: FULL DEX TRUE & AUTO FARM
-- =========================================================

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("BABFT - rqccc Ultimate Edition", "Midnight")

-- SERVICES
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Data = LocalPlayer:WaitForChild("OtherData")
local Claim = workspace:WaitForChild("ClaimRiverResultsGold")
local Stages = workspace.BoatStages.NormalStages
local Chest = Stages.TheEnd.GoldenChest.Trigger

-- CONFIG
local StartGold = LocalPlayer.Data.Gold.Value
local ChestCount = 0
local AutoFarmActive = false

-- DEX TRUE: TÜM OYUN ÖZELLİKLERİ (TETİKLİ)
local function ApplyAllGamepasses()
    local features = {"GoldPass", "VIP", "Member", "DoubleGold", "DoubleMoney", "ExtraBoatSlot"}
    for _, name in pairs(features) do
        local val = Instance.new("BoolValue", LocalPlayer)
        val.Name = name
        val.Value = true
    end
    Library:Notify("SİSTEM", "Tüm özelliklere sahipsin! (Dex: True)", "Success")
end

-- UI SETUP
local MainTab = Window:NewTab("Farming")
local Stats = MainTab:NewSection("rqccc Logic & Stats")
local goldLabel = Stats:NewLabel("Altın: " .. StartGold)
local chestLabel = Stats:NewLabel("Toplanan Sandık: 0")
local statusLabel = Stats:NewLabel("Durum: Bekleniyor...")

-- rqccc FUNCTIONS
local function HasStage(Num)
    return Data[`Stage{Num}`].Value ~= "" and Data[`Stage{Num}`].Value
end

local function ClaimStage(Num)
    task.spawn(function()
        local Value = Data[`Stage{Num}`]
        if not Value then
            Value:GetPropertyChangedSignal("Value"):Wait()
        end
        Claim:FireServer()
    end)
end

-- rqccc ORIGINAL FARM LOGIC (INTEGRATED)
local function Farm()
    if not AutoFarmActive then return end
    
    local Char = LocalPlayer.Character
    if not Char then return end
    local Root = Char:WaitForChild("HumanoidRootPart")

    local NewChar = false
    local conn
    conn = LocalPlayer.CharacterAdded:Once(function() NewChar = true end)

    for i = 1, 10 do
        if not AutoFarmActive or NewChar then break end
        
        statusLabel:UpdateLabel("Bölüm Geçiliyor: " .. i)
        local TargetPart = Stages[`CaveStage{i}`].DarknessPart
        local Teleporting = true

        -- rqccc's Precision Teleport
        task.spawn(function()
            while Teleporting and AutoFarmActive do
                Root.CFrame = TargetPart.CFrame
                for _, Part in Char:GetChildren() do
                    if Part:IsA("BasePart") then
                        Part.Velocity = Vector3.zero
                        Part.RotVelocity = Vector3.zero
                    end
                end
                task.wait()
            end
        end)

        -- GÜVENLİK İÇİN YAVAŞLATILMIŞ BEKLEME (TETİKLİ)
        task.wait(4.5) 
        
        if i ~= 10 then
            ClaimStage(i)
        end

        -- Stage Onayını Bekle
        repeat task.wait(0.5) until HasStage(i) or NewChar or not AutoFarmActive
        Teleporting = false
    end

    -- STAGE 11: THE END
    if AutoFarmActive and not NewChar then
        statusLabel:UpdateLabel("Sandık Alınıyor...")
        Root.CFrame = Chest.CFrame
        task.wait(1)
        Chest.CFrame = Root.CFrame
        task.wait(2)
        
        ChestCount = ChestCount + 1
        chestLabel:UpdateLabel("Toplanan Sandık: " .. ChestCount)
        
        Char:BreakJoints() -- Reset for next loop
    end
    if conn then conn:Disconnect() end
end

-- UI CONTROLS
Stats:NewToggle("AUTO FARM (rqccc MANTIĞI)", "Tetikli & Yavaş Farm", function(state)
    AutoFarmActive = state
    if state then
        ApplyAllGamepasses() -- DEX TRUE BURADA TETİKLENİR
        Farm()
    end
end)

-- AUTO RESTART ON DEATH
LocalPlayer.CharacterAdded:Connect(function()
    if AutoFarmActive then
        task.wait(5)
        Farm()
    end
end)

-- STATS UPDATE
task.spawn(function()
    while task.wait(1) do
        goldLabel:UpdateLabel("Mevcut Altın: " .. LocalPlayer.Data.Gold.Value)
    end
end)

-- MOBILE BUTTON
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local Btn = Instance.new("TextButton", ScreenGui)
Btn.Size, Btn.Position = UDim2.new(0,80,0,35), UDim2.new(0,10,0,150)
Btn.Text = "MENU"
Btn.BackgroundColor3 = Color3.fromRGB(30,30,30)
Btn.TextColor3 = Color3.new(1,1,1)
Btn.MouseButton1Click:Connect(function() Library:ToggleUI() end)
