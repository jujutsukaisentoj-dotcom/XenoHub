Content.Position = UDim2.new(0, 210, 0, 10)
Content.BackgroundTransparency = 1

local tabs = {}
local function CreateTab(name, icon)
    local TabBtn = Instance.new("TextButton", TabContainer)
    TabBtn.Size = UDim2.new(0.9, 0, 0, 45)
    TabBtn.BackgroundColor3 = Config.Theme
    TabBtn.BackgroundTransparency = 1
    TabBtn.Text = "  " .. name
    TabBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    TabBtn.Font = Enum.Font.GothamSemibold
    TabBtn.TextSize = 14
    TabBtn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 8)

    local Page = Instance.new("ScrollingFrame", Content)
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.BackgroundTransparency = 1
    Page.Visible = false
    Page.ScrollBarThickness = 2
    Page.ScrollBarImageColor3 = Config.Theme
    
    local PageList = Instance.new("UIListLayout", Page)
    PageList.Padding = UDim.new(0, 12)

    TabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.p.Visible = false
            TweenService:Create(t.b, TweenInfo.new(0.3), {BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(180, 180, 180)}):Play()
        end
        Page.Visible = true
        TweenService:Create(TabBtn, TweenInfo.new(0.3), {BackgroundTransparency = 0.8, TextColor3 = Color3.new(1,1,1)}):Play()
    end)

    if #tabs == 0 then
        Page.Visible = true
        TabBtn.BackgroundTransparency = 0.8
        TabBtn.TextColor3 = Color3.new(1,1,1)
    end
    
    table.insert(tabs, {p = Page, b = TabBtn})
    return Page
end

local function CreateToggle(parent, title, desc, callback)
    local Frame = Instance.new("Frame", parent)
    Frame.Size = UDim2.new(0.98, 0, 0, 75)
    Frame.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    local c = Instance.new("UICorner", Frame)
    c.CornerRadius = UDim.new(0, 10)

    local Title = Instance.new("TextLabel", Frame)
    Title.Text = title
    Title.Size = UDim2.new(0.7, 0, 0.4, 0)
    Title.Position = UDim2.new(0.05, 0, 0.15, 0)
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 15
    Title.TextColor3 = Color3.new(1,1,1)
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.BackgroundTransparency = 1

    local Desc = Instance.new("TextLabel", Frame)
    Desc.Text = desc
    Desc.Size = UDim2.new(0.7, 0, 0.3, 0)
    Desc.Position = UDim2.new(0.05, 0, 0.55, 0)
    Desc.Font = Enum.Font.Gotham
    Desc.TextSize = 12
    Desc.TextColor3 = Color3.fromRGB(150, 150, 150)
    Desc.TextXAlignment = Enum.TextXAlignment.Left
    Desc.BackgroundTransparency = 1

    local ToggleBG = Instance.new("TextButton", Frame)
    ToggleBG.Size = UDim2.new(0, 50, 0, 26)
    ToggleBG.Position = UDim2.new(0.85, -25, 0.5, -13)
    ToggleBG.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    ToggleBG.Text = ""
    Instance.new("UICorner", ToggleBG).CornerRadius = UDim.new(1, 0)

    local Circle = Instance.new("Frame", ToggleBG)
    Circle.Size = UDim2.new(0, 20, 0, 20)
    Circle.Position = UDim2.new(0, 3, 0.5, -10)
    Circle.BackgroundColor3 = Color3.new(1,1,1)
    Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)

    local active = false
    ToggleBG.MouseButton1Click:Connect(function()
        active = not active
        local targetPos = active and UDim2.new(0, 27, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
        local targetCol = active and Config.Theme or Color3.fromRGB(40, 40, 50)
        
        TweenService:Create(Circle, TweenInfo.new(0.3), {Position = targetPos}):Play()
        TweenService:Create(ToggleBG, TweenInfo.new(0.3), {BackgroundColor3 = targetCol}):Play()
        
        callback(active)
    end)
end

local function CreateButton(parent, text, callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(0.98, 0, 0, 45)
    btn.BackgroundColor3 = Config.Theme
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.TextColor3 = Color3.new(1,1,1)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    
    btn.MouseButton1Click:Connect(function()
        btn.TextSize = 12
        task.wait(0.1)
        btn.TextSize = 14
        callback()
    end)
end

