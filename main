-- =========================================================
-- rqccc LOGIC + SLOW & TETİKLİ & DEX TRUE (V9 FINAL)
-- =========================================================

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("BABFT - rqccc Pro Edition", "Midnight")

-- SERVICES & DATA
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Data = LocalPlayer:WaitForChild("OtherData")
local Claim = workspace:WaitForChild("ClaimRiverResultsGold")
local Stages = workspace.BoatStages.NormalStages
local GoldenChest = Stages.TheEnd.GoldenChest.Trigger

-- CONFIG & VARS
local StartGold = LocalPlayer.Data.Gold.Value
local ChestCount = 0
local StartTime = os.time()
local AutoFarmActive = false

-- DEX TRUE (ALL GAMEPASSES)
local function ApplyDexTrue()
    local passList = {"GoldPass", "VIP", "Member", "ExtraBoatSlot", "DoubleGold"}
    for _, pass in pairs(passList) do
        if not LocalPlayer:FindFirstChild(pass) then
            local val = Instance.new("BoolValue", LocalPlayer)
            val.Name = pass
            val.Value = true
        end
    end
end

-- UI TABS
local MainTab = Window:NewTab("Farming")
local StatusSection = MainTab:NewSection("rqccc Stats & Controls")

-- LABELS
local goldLabel = StatusSection:NewLabel("Current Gold: " .. StartGold)
local gainedLabel = StatusSection:NewLabel("Gained Gold: 0")
local chestLabel = StatusSection:NewLabel("Chest Collected: 0")
local stageLabel = StatusSection:NewLabel("Durum: Bekleniyor...")

-- rqccc LOGIC FUNCTIONS
local function HasStage(Num)
    return Data[`Stage{Num}`].Value ~= "" and Data[`Stage{Num}`].Value
end

local function ClaimStage(Num)
    task.spawn(function()
        local Value = Data[`Stage{Num}`]
        if not Value then
            Value:GetPropertyChangedSignal("Value"):Wait()
        end
        Claim:FireServer()
    end)
end

-- MAIN FARM FUNCTION (rqccc + SLOW MODE)
local function Farm()
    while AutoFarmActive do
        local Char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local Root = Char:WaitForChild("HumanoidRootPart")
        
        local NewChar = false
        local connection
        connection = LocalPlayer.CharacterAdded:Once(function()
            NewChar = true
        end)

        -- Stages 1 to 10
        for i = 1, 10 do
            if not AutoFarmActive or NewChar then break end
            
            stageLabel:UpdateLabel("Bölüm: " .. i .. " / 11")
            local TargetPart = Stages[`CaveStage{i}`].DarknessPart
            local Teleporting = true

            -- rqccc's Safe Teleport Loop
            task.spawn(function()
                while Teleporting and AutoFarmActive do
                    Root.CFrame = TargetPart.CFrame
                    for _, BodyPart in Char:GetChildren() do
                        if BodyPart:IsA("BasePart") then
                            BodyPart.Velocity = Vector3.zero
                            BodyPart.RotVelocity = Vector3.zero
                        end
                    end
                    task.wait()
                end
            end)

            task.wait(4.5) -- SENİN İSTEDİĞİN YAVAŞLIK
            ClaimStage(i)
            
            -- Wait for server validation (HasStage)
            repeat task.wait(0.5) until HasStage(i) or NewChar or not AutoFarmActive
            Teleporting = false
        end

        -- STAGE 11: THE END (GOLDEN CHEST)
        if AutoFarmActive and not NewChar then
            stageLabel:UpdateLabel("Durum: SANDIK ALINIYOR (11/11)")
            Root.CFrame = GoldenChest.CFrame
            task.wait(1.5)
            
            -- Touch Simulation (rqccc style)
            GoldenChest.CFrame = Root.CFrame
            task.wait(2)
            
            ChestCount = ChestCount + 1
            chestLabel:UpdateLabel("Chest Collected: " .. ChestCount)
            
            -- Reset Character
            stageLabel:UpdateLabel("Durum: Bitti, Resetleniyor...")
            Char:BreakJoints()
            task.wait(8) 
        end
        
        if connection then connection:Disconnect() end
    end
end

-- UI CONTROLS
StatusSection:NewToggle("Auto Farm [BAŞLAT]", "rqccc mantığı ile yavaş farm", function(state)
    AutoFarmActive = state
    if state then
        ApplyDexTrue() -- Dex True tetikle
        Library:Notify("Sistem", "Farm ve Dex: True Başlatıldı!", "Default")
        task.spawn(Farm)
    else
        stageLabel:UpdateLabel("Durum: DURDURULDU")
    end
end)

StatusSection:NewButton("Manual Dex: True", "Tüm Passleri Enjekte Et", function()
    ApplyDexTrue()
    Library:Notify("Başarılı", "Tüm Gamepassler Aktif Edildi!", "Success")
end)

-- LIVE DATA UPDATER
task.spawn(function()
    while task.wait(1) do
        local cur = LocalPlayer.Data.Gold.Value
        goldLabel:UpdateLabel("Current Gold: " .. cur)
        gainedLabel:UpdateLabel("Gained Gold: " .. (cur - StartGold))
        
        local diff = os.time() - StartTime
        local h, m, s = math.floor(diff/3600), math.floor((diff%3600)/60), diff%60
        -- İsteğe bağlı zaman etiketini de buraya ekleyebilirsin
    end
end)

-- MOBILE UI TOGGLE
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local ToggleBtn = Instance.new("TextButton", ScreenGui)
ToggleBtn.Size = UDim2.new(0, 80, 0, 35)
ToggleBtn.Position = UDim2.new(0, 15, 0, 150)
ToggleBtn.Text = "MENU"
ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
ToggleBtn.TextColor3 = Color3.new(1,1,1)
ToggleBtn.Draggable = true
ToggleBtn.MouseButton1Click:Connect(function() Library:ToggleUI() end)
