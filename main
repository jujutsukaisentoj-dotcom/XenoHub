--[[
	ULTIMATE BUILD A BOAT AUTO FARM
	Geliştirilmiş Sürüm: v2.0
	Özellikler:
	- Modern UI (Orion Library)
	- Tween (Kayarak) Farm (Anti-Kick korumalı)
	- Otomatik Engel ve Su Silici
	- Anti-AFK
	- Otomatik Sandık Açma
]]

local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()
local Window = OrionLib:MakeWindow({Name = "BaBft Ultimate Farm - Gelişmiş", HidePremium = false, SaveConfig = true, ConfigFolder = "BaBftConfig"})

-- ================================
-- Değişkenler
-- ================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local farming = false
local autoBuyCommon = false
local autoBuyRare = false

-- ================================
-- Yardımcı Fonksiyonlar
-- ================================

-- Engelleri ve Suyu Temizle (Ölmemek için)
local function ClearObstacles()
    pcall(function()
        local stages = Workspace:WaitForChild("BoatStages"):WaitForChild("NormalStages")
        for _, stage in pairs(stages:GetChildren()) do
            if stage:FindFirstChild("DarknessPart") then
                stage.DarknessPart:Destroy()
            end
        end
    end)
    -- İsteğe bağlı su silme (görsel olarak kötü durabilir ama güvenlidir)
    -- Workspace.Water:Destroy() 
end

-- Karakteri Hazırla (Yerçekimini kapatır, çarpışmayı kapatır)
local function SetupCharacter()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:WaitForChild("HumanoidRootPart")
    
    -- Havada durmasını sağla
    local bv = Instance.new("BodyVelocity")
    bv.Name = "FlyVelocity"
    bv.Velocity = Vector3.new(0,0,0)
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Parent = root
    
    -- Çarpışmaları kapat (Noclip)
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

-- ================================
-- Farm Mantığı
-- ================================

local function StartFarm()
    task.spawn(function()
        while farming do
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.CharacterAdded:Wait()
                task.wait(1)
                char = LocalPlayer.Character
            end

            local root = char:WaitForChild("HumanoidRootPart")
            
            -- 1. Hazırlık
            SetupCharacter()
            ClearObstacles()

            -- 2. Hedef Bölgeler (Stages)
            -- Oyunun sonundaki sandığa kadar olan yol
            local endZone = Workspace.BoatStages.NormalStages.TheEnd.GoldenChest.Trigger
            local checkPoints = {
                CFrame.new(-55, 65, 1365), -- Başlangıçtan çıkış
                CFrame.new(-55, 65, 8605), -- Son etabın önü
                endZone.CFrame             -- Hazine
            }

            -- 3. Hareket (Tween)
            for i, targetCF in ipairs(checkPoints) do
                if not farming or not char or not char.Parent then break end
                
                local distance = (root.Position - targetCF.Position).Magnitude
                -- Hızı ayarla (Çok hızlı olursa oyun atar, 300 ideal bir hız çarpanıdır)
                local speed = 300 
                local duration = distance / speed

                local info = TweenInfo.new(duration, Enum.EasingStyle.Linear)
                local tween = TweenService:Create(root, info, {CFrame = targetCF})
                
                tween:Play()
                tween.Completed:Wait()
            end

            -- 4. Sandığı Al
            if farming and char and char:FindFirstChild("HumanoidRootPart") then
                -- Sandığın tam üstüne in
                root.CFrame = endZone.CFrame
                task.wait(0.5)
                -- Sandık alma animasyonu ve sunucu onayı için bekle
                task.wait(10) 
            end

            -- 5. Reset ve Tekrar
            if farming then
                LocalPlayer.Character:BreakJoints() -- Öl ve başa dön
                task.wait(4) -- Respawn süresi
            end
        end
        
        -- Farm bittiğinde BodyVelocity'i temizle
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart:FindFirstChild("FlyVelocity") then
            LocalPlayer.Character.HumanoidRootPart.FlyVelocity:Destroy()
        end
    end)
end

-- ================================
-- UI Sekmeleri ve Butonlar
-- ================================

local FarmTab = Window:MakeTab({
	Name = "Auto Farm",
	Icon = "rbxassetid://4483345998",
	PremiumOnly = false
})

local MiscTab = Window:MakeTab({
	Name = "Ekstra",
	Icon = "rbxassetid://4483345998",
	PremiumOnly = false
})

-- Farm Kontrolleri
FarmTab:AddToggle({
	Name = "Otomatik Farm Başlat",
	Default = false,
	Callback = function(Value)
		farming = Value
		if farming then
			StartFarm()
            OrionLib:MakeNotification({
                Name = "Farm Başladı",
                Content = "Engeller siliniyor ve yola çıkılıyor...",
                Image = "rbxassetid://4483345998",
                Time = 5
            })
		else
            -- Durdurma işlemi
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                 if char.HumanoidRootPart:FindFirstChild("FlyVelocity") then
                    char.HumanoidRootPart.FlyVelocity:Destroy()
                 end
                 -- Hareketi durdur
                 TweenService:Create(char.HumanoidRootPart, TweenInfo.new(0.1), {CFrame = char.HumanoidRootPart.CFrame}):Play()
            end
        end
	end    
})

FarmTab:AddButton({
	Name = "Siyah Duvarları Sil (Manuel)",
	Callback = function()
      	ClearObstacles()
        OrionLib:MakeNotification({
            Name = "Temizlendi",
            Content = "Stage bariyerleri kaldırıldı.",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
  	end    
})

-- Ekstra Kontroller
MiscTab:AddToggle({
	Name = "Anti-AFK",
	Default = true,
	Callback = function(Value)
		if Value then
            local vu = game:GetService("VirtualUser")
            game:GetService("Players").LocalPlayer.Idled:Connect(function()
                vu:Button2Down(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
                wait(1)
                vu:Button2Up(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
            end)
        end
	end    
})

MiscTab:AddToggle({
	Name = "Otomatik Ortak Sandık Al (Common)",
	Default = false,
	Callback = function(Value)
        autoBuyCommon = Value
        task.spawn(function()
            while autoBuyCommon do
                workspace.ItemBoughtFromShop:FireServer("Common Chest", 1)
                task.wait(3)
            end
        end)
	end    
})

-- ================================
-- Başlatma
-- ================================

OrionLib:Init()

-- Anti-Kick Önlemi (Basit)
local mt = getrawmetatable(game)
local old = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if method == "Kick" then
        return nil -- Kick komutunu engellemeye çalışır (bazı client kick'ler için)
    end
    return old(self, ...)
end)
