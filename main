                Instance.new("UICorner", Btn).CornerRadius = UDim.new(0.5, 0.5)
                Btn.Activated:Connect(function() Cmdr:Toggle() end)
            end
        end
        SendNotif("XenoHub", "FULL BYPASS: Admin Aktif! (F2)")
        Cmdr:Toggle()
    end)
end, Color3.fromRGB(145, 90, 230))

