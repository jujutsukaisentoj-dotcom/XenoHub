-- =========================================================
-- W31rd.Hub - Gold Farming V1.4 (FORCED PROGRESSION)
-- IMPROVED LOOP, STAGE 1-11, & JESUS MODE
-- FIXED STAGE 10/11 STICKING & FORCED STAGE PROGRESSION
-- =========================================================

-- Services
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")

-- Variables
local LocalPlayer = Players.LocalPlayer
local Data = LocalPlayer:WaitForChild("OtherData")
local Claim = workspace:WaitForChild("ClaimRiverResultsGold")
local Stages = workspace.BoatStages.NormalStages
local GoldenChest = Stages.TheEnd.GoldenChest.Trigger

-- Stats
local StartGold = LocalPlayer.Data.Gold.Value
local ChestsCollected = 0
local CurrentStage = 0 
local StartTime = os.time()
local FarmingInProgress = false

-- UI Reference for dynamic updates
local StatusLabelRef = nil

-- [1] DEX TRUE & DOUBLE GOLD ENJECTOR (FORCED CHECK)
local function ApplyDexTrue()
    local passes = {"GoldPass", "VIP", "Member", "DoubleGold", "DoubleMoney", "ExtraBoatSlot"}
    for _, name in pairs(passes) do
        if not LocalPlayer:FindFirstChild(name) then
            local val = Instance.new("BoolValue", LocalPlayer)
            val.Name = name
            val.Value = true
        end
    end
end

-- [2] JESUS MODE (Suda Yürüme)
local function EnableJesusMode()
    task.spawn(function()
        while true do
            if workspace:FindFirstChild("Water") then
                workspace.Water.CanCollide = true
                workspace.Water.Transparency = 0.5
                workspace.Water.Size = Vector3.new(5000, 20, 5000)
            end
            task.wait(5)
        end
    end)
end

-- [3] W31RD.HUB PANEL UI
local function CreateUI()
    if CoreGui:FindFirstChild("W3rdHubGui") then CoreGui.W3rdHubGui:Destroy() end
    
    local ScreenGui = Instance.new("ScreenGui", CoreGui)
    ScreenGui.Name = "W3rdHubGui"
    
    local MainFrame = Instance.new("Frame", ScreenGui)
    MainFrame.Size = UDim2.new(0, 300, 0, 260)
    MainFrame.Position = UDim2.new(0.5, -150, 0.4, -130)
    MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    MainFrame.BorderSizePixel = 0
    
    local Corner = Instance.new("UICorner", MainFrame)
    Corner.CornerRadius = UDim.new(0, 10)
    
    -- Title
    local Title = Instance.new("TextLabel", MainFrame)
    Title.Size = UDim2.new(1, 0, 0, 40)
    Title.Text = "W31rd.Hub • Gold Farming • V1.4"
    Title.TextColor3 = Color3.fromRGB(130, 180, 255)
    Title.BackgroundTransparency = 1
    Title.Font = Enum.Font.SourceSansBold
    Title.TextSize = 20
    
    local Line = Instance.new("Frame", MainFrame)
    Line.Size = UDim2.new(0.9, 0, 0, 2)
    Line.Position = UDim2.new(0.05, 0, 0, 40)
    Line.BackgroundColor3 = Color3.fromRGB(50, 100, 255)
    Line.BorderSizePixel = 0
    
    -- Labels
    local function CreateStatLabel(text, pos, color)
        local Label = Instance.new("TextLabel", MainFrame)
        Label.Size = UDim2.new(1, -30, 0, 25)
        Label.Position = UDim2.new(0, 15, 0, pos)
        Label.Text = text
        Label.TextColor3 = color
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.BackgroundTransparency = 1
        Label.Font = Enum.Font.SourceSansBold
        Label.TextSize = 19
        return Label
    end
    
    local CurGoldL = CreateStatLabel("Current Gold: " .. StartGold, 55, Color3.fromRGB(255, 215, 0))
    local GainGoldL = CreateStatLabel("Gained Gold: 0", 85, Color3.fromRGB(100, 255, 100))
    local ChestsL = CreateStatLabel("Gold Blocks: 0", 115, Color3.fromRGB(255, 170, 50))
    local TimeL = CreateStatLabel("Total Time: 00:00:00", 145, Color3.fromRGB(150, 200, 255))
    
    -- Status Update Loop
    task.spawn(function()
        while task.wait(1) do
            if LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Gold") then
                local current = LocalPlayer.Data.Gold.Value
                local diff = os.time() - StartTime
                local h, m, s = math.floor(diff/3600), math.floor((diff%3600)/60), diff%60
                
                CurGoldL.Text = "Current Gold: " .. current
                GainGoldL.Text = "Gained Gold: " .. (current - StartGold)
                ChestsL.Text = "Gold Blocks: " .. ChestsCollected
                TimeL.Text = "Total Time: " .. string.format("%02d:%02d:%02d", h, m, s)
            end
        end
    end)
    
    -- RESET INFO BUTTON
    local ResetBtn = Instance.new("TextButton", MainFrame)
    ResetBtn.Size = UDim2.new(0.43, 0, 0, 35)
    ResetBtn.Position = UDim2.new(0.05, 0, 0, 185)
    ResetBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    ResetBtn.Text = "FIX / RESET"
    ResetBtn.TextColor3 = Color3.new(1,1,1)
    ResetBtn.Font = Enum.Font.SourceSansBold
    ResetBtn.TextSize = 14
    local RCorner = Instance.new("UICorner", ResetBtn)
    ResetBtn.MouseButton1Click:Connect(function()
        if LocalPlayer.Character then LocalPlayer.Character:BreakJoints() end
    end)

    -- Discord Button
    local DiscordBtn = Instance.new("TextButton", MainFrame)
    DiscordBtn.Size = UDim2.new(0.43, 0, 0, 35)
    DiscordBtn.Position = UDim2.new(0.52, 0, 0, 185)
    DiscordBtn.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
    DiscordBtn.Text = "Copy Discord"
    DiscordBtn.TextColor3 = Color3.new(1,1,1)
    DiscordBtn.Font = Enum.Font.SourceSansBold
    DiscordBtn.TextSize = 14
    local DCorner = Instance.new("UICorner", DiscordBtn)
    DiscordBtn.MouseButton1Click:Connect(function() setclipboard("discord.gg/EbhtGYbuTa") end)

    -- Dynamic Progress Label
    local Tip = Instance.new("TextLabel", MainFrame)
    Tip.Size = UDim2.new(1, 0, 0, 20)
    Tip.Position = UDim2.new(0, 0, 0, 230)
    Tip.Text = "Progress: Initializing..."
    Tip.TextColor3 = Color3.fromRGB(180, 180, 180)
    Tip.BackgroundTransparency = 1
    Tip.Font = Enum.Font.SourceSansItalic
    Tip.TextSize = 12
    StatusLabelRef = Tip
    
    -- Dragging Logic
    local Dragging, DragInput, DragStart, StartPos
    MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = true DragStart = input.Position StartPos = MainFrame.Position end
    end)
    MainFrame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = false end
    end)
    RunService.RenderStepped:Connect(function()
        if Dragging then
            local delta = game:GetService("UserInputService"):GetMouseLocation() - Vector2.new(DragStart.X, DragStart.Y)
            MainFrame.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + delta.X, StartPos.Y.Scale, StartPos.Y.Offset + delta.Y)
        end
    end)
end

-- [4] CORE FARM LOGIC (1 to 11)
local function HasStage(Num)
    return Data[`Stage{Num}`].Value ~= "" and Data[`Stage{Num}`].Value
end

local function ClaimStage(Num)
    task.spawn(function()
        local Value = Data[`Stage{Num}`]
        if not Value then Value:GetPropertyChangedSignal("Value"):Wait() end
        Claim:FireServer()
    end)
end

local function Farm()
    if FarmingInProgress then return end
    FarmingInProgress = true
    
    -- Forced Dex Check at start of cycle
    ApplyDexTrue()
    
    local Char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local Root = Char:WaitForChild("HumanoidRootPart")

    local NewChar = false
    local conn
    conn = LocalPlayer.CharacterAdded:Once(function() 
        NewChar = true 
        FarmingInProgress = false
        if StatusLabelRef then StatusLabelRef.Text = "Progress: Spawning..." end
    end)

    -- Stage 1 to 11 loop
    for i = 1, 11 do
        if NewChar then break end
        
        -- Forced Stage UI Update
        if StatusLabelRef then
            StatusLabelRef.Text = "Progress: Stage " .. i .. " / 11 (FORCING)"
        end
        
        local TargetPart
        if i <= 10 then
            -- Find the correct stage part even if it lags
            local StageFolder = Stages:FindFirstChild(`CaveStage{i}`)
            if StageFolder then
                TargetPart = StageFolder:FindFirstChild("DarknessPart")
            end
        else
            -- Stage 11: The End
            TargetPart = GoldenChest
        end
        
        if not TargetPart then
            -- Fallback anti-stuck if target part is missing
            task.wait(1)
            continue
        end
        
        local Teleporting = true
        task.spawn(function()
            while Teleporting and not NewChar do
                if Root and TargetPart then
                    Root.CFrame = TargetPart.CFrame
                    Root.Velocity = Vector3.zero
                    Root.RotVelocity = Vector3.zero
                    
                    -- Anti-physics freeze forced
                    for _, v in pairs(Char:GetChildren()) do
                        if v:IsA("BasePart") then
                            v.Velocity = Vector3.zero
                            v.RotVelocity = Vector3.zero
                            v.CanCollide = false -- Ghost mode for speed
                        end
                    end
                end
                task.wait()
            end
        end)

        -- Claim Logics
        if i <= 10 then
            ClaimStage(i)
        end

        if i == 11 then
            -- Stage 11: Final Force
            if StatusLabelRef then StatusLabelRef.Text = "Progress: FORCING GOLD BLOCK..." end
            task.wait(1.5)
            
            -- High-Speed Chest Injection
            for touch_attempt = 1, 10 do
                if Root and GoldenChest then
                    GoldenChest.CFrame = Root.CFrame
                    task.wait(0.1)
                end
            end
            
            task.wait(2.5) -- Confirm server receipt
            ChestsCollected = ChestsCollected + 1
            FarmingInProgress = false
            
            -- Immediate Reset to prevent getting stuck in the room
            if StatusLabelRef then StatusLabelRef.Text = "Progress: DONE! NEW CYCLE..." end
            if Char then Char:BreakJoints() end
            task.spawn(function() 
                task.wait(0.5) 
                Claim:FireServer() 
            end)
        else
            -- Aggressive Timeout for Stage 10/11 transitions
            local timeout = 0
            local max_wait = (i >= 9) and 4 or 5.5 -- Force faster skip for late stages
            
            repeat 
                task.wait(0.1) 
                timeout = timeout + 0.1
            until HasStage(i) or NewChar or timeout > max_wait
        end
        Teleporting = false
    end
    if conn then conn:Disconnect() end
end

-- [5] STARTUP & INFINITE LOOP
ApplyDexTrue()
EnableJesusMode()
CreateUI()

-- Auto-restart with Dex Verification
LocalPlayer.CharacterAdded:Connect(function()
    ApplyDexTrue()
    task.wait(3) 
    Farm()
end)

-- Background Guard for absolute loop continuity
task.spawn(function()
    while true do
        if not FarmingInProgress then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                Farm()
            end
        end
        task.wait(2)
    end
end)
