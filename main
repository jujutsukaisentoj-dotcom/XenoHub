    Workspace.CurrentCamera.CameraSubject = lp.Character.Humanoid
end)

AddAction(Tab3, "Player ESP", "Oyuncuları duvar arkasından gösterir.", function()
    XenoSettings.EspActive = not XenoSettings.EspActive
end)

-- SERVER MANAGER
AddAction(Tab4, "Advanced Server Hop", "En düşük pingli sunucuya geçer.", function()
    local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100")).data
    for _, s in pairs(servers) do
        if s.playing < s.maxPlayers and s.id ~= game.JobId then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id)
            break
        end
    end
end)

-- ============================================================================== --
-- DÖNGÜ VE SİSTEM ÇALIŞTIRMA
-- ============================================================================== --

RunService.RenderStepped:Connect(function()
    -- ESP
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then
            local h = p.Character:FindFirstChild("XenoHighlight")
            if XenoSettings.EspActive then
                if not h then
                    h = Instance.new("Highlight", p.Character)
                    h.Name = "XenoHighlight"
                    h.FillColor = Color3.fromRGB(145, 90, 230)
                end
            else
                if h then h:Destroy() end
            end
        end
    end
end)

