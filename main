local function SendNotif(title, text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title;
            Text = text;
            Duration = 4;
        })
    end)
end

local function UniversalItemTrigger(itemName, displayName)
    local ok, err = pcall(function()
        local re = ReplicatedStorage:FindFirstChild("RE")
        local trigger = re and re:FindFirstChild("1Playe1rTrigge1rEven1t")
        
        if trigger then
            trigger:FireServer("AcceptedToolToServer", itemName, lp)
            SendNotif("XenoHub", (displayName or itemName) .. " Verildi! 🎯")
        else
            local toolRem = ReplicatedStorage:FindFirstChild("1Too1l")
            if toolRem and toolRem:IsA("RemoteFunction") then
                toolRem:InvokeServer("PickingTools", itemName)
                SendNotif("XenoHub", (displayName or itemName) .. " Verildi (Alt)! 🛠️")
            end
        end
    end)
end

