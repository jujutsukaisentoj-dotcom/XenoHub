AddBtn(Home, "🌈 RGB NAME/BIO AKTIF ET", function() XenoSettings.RGBEnabled = not XenoSettings.RGBEnabled end, Color3.fromRGB(0, 200, 100))
AddBtn(Home, "🔓 PREMIUM BYPASS", function()
    local gpc = require(ReplicatedStorage.Modules.Client.UI.GamepassUnlockController)
    gpc.OwnsGamepass = function() return true end
    gpc.IsPremium = function() return true end
    SendNotif("XenoHub", "Premium Aktif!")
end)

local PlayerTab = NewTab("🏃 Oyuncu")
AddBtn(PlayerTab, "🏃 Hız Arttır (+10)", function() XenoSettings.Speed = XenoSettings.Speed + 10 lp.Character.Humanoid.WalkSpeed = XenoSettings.Speed end)
AddBtn(PlayerTab, "🚶 Hız Düşür (-10)", function() XenoSettings.Speed = math.max(16, XenoSettings.Speed - 10) lp.Character.Humanoid.WalkSpeed = XenoSettings.Speed end)
AddBtn(PlayerTab, "⬆️ Zıplama Arttır (+10)", function() XenoSettings.Jump = XenoSettings.Jump + 10 lp.Character.Humanoid.JumpPower = XenoSettings.Jump end)
AddBtn(PlayerTab, "👻 NOCLIP (Duvardan Geçme)", function() XenoSettings.Noclip = not XenoSettings.Noclip end)
AddBtn(PlayerTab, "🕊️ FLY (Uçma)", function() XenoSettings.Fly = not XenoSettings.Fly end)

local CarTab = NewTab("🚗 Araba")
AddBtn(CarTab, "🏎️ ARABA HIZINI ARTIR (Full Trigger)", function() XenoSettings.CarSpeed = XenoSettings.CarSpeed + 5 SetCarPerformance() end)
AddBtn(CarTab, "🔥 TURBO AKTİF ET", function() XenoSettings.CarTurbo = not XenoSettings.CarTurbo SetCarPerformance() end)
AddBtn(CarTab, "🎨 ARABA RGB MODU", function() SendNotif("XenoHub", "Araba RGB yakında!") end)

