AiInput.TextColor3 = Color3.new(1,1,1)
Instance.new("UICorner", AiInput)

AddBtn(AITab, "🤖 AI'ya Sor", function()
    local q = AiInput.Text
    if q ~= "" then
        AiLog.Text = "XenoAI Düşünüyor..."
        AskXenoAI(q, function(resp)
            AiLog.Text = "XenoAI: " .. resp
        end)
    end
end, Color3.fromRGB(100, 50, 200))

-- VISUALS (UNVIEW GÜNCELLENDİ)
AddBtn(VisTab, "🛑 İzlemeyi Bırak (Unview)", function()
    XenoSettings.Spectating = nil
    if lp.Character and lp.Character:FindFirstChild("Humanoid") then
        Workspace.CurrentCamera.CameraSubject = lp.Character.Humanoid
    end
    SendNotif("XenoHub", "Kendi karakterine dönüldü.")
end, Color3.fromRGB(200, 50, 50))

AddBtn(VisTab, "👁️ Oyuncu ESP", function() 
    XenoSettings.EspEnabled = not XenoSettings.EspEnabled 
    SendNotif("ESP", XenoSettings.EspEnabled and "Açık" or "Kapalı")
end)

-- SERVER
AddBtn(ServerTab, "🔄 Sunucuya Tekrar Gir", function() TeleportService:Teleport(game.PlaceId, lp) end)
AddBtn(ServerTab, "🦘 Server Hop (Hızlı)", ServerHop)
AddBtn(ServerTab, "📊 Sunucu Bilgisi", function() 
    SendNotif("Sunucu Bilgi", "Oyuncu Sayısı: " .. #Players:GetPlayers() .. "\nJobId: " .. game.JobId:sub(1,8))
end)

-- Looplar ve Sistemler
RunService.RenderStepped:Connect(function()
    if XenoSettings.Spectating and XenoSettings.Spectating.Character and XenoSettings.Spectating.Character:FindFirstChild("Humanoid") then
        Workspace.CurrentCamera.CameraSubject = XenoSettings.Spectating.Character.Humanoid
    end
    
    if XenoSettings.EspEnabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= lp and p.Character and not p.Character:FindFirstChild("XenoHighlight") then
                local hl = Instance.new("Highlight", p.Character)
                hl.Name = "XenoHighlight"
                hl.FillColor = Color3.fromRGB(145, 90, 230)
            end
        end
    else
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("XenoHighlight") then p.Character.XenoHighlight:Destroy() end
        end
    end
end)

-- Toggle Butonu
