-- ===============================================================
-- 👑 GEMINI HUB V11 - ULTIMATE BUILD A BOAT FARM
-- 🚀 FULL 11 STAGE + DEX BYPASS + 2X GOLD TETİKLEYİCİ
-- ===============================================================

local Settings = {
    FarmEnabled = false,
    DoubleGold = true,
    AntiWater = true,
    MaxStages = 10, -- 10. bölge dahil geçilecek
    ChestStage = 11, -- 11. sandık aşaması
    TeleportSpeed = 0.05,
    AutoClaim = true
}

-- Servisler
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Data = LocalPlayer:WaitForChild("OtherData")
local Claim = Workspace:WaitForChild("ClaimRiverResultsGold")
local Stages = Workspace:WaitForChild("BoatStages"):WaitForChild("NormalStages")

-- [ 2X GOLD & DEX BYPASS ]
-- Hem veri klasörünü (Dex) hem de ReplicatedStorage'ı tetikler
local function EnableDoubleGold()
    if Settings.DoubleGold then
        pcall(function()
            -- Dex üzerinden bakıldığında "True" görünmesi için zorunlu kılınır
            if Data:FindFirstChild("DoubleGold") then
                Data.DoubleGold.Value = true
            end
            -- Sunucuya Gamepass varmış gibi sinyal gönderir
            if ReplicatedStorage:FindFirstChild("DoubleGoldGamepass") then
                ReplicatedStorage.DoubleGoldGamepass:FireServer(true)
            end
        end)
    end
end

-- [ GUI OLUŞTURMA ]
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "Gemini_V11"
ScreenGui.Parent = (gethui and gethui()) or (game:GetService("CoreGui")) or LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
MainFrame.Size = UDim2.new(0, 230, 0, 270)
MainFrame.Position = UDim2.new(0.05, 0, 0.3, 0)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 12)
UICorner.Parent = MainFrame

local Title = Instance.new("TextLabel")
Title.Parent = MainFrame
Title.Size = UDim2.new(1, 0, 0, 45)
Title.Text = "GEMINI HUB V11 👑"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 16
Title.BackgroundColor3 = Color3.fromRGB(40, 0, 150)

local Corner2 = Instance.new("UICorner")
Corner2.CornerRadius = UDim.new(0, 12)
Corner2.Parent = Title

-- [ BUTON OLUŞTURUCU ]
local function CreateButton(name, pos, text, callback)
    local Btn = Instance.new("TextButton")
    Btn.Name = name
    Btn.Parent = MainFrame
    Btn.Position = pos
    Btn.Size = UDim2.new(0.9, 0, 0, 40)
    Btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    Btn.Text = text
    Btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    Btn.Font = Enum.Font.GothamMedium
    Btn.TextSize = 13
    Btn.BorderSizePixel = 0
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = Btn
    
    Btn.Activated:Connect(function()
        callback(Btn)
    end)
    return Btn
end

-- Farm Kontrolü
local FarmBtn = CreateButton("FarmBtn", UDim2.new(0.05, 0, 0.22, 0), "AUTO FARM: KAPALI", function(self)
    Settings.FarmEnabled = not Settings.FarmEnabled
    if Settings.FarmEnabled then
        self.Text = "AUTO FARM: AÇIK"
        self.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        self.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        self.Text = "AUTO FARM: KAPALI"
        self.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        self.TextColor3 = Color3.fromRGB(220, 220, 220)
    end
end)

-- Double Gold Kontrolü
local GoldBtn = CreateButton("GoldBtn", UDim2.new(0.05, 0, 0.42, 0), "2X GOLD (DEX): AKTİF", function(self)
    Settings.DoubleGold = not Settings.DoubleGold
    if Settings.DoubleGold then
        self.Text = "2X GOLD (DEX): AKTİF"
        self.BackgroundColor3 = Color3.fromRGB(255, 180, 0)
        EnableDoubleGold()
    else
        self.Text = "2X GOLD (DEX): PASİF"
        self.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    end
end)
GoldBtn.BackgroundColor3 = Color3.fromRGB(255, 180, 0)

-- Anti Water Kontrolü
CreateButton("WaterBtn", UDim2.new(0.05, 0, 0.62, 0), "ANTİ-SU HASARI: AÇIK", function(self)
    Settings.AntiWater = not Settings.AntiWater
    self.Text = Settings.AntiWater and "ANTİ-SU HASARI: AÇIK" or "ANTİ-SU HASARI: KAPALI"
end)

-- [ ANA SİSTEM ]

local function HasStage(Num)
    local val = Data:FindFirstChild(`Stage{Num}`)
    return val and val.Value ~= "" and val.Value
end

local function ClaimStage(Num)
    if not Settings.AutoClaim then return end
    task.spawn(function()
        local Value = Data:FindFirstChild(`Stage{Num}`)
        if Value and Value.Value == "" then
            Value:GetPropertyChangedSignal("Value"):Wait()
        end
        Claim:FireServer()
    end)
end

local function FarmLoop()
    while true do
        if Settings.FarmEnabled then
            local Char = LocalPlayer.Character
            local Root = Char and Char:FindFirstChild("HumanoidRootPart")
            
            if Root then
                EnableDoubleGold()
                
                local NewChar = false
                local charConn
                charConn = LocalPlayer.CharacterAdded:Once(function()
                    NewChar = true
                end)

                -- Karakter Sabitleyici (Anti-Kick)
                local BV = Instance.new("BodyVelocity", Root)
                BV.Velocity = Vector3.new(0,0,0)
                
                -- SIRALI GEÇİŞ (1'DEN 10'A KADAR TAMAMINI GEÇER)
                for i = 1, Settings.MaxStages do
                    if not Settings.FarmEnabled or NewChar then break end
                    
                    local StageFolder = Stages:FindFirstChild(`CaveStage{i}`)
                    if StageFolder and StageFolder:FindFirstChild("DarknessPart") then
                        local TargetPart = StageFolder.DarknessPart
                        local Teleporting = true
                        
                        -- Bölge Kilidi
                        task.spawn(function()
                            while Teleporting and Settings.FarmEnabled and not NewChar do
                                Root.CFrame = TargetPart.CFrame
                                for _, part in pairs(Char:GetChildren()) do
                                    if part:IsA("BasePart") then
                                        part.Velocity = Vector3.zero
                                        part.RotVelocity = Vector3.zero
                                    end
                                end
                                task.wait()
                            end
                        end)
                        
                        ClaimStage(i)
                        
                        -- Sunucu Onayı Bekleme (Stage Verisi Güncellenene Kadar)
                        local timeout = tick()
                        repeat task.wait() until HasStage(i) or NewChar or not Settings.FarmEnabled or (tick() - timeout > 5)
                        
                        Teleporting = false
                        task.wait(Settings.TeleportSpeed)
                    end
                end
                
                -- SANDIK ALMA (11. AŞAMA)
                if Settings.FarmEnabled and not NewChar then
                    local EndStage = Stages:FindFirstChild("TheEnd")
                    if EndStage and EndStage:FindFirstChild("GoldenChest") then
                        local Chest = EndStage.GoldenChest.Trigger
                        
                        -- Sandık Karakterin Üstüne Çekilir (Gelişmiş Bypass)
                        local OldCFrame = Chest.CFrame
                        Chest.CFrame = Root.CFrame
                        
                        if firetouchinterest then
                            firetouchinterest(Root, Chest, 0)
                            task.wait(0.1)
                            firetouchinterest(Root, Chest, 1)
                        end
                        
                        task.wait(0.4)
                        Chest.CFrame = OldCFrame 
                        
                        Claim:FireServer()
                        task.wait(2)
                        Char:BreakJoints() -- Yeni tur başlat
                    end
                end
                
                if BV then BV:Destroy() end
                if charConn then charConn:Disconnect() end
            end
        end
        task.wait(1)
    end
end

-- Anti Su Hasarı Mantığı
RunService.Stepped:Connect(function()
    if Settings.AntiWater and LocalPlayer.Character then
        pcall(function()
            for _, v in pairs(LocalPlayer.Character:GetChildren()) do
                if v:IsA("BasePart") then v.CanTouch = false end
            end
        end)
    end
end)

task.spawn(FarmLoop)
print("🚀 Gemini Hub V11 - Dex Bypass & Full Farm Aktif!")
