DiscordBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
DiscordBtn.Font = Enum.Font.GothamBold
DiscordBtn.TextSize = 14
Instance.new("UICorner", DiscordBtn).CornerRadius = UDim.new(0, 6)

-- İstatistik Güncelleme Döngüsü
task.spawn(function()
    while task.wait(1) do
        local currentGold = LocalPlayer.Data.Gold.Value
        GainedGold = currentGold - StartGold
        
        local diff = os.time() - StartTime
        local hours = math.floor(diff / 3600)
        local mins = math.floor((diff % 3600) / 60)
        local secs = diff % 60
        
        CurrentGoldLabel.Text = "Current Gold: " .. string.format('%,d', currentGold)
        GainedGoldLabel.Text = "Gained Gold: " .. string.format('%,d', GainedGold)
        ChestsLabel.Text = "Chests Collected: " .. ChestsCollected
        TimeLabel.Text = "Total Time Farming: " .. string.format("%02d:%02d:%02d", hours, mins, secs)
    end
end)

