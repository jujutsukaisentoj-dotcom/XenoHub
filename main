    Callback = function()
        -- Basit çekim mantığı
        local radius = 50
        local center = player.Character.HumanoidRootPart.Position
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Part") and not v.Anchored and v.Parent ~= player.Character then
                v.Velocity = (center - v.Position).Unit * 50
            end
        end
    end
})

