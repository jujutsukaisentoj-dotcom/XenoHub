    -- Renk geçişi efekti
    TweenService:Create(ToggleBtn, TweenInfo.new(0.3), {TextColor3 = MainFrame.Visible and Color3.fromRGB(145, 90, 230) or Color3.fromRGB(255, 255, 255)}):Play()
end)

