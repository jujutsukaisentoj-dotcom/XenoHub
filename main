--[[
    W31rd.Hub - Gold Farming V1.2
    Oyun: Build A Boat For Treasure
    Özellikler: Otomatik Altın Kasma, UI Takibi, Bypass Entegrasyonu
]]

local Lib = {}
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

-- Global Değişkenler
_G.AutoFarm = true
local GainedGold = 0
local ChestsCollected = 0
local StartGold = LocalPlayer.Data.gold.Value
local StartTime = os.time()

-- UI Oluşturma
local ScreenGui = Instance.new("ScreenGui")
local MainFrame = Instance.new("Frame")
local Title = Instance.new("TextLabel")
local StatsFrame = Instance.new("Frame")
local CurrentGoldLabel = Instance.new("TextLabel")
local GainedGoldLabel = Instance.new("TextLabel")
local ChestsLabel = Instance.new("TextLabel")
local TimeLabel = Instance.new("TextLabel")
local DiscordBtn = Instance.new("TextButton")

-- UI Ayarları (Görseldeki gibi koyu tema)
ScreenGui.Parent = game.CoreGui
MainFrame.Name = "W31rdHub"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
MainFrame.Position = UDim2.new(0.8, 0, 0.4, 0)
MainFrame.Size = UDim2.new(0, 250, 0, 300)
MainFrame.BorderSizePixel = 0

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = MainFrame

Title.Parent = MainFrame
Title.Size = UDim2.new(1, 0, 0, 40)
Title.Text = "W31rd.Hub • Gold Farming • V1.2"
Title.TextColor3 = Color3.fromRGB(80, 150, 255)
Title.BackgroundTransparency = 1
Title.TextSize = 16
Title.Font = Enum.Font.SourceSansBold

-- Veri Güncelleme Fonksiyonları
local function updateLabels()
    local currentGold = LocalPlayer.Data.gold.Value
    CurrentGoldLabel.Text = "Current Gold: " .. tostring(currentGold)
    GainedGoldLabel.Text = "Gained Gold: " .. tostring(currentGold - StartGold)
    ChestsLabel.Text = "Chests Collected: " .. tostring(ChestsCollected)
    
    local diff = os.difftime(os.time(), StartTime)
    local hours = math.floor(diff / 3600)
    local mins = math.floor((diff % 3600) / 60)
    local secs = diff % 60
    TimeLabel.Text = string.format("Total Time Farming: %02d:%02d:%02d", hours, mins, secs)
end

-- UI Elemanlarını Oluştur (Basitleştirilmiş Liste)
local function createLabel(text, color, pos)
    local lbl = Instance.new("TextLabel")
    lbl.Parent = MainFrame
    lbl.Position = pos
    lbl.Size = UDim2.new(1, -20, 0, 30)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = color
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Font = Enum.Font.SourceSansBold
    lbl.TextSize = 18
    return lbl
end

CurrentGoldLabel = createLabel("Current Gold: 0", Color3.fromRGB(255, 255, 0), UDim2.new(0, 10, 0, 50))
GainedGoldLabel = createLabel("Gained Gold: 0", Color3.fromRGB(0, 255, 0), UDim2.new(0, 10, 0, 90))
ChestsLabel = createLabel("Chests Collected: 0", Color3.fromRGB(255, 150, 0), UDim2.new(0, 10, 0, 130))
TimeLabel = createLabel("Total Time Farming: 00:00:00", Color3.fromRGB(100, 200, 255), UDim2.new(0, 10, 0, 170))

DiscordBtn.Parent = MainFrame
DiscordBtn.Position = UDim2.new(0.05, 0, 0.8, 0)
DiscordBtn.Size = UDim2.new(0.9, 0, 0, 40)
DiscordBtn.BackgroundColor3 = Color3.fromRGB(60, 120, 255)
DiscordBtn.Text = "Copy Discord Link"
DiscordBtn.TextColor3 = Color3.new(1, 1, 1)
DiscordBtn.Font = Enum.Font.SourceSansBold
DiscordBtn.TextSize = 18
Instance.new("UICorner", DiscordBtn).CornerRadius = UDim.new(0, 8)

DiscordBtn.MouseButton1Click:Connect(function()
    setclipboard("https://discord.gg/bQnXYAYTzF")
    DiscordBtn.Text = "Copied!"
    wait(2)
    DiscordBtn.Text = "Copy Discord Link"
end)

-- Farm Mantığı
local function getStages()
    local stages = {}
    for i = 1, 10 do
        local folder = workspace:FindFirstChild("Stage" .. i)
        if folder then
            table.insert(stages, folder)
        end
    end
    return stages
end

local function teleportTo(targetPos)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local tween = TweenService:Create(LocalPlayer.Character.HumanoidRootPart, TweenInfo.new(2, Enum.EasingStyle.Linear), {CFrame = targetPos})
    tween:Play()
    tween.Completed:Wait()
end

-- Ana Döngü
spawn(function()
    while _G.AutoFarm do
        pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                -- Karakteri sabitle (su ve engellerden ölmemek için)
                LocalPlayer.Character.HumanoidRootPart.Anchored = true
                
                -- Bölümleri Geç
                for i = 1, 10 do
                    local stageFolder = workspace.BoatStages.NormalStages:FindFirstChild("CaveStage" .. i)
                    if stageFolder then
                        local part = stageFolder:FindFirstChild("DarknessPart") or stageFolder:FindFirstChildOfClass("Part")
                        if part then
                            teleportTo(part.CFrame * CFrame.new(0, 50, 0)) -- Yüksekten geçerek bypass
                            wait(0.1)
                        end
                    end
                end
                
                -- Hazineye Git
                local endZone = workspace:FindFirstChild("BoatStages"):FindFirstChild("RetardZone")
                if endZone then
                    teleportTo(endZone.CFrame * CFrame.new(0, -10, 0))
                    wait(2)
                    ChestsCollected = ChestsCollected + 1
                end
                
                -- Reset at ve bekle
                LocalPlayer.Character:BreakJoints()
                wait(6) -- Yeniden doğma süresi
            end
        end)
        wait(1)
    end
end)

-- UI Güncelleme Döngüsü
RunService.RenderStepped:Connect(function()
    updateLabels()
end)

print("W31rd.Hub yüklendi!")
