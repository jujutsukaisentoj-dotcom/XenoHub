    ParentFolder.XenoBrookhaven:Destroy()
end

local XenoGui = Instance.new("ScreenGui")
XenoGui.Name = "XenoBrookhaven"
XenoGui.Parent = ParentFolder
XenoGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

function SendNotif(title, text, duration)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title;
            Text = text;
            Duration = duration or 3;
        })
    end)
end

local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
-- Mobilde daha iyi görünmesi için Scale kullanıldı
MainFrame.Size = UDim2.new(0, 580, 0, 360) 
MainFrame.Position = UDim2.new(0.5, -290, 0.5, -180)
MainFrame.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
MainFrame.BorderSizePixel = 0
MainFrame.Parent = XenoGui

Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 12)
local mainStroke = Instance.new("UIStroke")
mainStroke.Color = Color3.fromRGB(145, 90, 230)
mainStroke.Thickness = 2
mainStroke.Parent = MainFrame

-- Universal Sürükleme Mantığı (Mobile Friendly)
local function MakeDraggable(frame)
    local dragging, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    frame.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end

MakeDraggable(MainFrame)

