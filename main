-- 5. OYUNCU SAYFASI (DETAYLI ENTEGRASYON)
-- ============================================================================== --

AddSection(PlayerTab, "🏃 HAREKETLER")

AddBtn(PlayerTab, "🚀 Süper Hız (100)", function() lp.Character.Humanoid.WalkSpeed = 100 end)
AddBtn(PlayerTab, "🦘 Süper Zıplama (150)", function() lp.Character.Humanoid.JumpPower = 150 end)
AddBtn(PlayerTab, "🌍 Düşük Yerçekimi (50)", function() workspace.Gravity = 50 end)

AddBtn(PlayerTab, "♻️ İstatistikleri Sıfırla", function()
    local h = lp.Character:FindFirstChildOfClass("Humanoid")
    if h then h.WalkSpeed = 16 h.JumpPower = 50 end
    workspace.Gravity = 196.2
    XenoSettings.Noclip = false
    XenoSettings.Spinning = false
    XenoSettings.InfJump = false
    SendNotif("XenoHub", "Ayarlar Sıfırlandı.")
end, Color3.fromRGB(60, 60, 65))

AddSection(PlayerTab, "🌀 ÖZEL YETENEKLER")

local noclipBtn = AddBtn(PlayerTab, "🚫 Noclip: KAPALI", function()
    XenoSettings.Noclip = not XenoSettings.Noclip
end)

local spinBtn = AddBtn(PlayerTab, "🔄 Dönme: KAPALI", function()
    XenoSettings.Spinning = not XenoSettings.Spinning
end)

local jumpBtn = AddBtn(PlayerTab, "🦅 Sonsuz Zıplama: KAPALI", function()
    XenoSettings.InfJump = not XenoSettings.InfJump
end)

-- LOOP SİSTEMLERİ (Gelişmiş)
RunService.Stepped:Connect(function()
    noclipBtn.Text = "🚫 Noclip: " .. (XenoSettings.Noclip and "AÇIK" or "KAPALI")
    spinBtn.Text = "🔄 Dönme: " .. (XenoSettings.Spinning and "AÇIK" or "KAPALI")
    jumpBtn.Text = "🦅 Sonsuz Zıplama: " .. (XenoSettings.InfJump and "AÇIK" or "KAPALI")

    if XenoSettings.Noclip and lp.Character then
        for _, v in pairs(lp.Character:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if XenoSettings.Spinning and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
        lp.Character.HumanoidRootPart.CFrame *= CFrame.Angles(0, math.rad(XenoSettings.SpinSpeed), 0)
    end
end)

UserInputService.JumpRequest:Connect(function()
    if XenoSettings.InfJump and lp.Character then
        local h = lp.Character:FindFirstChildOfClass("Humanoid")
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

