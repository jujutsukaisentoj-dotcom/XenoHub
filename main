local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local StarterGui = game:GetService("StarterGui")

local lp = Players.LocalPlayer
local PlayerGui = lp:WaitForChild("PlayerGui")
local ParentFolder = (gethui and gethui()) or CoreGui

-- ============================================================================== --
-- 1. TEMEL AYARLAR & DEX LOGIC
-- ============================================================================== --

local XenoSettings = {
    PremiumEnabled = false,
    Speed = 16,
    Jump = 50,
    Noclip = false
}

local function SendNotif(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title;
            Text = text;
            Duration = 5;
        })
    end)
end

-- ============================================================================== --
-- 2. MAX BYPASS TETİKLEYİCİLER
-- ============================================================================== --

local function SafeTrigger(mode, ...)
    local args = {...}
    pcall(function()
        local re = ReplicatedStorage:FindFirstChild("RE")
        local mainEvent = re and re:FindFirstChild("1Playe1rTrigge1rEven1t")
        
        if mode == "House" then
            mainEvent:FireServer("HouseSettings", unpack(args))
        elseif mode == "Tool" then
            mainEvent:FireServer("AcceptedToolToServer", args[1], lp)
        elseif mode == "Avatar" then
            mainEvent:FireServer("AvatarSettings", unpack(args))
        end
    end)
end

-- ============================================================================== --
-- 3. BROOKHAVEN ORIJINAL MODALFIREASK TETİKLEYİCİ (MAX BYPASS)
-- ============================================================================== --

local function OpenOriginalFireModal()
    pcall(function()
        -- Oyunun kendi GUI'si içinde ModalFireAsk'ı buluyoruz
        local originalModal = nil
        for _, v in pairs(PlayerGui:GetDescendants()) do
            if v.Name == "ModalFireAsk" and (v:IsA("Frame") or v:IsA("ImageLabel")) then
                originalModal = v
                break
            end
        end

        if originalModal then
            -- Dex gibi zorla görünür yapıyoruz
            originalModal.Visible = true
            if originalModal:IsA("Frame") then
                originalModal.Active = true
            end
            
            -- Eğer frame içindeki butonlar özelse onları da aktif et
            for _, btn in pairs(originalModal:GetDescendants()) do
                if btn:IsA("GuiButton") then
                    -- Yeşil butona basıldığında çalışacak orijinal fonksiyonu tetikle (veya bizimkini bağla)
                    if btn.Name:lower():find("yes") or btn.BackgroundColor3 == Color3.fromRGB(34, 139, 34) then
                        btn.MouseButton1Click:Connect(function()
                            local Game8 = require(StarterGui.Player8Handler.Game8Settings)
                            Game8.PlayersHouse:FireServer("PlayerWantsFire")
                            SendNotif("XenoHub", "Orijinal Yangın Tetiklendi! 🔥")
                        end)
                    end
                end
            end
            SendNotif("XenoHub", "Orijinal ModalFireAsk Bulundu ve Aktif Edildi!")
        else
            -- Eğer frame henüz yüklenmemişse veya bulunamazsa doğrudan Remote tetikle
            SendNotif("XenoHub", "Modal bulunamadı, doğrudan Remote zorlanıyor...")
            local Game8 = require(StarterGui.Player8Handler.Game8Settings)
            Game8.PlayersHouse:FireServer("PlayerWantsFire")
        end
    end)
end

-- ============================================================================== --
-- 4. MEGA UI - XENOHUB ULTIMATE FRAME
-- ============================================================================== --

if ParentFolder:FindFirstChild("XenoBrookhaven") then ParentFolder.XenoBrookhaven:Destroy() end

local XenoGui = Instance.new("ScreenGui")
XenoGui.Name = "XenoBrookhaven"
XenoGui.Parent = ParentFolder
XenoGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 700, 0, 480)
MainFrame.Position = UDim2.new(0.5, -350, 0.5, -240)
MainFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
MainFrame.Parent = XenoGui
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 12)

local MainStroke = Instance.new("UIStroke")
MainStroke.Color = Color3.fromRGB(145, 90, 230)
MainStroke.Thickness = 2
MainStroke.Parent = MainFrame

local function MakeDraggable(f)
    local dragging, dragInput, dragStart, startPos
    f.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true dragStart = input.Position startPos = f.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    f.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
    end)
    RunService.RenderStepped:Connect(function()
        if dragging and dragInput then
            local delta = dragInput.Position - dragStart
            f.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end
MakeDraggable(MainFrame)

-- ============================================================================== --
-- 5. TAB SİSTEMİ (SIDEBAR)
-- ============================================================================== --

local SideBar = Instance.new("Frame")
SideBar.Size = UDim2.new(0, 180, 1, 0)
SideBar.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
SideBar.Parent = MainFrame
Instance.new("UICorner", SideBar).CornerRadius = UDim.new(0, 12)

local TabHolder = Instance.new("Frame")
TabHolder.Size = UDim2.new(1, -200, 1, -20)
TabHolder.Position = UDim2.new(0, 190, 0, 10)
TabHolder.BackgroundTransparency = 1
TabHolder.Parent = MainFrame

local pages = {}
local function NewTab(name)
    local tBtn = Instance.new("TextButton")
    tBtn.Size = UDim2.new(0.9, 0, 0, 40)
    tBtn.Position = UDim2.new(0.05, 0, 0, 60 + (#pages * 45))
    tBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    tBtn.BackgroundTransparency = 1
    tBtn.Text = "  " .. name
    tBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    tBtn.Font = Enum.Font.GothamBold
    tBtn.TextSize = 13
    tBtn.TextXAlignment = Enum.TextXAlignment.Left
    tBtn.Parent = SideBar
    Instance.new("UICorner", tBtn).CornerRadius = UDim.new(0, 6)

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ScrollBarThickness = 2
    page.Parent = TabHolder
    Instance.new("UIListLayout", page).Padding = UDim.new(0, 8)

    tBtn.MouseButton1Click:Connect(function()
        for _, p in pairs(pages) do p.p.Visible = false p.b.BackgroundTransparency = 1 p.b.TextColor3 = Color3.fromRGB(200, 200, 200) end
        page.Visible = true
        tBtn.BackgroundTransparency = 0.8
        tBtn.TextColor3 = Color3.fromRGB(145, 90, 230)
    end)

    if #pages == 0 then page.Visible = true tBtn.BackgroundTransparency = 0.8 tBtn.TextColor3 = Color3.fromRGB(145, 90, 230) end
    table.insert(pages, {b = tBtn, p = page})
    return page
end

local function AddBtn(parent, text, cb, color)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0.96, 0, 0, 44)
    b.BackgroundColor3 = color or Color3.fromRGB(25, 25, 30)
    b.Text = text
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.MouseButton1Click:Connect(cb)
end

