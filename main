local function SendNotif(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title;
            Text = text;
            Icon = "rbxassetid://6023426926";
            Duration = 3;
        })
    end)
end

-- ============================================================================== --
-- 2. YAPAY ZEKA SİSTEMİ (XenoAI v2)
-- ============================================================================== --

local function AskXenoAI(prompt, callback)
    task.spawn(function()
        local payload = {
            contents = {{ parts = {{ text = prompt }} }},
            systemInstruction = { parts = {{ text = XenoSettings.AiSystemPrompt }} }
        }
        
        local success, result
        local retries = 0
        local delays = {1, 2, 4}

        repeat
            success, result = pcall(function()
                return HttpService:PostAsync(
                    "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=" .. XenoSettings.ApiKey,
                    HttpService:JSONEncode(payload)
                )
            end)
            if not success then
                retries = retries + 1
                task.wait(delays[retries] or 5)
            end
        until success or retries >= 3

        if success then
            local data = HttpService:JSONDecode(result)
            local aiText = data.candidates[1].content.parts[1].text
            callback(aiText)
        else
            callback("Hata: AI şu an meşgul veya API sunucusuyla iletişim kurulamadı. Lütfen tekrar deneyin.")
        end
    end)
end

-- ============================================================================== --
-- 3. BYPASS VE SERVER FONKSİYONLARI
-- ============================================================================== --

local function FullPremiumBypass()
    pcall(function()
        local gpc = require(ReplicatedStorage.Modules.Client.UI.GamepassUnlockController)
        gpc.OwnsGamepass = function() return true end
        gpc.IsPremium = function() return true end
        
        -- Admin & Permissions Bypass
        local MainPermPath = ReplicatedStorage:FindFirstChild("Permissions", true)
        if MainPermPath then
            local MainPermissions = require(MainPermPath)
            local funcs = {"hasAdminAccess", "hasContentCreatorAccess", "hasModeratorAccess", "hasStaffAccess"}
            for _, f in ipairs(funcs) do MainPermissions[f] = function() return true end end
        end
        SendNotif("XenoHub", "Tüm Yetkiler ve Premium Özellikler Aktif Edildi!")
    end)
end

local function AdvancedServerHop()
    SendNotif("XenoHub", "Optimal sunucu aranıyor...")
    task.spawn(function()
        local function GetServers(cursor)
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor then url = url .. "&cursor=" .. cursor end
            return HttpService:JSONDecode(game:HttpGet(url))
        end
        
        local servers = GetServers()
        local bestServer = nil
        
        for _, s in pairs(servers.data) do
            if s.playing < s.maxPlayers and s.id ~= game.JobId then
                bestServer = s.id
                break
            end
        end
        
        if bestServer then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, bestServer)
        else
            SendNotif("Hata", "Uygun sunucu bulunamadı, tekrar deneniyor...")
        end
    end)
end

