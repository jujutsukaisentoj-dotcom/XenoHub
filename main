TabContainer.Position = UDim2.new(0, 170, 0, 10)
TabContainer.BackgroundTransparency = 1
TabContainer.Parent = MainFrame

-- Bypass ve Fire Sistemi
local function ExecuteFireBypass(state)
    pcall(function()
        local MainGUIHandler = PlayerGui:FindFirstChild("MainGUIHandler")
        if MainGUIHandler and MainGUIHandler:FindFirstChild("ModalFireAsk") then
            MainGUIHandler.ModalFireAsk.Visible = state
        end

        local GameSettings = require(game:GetService("StarterGui"):WaitForChild("Player8Handler"):WaitForChild("Game8Settings"))
        if GameSettings and GameSettings.PlayersHouse then
            GameSettings.PlayersHouse:FireServer(state and "PlayerWantsFire" or "PlayerWantsStopFire")
        end
    end)

    local RE = ReplicatedStorage:FindFirstChild("RE") or ReplicatedStorage:FindFirstChild("Remotes")
    if RE and RE:FindFirstChild("RemoteEvent") then
        RE.RemoteEvent:FireServer("HouseSettings", "Fire", state)
    end
    
    SendNotif("XenoHub", state and "Yangın Başladı! 🔥" or "Yangın Söndürüldü! 💧")
end

-- Tab ve Buton Fonksiyonları
local tabs = {}
function CreateTab(name)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(0.9, 0, 0, 40)
    tabBtn.Position = UDim2.new(0.05, 0, 0, 70 + (#tabs * 45))
    tabBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    tabBtn.BackgroundTransparency = 1
    tabBtn.Text = "  " .. name
    tabBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextSize = 13
    tabBtn.TextXAlignment = Enum.TextXAlignment.Left
    tabBtn.Parent = SideBar
    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 6)

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ScrollBarThickness = 2
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.Parent = TabContainer
    
    local layout = Instance.new("UIListLayout", page)
    layout.Padding = UDim.new(0, 10)
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 20)
    end)
    
    tabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do 
            t.page.Visible = false 
            t.btn.BackgroundTransparency = 1 
            t.btn.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
        page.Visible = true
        tabBtn.BackgroundTransparency = 0.85
        tabBtn.TextColor3 = Color3.fromRGB(145, 90, 230)
    end)
    
    if #tabs == 0 then 
        page.Visible = true 
        tabBtn.BackgroundTransparency = 0.85
        tabBtn.TextColor3 = Color3.fromRGB(145, 90, 230)
    end
    table.insert(tabs, {btn = tabBtn, page = page})
    return page
end

function AddButton(parent, text, color, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.95, 0, 0, 42)
    btn.BackgroundColor3 = color or Color3.fromRGB(25, 25, 30)
    btn.Text = text
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    
    -- Mobile Touch Feedback
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 40, 45)}):Play()
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = color or Color3.fromRGB(25, 25, 30)}):Play()
        end
    end)
    
    btn.MouseButton1Click:Connect(callback)
end

-- Sayfalar
