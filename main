-- =========================================================
-- W31rd.Hub - Gold Farming V2.1 (INSTANT MODE)
-- NO DELAY BETWEEN STAGES - MAXIMUM SPEED
-- INTEGRATED TREASURE EFFECTS & AUTO-COLLECT
-- =========================================================

-- Services
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

-- Variables
local LocalPlayer = Players.LocalPlayer
local Data = LocalPlayer:WaitForChild("OtherData")
local Claim = workspace:WaitForChild("ClaimRiverResultsGold")
local Stages = workspace.BoatStages.NormalStages
local GoldenChestModel = Stages.TheEnd.GoldenChest
local GoldenChestTrigger = GoldenChestModel.Trigger

-- Stats
local StartGold = LocalPlayer.Data.Gold.Value
local ChestsCollected = 0
local StartTime = os.time()
local FarmingInProgress = false

-- UI Reference
local StatusLabelRef = nil

-- [1] DEX TRUE & DOUBLE GOLD ENJECTOR
local function ApplyDexTrue()
    local passes = {"GoldPass", "VIP", "Member", "DoubleGold", "DoubleMoney", "ExtraBoatSlot"}
    for _, name in pairs(passes) do
        if not LocalPlayer:FindFirstChild(name) then
            local val = Instance.new("BoolValue", LocalPlayer)
            val.Name = name
            val.Value = true
        end
    end
end

-- [2] JESUS MODE
local function EnableJesusMode()
    task.spawn(function()
        while true do
            if workspace:FindFirstChild("Water") then
                workspace.Water.CanCollide = true
                workspace.Water.Transparency = 0.5
                workspace.Water.Size = Vector3.new(10000, 20, 10000)
            end
            task.wait(2)
        end
    end)
end

-- [3] W31RD.HUB PANEL UI
local function CreateUI()
    if CoreGui:FindFirstChild("W3rdHubGui") then CoreGui.W3rdHubGui:Destroy() end
    
    local ScreenGui = Instance.new("ScreenGui", CoreGui)
    ScreenGui.Name = "W3rdHubGui"
    
    local MainFrame = Instance.new("Frame", ScreenGui)
    MainFrame.Size = UDim2.new(0, 300, 0, 260)
    MainFrame.Position = UDim2.new(0.5, -150, 0.4, -130)
    MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    MainFrame.BorderSizePixel = 0
    
    local Corner = Instance.new("UICorner", MainFrame)
    Corner.CornerRadius = UDim.new(0, 10)
    
    local Title = Instance.new("TextLabel", MainFrame)
    Title.Size = UDim2.new(1, 0, 0, 40)
    Title.Text = "W31rd.Hub • Gold Farming • V2.1"
    Title.TextColor3 = Color3.fromRGB(130, 180, 255)
    Title.BackgroundTransparency = 1
    Title.Font = Enum.Font.SourceSansBold
    Title.TextSize = 20
    
    local Line = Instance.new("Frame", MainFrame)
    Line.Size = UDim2.new(0.9, 0, 0, 2)
    Line.Position = UDim2.new(0.05, 0, 0, 40)
    Line.BackgroundColor3 = Color3.fromRGB(50, 100, 255)
    Line.BorderSizePixel = 0
    
    local function CreateStatLabel(text, pos, color)
        local Label = Instance.new("TextLabel", MainFrame)
        Label.Size = UDim2.new(1, -30, 0, 25)
        Label.Position = UDim2.new(0, 15, 0, pos)
        Label.Text = text
        Label.TextColor3 = color
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.BackgroundTransparency = 1
        Label.Font = Enum.Font.SourceSansBold
        Label.TextSize = 19
        return Label
    end
    
    local CurGoldL = CreateStatLabel("Mevcut Altın: " .. StartGold, 55, Color3.fromRGB(255, 215, 0))
    local GainGoldL = CreateStatLabel("Kazanılan: 0", 85, Color3.fromRGB(100, 255, 100))
    local ChestsL = CreateStatLabel("Altın Bloklar: 0", 115, Color3.fromRGB(255, 170, 50))
    local TimeL = CreateStatLabel("Toplam Süre: 00:00:00", 145, Color3.fromRGB(150, 200, 255))
    
    task.spawn(function()
        while task.wait(1) do
            if LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Gold") then
                local current = LocalPlayer.Data.Gold.Value
                local diff = os.time() - StartTime
                local h, m, s = math.floor(diff/3600), math.floor((diff%3600)/60), diff%60
                CurGoldL.Text = "Mevcut Altın: " .. current
                GainGoldL.Text = "Kazanılan: " .. (current - StartGold)
                ChestsL.Text = "Altın Bloklar: " .. ChestsCollected
                TimeL.Text = "Toplam Süre: " .. string.format("%02d:%02d:%02d", h, m, s)
            end
        end
    end)
    
    local Tip = Instance.new("TextLabel", MainFrame)
    Tip.Size = UDim2.new(1, 0, 0, 20)
    Tip.Position = UDim2.new(0, 0, 0, 230)
    Tip.Text = "Durum: Full Hız (Bekleme Yok)"
    Tip.TextColor3 = Color3.fromRGB(255, 255, 255)
    Tip.BackgroundTransparency = 1
    Tip.Font = Enum.Font.SourceSansItalic
    Tip.TextSize = 13
    StatusLabelRef = Tip

    local Dragging, DragStart, StartPos
    MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = true DragStart = input.Position StartPos = MainFrame.Position end
    end)
    MainFrame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = false end
    end)
    RunService.RenderStepped:Connect(function()
        if Dragging then
            local delta = game:GetService("UserInputService"):GetMouseLocation() - Vector2.new(DragStart.X, DragStart.Y)
            MainFrame.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + delta.X, StartPos.Y.Scale, StartPos.Y.Offset + delta.Y)
        end
    end)
end

-- [4] TREASURE EFFECT INTEGRATION
local function TriggerTreasureFX(Root)
    if StatusLabelRef then StatusLabelRef.Text = "FX: Toplama Başladı" end
    
    TweenService:Create(game.Lighting, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
        ClockTime = 3.7;
        FogEnd = 100;
        FogStart = 20;
    }):Play()

    if GoldenChestModel:FindFirstChild("LightPart") then
        GoldenChestModel.LightPart.PointLight.Brightness = 1.5
    end

    for _ = 1, 5 do 
        local bar = GoldenChestModel.DisplayPrizes.GoldBar:Clone()
        bar.Transparency = 0
        bar.Parent = GoldenChestModel.DisplayPrizesTemp
        bar.Position = GoldenChestModel.Base.GoldSpawn.Position
        TweenService:Create(bar, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
            Position = GoldenChestModel.Base.GoldSpawn.Position + Vector3.new(math.random(-5, 5), math.random(4, 8), math.random(-5, 5));
        }):Play()
    end

    local block = GoldenChestModel.DisplayPrizes.GoldBlock:Clone()
    block.Transparency = 0
    block.Parent = GoldenChestModel.DisplayPrizesTemp
    block.Position = GoldenChestModel.Base.GoldSpawn.Position
    TweenService:Create(block, TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
        Position = GoldenChestModel.Base.GoldSpawn.Position + Vector3.new(0, 7, 0);
    }):Play()

    task.wait(0.2)

    for _, v in pairs(GoldenChestModel.DisplayPrizesTemp:GetChildren()) do
        task.spawn(function()
            TweenService:Create(v, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                CFrame = Root.CFrame;
            }):Play()
            task.wait(0.2)
            if v:FindFirstChild("Sound") then v.Sound:Play() end
            v.Transparency = 1
            Debris:AddItem(v, 1)
        end)
    end
end

-- [5] CORE FARM LOGIC (INSTANT)
local function Farm()
    if FarmingInProgress then return end
    FarmingInProgress = true
    
    ApplyDexTrue()
    local Char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local Root = Char:WaitForChild("HumanoidRootPart")

    local NewChar = false
    local conn
    conn = LocalPlayer.CharacterAdded:Once(function() 
        NewChar = true 
        FarmingInProgress = false
    end)

    for _ = 1, 11 do
        if NewChar then break end
        if StatusLabelRef then StatusLabelRef.Text = "Bölüm " .. _ .. " / 11" end

        local TargetPart = (_ <= 10) and Stages[`CaveStage{_}`].DarknessPart or GoldenChestTrigger

        -- Bölüme Işınlan (Saniye yok, direkt hedef)
        local Teleporting = true
        task.spawn(function()
            while Teleporting and not NewChar do
                if Root and TargetPart then
                    Root.CFrame = TargetPart.CFrame
                    for _, v in pairs(Char:GetChildren()) do
                        if v:IsA("BasePart") then
                            v.Velocity = Vector3.zero
                            v.RotVelocity = Vector3.zero
                            v.CanCollide = false
                        end
                    end
                end
                task.wait()
            end
        end)

        if _ == 11 then
            -- Sandık Bölümü
            for i = 1, 5 do
                GoldenChestTrigger.CFrame = Root.CFrame
                task.wait(0.1)
            end
            
            TriggerTreasureFX(Root)
            ChestsCollected = ChestsCollected + 1
            FarmingInProgress = false
            
            task.wait(0.4)
            if Char then Char:BreakJoints() end
            task.spawn(function() Claim:FireServer() end)
            break
        else
            -- Normal Bölüm (Bekleme kaldırıldı)
            Claim:FireServer()
            task.wait(0.35) -- Minimum stabilizasyon süresi
            Teleporting = false
        end
    end
    if conn then conn:Disconnect() end
end

-- [6] INITIALIZATION
ApplyDexTrue()
EnableJesusMode()
CreateUI()

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1.5)
    Farm()
end)

task.spawn(function()
    while true do
        if not FarmingInProgress then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                Farm()
            end
        end
        task.wait(0.5)
    end
end)
