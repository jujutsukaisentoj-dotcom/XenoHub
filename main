-- =========================================================
-- BABFT - FULL TETİKLİ DEX: TRUE & rqccc PRO (V10)
-- =========================================================

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("BABFT - Ultra Dex True v10", "Midnight")

-- SERVICES & DATA
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Data = LocalPlayer:WaitForChild("OtherData")
local Claim = workspace:WaitForChild("ClaimRiverResultsGold")
local Stages = workspace.BoatStages.NormalStages
local GoldenChest = Stages.TheEnd.GoldenChest.Trigger

-- CONFIG & VARS
local StartGold = LocalPlayer.Data.Gold.Value
local ChestCount = 0
local StartTime = os.time()
local AutoFarmActive = false

-- FULL DEX: TRUE & GAMEPASS ENJECTOR
local function ApplyUltimateDex()
    local passes = {"GoldPass", "VIP", "Member", "ExtraBoatSlot", "DoubleGold", "DoubleMoney"}
    for _, name in pairs(passes) do
        if not LocalPlayer:FindFirstChild(name) then
            local val = Instance.new("BoolValue", LocalPlayer)
            val.Name = name
            val.Value = true
        end
    end
    -- İSTEDİĞİN O ÖZEL BİLDİRİM
    Library:Notify("SİSTEM AKTİF", "Tüm Gamepass'lara Sahipsin!", "Success")
end

-- UI TABS
local MainTab = Window:NewTab("Farming")
local StatusSection = MainTab:NewSection("Pro Stats (Tetikli)")

-- LABELS
local goldLabel = StatusSection:NewLabel("Mevcut Altın: " .. StartGold)
local gainedLabel = StatusSection:NewLabel("Kazanç: 0")
local chestLabel = StatusSection:NewLabel("Toplanan Sandık: 0")
local stageLabel = StatusSection:NewLabel("Durum: Bekleniyor...")

-- rqccc LOGIC FUNCTIONS
local function HasStage(Num)
    return Data[`Stage{Num}`].Value ~= "" and Data[`Stage{Num}`].Value
end

local function ClaimStage(Num)
    task.spawn(function()
        local Value = Data[`Stage{Num}`]
        if not Value then
            Value:GetPropertyChangedSignal("Value"):Wait()
        end
        Claim:FireServer()
    end)
end

-- MAIN FARM FUNCTION (rqccc + SLOW & FULL TETİKLİ)
local function StartFarm()
    while AutoFarmActive do
        local Char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local Root = Char:WaitForChild("HumanoidRootPart")
        
        local NewChar = false
        local connection
        connection = LocalPlayer.CharacterAdded:Once(function() NewChar = true end)

        -- 1'DEN 10'A YAVAŞ GEÇİŞ
        for i = 1, 10 do
            if not AutoFarmActive or NewChar then break end
            
            stageLabel:UpdateLabel("İlerleme: Bölüm " .. i .. " / 11")
            local TargetPart = Stages[`CaveStage{i}`].DarknessPart
            local Teleporting = true

            -- rqccc's Pro Teleport (Anti-Kick)
            task.spawn(function()
                while Teleporting and AutoFarmActive do
                    Root.CFrame = TargetPart.CFrame
                    for _, Part in Char:GetChildren() do
                        if Part:IsA("BasePart") then
                            Part.Velocity = Vector3.zero
                            Part.RotVelocity = Vector3.zero
                        end
                    end
                    task.wait()
                end
            end)

            task.wait(5) -- FULL YAVAŞ GÜVENLİK
            ClaimStage(i)
            
            -- Stage Onay Tetikleyici
            repeat task.wait(0.5) until HasStage(i) or NewChar or not AutoFarmActive
            Teleporting = false
        end

        -- 11. BÖLÜM: FINAL SANDIĞI (TETİKLİ)
        if AutoFarmActive and not NewChar then
            stageLabel:UpdateLabel("Durum: SANDIK ALINIYOR...")
            Root.CFrame = GoldenChest.CFrame
            task.wait(1.5)
            
            GoldenChest.CFrame = Root.CFrame
            task.wait(2.5)
            
            ChestCount = ChestCount + 1
            chestLabel:UpdateLabel("Toplanan Sandık: " .. ChestCount)
            
            stageLabel:UpdateLabel("Durum: Başarıyla Alındı! Resetleniyor...")
            Char:BreakJoints()
            task.wait(8) 
        end
        if connection then connection:Disconnect() end
    end
end

-- UI CONTROLS
StatusSection:NewToggle("AUTO FARM BAŞLAT", "Basınca Dex: True ve Farm Tetiklenir", function(state)
    AutoFarmActive = state
    if state then
        ApplyUltimateDex() -- "Tüm Gamepasslara Sahipsin" burada tetiklenir
        task.spawn(StartFarm)
    else
        stageLabel:UpdateLabel("Durum: DURDURULDU")
    end
end)

-- LIVE DATA UPDATER
task.spawn(function()
    while task.wait(1) do
        local cur = LocalPlayer.Data.Gold.Value
        goldLabel:UpdateLabel("Mevcut Altın: " .. cur)
        gainedLabel:UpdateLabel("Kazanç: " .. (cur - StartGold))
    end
end)

-- MOBILE UI TOGGLE
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local ToggleBtn = Instance.new("TextButton", ScreenGui)
ToggleBtn.Size = UDim2.new(0, 80, 0, 35)
ToggleBtn.Position = UDim2.new(0, 15, 0, 150)
ToggleBtn.Text = "MENU"
ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
ToggleBtn.TextColor3 = Color3.new(1,1,1)
ToggleBtn.Draggable = true
ToggleBtn.MouseButton1Click:Connect(function() Library:ToggleUI() end)
