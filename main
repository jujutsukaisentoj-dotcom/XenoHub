local pages = {}
local function NewTab(name)
    local tBtn = Instance.new("TextButton", SideBar)
    tBtn.Size = UDim2.new(0.9, 0, 0, 32)
    tBtn.Position = UDim2.new(0.05, 0, 0, 60 + (#pages * 36))
    tBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    tBtn.BackgroundTransparency = 1
    tBtn.Text = "  " .. name
    tBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    tBtn.Font = Enum.Font.GothamBold
    tBtn.TextSize = 12
    tBtn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", tBtn).CornerRadius = UDim.new(0, 6)

    local page = Instance.new("ScrollingFrame", TabHolder)
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ScrollBarThickness = 2
    Instance.new("UIListLayout", page).Padding = UDim.new(0, 6)

    tBtn.MouseButton1Click:Connect(function()
        for _, p in pairs(pages) do p.p.Visible = false p.b.BackgroundTransparency = 1 p.b.TextColor3 = Color3.fromRGB(180, 180, 180) end
        page.Visible = true
        tBtn.BackgroundTransparency = 0.8
        tBtn.TextColor3 = Color3.fromRGB(145, 90, 230)
    end)

    if #pages == 0 then page.Visible = true tBtn.BackgroundTransparency = 0.8 tBtn.TextColor3 = Color3.fromRGB(145, 90, 230) end
    table.insert(pages, {b = tBtn, p = page})
    return page
end

local function AddBtn(parent, text, cb, color)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(0.98, 0, 0, 36)
    b.BackgroundColor3 = color or Color3.fromRGB(22, 22, 28)
    b.Text = text
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamSemibold
    b.TextSize = 12
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.MouseButton1Click:Connect(function()
        local s, e = pcall(cb, b)
        if not s then warn(e) end
        b.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        task.wait(0.1)
        b.BackgroundColor3 = color or Color3.fromRGB(22, 22, 28)
    end)
end

-- Yeni Input Kutusu Fonksiyonu (Max 1000 Limitli)
local function AddBox(parent, placeholder, callback)
    local container = Instance.new("Frame", parent)
    container.Size = UDim2.new(0.98, 0, 0, 36)
    container.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 6)
    
    local box = Instance.new("TextBox", container)
    box.Size = UDim2.new(0.7, 0, 1, 0)
    box.Position = UDim2.new(0, 10, 0, 0)
    box.BackgroundTransparency = 1
    box.TextColor3 = Color3.new(1, 1, 1)
    box.PlaceholderText = placeholder
    box.Text = ""
    box.Font = Enum.Font.GothamSemibold
    box.TextSize = 12
    box.TextXAlignment = Enum.TextXAlignment.Left
    
    local setBtn = Instance.new("TextButton", container)
    setBtn.Size = UDim2.new(0.25, 0, 0.8, 0)
    setBtn.Position = UDim2.new(0.73, 0, 0.1, 0)
    setBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    setBtn.Text = "Ayarla"
    setBtn.TextColor3 = Color3.fromRGB(145, 90, 230)
    setBtn.Font = Enum.Font.GothamBold
    setBtn.TextSize = 11
    Instance.new("UICorner", setBtn).CornerRadius = UDim.new(0, 4)
    
    setBtn.MouseButton1Click:Connect(function()
        local num = tonumber(box.Text)
        if num then
            if num > 1000 then num = 1000 end -- Max Limit 1000
            if num < 0 then num = 0 end
            callback(num)
            box.Text = tostring(num)
            SendNotif("Ayarlandı", placeholder .. ": " .. num)
        else
             box.Text = "Hata"
             task.wait(1)
             box.Text = ""
        end
    end)
end

