-- ===============================================================
-- ⚡ GEMINI HUB V4 - 11 STAGE ULTRA FAST (FIXED)
-- ===============================================================

local Settings = {
    Enabled = false,
    Speed = 0.05, -- Daha da hızlandırıldı
    Stages = 11   -- İstediğin gibi 11 stage yapıldı
}

-- Servisler
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

-- [ GUI ]
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local Main = Instance.new("Frame", ScreenGui)
local Btn = Instance.new("TextButton", Main)
local Title = Instance.new("TextLabel", Main)

Main.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
Main.Position = UDim2.new(0.05, 0, 0.4, 0)
Main.Size = UDim2.new(0, 160, 0, 100)
Main.Active = true
Main.Draggable = true

Title.Size = UDim2.new(1, 0, 0, 30)
Title.Text = "GEMINI V4 (11 STAGE)"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.BackgroundColor3 = Color3.fromRGB(60, 0, 150)
Title.TextSize = 12

Btn.Size = UDim2.new(0.8, 0, 0.4, 0)
Btn.Position = UDim2.new(0.1, 0, 0.45, 0)
Btn.Text = "BAŞLAT"
Btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
Btn.TextColor3 = Color3.fromRGB(255, 255, 255)

-- [ GAMEPASS & BYPASS ]
local function ApplyBypass()
    pcall(function()
        local data = LocalPlayer:WaitForChild("OtherData", 5)
        if data then
            if data:FindFirstChild("DoubleGold") then data.DoubleGold.Value = true end
            if data:FindFirstChild("Gold") then -- Gold çarpanı tetikleyici
                local goldVal = data.Gold
                goldVal.Changed:Connect(function()
                    Workspace.ClaimRiverResultsGold:FireServer()
                end)
            end
        end
    end)
end

-- [ ANA FARM DÖNGÜSÜ ]
local function DoFarm()
    while Settings.Enabled do
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local stages = Workspace:FindFirstChild("BoatStages") and Workspace.BoatStages:FindFirstChild("NormalStages")
        
        if root and stages then
            ApplyBypass()
            
            -- Anti-Düşme: Karakteri havada kilitler
            local antizero = Instance.new("BodyVelocity", root)
            antizero.Velocity = Vector3.new(0,0,0)

            for i = 1, Settings.Stages do
                if not Settings.Enabled then break end
                
                local sName = "CaveStage" .. i
                local stage = stages:FindFirstChild(sName)
                
                if stage and stage:FindFirstChild("DarknessPart") then
                    -- Çok hızlı ışınlanma
                    root.CFrame = stage.DarknessPart.CFrame
                    Workspace.ClaimRiverResultsGold:FireServer()
                    task.wait(Settings.Speed)
                end
            end
            
            -- Sandık Bölümü
            if Settings.Enabled then
                local endStage = stages:FindFirstChild("TheEnd")
                if endStage and endStage:FindFirstChild("GoldenChest") then
                    local chest = endStage.GoldenChest.Trigger
                    root.CFrame = chest.CFrame
                    if firetouchinterest then
                        firetouchinterest(root, chest, 0)
                        task.wait(0.1)
                        firetouchinterest(root, chest, 1)
                    end
                end
                task.wait(1)
                char:BreakJoints() -- Resetle ve tekrar başla
            end
            antizero:Destroy()
        end
        task.wait(2) -- Reset sonrası bekleme
    end
end

-- [ BUTON TETİKLEME FIX ]
Btn.MouseButton1Click:Connect(function()
    Settings.Enabled = not Settings.Enabled
    if Settings.Enabled then
        Btn.Text = "ÇALIŞIYOR..."
        Btn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        task.spawn(DoFarm)
    else
        Btn.Text = "DURDURULDU"
        Btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- Karakter doğduğunda ayarları kontrol et
LocalPlayer.CharacterAdded:Connect(function()
    if Settings.Enabled then
        task.wait(1)
        task.spawn(DoFarm)
    end
end)
