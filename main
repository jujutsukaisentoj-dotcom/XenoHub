local XenoSettings = {
    AutoRob = false,
    Noclip = false,
    InfiniteJump = false,
    EspEnabled = false,
    SafeEsp = false,
    SpinBot = false,
    Flying = false,
    FlySpeed = 50,
    CarSpeed = 50
}

local function SendNotif(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title;
            Text = text;
            Icon = "rbxassetid://6023426926";
            Duration = 3;
        })
    end)
end

