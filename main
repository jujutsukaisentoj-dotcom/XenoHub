--[[
    BUILD A BOAT - ULTIMATE MOBILE FARMER (ALL GAMEPASS BYPASS)
    Geliştirici: Gemini
    Özellikler: 11 Stages, Auto-Chest, All Gamepass, Mobile UI, Live Stats
]]

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("BABFT - Mobile Pro", "DarkTheme")

-- VERİLER
local StartGold = game.Players.LocalPlayer.Data.Gold.Value
local GainedGold = 0
local Chests = 0
local StartTime = os.time()
local AutoFarm = false

-- MOBILE UYUMLULUK: AÇ/KAPAT BUTONU
local OpenBtn = Instance.new("ScreenGui")
local MainBtn = Instance.new("TextButton")
OpenBtn.Parent = game.CoreGui
MainBtn.Parent = OpenBtn
MainBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
MainBtn.Position = UDim2.new(0, 10, 0, 150)
MainBtn.Size = UDim2.new(0, 100, 0, 40)
MainBtn.Text = "Menu Aç/Kapat"
MainBtn.MouseButton1Click:Connect(function()
    Library:ToggleUI()
end)

-- SEKMELER
local MainTab = Window:NewTab("Stats")
local FarmTab = Window:NewTab("Auto Farm")
local GamepassTab = Window:NewTab("Gamepass & Bypass")

-- STATS SECTION
local Stats = MainTab:NewSection("Live Tracking")
local goldLabel = Stats:NewLabel("Current Gold: " .. StartGold)
local gainedLabel = Stats:NewLabel("Gained Gold: 0")
local chestLabel = Stats:NewLabel("Chest Collected: 0")
local timeLabel = Stats:NewLabel("Total Time Farming: 00:00:00")

-- GAMEPASS BYPASS (TETİKLİ)
local GPSection = GamepassTab:NewSection("Premium Features")
GPSection:NewButton("Unlock All Gamepasses", "Double Gold, Jetpack, VIP etc.", function()
    -- Gamepass Bypass Mantığı (DEX True)
    local localPlayer = game.Players.LocalPlayer
    if not localPlayer:FindFirstChild("GoldPass") then
        local gp = Instance.new("BoolValue", localPlayer)
        gp.Name = "GoldPass" -- Double Gold Tetikleyici
        local vip = Instance.new("BoolValue", localPlayer)
        vip.Name = "VIP"
    end
    Library:Notify("Bypass", "Tüm Gamepass Özellikleri Tetiklendi!", "Default")
end)

-- AUTO FARM (11 BÖLÜM + CHEST)
local FarmSection = FarmTab:NewSection("Stage Farm")
FarmSection:NewToggle("Start Full Farm", "11 Bölüm Geçer ve Sandığı Alır", function(state)
    AutoFarm = state
    if state then
        spawn(function()
            while AutoFarm do
                local char = game.Players.LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    -- 1'den 10'a kadar bölümleri geç (Tetikli)
                    for i = 1, 10 do
                        if not AutoFarm then break end
                        char.HumanoidRootPart.CFrame = game:GetService("Workspace").BoatStages.NormalStages["Stage" .. i].GoldenChest.Trigger.CFrame
                        task.wait(1.5) -- Anti-Cheat Bypass hızı
                    end
                    
                    -- 11. Bölüm (Golden Chest)
                    if AutoFarm then
                        char.HumanoidRootPart.CFrame = game:GetService("Workspace").BoatStages.NormalStages.TheEnd.GoldenChest.Trigger.CFrame
                        task.wait(2)
                        Chests = Chests + 1
                        chestLabel:UpdateLabel("Chest Collected: " .. Chests)
                    end
                    
                    -- Reset ve Tekrar Başla
                    char.Humanoid:BreakJoints()
                    task.wait(5)
                end
            end
        end)
    end
end)

-- ARKA PLAN DÖNGÜSÜ (GÜNCELLEMELER)
spawn(function()
    while task.wait(1) do
        -- Zaman
        local diff = os.time() - StartTime
        local h, m, s = math.floor(diff/3600), math.floor((diff%3600)/60), diff%60
        timeLabel:UpdateLabel("Total Time Farming: " .. string.format("%02d:%02d:%02d", h, m, s))
        
        -- Gold Takibi
        local currentGold = game.Players.LocalPlayer.Data.Gold.Value
        GainedGold = currentGold - StartGold
        goldLabel:UpdateLabel("Current Gold: " .. currentGold)
        gainedLabel:UpdateLabel("Gained Gold: " .. GainedGold)
    end
end)
