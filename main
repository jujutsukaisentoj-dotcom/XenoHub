-- =========================================================
-- BUILD A BOAT - FULL TETİKLİ & YAVAŞ SAFE FARMER
-- =========================================================

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("BABFT - Full Tetikli v5", "DarkTheme")

-- DATA & SERVICES
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Data = LocalPlayer:WaitForChild("OtherData")
local Claim = workspace:WaitForChild("ClaimRiverResultsGold")
local StartGold = LocalPlayer.Data.Gold.Value
local GainedGold = 0
local Chests = 0
local StartTime = os.time()
local AutoFarmActive = false 

-- MOBILE UI BUTTON (AÇ/KAPAT)
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local ToggleBtn = Instance.new("TextButton", ScreenGui)
ToggleBtn.Size = UDim2.new(0, 80, 0, 35)
ToggleBtn.Position = UDim2.new(0, 10, 0, 300)
ToggleBtn.Text = "MENU"
ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
ToggleBtn.TextColor3 = Color3.new(1,1,1)
ToggleBtn.MouseButton1Click:Connect(function() Library:ToggleUI() end)

-- SEKMELER
local MainTab = Window:NewTab("Farming")
local StatusSection = MainTab:NewSection("Anlık Takip (Tetikli)")

-- SAYAÇLAR (UI ÜZERİNDE TETİKLENENLER)
local goldLabel = StatusSection:NewLabel("Current Gold: " .. StartGold)
local gainedLabel = StatusSection:NewLabel("Gained Gold: 0")
local chestLabel = StatusSection:NewLabel("Chest Collected: 0")
local timeLabel = StatusSection:NewLabel("Total Time Farming: 00:00:00")
local stageLabel = StatusSection:NewLabel("Şu Anki Bölüm: Bekliyor...")

-- BÖLÜM KONTROL FONKSİYONU
local function HasStage(Num)
    return Data[`Stage{Num}`].Value ~= "" and Data[`Stage{Num}`].Value
end

-- FULL YAVAŞ & TETİKLİ FARM DÖNGÜSÜ
local function StartFullTetikliFarm()
    while AutoFarmActive do
        local Char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local Root = Char:WaitForChild("HumanoidRootPart")
        local Stages = workspace.BoatStages.NormalStages
        
        -- 1'den 10'a Kadar Bölümleri Tetikleyerek Geç
        for i = 1, 10 do
            if not AutoFarmActive then break end
            
            stageLabel:UpdateLabel("Şu Anki Bölüm: " .. i .. " / 11")
            
            local Target = Stages[`CaveStage{i}`].DarknessPart
            Root.CFrame = Target.CFrame
            Root.Velocity = Vector3.zero
            
            -- Bölüm Ödülünü Tetikle
            task.spawn(function() Claim:FireServer() end)
            
            -- Yavaş İlerleme (Senin istediğin full yavaşlık)
            task.wait(4.5) 
            
            -- Bölümün onaylanmasını bekle
            repeat task.wait(0.5) until HasStage(i) or not AutoFarmActive
        end

        -- 11. BÖLÜM (GOLDEN CHEST - OYUNU BİTİRİŞ)
        if AutoFarmActive then
            stageLabel:UpdateLabel("Şu Anki Bölüm: 11 (FINAL CHEST)")
            local EndStage = Stages.TheEnd.GoldenChest
            
            -- Sandığa Git
            Root.CFrame = EndStage.Trigger.CFrame
            task.wait(2)
            
            -- Sandık Dokunmasını Tetikle (Bypass)
            EndStage.Trigger.CFrame = Root.CFrame
            task.wait(2)
            
            -- UI Sayaçlarını Tetikle
            Chests = Chests + 1
            chestLabel:UpdateLabel("Chest Collected: " .. Chests)
            
            -- Turu Bitir ve Dinlen
            Char:BreakJoints()
            stageLabel:UpdateLabel("Şu Anki Bölüm: Resetleniyor...")
            task.wait(8) 
        end
    end
end

-- KONTROL PANELİ
StatusSection:NewToggle("Auto Farm (Tetikli)", "Bölüm bölüm geçer, sayaçları günceller", function(state)
    AutoFarmActive = state
    if state then
        Library:Notify("Sistem", "Tetikli Farm Başladı!", "Default")
        task.spawn(StartFullTetikliFarm)
    else
        stageLabel:UpdateLabel("Şu Anki Bölüm: DURDURULDU")
        Library:Notify("Sistem", "Farm Kapatıldı.", "Default")
    end
end)

StatusSection:NewButton("Double Gold Button (X2)", "Gamepass Bypass Tetikle", function()
    local gp = Instance.new("BoolValue", LocalPlayer); gp.Name = "GoldPass"
    local vip = Instance.new("BoolValue", LocalPlayer); vip.Name = "VIP"
    Library:Notify("Bypass", "Double Gold Aktif (DEX: TRUE)", "Success")
end)

-- ANA VERİ GÜNCELLEME DÖNGÜSÜ (SÜREKLİ TETİKLİ)
task.spawn(function()
    while task.wait(1) do
        -- Zaman Sayacı
        local diff = os.time() - StartTime
        local h, m, s = math.floor(diff/3600), math.floor((diff%3600)/60), diff%60
        timeLabel:UpdateLabel("Total Time Farming: " .. string.format("%02d:%02d:%02d", h, m, s))
        
        -- Altın Takibi
        local cur = LocalPlayer.Data.Gold.Value
        goldLabel:UpdateLabel("Current Gold: " .. cur)
        gainedLabel:UpdateLabel("Gained Gold: " .. (cur - StartGold))
    end
end)
