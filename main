    Logo.Size = UDim2.new(0.8, 0, 0, 80)
    Logo.Position = UDim2.new(0.1, 0, 0.45, -40)
    Logo.BackgroundTransparency = 1
    Logo.TextColor3 = Color3.fromRGB(145, 90, 230)
