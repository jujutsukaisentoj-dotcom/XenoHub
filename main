    local frame = CoreGui:FindFirstChild("Orion")
    if frame then frame.Enabled = not frame.Enabled end
    MainFrame.Visible = not MainFrame.Visible -- Stat board'ı da senkronize et
end)

-- ================================
-- BYPASS & FARM SİSTEMİ
-- ================================
local function ApplyBypass()
    local mt = getrawmetatable(game)
    setreadonly(mt, false)
    local oldNamecall = mt.__namecall

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "Kick" or method == "kick" then return nil end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end
ApplyBypass()

local function ClearMap()
    pcall(function()
        local stages = Workspace.BoatStages.NormalStages
        for _, stage in pairs(stages:GetChildren()) do
            if stage:FindFirstChild("DarknessPart") then stage.DarknessPart:Destroy() end
        end
    end)
end

local function StartFarm()
    task.spawn(function()
        while farming do
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.CharacterAdded:Wait()
                task.wait(1)
                char = LocalPlayer.Character
            end

            local root = char.HumanoidRootPart
            ClearMap()
            
            local bv = Instance.new("BodyVelocity", root)
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)

            local endZone = Workspace.BoatStages.NormalStages.TheEnd.GoldenChest.Trigger
            local path = {
                CFrame.new(-55, 85, 1500),
                CFrame.new(-55, 85, 4500),
                CFrame.new(-55, 85, 7500),
                CFrame.new(-55, 85, 9450),
                endZone.CFrame
            }

            for _, targetCF in ipairs(path) do
                if not farming then break end
                local dist = (root.Position - targetCF.Position).Magnitude
                local tween = TweenService:Create(root, TweenInfo.new(dist / 350, Enum.EasingStyle.Linear), {CFrame = targetCF})
                tween:Play()
                tween.Completed:Wait()
            end

            if farming then
                root.CFrame = endZone.CFrame
                task.wait(2) -- Hazineye dokunma payı
                ChestsCollected = ChestsCollected + 1
                task.wait(8)
                bv:Destroy()
                char:BreakJoints()
                task.wait(4)
            end
        end
    end)
end

-- ================================
-- ARAYÜZ AYARLARI
-- ================================
local MainTab = Window:MakeTab({Name = "Farm", Icon = "rbxassetid://4483345998"})
local PlayerTab = Window:MakeTab({Name = "Karakter", Icon = "rbxassetid://4483345998"})

MainTab:AddToggle({
	Name = "Auto Gold Farm",
	Default = false,
	Callback = function(v) farming = v if v then StartFarm() end end    
})

PlayerTab:AddSlider({
	Name = "Hız",
	Min = 16, Max = 300, Default = 16,
	Callback = function(v) walkSpeed = v end    
})

PlayerTab:AddToggle({
	Name = "Noclip",
	Default = false,
	Callback = function(v) noclipActive = v end    
})

RunService.Stepped:Connect(function()
    if noclipActive and LocalPlayer.Character then
        for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = walkSpeed
    end
end)

OrionLib:Init()
