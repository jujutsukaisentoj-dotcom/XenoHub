-- =========================================================
-- BUILD A BOAT - GOD SPEED HYBRID FARMER (FASTEST)
-- =========================================================

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("BABFT - GOD SPEED V3", "Midnight")

-- SERVICES & DATA
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Data = LocalPlayer:WaitForChild("OtherData")
local Claim = workspace:WaitForChild("ClaimRiverResultsGold")
local StartGold = LocalPlayer.Data.Gold.Value
local GainedGold = 0
local Chests = 0
local StartTime = os.time()
local AutoFarmActive = true

-- MOBILE UI TOGGLE
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local ToggleBtn = Instance.new("TextButton", ScreenGui)
ToggleBtn.Size = UDim2.new(0, 80, 0, 35)
ToggleBtn.Position = UDim2.new(0, 5, 0, 180)
ToggleBtn.Text = "Menu"
ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 0, 50)
ToggleBtn.TextColor3 = Color3.new(1,1,1)
ToggleBtn.MouseButton1Click:Connect(function() Library:ToggleUI() end)

-- UI TABS
local MainTab = Window:NewTab("Main")
local StatsSection = MainTab:NewSection("Live Farm Stats")

-- LABELS (TETİKLİ)
local goldLabel = StatsSection:NewLabel("Current Gold: " .. StartGold)
local gainedLabel = StatsSection:NewLabel("Gained Gold: 0")
local chestLabel = StatsSection:NewLabel("Chest Collected: 0")
local timeLabel = StatsSection:NewLabel("Time: 00:00:00")

-- GAMEPASS BYPASS (ALL IN ONE)
StatsSection:NewButton("Triple Bypass & X2 Gold", "Gamepass + Dex + Anti-Cheat", function()
    local gp = Instance.new("BoolValue", LocalPlayer); gp.Name = "GoldPass"
    local vip = Instance.new("BoolValue", LocalPlayer); vip.Name = "VIP"
    local extra = Instance.new("BoolValue", LocalPlayer); extra.Name = "ExtraBoatSlot"
    Library:Notify("Bypass", "Tüm Yetkiler DEX: TRUE yapıldı.", "Success")
end)

-- GOD SPEED FARM FUNCTION
local function Farm()
    if not AutoFarmActive then return end
    
    local Char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local Root = Char:WaitForChild("HumanoidRootPart")
    local Stages = workspace.BoatStages.NormalStages
    
    -- STAGE BYPASS (GOD SPEED)
    for i = 1, 10 do
        if not AutoFarmActive then break end
        
        local Target = Stages[`CaveStage{i}`].DarknessPart
        Root.CFrame = Target.CFrame
        
        -- Hız için Velocity sıfırlama (Ban önleyici)
        Root.Velocity = Vector3.new(0,0,0)
        
        -- Agresif Claim
        task.spawn(function()
            Claim:FireServer()
        end)
        
        task.wait(0.15) -- Maksimum hız sınırı (0.1'in altı kickletebilir)
    end

    -- THE END: FULL CHEST CLUTCH
    if AutoFarmActive then
        local EndStage = Stages.TheEnd.GoldenChest
        Root.CFrame = EndStage.Trigger.CFrame
        
        -- Chest Dokunma Tetikleyici
        task.wait(0.2)
        EndStage.Trigger.CFrame = Root.CFrame 
        
        -- İstatistik Güncelleme
        Chests = Chests + 1
        chestLabel:UpdateLabel("Chest Collected: " .. Chests)
        
        task.wait(0.5)
        Char:BreakJoints() -- Hızlı reset
    end
end

-- AUTO-RESTART & TRACKER
LocalPlayer.CharacterAdded:Connect(function()
    if AutoFarmActive then
        task.wait(0.5) -- Doğar doğmaz başla
        Farm()
    end
end)

-- LIVE UPDATE THREAD
task.spawn(function()
    while task.wait(1) do
        -- Timer
        local diff = os.time() - StartTime
        timeLabel:UpdateLabel("Time: " .. string.format("%02d:%02d:%02d", math.floor(diff/3600), math.floor((diff%3600)/60), diff%60))
        
        -- Gold Update
        local cur = LocalPlayer.Data.Gold.Value
        goldLabel:UpdateLabel("Current Gold: " .. cur)
        gainedLabel:UpdateLabel("Gained Gold: " .. (cur - StartGold))
    end
end)

-- INITIAL START
Farm()
