local XenoSettings = {
    Speed = 16,
    Jump = 50,
    Noclip = false,
    Fly = false,
    RGBEnabled = true,
    RGBSpeed = 1,
    CarSpeed = 1,
    CarTurbo = false
}

local function SendNotif(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title;
            Text = text;
            Duration = 5;
        })
    end)
end

-- ============================================================================== --
-- 2. FULL GAMEPASS & PREMIUM BYPASS (PC/MOBIL FIXED)
-- ============================================================================== --

local function BypassAllGamepasses()
    pcall(function()
        -- Gerekli Modülleri Al
        local GpassUnlock = require(ReplicatedStorage.Modules.Client.UI.GamepassUnlockController)
        local GpassController = require(ReplicatedStorage.Modules.Client.PlayerData.GamepassController)
        local GpassData = require(ReplicatedStorage.Modules.Shared.PlayerData.Gamepasses)
        
        -- Fonksiyonel Bypass (Metotları Değiştirme)
        local bypassFunc = function() return true end
        
        -- GamepassController Hook
        GpassController.PlayerOwnsGamepass = bypassFunc
        GpassController.OwnsGamepass = bypassFunc
        GpassController.HasGamepass = bypassFunc
        
        -- UI Unlock Controller Hook
        GpassUnlock.OwnsGamepass = bypassFunc
        GpassUnlock.IsPremium = bypassFunc
        GpassUnlock.Show = function() return end -- Satın alma ekranını kapat
        
        -- Gamepasses.All Verilerini Zorla
        if GpassData and GpassData.All then
            for i, v in pairs(GpassData.All) do
                if typeof(v) == "table" then
                    v.__OWNED = true
                    v.Owned = true
                end
            end
        end

        SendNotif("XenoHub", "Tüm Gamepassler Full Aktif! (PC/Mobil) ✅")
    end)
end

-- ============================================================================== --
-- 3. SINIRSIZ REKLAM VE ADSTORE (ÇALIŞMAYAN REKLAM FİX)
-- ============================================================================== --

local function TriggerInfiniteAds()
    pcall(function()
        local Ads = require(ReplicatedStorage.Modules.Client.Ads.AdvertisementsController)
        local Panel = require(ReplicatedStorage.Modules.Client.UI.PanelController)
        
        -- Reklam Kontrollerini Bypass Et
        Ads.IsAdAvailable = function() return true end
        Ads.CanWatchVideoAd = function() return true end
        Ads.GetRemainingCooldown = function() return 0 end
        
        -- UI Zorlama (AdStore Panelini Aç ve Butonları Göster)
        local MainUI = PlayerGui:FindFirstChild("MainGUIHandler")
        if MainUI then
            local adStore = MainUI:FindFirstChild("AdStore", true)
            if adStore then
                adStore.Visible = true
                adStore.Active = true
                for _, btn in pairs(adStore:GetDescendants()) do
                    if btn:IsA("GuiButton") then
                        btn.Visible = true
                        btn.Active = true
                    end
                    if btn.Name:find("Waiting") or btn.Name:find("Timer") then
                        btn.Visible = false -- Bekleme yazılarını gizle
                    end
                end
            end
            
            -- AdStore Panelini Resmi Olarak Tetikle
            Panel.OpenPanelByContext("MainGUIHandler", "AdStore")
        end
        
        -- Reklam Ödülünü Hemen Al (Süre Beklemeden)
        Ads.RequestRewardedVideoAd("XenoHub_Reward", "rbxassetid://0", 0, "Refresh", "Success", false, false)

        SendNotif("XenoHub", "Reklamlar ve AdStore Çalışıyor! 📺")
    end)
end

-- ============================================================================== --
-- 4. RGB NAME & BIO SİSTEMİ
-- ============================================================================== --

RunService.RenderStepped:Connect(function()
    if XenoSettings.RGBEnabled then
        local hue = tick() * XenoSettings.RGBSpeed % 1
        local color = Color3.fromHSV(hue, 1, 1)
        local hex = color:ToHex()
        
        pcall(function()
            local remote = ReplicatedStorage:FindFirstChild("RE"):FindFirstChild("1Plr1Name1Chan1ge")
            if remote then
                remote:FireServer("UpdateName", lp.Name, hex)
                remote:FireServer("UpdateBio", "XenoHub | " .. lp.Name, hex)
            end
        end)
    end
end)

-- Noclip Logic
RunService.Stepped:Connect(function()
    if XenoSettings.Noclip and lp.Character then
        for _, part in pairs(lp.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
end)

