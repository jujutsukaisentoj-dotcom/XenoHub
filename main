-- İçerik Alanı
local Content = Instance.new("Frame", Main)
Content.Size = UDim2.new(1, -190, 1, -20)
Content.Position = UDim2.new(0, 190, 0, 10)
Content.BackgroundTransparency = 1

local tabs = {}
local function CreateTab(name)
    local btn = Instance.new("TextButton", Sidebar)
    btn.Size = UDim2.new(0.9, 0, 0, 42)
    btn.Position = UDim2.new(0.05, 0, 0, 80 + (#tabs * 48))
    btn.BackgroundColor3 = Color3.fromRGB(145, 90, 230)
    btn.BackgroundTransparency = 1
    btn.Text = "  " .. name
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local page = Instance.new("ScrollingFrame", Content)
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ScrollBarThickness = 2
    page.ScrollBarImageColor3 = Color3.fromRGB(145, 90, 230)
    local list = Instance.new("UIListLayout", page)
    list.Padding = UDim.new(0, 10)
    list.HorizontalAlignment = Enum.HorizontalAlignment.Center

    btn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do t.p.Visible = false t.b.BackgroundTransparency = 1 t.b.TextColor3 = Color3.fromRGB(200, 200, 200) end
        page.Visible = true
        btn.BackgroundTransparency = 0.8
        btn.TextColor3 = Color3.new(1, 1, 1)
    end)

    if #tabs == 0 then page.Visible = true btn.BackgroundTransparency = 0.8 end
    table.insert(tabs, {p = page, b = btn})
    return page
end

local function CreateCard(parent, title, desc, callback)
    local card = Instance.new("Frame", parent)
    card.Size = UDim2.new(0.95, 0, 0, 65)
    card.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)
    
    local t = Instance.new("TextLabel", card)
    t.Size = UDim2.new(0.7, 0, 0.4, 0)
    t.Position = UDim2.new(0.05, 0, 0.15, 0)
    t.Text = title
    t.TextColor3 = Color3.new(1, 1, 1)
    t.Font = Enum.Font.GothamBold
    t.TextSize = 14
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.BackgroundTransparency = 1

    local d = Instance.new("TextLabel", card)
    d.Size = UDim2.new(0.7, 0, 0.3, 0)
    d.Position = UDim2.new(0.05, 0, 0.55, 0)
    d.Text = desc
    d.TextColor3 = Color3.fromRGB(160, 160, 160)
    d.Font = Enum.Font.Gotham
    d.TextSize = 11
    d.TextXAlignment = Enum.TextXAlignment.Left
    d.BackgroundTransparency = 1

    local action = Instance.new("TextButton", card)
    action.Size = UDim2.new(0.22, 0, 0.6, 0)
    action.Position = UDim2.new(0.73, 0, 0.2, 0)
    action.BackgroundColor3 = Color3.fromRGB(145, 90, 230)
    action.Text = "AKTİF ET"
    action.TextColor3 = Color3.new(1, 1, 1)
    action.Font = Enum.Font.GothamBold
    action.TextSize = 11
    Instance.new("UICorner", action)
    
    action.MouseButton1Click:Connect(function()
        action.Text = "LÜTFEN BEKLEYİN..."
        task.wait(0.3)
        callback()
        action.Text = "TAMAMLANDI"
        task.delay(1, function() action.Text = "AKTİF ET" end)
    end)
end

