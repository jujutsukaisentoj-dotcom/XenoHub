-- ============================================================================== --
-- CORE ENGINE FUNCTIONS
-- ============================================================================== --

local function Notify(title, text)
    StarterGui:SetCore("SendNotification", {
        Title = title;
        Text = text;
        Duration = 5;
    })
end

local function FullGamepassBypass()
    local success, err = pcall(function()
        -- Gamepass Module Spoofing
        local GamepassModule = require(ReplicatedStorage.Modules.Client.UI.Gamepass.GamepassController)
        local UnlockController = require(ReplicatedStorage.Modules.Client.UI.GamepassUnlockController)
        local SharedPasses = require(ReplicatedStorage.Modules.Shared.PlayerData.Gamepasses)

        -- Force Ownership
        local mt = getrawmetatable(GamepassModule)
        if mt then
            setreadonly(mt, false)
            local old = mt.__index
            mt.__index = newcclosure(function(t, k)
                if k == "OwnsGamepass" or k == "HasPass" then return function() return true end end
                return old(t, k)
            end)
        end

        GamepassModule.OwnsGamepass = function() return true end
        UnlockController.OwnsGamepass = function() return true end

        -- Unlock All Data Entries
        if SharedPasses and SharedPasses.All then
            for _, data in pairs(SharedPasses.All) do
                if type(data) == "table" then
                    data.__GAMEPASS = true
                    data.Unlocked = true
                end
            end
        end
    end)
    
    if success then Notify("XenoHub V19", "Tüm kilitler ve Gamepassler başarıyla kırıldı!")
    else warn("Bypass Error: " .. tostring(err)) end
end

local function TeleportTo(pos)
    if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
        lp.Character.HumanoidRootPart.CFrame = pos
    end
end

