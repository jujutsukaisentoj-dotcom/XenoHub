-- ============================================================================== --
-- 4. DEX KONTROLLÜ FIRE & BYPASS SİSTEMİ
-- ============================================================================== --

local function ExecuteFireSystem(state)
    -- Dex Logic: Internal UI manipulation
    pcall(function()
        local MainGUI = PlayerGui:FindFirstChild("MainGUIHandler")
        if MainGUI and MainGUI:FindFirstChild("ModalFireAsk") then
            MainGUI.ModalFireAsk.Visible = state
        end
    end)

    -- Remote Event Tetikleyicileri (Universal Bypass)
    pcall(function()
        local Trigger = ReplicatedStorage:FindFirstChild("1Playe1rTrigge1rEven1t")
        local RE = ReplicatedStorage:FindFirstChild("RE") or ReplicatedStorage:FindFirstChild("Remotes")
        
        -- Bypass 1: Trigger Event
        if Trigger then
            Trigger:FireServer("HouseSettings", "Fire", state)
        end
        
        -- Bypass 2: RE Control
        if RE and RE:FindFirstChild("RemoteEvent") then
            RE.RemoteEvent:FireServer("HouseSettings", "Fire", state)
        end

        -- Bypass 3: GameSettings Module Trigger
        local GameSettings = require(game:GetService("StarterGui"):WaitForChild("Player8Handler"):WaitForChild("Game8Settings"))
        if GameSettings and GameSettings.PlayersHouse then
            GameSettings.PlayersHouse:FireServer(state and "PlayerWantsFire" or "PlayerWantsStopFire")
        end
    end)

    SendNotif("XenoHub Bypass", state and "Yangın Sistemi Aktif! 🔥" or "Yangın Söndürüldü! 💧")
end

