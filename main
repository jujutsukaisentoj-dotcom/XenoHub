-- ============================================================================== --
-- 1. DURUM VE AYARLAR
-- ============================================================================== --

local XenoSettings = {
    AutoRob = false,
    Noclip = false,
    EspEnabled = false,
    Flying = false,
    FlySpeed = 50,
    Spectating = nil,
    ClickTP = false,
    ApiKey = "" -- Gemini API anahtarı boş bırakıldı, çalışma zamanında otomatik atanır.
}

local function SendNotif(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title;
            Text = text;
            Icon = "rbxassetid://6023426926";
            Duration = 3;
        })
    end)
end

-- ============================================================================== --
-- 2. YAPAY ZEKA SİSTEMİ (XenoAI)
-- ============================================================================== --

local function AskXenoAI(prompt, callback)
    task.spawn(function()
        local systemPrompt = "Sen XenoHub'ın yapay zeka asistanısın. Brookhaven oyununda oyunculara yardım ediyorsun. Scripting, exploit özellikleri ve oyun içi sırlar hakkında bilgilisin. Kısa ve öz cevaplar ver."
        local payload = {
            contents = {{ parts = {{ text = prompt }} }},
            systemInstruction = { parts = {{ text = systemPrompt }} }
        }
        
        local success, result
        local retries = 0
        local delays = {1, 2, 4}

        repeat
            success, result = pcall(function()
                return HttpService:PostAsync(
                    "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=" .. XenoSettings.ApiKey,
                    HttpService:JSONEncode(payload)
                )
            end)
            if not success then
                retries = retries + 1
                task.wait(delays[retries] or 5)
            end
        until success or retries >= 3

        if success then
            local data = HttpService:JSONDecode(result)
            local aiText = data.candidates[1].content.parts[1].text
            callback(aiText)
        else
            callback("Hata: AI şu an meşgul veya API bağlantısı sağlanamadı.")
        end
    end)
end

-- ============================================================================== --
-- 3. CORE FONKSİYONLAR
-- ============================================================================== --

local function InjectBypasses()
    pcall(function()
        local gpc = require(ReplicatedStorage.Modules.Client.UI.GamepassUnlockController)
        gpc.OwnsGamepass = function() return true end
        gpc.IsPremium = function() return true end
        
        -- Admin & Staff Bypass
        local MainPermPath = ReplicatedStorage:FindFirstChild("Permissions", true)
        if MainPermPath then
            local MainPermissions = require(MainPermPath)
            local funcs = {"hasAdminAccess", "hasContentCreatorAccess", "hasModeratorAccess", "hasStaffAccess"}
            for _, f in ipairs(funcs) do MainPermissions[f] = function() return true end end
        end
        SendNotif("XenoHub", "Tüm Premium ve Admin özellikleri açıldı!")
    end)
end

local function ServerHop()
    SendNotif("XenoHub", "Yeni sunucu aranıyor...")
    pcall(function()
        local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100")).data
        for _, s in pairs(servers) do
            if s.playing < s.maxPlayers and s.id ~= game.JobId then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id)
                break
            end
        end
    end)
end

-- ============================================================================== --
-- 4. UI TASARIMI (V16)
-- ============================================================================== --

if ParentFolder:FindFirstChild("XenoBrookhavenV16") then ParentFolder.XenoBrookhavenV16:Destroy() end
local XenoGui = Instance.new("ScreenGui", ParentFolder)
XenoGui.Name = "XenoBrookhavenV16"

local MainFrame = Instance.new("Frame", XenoGui)
MainFrame.Size = UDim2.new(0, 550, 0, 360)
MainFrame.Position = UDim2.new(0.5, -275, 0.5, -180)
MainFrame.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 10)
local Stroke = Instance.new("UIStroke", MainFrame)
Stroke.Color = Color3.fromRGB(145, 90, 230)
Stroke.Thickness = 2

-- Tab Sistemi
local SideBar = Instance.new("Frame", MainFrame)
SideBar.Size = UDim2.new(0, 150, 1, 0)
SideBar.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
Instance.new("UICorner", SideBar).CornerRadius = UDim.new(0, 10)

local TabHolder = Instance.new("Frame", MainFrame)
TabHolder.Size = UDim2.new(1, -160, 1, -10)
TabHolder.Position = UDim2.new(0, 160, 0, 5)
TabHolder.BackgroundTransparency = 1

local pages = {}
local function NewTab(name, icon)
    local tBtn = Instance.new("TextButton", SideBar)
    tBtn.Size = UDim2.new(0.9, 0, 0, 32)
    tBtn.Position = UDim2.new(0.05, 0, 0, 50 + (#pages * 36))
    tBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    tBtn.BackgroundTransparency = 1
    tBtn.Text = "  " .. name
    tBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    tBtn.Font = Enum.Font.GothamBold
    tBtn.TextSize = 12
    tBtn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", tBtn).CornerRadius = UDim.new(0, 6)

    local page = Instance.new("ScrollingFrame", TabHolder)
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ScrollBarThickness = 2
    Instance.new("UIListLayout", page).Padding = UDim.new(0, 6)

    tBtn.MouseButton1Click:Connect(function()
        for _, p in pairs(pages) do p.p.Visible = false p.b.BackgroundTransparency = 1 end
        page.Visible = true
        tBtn.BackgroundTransparency = 0.8
    end)
    
    if #pages == 0 then page.Visible = true tBtn.BackgroundTransparency = 0.8 end
    table.insert(pages, {b = tBtn, p = page})
    return page
end

local function AddBtn(parent, text, cb, color)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(0.98, 0, 0, 35)
    b.BackgroundColor3 = color or Color3.fromRGB(25, 25, 30)
    b.Text = text
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamSemibold
    b.TextSize = 12
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.MouseButton1Click:Connect(cb)
end

