local Container = Instance.new("Frame", Main)
Container.Size = UDim2.new(1, -180, 1, -20)
Container.Position = UDim2.new(0, 180, 0, 10)
Container.BackgroundTransparency = 1

local pages = {}
local function AddTab(name, icon)
    local btn = Instance.new("TextButton", Side)
    btn.Size = UDim2.new(0.9, 0, 0, 40)
    btn.Position = UDim2.new(0.05, 0, 0, 70 + (#pages * 45))
    btn.BackgroundColor3 = Color3.fromRGB(145, 90, 230)
    btn.BackgroundTransparency = 1
    btn.Text = "  " .. name
    btn.TextColor3 = Color3.new(0.8, 0.8, 0.8)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local page = Instance.new("ScrollingFrame", Container)
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ScrollBarThickness = 0
    Instance.new("UIListLayout", page).Padding = UDim.new(0, 10)

    btn.MouseButton1Click:Connect(function()
        for _, p in pairs(pages) do p.p.Visible = false p.b.BackgroundTransparency = 1 end
        page.Visible = true
        btn.BackgroundTransparency = 0.8
    end)

    if #pages == 0 then page.Visible = true btn.BackgroundTransparency = 0.8 end
    table.insert(pages, {p = page, b = btn})
    return page
end

local function AddAction(parent, text, desc, callback)
    local f = Instance.new("Frame", parent)
    f.Size = UDim2.new(0.98, 0, 0, 55)
    f.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    Instance.new("UICorner", f)
    
    local t = Instance.new("TextLabel", f)
    t.Size = UDim2.new(0.7, 0, 0.5, 0)
    t.Position = UDim2.new(0.05, 0, 0.1, 0)
    t.Text = text
    t.TextColor3 = Color3.new(1,1,1)
    t.Font = Enum.Font.GothamBold
    t.TextSize = 14
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.BackgroundTransparency = 1

    local d = Instance.new("TextLabel", f)
    d.Size = UDim2.new(0.7, 0, 0.4, 0)
    d.Position = UDim2.new(0.05, 0, 0.5, 0)
    d.Text = desc
    d.TextColor3 = Color3.new(0.6,0.6,0.6)
    d.Font = Enum.Font.Gotham
    d.TextSize = 11
    d.TextXAlignment = Enum.TextXAlignment.Left
    d.BackgroundTransparency = 1

    local b = Instance.new("TextButton", f)
    b.Size = UDim2.new(0.25, 0, 0.6, 0)
    b.Position = UDim2.new(0.72, 0, 0.2, 0)
    b.BackgroundColor3 = Color3.fromRGB(145, 90, 230)
    b.Text = "UYGULA"
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    Instance.new("UICorner", b)
    b.MouseButton1Click:Connect(callback)
end

