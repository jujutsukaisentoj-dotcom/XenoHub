    {"UraniumRod", "Uranyum ☢️"},
    {"AgencyBook", "Ajans Kitabı 📘"}
}

for _, item in pairs(items_list) do
    AddButton(ItemTab, "🛠️ Al: " .. item[2], nil, function() SafeTriggerTool(item[1]) end)
end

