local XenoSettings = {
    AutoRob = false,
    PremiumEnabled = true,
    Speed = 16,
    Jump = 50,
    Noclip = false,
    RainbowBody = false,
    InfiniteJump = false,
    Invisible = false
}

local function SendNotif(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title;
            Text = text;
            Icon = "rbxassetid://6023426926";
            Duration = 4;
        })
    end)
end

-- ============================================================================== --
-- 2. ÖZEL BYPASS SİSTEMLERİ (Geri Getirilenler)
-- ============================================================================== --

local function TriggerFullADStore()
    pcall(function()
        local AdsController = require(ReplicatedStorage.Modules.Client.Ads.AdvertisementsController)
        local PanelController = require(ReplicatedStorage.Modules.Client.UI.PanelController)
        local AdJoinController = require(ReplicatedStorage.Modules.Client.Ads.AdvertisementJoinController)
        
        AdJoinController.CancelCheck()
        AdJoinController.CheckAd()
        PanelController.OpenPanelByContext("MainGUIHandler", "AdStore")
        
        AdsController.RequestRewardedVideoAd("XenoBypass_Reward", "rbxassetid://0", 0, "Item Refresh", "Item Refresh", false, false)
        SendNotif("XenoHub", "ADStore ve Reklamlar Full Aktif! ✅")
    end)
end

local function OpenOriginalFireModal()
    pcall(function()
        local Game8 = require(StarterGui.Player8Handler.Game8Settings)
        Game8.PlayersHouse:FireServer("PlayerWantsFire")
        SendNotif("XenoHub", "Yangın Remote Tetiklendi! 🔥")
    end)
end

-- ============================================================================== --
-- 3. GENEL FONKSİYONLAR & OYUNCU HİLELERİ
-- ============================================================================== --

-- Noclip Döngüsü
RunService.Stepped:Connect(function()
    if XenoSettings.Noclip and lp.Character then
        for _, v in pairs(lp.Character:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end
end)

-- Sonsuz Zıplama
UserInputService.JumpRequest:Connect(function()
    if XenoSettings.InfiniteJump and lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then
        lp.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
    end
end)

local function GetSafes()
    local safes = {}
    for _, v in pairs(Workspace:GetDescendants()) do
        if v.Name == "Safe" and v:IsA("Model") then table.insert(safes, v) end
    end
    return safes
end

-- ============================================================================== --
-- 4. CORE BYPASS & UI SETUP
-- ============================================================================== --

local function InjectBypasses()
    pcall(function()
        local gpc = require(ReplicatedStorage.Modules.Client.UI.GamepassUnlockController)
        gpc.OwnsGamepass = function() return true end
        gpc.IsPremium = function() return true end
        
        local MainPermPath = ReplicatedStorage:FindFirstChild("Permissions", true)
        if MainPermPath then
            local MainPermissions = require(MainPermPath)
            local funcs = {"hasAdminAccess", "hasContentCreatorAccess", "hasModeratorAccess", "hasStaffAccess"}
            for _, f in ipairs(funcs) do MainPermissions[f] = function() return true end end
        end
    end)
end

-- UI Tasarımı
if ParentFolder:FindFirstChild("XenoBrookhaven") then ParentFolder.XenoBrookhaven:Destroy() end
local XenoGui = Instance.new("ScreenGui", ParentFolder)
XenoGui.Name = "XenoBrookhaven"

local MainFrame = Instance.new("Frame", XenoGui)
MainFrame.Size = UDim2.new(0, 720, 0, 480)
MainFrame.Position = UDim2.new(0.5, -360, 0.5, -240)
MainFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 10)
Instance.new("UIStroke", MainFrame).Color = Color3.fromRGB(145, 90, 230)

local function Drag(f)
    local d, i, s, p
    f.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then d = true s = input.Position p = f.Position end end)
    f.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement then i = input end end)
    RunService.RenderStepped:Connect(function() if d and i then local dl = i.Position - s f.Position = UDim2.new(p.X.Scale, p.X.Offset + dl.X, p.Y.Scale, p.Y.Offset + dl.Y) end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then d = false end end)
end
Drag(MainFrame)

local SideBar = Instance.new("Frame", MainFrame)
SideBar.Size = UDim2.new(0, 180, 1, 0)
SideBar.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
Instance.new("UICorner", SideBar).CornerRadius = UDim.new(0, 10)

local TabHolder = Instance.new("Frame", MainFrame)
TabHolder.Size = UDim2.new(1, -200, 1, -20)
TabHolder.Position = UDim2.new(0, 190, 0, 10)
TabHolder.BackgroundTransparency = 1

local pages = {}
local function NewTab(name)
    local tBtn = Instance.new("TextButton", SideBar)
    tBtn.Size = UDim2.new(0.9, 0, 0, 35)
    tBtn.Position = UDim2.new(0.05, 0, 0, 50 + (#pages * 38))
    tBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    tBtn.BackgroundTransparency = 1
    tBtn.Text = "  " .. name
    tBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    tBtn.Font = Enum.Font.GothamBold
    tBtn.TextSize = 12
    tBtn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", tBtn).CornerRadius = UDim.new(0, 4)

    local page = Instance.new("ScrollingFrame", TabHolder)
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ScrollBarThickness = 2
    Instance.new("UIListLayout", page).Padding = UDim.new(0, 6)

    tBtn.MouseButton1Click:Connect(function()
        for _, p in pairs(pages) do p.p.Visible = false p.b.BackgroundTransparency = 1 p.b.TextColor3 = Color3.fromRGB(200, 200, 200) end
        page.Visible = true
        tBtn.BackgroundTransparency = 0.8
        tBtn.TextColor3 = Color3.fromRGB(145, 90, 230)
    end)

    if #pages == 0 then page.Visible = true tBtn.BackgroundTransparency = 0.8 tBtn.TextColor3 = Color3.fromRGB(145, 90, 230) end
    table.insert(pages, {b = tBtn, p = page})
    return page
end

local function AddBtn(parent, text, cb, color)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(0.97, 0, 0, 38)
    b.BackgroundColor3 = color or Color3.fromRGB(22, 22, 28)
    b.Text = text
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
    b.MouseButton1Click:Connect(cb)
end

