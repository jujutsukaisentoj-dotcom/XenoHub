local function SendNotif(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title;
            Text = text;
            Duration = 5;
        })
    end)
end

-- ============================================================================== --
-- 2. FULL ADSTORE & VIDEO AD BYPASS (KONSTANT DECOMPILED LOGIC)
-- ============================================================================== --

local function TriggerFullADStore()
    pcall(function()
        -- Decompiled kodlardaki ana modüllere erişim
        local AdsController = require(ReplicatedStorage.Modules.Client.Ads.AdvertisementsController)
        local PanelController = require(ReplicatedStorage.Modules.Client.UI.PanelController)
        local AdJoinController = require(ReplicatedStorage.Modules.Client.Ads.AdvertisementJoinController)
        
        local MainGUI = PlayerGui:FindFirstChild("MainGUIHandler")
        if not MainGUI then return end

        -- 1. ADSTORE MENÜSÜNÜ BUL VE DEX MANTIGIYLA AÇ
        local adStore = MainGUI:FindFirstChild("AdStore", true)
        if adStore then
            adStore.Visible = true
            adStore.Active = true
            -- Tüm alt butonları (VideoAdAvailable, UnlockButton vb.) aktif et
            for _, v in pairs(adStore:GetDescendants()) do
                if v:IsA("GuiButton") or v:IsA("CanvasGroup") then
                    v.Visible = true
                end
            end
        end

        -- 2. ADS BUTONUNU (GİRİŞ NOKTASI) ZORLA GÖRÜNÜR YAP
        local shopButtons = MainGUI:FindFirstChild("ShopButtons", true)
        if shopButtons then
            local adsBtn = shopButtons:FindFirstChild("Ads", true) or shopButtons:FindFirstChild("AdsButton", true)
            if adsBtn then
                adsBtn.Visible = true
                adsBtn.Active = true
            end
        end

        -- 3. REKLAM TETİKLEME VE BYPASS (PC/MOBIL)
        -- Decompiled koddaki 'CheckAd' mantığını simüle ediyoruz
        AdJoinController.CancelCheck()
        AdJoinController.CheckAd()

        -- Orijinal PanelController üzerinden menüyü resmi olarak aç (Context tetikleme)
        PanelController.OpenPanelByContext("MainGUIHandler", "AdStore")

        -- Reklam Hazır mı Kontrolü Bypass
        AdsController.RequestRewardedVideoAd(
            "XenoBypass_PremiumItem", 
            "rbxassetid://0", 
            0, 
            "Item Refresh", 
            "Item Refresh", 
            false, 
            false
        )

        SendNotif("XenoHub", "ADStore ve Reklamlar Full Aktif Edildi! ✅")
    end)
end

-- ============================================================================== --
-- 3. DIGER ORIJINAL GUI TETİKLEYİCİLER
-- ============================================================================== --

local function OpenOriginalFireModal()
    pcall(function()
        local originalModal = nil
        for _, v in pairs(PlayerGui:GetDescendants()) do
            if v.Name == "ModalFireAsk" and (v:IsA("Frame") or v:IsA("ImageLabel")) then
                originalModal = v
                break
            end
        end

        if originalModal then
            originalModal.Visible = true
            originalModal.Active = true
            
            for _, btn in pairs(originalModal:GetDescendants()) do
                if btn:IsA("GuiButton") then
                    if btn.Name:lower():find("yes") or btn.BackgroundColor3 == Color3.fromRGB(34, 139, 34) then
                        btn.MouseButton1Click:Connect(function()
                            local Game8 = require(StarterGui.Player8Handler.Game8Settings)
                            Game8.PlayersHouse:FireServer("PlayerWantsFire")
                            SendNotif("XenoHub", "Orijinal Yangın Tetiklendi! 🔥")
                        end)
                    end
                end
            end
        else
            local Game8 = require(StarterGui.Player8Handler.Game8Settings)
            Game8.PlayersHouse:FireServer("PlayerWantsFire")
            SendNotif("XenoHub", "Yangın Remote Tetiklendi.")
        end
    end)
end

