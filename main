--[[
	ULTIMATE BUILD A BOAT FOR TREASURE - FULL BYPASS & FARM (V3.5)
	- Sol Alt Köşe Menü Tetikleyici (Toggle Button)
	- Gelişmiş Meta-Table Bypass
	- Hız, Zıplama ve Otomatik Farm
]]

local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()
local Window = OrionLib:MakeWindow({Name = "BaBft Ultimate - Full Bypass", HidePremium = false, SaveConfig = true, ConfigFolder = "BaBftUltimate"})

-- ================================
-- Servisler ve Değişkenler
-- ================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local farming = false
local autoBuyType = "None"
local walkSpeed = 16
local jumpPower = 50

-- ================================
-- SOL ALT MENÜ BUTONU (GUI)
-- ================================
local ScreenGui = Instance.new("ScreenGui")
local OpenBtn = Instance.new("TextButton")
local UICorner = Instance.new("UICorner")

ScreenGui.Name = "MenuTrigger"
ScreenGui.Parent = CoreGui
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

OpenBtn.Name = "OpenBtn"
OpenBtn.Parent = ScreenGui
OpenBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
OpenBtn.BorderSizePixel = 0
OpenBtn.Position = UDim2.new(0, 10, 1, -60) -- Sol alt köşe
OpenBtn.Size = UDim2.new(0, 50, 0, 50)
OpenBtn.Font = Enum.Font.SourceSansBold
OpenBtn.Text = "MENU"
OpenBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
OpenBtn.TextSize = 14.000

UICorner.CornerRadius = UDim.new(0, 10)
UICorner.Parent = OpenBtn

OpenBtn.MouseButton1Click:Connect(function()
    -- Orion menüsünü aç/kapat (Tetikleme)
    local frame = CoreGui:FindFirstChild("Orion")
    if frame then
        frame.Enabled = not frame.Enabled
    end
end)

-- ================================
-- FULL BYPASS MANTIĞI
-- ================================
local function ApplyBypass()
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        
        if method == "Kick" or method == "kick" then
            OrionLib:MakeNotification({Name = "Bypass", Content = "Atılma engellendi!", Time = 3})
            return nil
        end
        
        if not checkcaller() and method == "FireServer" and (tostring(self) == "RemoteEvent" or tostring(self) == "Report") then
            return nil
        end

        return oldNamecall(self, ...)
    end)

    setreadonly(mt, true)
end

ApplyBypass()

-- ================================
-- Yardımcı Fonksiyonlar
-- ================================
local function ClearMap()
    pcall(function()
        local stages = Workspace:WaitForChild("BoatStages"):WaitForChild("NormalStages")
        for _, stage in pairs(stages:GetChildren()) do
            if stage:FindFirstChild("DarknessPart") then
                stage.DarknessPart:Destroy()
            end
        end
    end)
end

local function GetFullNoclip()
    local char = LocalPlayer.Character
    if char then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end

-- ================================
-- Farm Mantığı
-- ================================
local function StartFarm()
    task.spawn(function()
        while farming do
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.CharacterAdded:Wait()
                task.wait(1)
                char = LocalPlayer.Character
            end

            local root = char:WaitForChild("HumanoidRootPart")
            ClearMap()
            
            local bv = root:FindFirstChild("FlyVelocity") or Instance.new("BodyVelocity")
            bv.Name = "FlyVelocity"
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Parent = root

            local noclipLoop = RunService.Stepped:Connect(GetFullNoclip)
            local endZone = Workspace.BoatStages.NormalStages.TheEnd.GoldenChest.Trigger
            
            local path = {
                CFrame.new(-55, 70, 1500),
                CFrame.new(-55, 70, 3000),
                CFrame.new(-55, 70, 6000),
                CFrame.new(-55, 70, 9450),
                endZone.CFrame
            }

            for _, targetCF in ipairs(path) do
                if not farming then break end
                local dist = (root.Position - targetCF.Position).Magnitude
                local tweenInfo = TweenInfo.new(dist / 350, Enum.EasingStyle.Linear)
                local tween = TweenService:Create(root, tweenInfo, {CFrame = targetCF})
                tween:Play()
                tween.Completed:Wait()
            end

            if farming then
                root.CFrame = endZone.CFrame
                task.wait(12)
                noclipLoop:Disconnect()
                char:BreakJoints()
                task.wait(5)
            end
        end
    end)
end

-- ================================
-- Arayüz Yapılandırması
-- ================================
local MainTab = Window:MakeTab({Name = "Otomatik Farm", Icon = "rbxassetid://4483345998"})
local PlayerTab = Window:MakeTab({Name = "Oyuncu", Icon = "rbxassetid://4483345998"})
local ShopTab = Window:MakeTab({Name = "Market", Icon = "rbxassetid://4483345998"})

MainTab:AddToggle({
	Name = "Ultra Auto Farm",
	Default = false,
	Callback = function(Value)
		farming = Value
		if farming then StartFarm() end
	end    
})

PlayerTab:AddSlider({
	Name = "Hız",
	Min = 16,
	Max = 300,
	Default = 16,
	Callback = function(v) walkSpeed = v end    
})

PlayerTab:AddSlider({
	Name = "Zıplama",
	Min = 50,
	Max = 500,
	Default = 50,
	Callback = function(v) jumpPower = v end    
})

RunService.RenderStepped:Connect(function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = walkSpeed
        LocalPlayer.Character.Humanoid.JumpPower = jumpPower
    end
end)

ShopTab:AddDropdown({
	Name = "Otomatik Sandık",
	Default = "None",
	Options = {"None", "Common Chest", "Uncommon Chest", "Rare Chest", "Epic Chest", "Legendary Chest"},
	Callback = function(v) autoBuyType = v end    
})

task.spawn(function()
    while true do
        if autoBuyType ~= "None" then
            workspace.ItemBoughtFromShop:FireServer(autoBuyType, 1)
        end
        task.wait(2)
    end
end)

-- Anti-AFK
local vu = game:GetService("VirtualUser")
LocalPlayer.Idled:Connect(function()
    vu:Button2Down(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
    task.wait(1)
    vu:Button2Up(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
end)

OrionLib:Init()
