local XenoSettings = {
    AutoRob = false,
    Noclip = false,
    InfiniteJump = false,
    EspEnabled = false,
    SafeEsp = false,
    SpinBot = false,
    Flying = false,
    FlySpeed = 50,
    CarSpeed = 50,
    ClickTP = false,
    Spectating = nil
}

local function SendNotif(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title;
            Text = text;
            Icon = "rbxassetid://6023426926";
            Duration = 3;
        })
    end)
end

-- Anti-AFK
lp.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

-- Click TP (Ctrl + Click)
Mouse.Button1Down:Connect(function()
    if XenoSettings.ClickTP and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        if Mouse.Target then
            lp.Character:MoveTo(Mouse.Hit.Position)
        end
    end
end)

