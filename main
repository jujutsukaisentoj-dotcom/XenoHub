        workspace.CurrentCamera.CameraSubject = target.Character.Humanoid
        viewingPlayer = target
        SendNotif("XenoHub", "İzlenen Oyuncu: " .. target.DisplayName)
    end
end, Color3.fromRGB(255, 255, 255))

