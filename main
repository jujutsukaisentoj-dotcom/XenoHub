--[[ 
    XENOHUB ULTIMATE - BROOKHAVEN MEGA FULL SCRIPT (FIRE EDITION)
    Geliştirici: XenoHub Team & EgeKazak_Real1
    Özellikler: Full ADStore, CMDR Bypass, Premium Unlock, Fire Trigger, Advanced Player
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local StarterGui = game:GetService("StarterGui")

local lp = Players.LocalPlayer
local ParentFolder = (gethui and gethui()) or CoreGui

-- ============================================================================== --
-- 1. SİSTEM AYARLARI
-- ============================================================================== --

local XenoSettings = {
    PremiumEnabled = false,
    Noclip = false,
    Spinning = false,
    SpinSpeed = 50,
    InfJump = false
}

local function SendNotif(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title;
            Text = text;
            Duration = 5;
        })
    end)
end

-- ============================================================================== --
-- 2. YANGIN SİSTEMİ (FIRE TRIGGER)
-- ============================================================================== --

local function OpenOriginalFireModal()
    pcall(function()
        -- 1. Orijinal GUI üzerinden tetiklemeye çalış (ModalFireAsk kontrolü)
        local found = false
        for _, v in pairs(lp.PlayerGui:GetDescendants()) do
            if v.Name == "ModalFireAsk" or v.Name == "FireAsk" then
                if v:IsA("Frame") or v:IsA("ImageLabel") or v:IsA("CanvasGroup") then
                    v.Visible = true
                    found = true
                end
            end
        end

        if found then
            SendNotif("XenoHub", "Orijinal Yangın Paneli Açıldı! 🔥")
        else
            -- 2. Eğer GUI bulunamazsa Remote üzerinden ev yangınını tetikle
            local Player8 = StarterGui:FindFirstChild("Player8Handler")
            if Player8 then
                local Game8 = require(Player8:FindFirstChild("Game8Settings"))
                if Game8 and Game8.PlayersHouse then
                    Game8.PlayersHouse:FireServer("PlayerWantsFire")
                    SendNotif("XenoHub", "Yangın Remote Üzerinden Başlatıldı! 🔥")
                end
            else
                -- Alternatif Remote yolu
                ReplicatedStorage.RE["1House1Even1t"]:FireServer("PlayerWantsFire")
                SendNotif("XenoHub", "Yangın Komutu Gönderildi! 🔥")
            end
        end
    end)
end

-- ============================================================================== --
-- 3. REKLAM & ADSTORE SİSTEMİ
-- ============================================================================== --

local function TriggerFullADStore()
    pcall(function()
        local AdsController = require(ReplicatedStorage.Modules.Client.Ads.AdvertisementsController)
        local PanelController = require(ReplicatedStorage.Modules.Client.UI.PanelController)
        
        PanelController.OpenPanelByContext("MainGUIHandler", "AdStore")
        AdsController.RequestRewardedVideoAd("XenoBypass", "rbxassetid://0", 0, "Item", "Item", false, false)
        SendNotif("XenoHub", "ADStore Aktif Edildi!")
    end)
end

-- ============================================================================== --
-- 4. UI İSKELETİ
-- ============================================================================== --

if ParentFolder:FindFirstChild("XenoBrookhaven") then ParentFolder.XenoBrookhaven:Destroy() end

local XenoGui = Instance.new("ScreenGui")
XenoGui.Name = "XenoBrookhaven"
XenoGui.Parent = ParentFolder
XenoGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 720, 0, 500)
MainFrame.Position = UDim2.new(0.5, -360, 0.5, -250)
MainFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
MainFrame.Parent = XenoGui
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 15)
Instance.new("UIStroke", MainFrame).Color = Color3.fromRGB(145, 90, 230)

-- Draggable
local dragging, dragInput, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true dragStart = input.Position startPos = MainFrame.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
    end
end)
MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)
RunService.RenderStepped:Connect(function()
    if dragging and dragInput then
        local delta = dragInput.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Sidebar
local SideBar = Instance.new("Frame")
SideBar.Size = UDim2.new(0, 200, 1, 0)
SideBar.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
SideBar.Parent = MainFrame
Instance.new("UICorner", SideBar).CornerRadius = UDim.new(0, 15)

local TabHolder = Instance.new("Frame")
TabHolder.Size = UDim2.new(1, -220, 1, -20)
TabHolder.Position = UDim2.new(0, 210, 0, 10)
TabHolder.BackgroundTransparency = 1
TabHolder.Parent = MainFrame

local pages = {}
local function NewTab(name)
    local tBtn = Instance.new("TextButton")
    tBtn.Size = UDim2.new(0.9, 0, 0, 45)
    tBtn.Position = UDim2.new(0.05, 0, 0, 80 + (#pages * 50))
    tBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    tBtn.BackgroundTransparency = 1
    tBtn.Text = "  " .. name
    tBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    tBtn.Font = Enum.Font.GothamBold
    tBtn.TextSize = 14
    tBtn.TextXAlignment = Enum.TextXAlignment.Left
    tBtn.Parent = SideBar
    Instance.new("UICorner", tBtn).CornerRadius = UDim.new(0, 8)

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ScrollBarThickness = 2
    page.Parent = TabHolder
    Instance.new("UIListLayout", page).Padding = UDim.new(0, 10)

    tBtn.MouseButton1Click:Connect(function()
        for _, p in pairs(pages) do p.p.Visible = false p.b.BackgroundTransparency = 1 p.b.TextColor3 = Color3.fromRGB(200, 200, 200) end
        page.Visible = true
        tBtn.BackgroundTransparency = 0.8
        tBtn.TextColor3 = Color3.fromRGB(145, 90, 230)
    end)

    if #pages == 0 then page.Visible = true tBtn.BackgroundTransparency = 0.8 tBtn.TextColor3 = Color3.fromRGB(145, 90, 230) end
    table.insert(pages, {b = tBtn, p = page})
    return page
end

local function AddBtn(parent, text, cb, color)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0.95, 0, 0, 48)
    b.BackgroundColor3 = color or Color3.fromRGB(25, 25, 30)
    b.Text = text
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 14
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    b.MouseButton1Click:Connect(cb)
    return b
end

-- ============================================================================== --
-- 5. SAYFALAR VE BUTONLAR
-- ============================================================================== --

local Home = NewTab("🏠 Ana Sayfa")
local PlayerTab = NewTab("👤 Oyuncu")
local WorldTab = NewTab("🌍 Dünya & Yangın")
local Items = NewTab("🎒 Eşyalar")

-- [HOME]
AddBtn(Home, "⚡ CMDR FULL BYPASS (F2)", function()
    pcall(function()
        require(ReplicatedStorage.Modules.Shared.Cmdr.CmdrPermissions).hasCmdrAccess = function() return true end
        require(ReplicatedStorage.Modules.Shared.Permissions).hasAdminAccess = function() return true end
        local Cmdr = require(ReplicatedStorage:WaitForChild("CmdrClient"))
        Cmdr:SetActivationKeys({Enum.KeyCode.F2})
        Cmdr:Toggle()
    end)
end, Color3.fromRGB(145, 90, 230))

AddBtn(Home, "📺 FULL ADSTORE TETIKLE", TriggerFullADStore, Color3.fromRGB(0, 162, 255))

-- [PLAYER]
AddBtn(PlayerTab, "🚀 Hız Arttır (100)", function() if lp.Character and lp.Character:FindFirstChild("Humanoid") then lp.Character.Humanoid.WalkSpeed = 100 end end)
AddBtn(PlayerTab, "🦘 Zıplama Arttır (150)", function() if lp.Character and lp.Character:FindFirstChild("Humanoid") then lp.Character.Humanoid.JumpPower = 150 end end)

local noclipBtn = AddBtn(PlayerTab, "🚫 Noclip: KAPALI", function() XenoSettings.Noclip = not XenoSettings.Noclip end)
local jumpBtn = AddBtn(PlayerTab, "🦅 Sonsuz Zıplama: KAPALI", function() XenoSettings.InfJump = not XenoSettings.InfJump end)
local spinBtn = AddBtn(PlayerTab, "🔄 Dönme: KAPALI", function() XenoSettings.Spinning = not XenoSettings.Spinning end)

-- [WORLD & FIRE]
AddBtn(WorldTab, "🔥 YANGIN PANELİNİ AÇ (FIRE)", function() OpenOriginalFireModal() end, Color3.fromRGB(255, 60, 0))
AddBtn(WorldTab, "☀️ Saati Gündüz Yap", function() Lighting.TimeOfDay = "12:00:00" end)
AddBtn(WorldTab, "🌑 Saati Gece Yap", function() Lighting.TimeOfDay = "00:00:00" end)

-- [ITEMS]
local items_list = {{"MoneyGun", "Money Gun 💸"}, {"Glider", "Glider 🪂"}, {"Scythe", "Scythe ☠️"}}
for _, item in pairs(items_list) do
    AddBtn(Items, "🛠️ Get: " .. item[2], function() 
        pcall(function() ReplicatedStorage.RE["1Playe1rTrigge1rEven1t"]:FireServer("AcceptedToolToServer", item[1], lp) end)
    end)
end

-- ============================================================================== --
-- 6. DÖNGÜLER (LOOP)
-- ============================================================================== --

RunService.Stepped:Connect(function()
    noclipBtn.Text = "🚫 Noclip: " .. (XenoSettings.Noclip and "AÇIK" or "KAPALI")
    jumpBtn.Text = "🦅 Sonsuz Zıplama: " .. (XenoSettings.InfJump and "AÇIK" or "KAPALI")
    spinBtn.Text = "🔄 Dönme: " .. (XenoSettings.Spinning and "AÇIK" or "KAPALI")

    if XenoSettings.Noclip and lp.Character then
        for _, v in pairs(lp.Character:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide = false end end
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if XenoSettings.Spinning and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
        lp.Character.HumanoidRootPart.CFrame *= CFrame.Angles(0, math.rad(XenoSettings.SpinSpeed), 0)
    end
end)

UserInputService.JumpRequest:Connect(function()
    if XenoSettings.InfJump and lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then
        lp.Character:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- Toggle Button
local TButton = Instance.new("TextButton")
TButton.Size = UDim2.new(0, 60, 0, 60)
TButton.Position = UDim2.new(0, 30, 0.5, -30)
TButton.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
TButton.Text = "X"
TButton.TextColor3 = Color3.fromRGB(145, 90, 230)
TButton.Font = Enum.Font.GothamBlack
TButton.TextSize = 25
TButton.Parent = XenoGui
Instance.new("UICorner", TButton).CornerRadius = UDim.new(1, 0)
Instance.new("UIStroke", TButton).Color = Color3.fromRGB(145, 90, 230)

TButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
    TButton.Text = MainFrame.Visible and "X" or "O"
end)

SendNotif("XenoHub ULTIMATE", "Yangın Sistemi & Tüm Özellikler Güncellendi! 🔥")
