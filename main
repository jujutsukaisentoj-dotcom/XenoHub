-- =========================================================
-- rqccc AUTO-LOADER + FULL DEX TRUE (NO BUTTON EDITION)
-- =========================================================

-- Services
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Data = LocalPlayer:WaitForChild("OtherData")
local Claim = workspace:WaitForChild("ClaimRiverResultsGold")
local Stages = workspace.BoatStages.NormalStages
local Chest = Stages.TheEnd.GoldenChest.Trigger

-- [1] DEX TRUE / GAMEPASS BYPASS (Hemen Çalışır)
-- Bu kısım sana Double Gold ve VIP özelliklerini script açıldığı an verir.
local function ApplyDexTrue()
    local passes = {"GoldPass", "VIP", "Member", "DoubleGold", "DoubleMoney", "ExtraBoatSlot"}
    for _, name in pairs(passes) do
        if not LocalPlayer:FindFirstChild(name) then
            local val = Instance.new("BoolValue", LocalPlayer)
            val.Name = name
            val.Value = true
        end
    end
    -- Oyun içi bildirim (Opsiyonel, temizlik için sadece print bırakabilirsin)
    print("Dex: True Aktif! Double Gold ve Tüm Özelliklere Sahipsin.")
end

-- [2] rqccc'S FUNCTIONS
local function HasStage(Num)
	return Data[`Stage{Num}`].Value ~= "" and Data[`Stage{Num}`].Value
end

local function ClaimStage(Num)
	task.spawn(function()
		local Value = Data[`Stage{Num}`]
		if not Value then
			Value:GetPropertyChangedSignal("Value"):Wait()
		end
		Claim:FireServer()
	end)
end

-- [3] MAIN AUTOMATIC FARM
local function Farm()
    -- Her tur başında Dex True kontrolü (Garantiye almak için)
    ApplyDexTrue()

	local Char = LocalPlayer.Character
	if not Char then return end

	local Root = Char:WaitForChild("HumanoidRootPart")
	if not Root then return end

	local NewChar = false
	task.spawn(function()
		LocalPlayer.CharacterAdded:Once(function()
			NewChar = true
		end)
	end)

	for _ = 1, 10 do
		local TargetPart = Stages[`CaveStage{_}`].DarknessPart
		local Teleporting = true

		task.spawn(function()
			while Teleporting do
				Root.CFrame = TargetPart.CFrame
				for _, BodyPart in Char:GetChildren() do
					if BodyPart:IsA("BasePart") then
						BodyPart.Velocity = Vector3.zero
						BodyPart.RotVelocity = Vector3.zero
					end
				end
				task.wait()
			end
		end)

		-- rqccc Orijinal Chest Mantığı (Stage 3)
		if _ == 3 then
			task.spawn(function()
				Chest.CFrame = Root.CFrame
				task.wait()
				Chest.CFrame = CFrame.new(0, 9e9, 0)
				task.wait(0.2)
				ClaimStage(_)
			end)
		elseif _ ~= 10 then
			ClaimStage(_)
		end

		if _ == 10 then
            -- 10. Bölümde Reset Atar
			Char:BreakJoints()
			task.spawn(function()
				task.wait(1)
				Claim:FireServer()
			end)
		else
            -- Stage onayı gelene kadar bekler (Bypass)
			repeat task.wait(0.1) until HasStage(_) or NewChar
		end

		Teleporting = false
	end
end

-- [4] SİSTEMİ BAŞLAT
-- Scripti inject ettiğin an çalışır
ApplyDexTrue()
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(2) -- Karakterin tam doğmasını bekle
    Farm()
end)

-- İlk çalıştırma
Farm()
