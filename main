local tStroke = Instance.new("UIStroke")
tStroke.Color = Color3.fromRGB(145, 90, 230)
tStroke.Thickness = 2
tStroke.Parent = Toggle
MakeDraggable(Toggle)
Toggle.MouseButton1Click:Connect(function() MainFrame.Visible = not MainFrame.Visible Toggle.Text = MainFrame.Visible and "X" or "O" end)

