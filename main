-- ======= YARDIMCI FONKSIYONLAR =======
local function safeRequire(module)
    if typeof(module) ~= "Instance" then return nil end
    local ok, res = pcall(function() return require(module) end)
    if ok then return res end
    warn("safeRequire failed for:", module:GetFullName())
    return nil
end

local function safeFind(parent, name)
    if not parent then return nil end
    local suc, res = pcall(function() return parent:FindFirstChild(name, true) end)
    if not suc then return nil end
    return res
end

local function SendNotif(title, text, duration)
    duration = duration or 4
    pcall(function()
        StarterGui:SetCore("SendNotification", {Title = title; Text = text; Duration = duration})
    end)
end

local function waitForDescendant(parent, name, timeout)
    timeout = timeout or 5
    local node = parent:FindFirstChild(name, true)
    if node then return node end
    local start = tick()
    while tick() - start < timeout do
        node = parent:FindFirstChild(name, true)
        if node then return node end
        task.wait(0.1)
    end
    return nil
end

local function safeFire(remote, ...)
    if not remote then return false end
    local ok, _ = pcall(function() remote:FireServer(...) end)
    return ok
end

local function safeInvoke(remote, ...)
    if not remote then return nil end
    local ok, res = pcall(function() return remote:InvokeServer(...) end)
    if ok then return res end
    return nil
end

-- ======= UTIL: Wait for PlayerGui hazır olsun =======
local PlayerGui = lp:WaitForChild("PlayerGui")

-- ======= ADSTORE / REKLAM TETIKLEME (Geliştirilmiş, güvenli) =======
local function TriggerFullADStore()
    pcall(function()
        local adsCtrl = nil
        local panelCtrl = nil
        local adJoinCtrl = nil

        -- Olası modül yollarını kontrol et
        local modRoot = ReplicatedStorage:FindFirstChild("Modules") or ReplicatedStorage
        if modRoot then
            adsCtrl = safeRequire(safeFind(modRoot, "AdvertisementsController") or modRoot:FindFirstChild("AdvertisementsController", true))
            panelCtrl = safeRequire(safeFind(modRoot, "PanelController") or modRoot:FindFirstChild("PanelController", true))
            adJoinCtrl = safeRequire(safeFind(modRoot, "AdvertisementJoinController") or modRoot:FindFirstChild("AdvertisementJoinController", true))
        end

        -- UI elemanlarını zorla görünür yap (varsa)
        local MainGUI = PlayerGui:FindFirstChild("MainGUIHandler") or PlayerGui:FindFirstChildWhichIsA("ScreenGui")
        if MainGUI then
            local adStore = MainGUI:FindFirstChild("AdStore", true)
            if adStore and adStore:IsA("Frame") then
                adStore.Visible = true
                adStore.Active = true
                for _, v in pairs(adStore:GetDescendants()) do
                    if v:IsA("GuiButton") or v:IsA("ImageButton") or v:IsA("TextButton") then
                        v.Visible = true
                    end
                end
            end

            local shopButtons = MainGUI:FindFirstChild("ShopButtons", true)
            if shopButtons then
                local adsBtn = shopButtons:FindFirstChild("Ads", true) or shopButtons:FindFirstChild("AdsButton", true)
                if adsBtn then
                    adsBtn.Visible = true
                    adsBtn.Active = true
                end
            end
        end

        -- Modülleri kullanarak tetikleme (varsa)
        if adJoinCtrl and type(adJoinCtrl.CancelCheck) == "function" then
            pcall(function() adJoinCtrl.CancelCheck() end)
            pcall(function() adJoinCtrl.CheckAd() end)
        end

        if panelCtrl and type(panelCtrl.OpenPanelByContext) == "function" then
            pcall(function() panelCtrl:OpenPanelByContext("MainGUIHandler", "AdStore") end)
        end

        if adsCtrl and type(adsCtrl.RequestRewardedVideoAd) == "function" then
            pcall(function()
                adsCtrl:RequestRewardedVideoAd("XenoBypass_PremiumItem", "rbxassetid://0", 0, "Item Refresh", "Item Refresh", false, false)
            end)
        end

        SendNotif("XenoHub", "ADStore ve Reklamlar Full Aktif Edildi! ✅")
    end)
end

-- ======= ORIJINAL MODAL TETIKLEYICI (Güvenli) =======
local function OpenOriginalFireModal()
    pcall(function()
        local originalModal = waitForDescendant(PlayerGui, "ModalFireAsk", 2)
        if originalModal then
            originalModal.Visible = true
            originalModal.Active = true
            for _, btn in pairs(originalModal:GetDescendants()) do
                if btn:IsA("GuiButton") or btn:IsA("TextButton") or btn:IsA("ImageButton") then
                    -- Butonun ismine/görseline göre uygun handler bağla
                    btn.Activated:Connect(function()
                        -- Güvenli bir remote tetiklemesi
                        local ok, Game8 = pcall(function() return require(StarterGui.Player8Handler.Game8Settings) end)
                        if ok and Game8 and Game8.PlayersHouse and type(Game8.PlayersHouse.FireServer) == "function" then
                            pcall(function() Game8.PlayersHouse:FireServer("PlayerWantsFire") end)
                            SendNotif("XenoHub", "Orijinal Yangın Tetiklendi! 🔥")
                        else
                            SendNotif("XenoHub", "Yangın Remote tetiklenemedi (modül bulunamadı)")
                        end
                    end)
                end
            end
        else
            -- Fallback: doğrudan bilinen remote varsa tetikle
            local re = ReplicatedStorage:FindFirstChild("RE")
            local event = re and re:FindFirstChild("PlayersHouse") or re and re:FindFirstChild("1Playe1rTrigge1rEven1t")
            if event and event.FireServer then
                pcall(function() event:FireServer("PlayerWantsFire") end)
                SendNotif("XenoHub", "Yangın Remote (fallback) tetiklendi.")
            else
                SendNotif("XenoHub", "Yangın tetiklenemedi: uygun remote bulunamadı.")
            end
        end
    end)
end

