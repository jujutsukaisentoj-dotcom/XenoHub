    RunService.Stepped:Connect(function()
        if lp.Character then
            for _, v in pairs(lp.Character:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
        end
    end)
end)

-- ITEMS
local ItemsTab = CreateTab("🎒 Eşyalar")
local function GetItem(name)
    local re = ReplicatedStorage:FindFirstChild("RE") or ReplicatedStorage:FindFirstChild("Remotes")
    if re and re:FindFirstChild("RemoteEvent") then
        re.RemoteEvent:FireServer("GetItem", name)
    end
    SendNotif("Eşya", name .. " alındı!")
end

AddButton(ItemsTab, "💸 Money Gun", nil, function() GetItem("MoneyGun") end)
AddButton(ItemsTab, "🆔 Agency Card", nil, function() GetItem("AgencyCard") end)
AddButton(ItemsTab, "🚫 Ban Hammer", nil, function() GetItem("BanHammer") end)

-- TELEPORT
local TPTab = CreateTab("📍 Işınlanma")
local function TP(cf) lp.Character.HumanoidRootPart.CFrame = cf end

AddButton(TPTab, "Spawn", nil, function() TP(CFrame.new(0, 10, 0)) end)
AddButton(TPTab, "Banka Kasası", nil, function() TP(CFrame.new(21, 16, 35)) end)
AddButton(TPTab, "Gizli Üs", nil, function() TP(CFrame.new(-220, 15, 600)) end)

