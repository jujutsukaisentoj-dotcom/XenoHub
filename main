-- ===============================================================
-- 🚀 BUILD A BOAT ULTRA FARM + GUI (Double Gold Bypass)
-- ===============================================================

local Library = {Toggle = true}
local Settings = {FarmEnabled = false, Speed = 0.1}

-- [ GUI OLUŞTURMA ]
local ScreenGui = Instance.new("ScreenGui")
local MainFrame = Instance.new("Frame")
local Title = Instance.new("TextLabel")
local ToggleBtn = Instance.new("TextButton")
local StatusLabel = Instance.new("TextLabel")

ScreenGui.Name = "GeminiFarmGUI"
ScreenGui.Parent = game.CoreGui
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
MainFrame.BorderSizePixel = 0
MainFrame.Position = UDim2.new(0.05, 0, 0.4, 0)
MainFrame.Size = UDim2.new(0, 180, 0, 150)
MainFrame.Active = true
MainFrame.Draggable = true -- Menüyü ekranda sürükleyebilirsin

Title.Parent = MainFrame
Title.Size = UDim2.new(1, 0, 0, 30)
Title.Text = "GEMINI HUB V3"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 14

ToggleBtn.Name = "ToggleBtn"
ToggleBtn.Parent = MainFrame
ToggleBtn.Position = UDim2.new(0.1, 0, 0.35, 0)
ToggleBtn.Size = UDim2.new(0.8, 0, 0.3, 0)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
ToggleBtn.Text = "FARM: OFF"
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.Font = Enum.Font.Gotham
ToggleBtn.TextSize = 16

StatusLabel.Parent = MainFrame
StatusLabel.Position = UDim2.new(0, 0, 0.75, 0)
StatusLabel.Size = UDim2.new(1, 0, 0, 20)
StatusLabel.Text = "Double Gold: ACTIVE ✅"
StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
StatusLabel.BackgroundTransparency = 1
StatusLabel.Font = Enum.Font.Small
StatusLabel.TextSize = 12

-- [ FARM MANTIĞI ]
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")

local function ClaimGold()
    local remote = Workspace:FindFirstChild("ClaimRiverResultsGold")
    if remote then remote:FireServer() end
end

-- Double Gold Bypass (Tetikleyici)
task.spawn(function()
    local data = LocalPlayer:WaitForChild("OtherData")
    if data:FindFirstChild("DoubleGold") then
        data.DoubleGold.Value = true
    end
end)

local function StartFarmLoop()
    while Settings.FarmEnabled do
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local stages = Workspace:FindFirstChild("BoatStages") and Workspace.BoatStages:FindFirstChild("NormalStages")

        if root and stages then
            -- Havada asılı kalma (Anti-Fall)
            local bp = Instance.new("BodyVelocity", root)
            bp.Velocity = Vector3.new(0,0,0)
            
            for i = 1, 10 do
                if not Settings.FarmEnabled then break end
                local stagePart = stages:FindFirstChild("CaveStage"..i) and stages["CaveStage"..i]:FindFirstChild("DarknessPart")
                if stagePart then
                    root.CFrame = stagePart.CFrame
                    ClaimGold()
                    task.wait(Settings.Speed)
                end
            end
            
            -- Sandık Sonu
            if Settings.FarmEnabled then
                local chest = stages:FindFirstChild("TheEnd") and stages.TheEnd.GoldenChest.Trigger
                if chest then
                    root.CFrame = chest.CFrame
                    if firetouchinterest then
                        firetouchinterest(root, chest, 0)
                        task.wait(0.1)
                        firetouchinterest(root, chest, 1)
                    end
                end
                task.wait(1.5)
                char:BreakJoints() -- Reset
            end
            bp:Destroy()
        end
        task.wait(1)
    end
end

-- [ BUTON KONTROLÜ ]
ToggleBtn.MouseButton1Click:Connect(function()
    Settings.FarmEnabled = not Settings.FarmEnabled
    if Settings.FarmEnabled then
        ToggleBtn.Text = "FARM: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        task.spawn(StartFarmLoop)
    else
        ToggleBtn.Text = "FARM: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

print("✅ Gemini Hub V3 Yüklendi! Menü sol tarafta.")
