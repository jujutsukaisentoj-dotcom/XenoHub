local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()
local Window = OrionLib:MakeWindow({Name = "BaBft Ultimate - MAX EDITION", HidePremium = false, SaveConfig = true, ConfigFolder = "BaBftUltimate"})

-- ================================
-- Değişkenler & İstatistikler
-- ================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local farming = false
local walkSpeed = 16
local noclipActive = false

-- İstatistik Verileri
local StartGold = LocalPlayer.Data.Gold.Value
local GainedGold = 0
local ChestsCollected = 0
local StartTime = os.time()

-- ================================
-- STAT BOARD (Görseldeki Tasarım)
-- ================================
local StatGui = Instance.new("ScreenGui")
StatGui.Name = "MaxStatBoard"
StatGui.Parent = CoreGui

local MainFrame = Instance.new("Frame", StatGui)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
MainFrame.BorderSizePixel = 0
MainFrame.Position = UDim2.new(0, 20, 0, 20)
MainFrame.Size = UDim2.new(0, 280, 0, 240)
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 10)

local FrameStroke = Instance.new("UIStroke", MainFrame)
FrameStroke.Color = Color3.fromRGB(40, 40, 55)
FrameStroke.Thickness = 2

local TitleLabel = Instance.new("TextLabel", MainFrame)
TitleLabel.Size = UDim2.new(1, 0, 0, 40)
TitleLabel.Font = Enum.Font.GothamBold
TitleLabel.Text = "W31rd.Hub • Gold Farming • V1.2"
TitleLabel.TextColor3 = Color3.fromRGB(100, 160, 255)
TitleLabel.TextSize = 15
TitleLabel.BackgroundTransparency = 1
TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
TitleLabel.Position = UDim2.new(0, 15, 0, 0)

local Line = Instance.new("Frame", MainFrame)
Line.Position = UDim2.new(0, 10, 0, 38)
Line.Size = UDim2.new(1, -20, 0, 1)
Line.BackgroundColor3 = Color3.fromRGB(100, 160, 255)
Line.BorderSizePixel = 0

local function CreateStatLine(text, color, pos)
    local lbl = Instance.new("TextLabel", MainFrame)
    lbl.Position = UDim2.new(0, 15, 0, pos)
    lbl.Size = UDim2.new(1, -30, 0, 30)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextColor3 = color
    lbl.TextSize = 17
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    return lbl
end

local CurrentGoldLabel = CreateStatLine("Current Gold: 0", Color3.fromRGB(255, 200, 0), 50)
local GainedGoldLabel = CreateStatLine("Gained Gold: 0", Color3.fromRGB(0, 255, 100), 85)
local ChestsLabel = CreateStatLine("Chests Collected: 0", Color3.fromRGB(255, 140, 0), 120)
local TimeLabel = CreateStatLine("Total Time Farming: 00:00:00", Color3.fromRGB(110, 200, 255), 155)

local DiscordBtn = Instance.new("TextButton", MainFrame)
DiscordBtn.Size = UDim2.new(1, -30, 0, 35)
DiscordBtn.Position = UDim2.new(0, 15, 1, -45)
DiscordBtn.BackgroundColor3 = Color3.fromRGB(60, 120, 255)
DiscordBtn.Font = Enum.Font.GothamBold
DiscordBtn.Text = "Copy Discord Link"
DiscordBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
DiscordBtn.TextSize = 14
Instance.new("UICorner", DiscordBtn).CornerRadius = UDim.new(0, 8)

-- İstatistik Güncelleme Döngüsü
task.spawn(function()
    while task.wait(1) do
        pcall(function()
            local currentGold = LocalPlayer.Data.Gold.Value
            GainedGold = currentGold - StartGold
            local diff = os.time() - StartTime
            local h, m, s = math.floor(diff/3600), math.floor((diff%3600)/60), diff%60
            
            CurrentGoldLabel.Text = "Current Gold: " .. string.format('%,d', currentGold)
            GainedGoldLabel.Text = "Gained Gold: " .. string.format('%,d', GainedGold)
            ChestsLabel.Text = "Chests Collected: " .. ChestsCollected
            TimeLabel.Text = "Total Time Farming: " .. string.format("%02d:%02d:%02d", h, m, s)
        end)
    end
end)

-- ================================
-- MENÜ TETİKLEME (Sol Alt)
-- ================================
local OpenBtnGui = Instance.new("ScreenGui", CoreGui)
local OpenBtn = Instance.new("TextButton", OpenBtnGui)
OpenBtn.Size = UDim2.new(0, 65, 0, 65)
OpenBtn.Position = UDim2.new(0, 15, 1, -80)
OpenBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
OpenBtn.Text = "MAX"
OpenBtn.TextColor3 = Color3.fromRGB(100, 160, 255)
OpenBtn.Font = Enum.Font.GothamBold
Instance.new("UICorner", OpenBtn).CornerRadius = UDim.new(0, 12)
local Stroke = Instance.new("UIStroke", OpenBtn)
Stroke.Color = Color3.fromRGB(100, 160, 255)
Stroke.Thickness = 2

OpenBtn.MouseButton1Click:Connect(function()
    local frame = CoreGui:FindFirstChild("Orion")
    if frame then frame.Enabled = not frame.Enabled end
    MainFrame.Visible = not MainFrame.Visible
end)

-- ================================
-- MAX BYPASS & FARM SİSTEMİ
-- ================================
local function ApplyBypass()
    local mt = getrawmetatable(game)
    setreadonly(mt, false)
    local oldNamecall = mt.__namecall
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "Kick" or method == "kick" then return nil end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end
ApplyBypass()

local function ClearMap()
    pcall(function()
        local stages = Workspace.BoatStages.NormalStages
        for _, stage in pairs(stages:GetChildren()) do
            if stage:FindFirstChild("DarknessPart") then stage.DarknessPart:Destroy() end
        end
    end)
end

local function StartFarm()
    task.spawn(function()
        while farming do
            local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local root = char:WaitForChild("HumanoidRootPart", 10)
            
            if root then
                ClearMap()
                local bv = Instance.new("BodyVelocity", root)
                bv.Velocity = Vector3.new(0, 0, 0)
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)

                local endZone = Workspace.BoatStages.NormalStages.TheEnd.GoldenChest.Trigger
                local path = {
                    CFrame.new(-55, 90, 1500),
                    CFrame.new(-55, 90, 4500),
                    CFrame.new(-55, 90, 7500),
                    CFrame.new(-55, 90, 9480),
                    endZone.CFrame
                }

                for _, targetCF in ipairs(path) do
                    if not farming then break end
                    local dist = (root.Position - targetCF.Position).Magnitude
                    local tween = TweenService:Create(root, TweenInfo.new(dist / 380, Enum.EasingStyle.Linear), {CFrame = targetCF})
                    tween:Play()
                    tween.Completed:Wait()
                end

                if farming then
                    root.CFrame = endZone.CFrame
                    task.wait(1)
                    ChestsCollected = ChestsCollected + 1
                    task.wait(9)
                    bv:Destroy()
                    char:BreakJoints()
                    task.wait(4)
                end
            end
            task.wait()
        end
    end)
end

-- ================================
-- ARAYÜZ (Orion)
-- ================================
local MainTab = Window:MakeTab({Name = "Farm & Loop", Icon = "rbxassetid://4483345998"})
local PlayerTab = Window:MakeTab({Name = "Karakter", Icon = "rbxassetid://4483345998"})

MainTab:AddToggle({
	Name = "MAX Auto Loop Farm",
	Default = false,
	Callback = function(v)
        farming = v 
        if v then 
            StartFarm() 
            OrionLib:MakeNotification({Name = "Farm Aktif", Content = "Döngü başlatıldı.", Time = 3})
        end 
    end    
})

PlayerTab:AddSlider({
	Name = "Hız",
	Min = 16, Max = 400, Default = 16,
	Callback = function(v) walkSpeed = v end    
})

PlayerTab:AddToggle({
	Name = "Noclip",
	Default = false,
	Callback = function(v) noclipActive = v end    
})

RunService.Stepped:Connect(function()
    if noclipActive and LocalPlayer.Character then
        for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = walkSpeed
    end
end)

OrionLib:Init()
