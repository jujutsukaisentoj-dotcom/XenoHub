-- =========================================================
-- W3rdHub Style - rqccc PRO & FULL DEX TRUE (V11)
-- =========================================================

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("W3rdHub - Gold Farming v1.2", "Midnight")

-- SERVICES
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Data = LocalPlayer:WaitForChild("OtherData")
local Claim = workspace:WaitForChild("ClaimRiverResultsGold")
local Stages = workspace.BoatStages.NormalStages
local GoldenChest = Stages.TheEnd.GoldenChest.Trigger

-- STATS (Videodaki Panel İçin)
local StartGold = LocalPlayer.Data.Gold.Value
local ChestsCollected = 0
local StartTime = os.time()
local AutoFarmActive = false

-- DEX TRUE: TÜM GAMEPASS ÖZELLİKLERİ
local function ActivateAllPasses()
    local passes = {"GoldPass", "VIP", "Member", "DoubleGold", "DoubleMoney", "ExtraBoatSlot"}
    for _, name in pairs(passes) do
        if not LocalPlayer:FindFirstChild(name) then
            local v = Instance.new("BoolValue", LocalPlayer)
            v.Name = name
            v.Value = true
        end
    end
    Library:Notify("W3rdHub", "Tüm Gamepasslar ve Dex Özellikleri Aktif!", "Success")
end

-- UI TAB & SECTION
local MainTab = Window:NewTab("Farming")
local HubSection = MainTab:NewSection("Gold Farming Panel")

-- VIDEODAKİ GİBİ STATS LABELLARI
local curGoldLabel = HubSection:NewLabel("Current Gold: " .. StartGold)
local gainedGoldLabel = HubSection:NewLabel("Gained Gold: 0")
local chestsLabel = HubSection:NewLabel("Chests Collected: 0")
local timeLabel = HubSection:NewLabel("Total Time Farming: 00:00:00")

-- rqccc BYPASS FUNCTIONS
local function HasStage(Num)
    return Data[`Stage{Num}`].Value ~= "" and Data[`Stage{Num}`].Value
end

local function ClaimStage(Num)
    task.spawn(function()
        local Value = Data[`Stage{Num}`]
        if not Value then Value:GetPropertyChangedSignal("Value"):Wait() end
        Claim:FireServer()
    end)
end

-- MAIN FARM LOOP (rqccc Logic + W3rdHub Display)
local function ExecuteFarm()
    while AutoFarmActive do
        local Char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local Root = Char:WaitForChild("HumanoidRootPart")
        
        local NewChar = false
        local conn = LocalPlayer.CharacterAdded:Once(function() NewChar = true end)

        for i = 1, 10 do
            if not AutoFarmActive or NewChar then break end
            
            local TargetPart = Stages[`CaveStage{i}`].DarknessPart
            local Teleporting = true

            -- rqccc Velocity Bypass (Videodaki Akıcılık)
            task.spawn(function()
                while Teleporting and AutoFarmActive do
                    Root.CFrame = TargetPart.CFrame
                    for _, Part in Char:GetChildren() do
                        if Part:IsA("BasePart") then
                            Part.Velocity = Vector3.zero
                            Part.RotVelocity = Vector3.zero
                        end
                    end
                    task.wait()
                end
            end)

            task.wait(4.8) -- Güvenli Bekleme
            ClaimStage(i)
            repeat task.wait(0.5) until HasStage(i) or NewChar or not AutoFarmActive
            Teleporting = false
        end

        -- FINAL CHEST (Stage 11)
        if AutoFarmActive and not NewChar then
            Root.CFrame = GoldenChest.CFrame
            task.wait(1.5)
            GoldenChest.CFrame = Root.CFrame
            task.wait(2)
            
            ChestsCollected = ChestsCollected + 1
            chestsLabel:UpdateLabel("Chests Collected: " .. ChestsCollected)
            
            Char:BreakJoints() -- Reset
            task.wait(8)
        end
        if conn then conn:Disconnect() end
    end
end

-- CONTROLS
HubSection:NewToggle("Start Auto Farm", "Videodaki gibi istatistikleri tutar", function(state)
    AutoFarmActive = state
    if state then
        ActivateAllPasses()
        task.spawn(ExecuteFarm)
    end
end)

HubSection:NewButton("Copy Discord Link", "Discord linkini kopyalar", function()
    setclipboard("discord.gg/EbhtGYbuTa")
    Library:Notify("W3rdHub", "Link Kopyalandı!", "Default")
end)

-- PANEL UPDATER (Saniyelik Güncelleme)
task.spawn(function()
    while task.wait(1) do
        -- Zaman Sayacı
        local diff = os.time() - StartTime
        local h, m, s = math.floor(diff/3600), math.floor((diff%3600)/60), diff%60
        timeLabel:UpdateLabel("Total Time Farming: " .. string.format("%02d:%02d:%02d", h, m, s))
        
        -- Altın Sayacı
        local current = LocalPlayer.Data.Gold.Value
        curGoldLabel:UpdateLabel("Current Gold: " .. current)
        gainedGoldLabel:UpdateLabel("Gained Gold: " .. (current - StartGold))
    end
end)

-- MOBILE UI BUTTON
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local ToggleBtn = Instance.new("TextButton", ScreenGui)
ToggleBtn.Size = UDim2.new(0, 90, 0, 35)
ToggleBtn.Position = UDim2.new(0, 20, 0, 200)
ToggleBtn.Text = "W3rdHub"
ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 170, 0) -- Turuncu
ToggleBtn.TextColor3 = Color3.new(0,0,0)
ToggleBtn.Draggable = true
ToggleBtn.MouseButton1Click:Connect(function() Library:ToggleUI() end)
