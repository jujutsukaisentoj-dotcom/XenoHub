-- =========================================================
-- BABFT ULTIMATE TETİKLİ FARM & DEX TRUE (rqccc Logic)
-- =========================================================

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("BABFT - rqccc Pro Hybrid", "Midnight")

-- SERVICES & VARS
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Data = LocalPlayer:WaitForChild("OtherData")
local Claim = workspace:WaitForChild("ClaimRiverResultsGold")
local Stages = workspace.BoatStages.NormalStages
local GoldenChest = Stages.TheEnd.GoldenChest.Trigger

local AutoFarmActive = false
local StartGold = LocalPlayer.Data.Gold.Value

-- DEX TRUE: TÜM OYUN ÖZELLİKLERİNİ AKTİF ET
local function ActivateDexTrue()
    local passList = {"GoldPass", "VIP", "Member", "DoubleGold", "DoubleMoney", "ExtraBoatSlot"}
    for _, name in pairs(passList) do
        if not LocalPlayer:FindFirstChild(name) then
            local val = Instance.new("BoolValue", LocalPlayer)
            val.Name = name
            val.Value = true
        end
    end
    Library:Notify("SİSTEM", "Tüm özelliklere (Dex: True) sahipsin!", "Success")
end

-- UI TABS
local MainTab = Window:NewTab("Farming")
local Section = MainTab:NewSection("Tetikli rqccc Farm")

-- LABELS
local statusLabel = Section:NewLabel("Durum: Bekleniyor...")
local goldLabel = Section:NewLabel("Altın: " .. StartGold)

-- rqccc MANTIĞI: BÖLÜM DOĞRULAMA
local function HasStage(Num)
    return Data[`Stage{Num}`].Value ~= "" and Data[`Stage{Num}`].Value
end

-- rqccc MANTIĞI: BÖLÜM ONAYLAMA
local function ClaimStage(Num)
    task.spawn(function()
        local Value = Data[`Stage{Num}`]
        if not Value then Value:GetPropertyChangedSignal("Value"):Wait() end
        Claim:FireServer()
    end)
end

-- ANA FARM DÖNGÜSÜ (Bölüm Bölüm Işınlanma)
local function StartFarming()
    while AutoFarmActive do
        local Char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local Root = Char:WaitForChild("HumanoidRootPart")
        
        local NewChar = false
        local conn = LocalPlayer.CharacterAdded:Once(function() NewChar = true end)

        -- 1. Bölümden 10. Bölüme kadar sırayla git
        for i = 1, 10 do
            if not AutoFarmActive or NewChar then break end
            
            statusLabel:UpdateLabel("İlerleme: Bölüm " .. i .. " / 11")
            local TargetPart = Stages[`CaveStage{i}`].DarknessPart
            local Teleporting = true

            -- rqccc Velocity Bypass: Atılmanı engeller
            task.spawn(function()
                while Teleporting and AutoFarmActive do
                    Root.CFrame = TargetPart.CFrame
                    for _, Part in Char:GetChildren() do
                        if Part:IsA("BasePart") then
                            Part.Velocity = Vector3.zero
                            Part.RotVelocity = Vector3.zero
                        end
                    end
                    task.wait()
                end
            end)

            task.wait(5) -- Bölüm arası güvenli bekleme
            ClaimStage(i)
            
            -- Sunucu "Bölümü geçtin" diyene kadar bekle
            repeat task.wait(0.5) until HasStage(i) or NewChar or not AutoFarmActive
            Teleporting = false
        end

        -- 11. BÖLÜM: ALTIN SANDIK
        if AutoFarmActive and not NewChar then
            statusLabel:UpdateLabel("Durum: SANDIK ALINIYOR...")
            Root.CFrame = GoldenChest.CFrame
            task.wait(1)
            GoldenChest.CFrame = Root.CFrame
            task.wait(2.5)
            
            statusLabel:UpdateLabel("Durum: Başarılı! Resetleniyor...")
            Char:BreakJoints()
            task.wait(8)
        end
        if conn then conn:Disconnect() end
    end
end

-- UI KONTROLLERİ
Section:NewToggle("AUTO FARM BAŞLAT", "Basınca Dex: True ve Farm Tetiklenir", function(state)
    AutoFarmActive = state
    if state then
        ActivateDexTrue() -- Özellikleri tetikle
        task.spawn(StartFarming)
    else
        statusLabel:UpdateLabel("Durum: DURDURULDU")
    end
end)

-- ANLIK ALTIN TAKİBİ
task.spawn(function()
    while task.wait(1) do
        goldLabel:UpdateLabel("Mevcut Altın: " .. LocalPlayer.Data.Gold.Value)
    end
end)

-- MOBİL İÇİN MENU BUTONU
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local ToggleBtn = Instance.new("TextButton", ScreenGui)
ToggleBtn.Size = UDim2.new(0, 80, 0, 35)
ToggleBtn.Position = UDim2.new(0, 15, 0, 150)
ToggleBtn.Text = "MENU"
ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
ToggleBtn.TextColor3 = Color3.new(1,1,1)
ToggleBtn.Draggable = true
ToggleBtn.MouseButton1Click:Connect(function() Library:ToggleUI() end)
