-- --> SAYFA: ANA (PREMIUM)
local PremiumPage = CreateTab("⭐ Premium", "")
AddButton(PremiumPage, "🔓 FULL PREMIUM UNLOCK (Client)", Color3.fromRGB(145, 90, 230), function()
    local PlayerGui = lp:WaitForChild("PlayerGui")
    for _, gui in pairs(PlayerGui:GetDescendants()) do
        if gui:IsA("ImageButton") or gui:IsA("TextButton") then
            if gui.Name:lower():find("lock") or gui.Name:lower():find("premium") then
                gui.Visible = false
            end
        end
    end
    pcall(function()
        local GC = require(ReplicatedStorage.Modules.Client.UI.GamepassUnlockController)
        GC.OwnsGamepass = function() return true end
    end)
    SendNotif("Başarılı", "Premium kilitleri kaldırıldı!")
end)

AddButton(PremiumPage, "🏠 Evleri Yak (House Fire)", Color3.fromRGB(200, 50, 50), function()
    local r = ReplicatedStorage:FindFirstChild("RE") or ReplicatedStorage:FindFirstChild("Remotes")
    pcall(function() r.RemoteEvent:FireServer("HouseSettings", "Fire", true) end)
    SendNotif("Troll", "Bölgedeki evlerde yangın başlatıldı!")
end)

