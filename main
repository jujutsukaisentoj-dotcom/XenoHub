--[[
	ULTIMATE BUILD A BOAT FOR TREASURE - FULL BYPASS & FARM
	Geliştirilmiş Sürüm: v3.0 (Full Bypass Edition)
	Özellikler:
	- Gelişmiş Meta-Table Bypass (Anticheat Korunması)
	- Tween (Kayarak) Farm (Hız ve Mesafe Kontrollü)
	- Otomatik Engel, Su ve Kara Delik Silici
	- Full Auto-Buy (Tüm Sandıklar)
	- Hız ve Zıplama Hilesi (Slider ile)
	- Anti-AFK & Karakter Koruma
]]

local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()
local Window = OrionLib:MakeWindow({Name = "BaBft Ultimate - Full Bypass", HidePremium = false, SaveConfig = true, ConfigFolder = "BaBftUltimate"})

-- ================================
-- Servisler ve Değişkenler
-- ================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local farming = false
local autoBuyType = "None"
local walkSpeed = 16
local jumpPower = 50

-- ================================
-- FULL BYPASS MANTIĞI
-- ================================
-- Oyunun hile tespit sistemini (Kick/Teleport Check) devre dışı bırakmaya çalışır.
local function ApplyBypass()
    local mt = getrawmetatable(game)
    local oldIndex = mt.__index
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        -- Oyunun karakteri izleyen veya hile kontrolü yapan belirli uzaktan tetiklemelerini engeller
        if method == "Kick" or method == "kick" then
            OrionLib:MakeNotification({Name = "Bypass", Content = "Oyun seni atmaya çalıştı, engellendi!", Time = 3})
            return nil
        end
        
        if not checkcaller() and method == "FireServer" and tostring(self) == "RemoteEvent" then
            -- Bazı şüpheli raporlama eventlerini filtrele
            return nil
        end

        return oldNamecall(self, ...)
    end)

    setreadonly(mt, true)
end

ApplyBypass()

-- ================================
-- Yardımcı Fonksiyonlar
-- ================================

local function ClearMap()
    pcall(function()
        -- Öldüren bölgeleri ve engelleri temizle
        local stages = Workspace:WaitForChild("BoatStages"):WaitForChild("NormalStages")
        for _, stage in pairs(stages:GetChildren()) do
            if stage:FindFirstChild("DarknessPart") then
                stage.DarknessPart:Destroy()
            end
        end
        -- Su hasarını ve görsel kirliliği engellemek için isteğe bağlı
        if Workspace:FindFirstChild("Water") then
            -- Workspace.Water:Destroy() -- Tamamen silmek bazen sorun çıkarabilir
        end
    end)
end

local function GetFullNoclip()
    local char = LocalPlayer.Character
    if char then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end

-- ================================
-- Gelişmiş Farm Mantığı
-- ================================

local function StartFarm()
    task.spawn(function()
        while farming do
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.CharacterAdded:Wait()
                task.wait(1)
                char = LocalPlayer.Character
            end

            local root = char:WaitForChild("HumanoidRootPart")
            ClearMap()
            
            -- Uçuş/Kayma Hazırlığı
            local bv = root:FindFirstChild("FlyVelocity") or Instance.new("BodyVelocity")
            bv.Name = "FlyVelocity"
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Parent = root

            -- Noclip aktif et
            local noclipLoop = RunService.Stepped:Connect(GetFullNoclip)

            -- Hedef: Stages -> End
            local endZone = Workspace.BoatStages.NormalStages.TheEnd.GoldenChest.Trigger
            
            -- Duraklama Noktaları (Checkpoint Bypass)
            -- Oyunun "hızlı teleport" algılamaması için ara duraklar eklenmiştir.
            local path = {
                CFrame.new(-55, 70, 1500),
                CFrame.new(-55, 70, 3000),
                CFrame.new(-55, 70, 4500),
                CFrame.new(-55, 70, 6000),
                CFrame.new(-55, 70, 7500),
                CFrame.new(-55, 70, 9450), -- Son Bölüm
                endZone.CFrame
            }

            for _, targetCF in ipairs(path) do
                if not farming then break end
                local dist = (root.Position - targetCF.Position).Magnitude
                local tweenInfo = TweenInfo.new(dist / 320, Enum.EasingStyle.Linear) -- Hız: 320 (Güvenli sınır)
                local tween = TweenService:Create(root, tweenInfo, {CFrame = targetCF})
                tween:Play()
                tween.Completed:Wait()
            end

            -- Sandık Bölgesinde Bekleme ve Ödül
            if farming then
                root.CFrame = endZone.CFrame
                task.wait(12) -- Ödülün işlenmesi için gereken süre
                noclipLoop:Disconnect()
                if farming then
                    char:BreakJoints() -- Resetle ve tekrar başla
                    task.wait(5)
                end
            end
        end
    end)
end

-- ================================
-- Arayüz (UI) Yapılandırması
-- ================================

local MainTab = Window:MakeTab({Name = "Otomatik Farm", Icon = "rbxassetid://4483345998"})
local PlayerTab = Window:MakeTab({Name = "Oyuncu", Icon = "rbxassetid://4483345998"})
local ShopTab = Window:MakeTab({Name = "Market", Icon = "rbxassetid://4483345998"})

-- Main Tab
MainTab:AddToggle({
	Name = "Ultra Auto Farm",
	Default = false,
	Callback = function(Value)
		farming = Value
		if farming then StartFarm() end
	end    
})

MainTab:AddButton({
	Name = "Map Engellerini Temizle",
	Callback = function() ClearMap() end
})

-- Player Tab
PlayerTab:AddSlider({
	Name = "Yürüme Hızı",
	Min = 16,
	Max = 250,
	Default = 16,
	Color = Color3.fromRGB(255,255,255),
	Increment = 1,
	ValueName = "Hız",
	Callback = function(Value)
		walkSpeed = Value
	end    
})

PlayerTab:AddSlider({
	Name = "Zıplama Gücü",
	Min = 50,
	Max = 500,
	Default = 50,
	Color = Color3.fromRGB(255,255,255),
	Increment = 1,
	ValueName = "Güç",
	Callback = function(Value)
		jumpPower = Value
	end    
})

RunService.RenderStepped:Connect(function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = walkSpeed
        LocalPlayer.Character.Humanoid.JumpPower = jumpPower
    end
end)

-- Shop Tab
ShopTab:AddDropdown({
	Name = "Otomatik Sandık Al",
	Default = "None",
	Options = {"None", "Common Chest", "Uncommon Chest", "Rare Chest", "Epic Chest", "Legendary Chest"},
	Callback = function(Value)
		autoBuyType = Value
	end    
})

task.spawn(function()
    while true do
        if autoBuyType ~= "None" then
            workspace.ItemBoughtFromShop:FireServer(autoBuyType, 1)
        end
        task.wait(2)
    end
end)

-- Anti-AFK
local vu = game:GetService("VirtualUser")
LocalPlayer.Idled:Connect(function()
    vu:Button2Down(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
    wait(1)
    vu:Button2Up(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
end)

OrionLib:Init()
