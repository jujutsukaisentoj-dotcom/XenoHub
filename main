    Config.AutoAds = state
end)
CreateButton(Auto, "Optimize FPS", function()
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") then v.CastShadow = false end
    end
    settings().Rendering.QualityLevel = 1
end)

-- Store Hub
