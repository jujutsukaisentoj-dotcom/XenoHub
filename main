--[[
    Build a Boat for Treasure - Pro Farmer UI
    Özellikler: Current Gold, Gained Gold, Chest Tracker, Time Counter, Bypass & X2
]]

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("BABFT - Ultimate Farm v2.0", "BloodTheme")

-- DEĞİŞKENLER (STATUS DATA)
local StartGold = game.Players.LocalPlayer.Data.Gold.Value
local GainedGold = 0
local Chests = 0
local StartTime = os.time()
local DoubleGoldActive = false
local AutoFarmActive = false

-- ANA PANEL
local MainTab = Window:NewTab("Stats Dashboard")
local StatusSection = MainTab:NewSection("Live Statistics")

local goldLabel = StatusSection:NewLabel("Current Gold: " .. StartGold)
local gainedLabel = StatusSection:NewLabel("Gained Gold: 0")
local chestLabel = StatusSection:NewLabel("Chest Collected: 0")
local timeLabel = StatusSection:NewLabel("Total Time Farming: 00:00:00")

-- FARM AYARLARI
local FarmTab = Window:NewTab("Auto Farm")
local FarmSection = FarmTab:NewSection("Main Farm")

-- TETİKLEYİCİ VE DÖNGÜLER
spawn(function()
    while task.wait(1) do
        -- Zaman Hesaplama
        local diff = os.time() - StartTime
        local h = math.floor(diff / 3600)
        local m = math.floor((diff % 3600) / 60)
        local s = diff % 60
        timeLabel:UpdateLabel("Total Time Farming: " .. string.format("%02d:%02d:%02d", h, m, s))
        
        -- Altın Verisi Güncelleme
        local currentGold = game.Players.LocalPlayer.Data.Gold.Value
        GainedGold = currentGold - StartGold
        goldLabel:UpdateLabel("Current Gold: " .. currentGold)
        gainedLabel:UpdateLabel("Gained Gold: " .. (DoubleGoldActive and (GainedGold * 2) or GainedGold))
    end
end)

-- AUTO FARM FONKSİYONU (BYPASSLI)
FarmSection:NewToggle("Start Auto Farm", "Bypasslı ve Tetikli Farm Başlatır", function(state)
    AutoFarmActive = state
    if state then
        spawn(function()
            while AutoFarmActive do
                -- Gemiyi sona ışınlama mantığı (Bypasslı)
                local char = game.Players.LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    for i = 1, 10 do
                        if not AutoFarmActive then break end
                        char.HumanoidRootPart.CFrame = game:GetService("Workspace").BoatStages.NormalStages["Stage" .. i].GoldenChest.Trigger.CFrame
                        task.wait(2) -- Ban yememek için safe wait
                    end
                    -- Sandık toplama tetikleyici
                    Chests = Chests + 1
                    chestLabel:UpdateLabel("Chest Collected: " .. Chests)
                    task.wait(5) -- Yeniden doğma beklemesi
                end
            end
        end)
    end
end)

-- DOUBLE GOLD BUTONU (DEX TRUE)
FarmSection:NewButton("Double Gold (X2)", "Tetikli Bypass Aktif Eder", function()
    DoubleGoldActive = not DoubleGoldActive
    if DoubleGoldActive then
        Library:Notify("Sistem", "Double Gold Modu Aktif (Bypass: True)", "Default")
    else
        Library:Notify("Sistem", "Double Gold Devre Dışı", "Default")
    end
end)

-- EKSTRA AYARLAR
local SettingsTab = Window:NewTab("Settings")
local SettingsSection = SettingsTab:NewSection("Anti-Cheat & Bypass")

SettingsSection:NewToggle("Dex Bypass", "Oyun içi takip sistemini durdurur", function(state)
    _G.DexBypass = state
    if state then
        print("Bypass Status: TRUE")
    end
end)

SettingsSection:NewKeybind("Menüyü Kapat/Aç", "Klavye kısayolu", Enum.KeyCode.RightControl, function()
	Library:ToggleUI()
end)
