-- 👻 NOCLIP (DUVAR GEÇME)
AddBtn(PlayerTab, "👻 Noclip (Duvar Geçme): AÇ/KAPAT", function()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
        SendNotif("XenoHub", "Noclip Kapatıldı.")
    else
        noclipConnection = RunService.Stepped:Connect(function()
            if lp.Character then
                for _, v in pairs(lp.Character:GetDescendants()) do
                    if v:IsA("BasePart") then v.CanCollide = false end
                end
            end
        end)
        SendNotif("XenoHub", "Noclip Aktif! Duvarlardan geçebilirsiniz.")
    end
end, Color3.fromRGB(80, 80, 80))

-- ✈️ FLY (UÇMA - WASD+QE DESTEKLİ)
AddBtn(PlayerTab, "✈️ Fly (Uçma): AÇ/KAPAT", function()
    flying = not flying
    local root = lp.Character:FindFirstChild("HumanoidRootPart")
    if flying and root then
        local bv = Instance.new("BodyVelocity", root)
        bv.Name = "XenoFlyForce"
        bv.MaxForce = Vector3.new(1,1,1) * math.huge
        bv.Velocity = Vector3.new(0,0,0)
        
        local bg = Instance.new("BodyGyro", root)
        bg.Name = "XenoFlyGyro"
        bg.MaxTorque = Vector3.new(1,1,1) * math.huge
        bg.P = 9e4
        
        task.spawn(function()
            while flying do
                RunService.RenderStepped:Wait()
                bg.CFrame = workspace.CurrentCamera.CFrame
                local dir = Vector3.new(0,0,0)
                local cam = workspace.CurrentCamera.CFrame
                
                if flyKeys.W then dir = dir + cam.LookVector end
                if flyKeys.S then dir = dir - cam.LookVector end
                if flyKeys.A then dir = dir - cam.RightVector end
                if flyKeys.D then dir = dir + cam.RightVector end
                if flyKeys.Q then dir = dir + Vector3.new(0, 1, 0) end
                if flyKeys.E then dir = dir - Vector3.new(0, 1, 0) end
                
                bv.Velocity = dir * flySpeed
            end
            bv:Destroy()
            bg:Destroy()
        end)
        SendNotif("XenoHub", "Uçma Aktif! WASD + QE Tuşlarını Kullanın.")
    else
        SendNotif("XenoHub", "Uçma Devre Dışı.")
    end
end, Color3.fromRGB(0, 255, 127))

-- Uçuş Tuş Kontrolleri
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    local k = input.KeyCode.Name
    if flyKeys[k] ~= nil then flyKeys[k] = true end
end)
UserInputService.InputEnded:Connect(function(input)
    local k = input.KeyCode.Name
    if flyKeys[k] ~= nil then flyKeys[k] = false end
end)

