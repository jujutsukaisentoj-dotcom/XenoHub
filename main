    BarBack.Size = UDim2.new(0.5, 0, 0, 4)
    BarBack.Position = UDim2.new(0.25, 0, 0.55, 0)
    BarBack.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    BarBack.Parent = MainLoad
    Instance.new("UICorner", BarBack)
    
    local BarFill = Instance.new("Frame")
    BarFill.Size = UDim2.new(0, 0, 1, 0)
    BarFill.BackgroundColor3 = Color3.fromRGB(145, 90, 230)
    BarFill.Parent = BarBack
    Instance.new("UICorner", BarFill)
    
    task.wait(0.1)
    TweenService:Create(BarFill, TweenInfo.new(1.5, Enum.EasingStyle.Quart), {Size = UDim2.new(1, 0, 1, 0)}):Play()
    task.wait(1.6)
    
    TweenService:Create(MainLoad, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
    TweenService:Create(Logo, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
    task.wait(0.5)
    LoadGui:Destroy()
end

