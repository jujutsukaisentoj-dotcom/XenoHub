-- FARM
AddBtn(FarmTab, "💰 Auto-Rob Safes (Start)", function() 
    XenoSettings.AutoRob = true 
    SendNotif("Xeno", "Kasa Avı Başladı!") 
    task.spawn(function()
        while XenoSettings.AutoRob do
            local safes = GetSafes()
            if #safes == 0 then SendNotif("Xeno", "Kasa Yok!") break end
            for _, s in pairs(safes) do
                if not XenoSettings.AutoRob then break end
                if s:FindFirstChild("Safe") then
                    lp.Character.HumanoidRootPart.CFrame = s.Safe.CFrame * CFrame.new(0,0,3)
                    task.wait(0.5)
                    ReplicatedStorage.RE["1Playe1rTrigge1rEven1t"]:FireServer("AcceptedToolToServer", "C4", lp)
                    task.wait(2.5)
                end
            end
            task.wait(3)
        end
    end)
end)
AddBtn(FarmTab, "🛑 Stop Farm", function() XenoSettings.AutoRob = false end)

-- TROLL
AddBtn(TrollTab, "🌪️ Fling (Döndür)", function() 
    local b = Instance.new("BodyAngularVelocity", lp.Character.HumanoidRootPart)
    b.AngularVelocity = Vector3.new(0,99999,0) b.MaxTorque = Vector3.new(0,math.huge,0) b.P = math.huge
end)
AddBtn(TrollTab, "🛑 Fling Stop", function() for _, v in pairs(lp.Character.HumanoidRootPart:GetChildren()) do if v:IsA("BodyAngularVelocity") then v:Destroy() end end end)

-- SERVER TAB
AddBtn(ServerTab, "🔄 Rejoin (Tekrar Gir)", function() TeleportService:Teleport(game.PlaceId, lp) end)
AddBtn(ServerTab, "🦘 Server Hop (Sunucu Değiş)", function()
    SendNotif("Xeno", "Sunucu aranıyor...")
    local Api = "https://games.roblox.com/v1/games/"
    local _place = game.PlaceId
    local _servers = Api.._place.."/servers/Public?sortOrder=Asc&limit=100"
    local function ListServers(cursor)
        local Raw = game:HttpGet(_servers .. ((cursor and "&cursor="..cursor) or ""))
        return HttpService:JSONDecode(Raw)
    end
    local Server, Next; repeat
        local Servers = ListServers(Next)
        Server = Servers.data[1]
        Next = Servers.nextPageCursor
    until Server
    TeleportService:TeleportToPlaceInstance(_place, Server.id, lp)
end)

