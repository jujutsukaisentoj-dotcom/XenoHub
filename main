-- Oyuncu Bulma (Kısaltma destekli)
local function GetPlayer(name)
    name = name:lower()
    for _, p in pairs(Players:GetPlayers()) do
        if p.Name:lower():find(name) or p.DisplayName:lower():find(name) then
            return p
        end
    end
    return nil
end

-- AdStore Tetikleyici
local function TriggerFullADStore()
    pcall(function()
        local AdsController = require(ReplicatedStorage.Modules.Client.Ads.AdvertisementsController)
        local PanelController = require(ReplicatedStorage.Modules.Client.UI.PanelController)
        local AdJoinController = require(ReplicatedStorage.Modules.Client.Ads.AdvertisementJoinController)
        
        local MainGUI = PlayerGui:FindFirstChild("MainGUIHandler")
        if MainGUI then
            local adStore = MainGUI:FindFirstChild("AdStore", true)
            if adStore then adStore.Visible = true adStore.Active = true end
        end

        AdJoinController.CancelCheck()
        AdJoinController.CheckAd()
        PanelController.OpenPanelByContext("MainGUIHandler", "AdStore", "ads")
        AdsController.RequestRewardedVideoAd("XenoBypass_Reward", "rbxassetid://0", 0, "Item Refresh", "Item Refresh", false, false)
        SendNotif("XenoHub", "AdStore Tetiklendi! ✅")
    end)
end

-- Yangın Kontrol
local function FireControl(state)
    pcall(function()
        local Game8 = require(StarterGui.Player8Handler.Game8Settings)
        if state == "start" then
            Game8.PlayersHouse:FireServer("PlayerWantsFire")
            SendNotif("XenoHub", "🔥 Yangın Başlatıldı!")
        elseif state == "stop" then
            Game8.PlayersHouse:FireServer("PlayerWantsToExtinguishFire")
            SendNotif("XenoHub", "🧯 Yangın Söndürüldü!")
        end
    end)
end

-- Özel Fly Fonksiyonu
local function ToggleFly()
    XenoSettings.Flying = not XenoSettings.Flying
    local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    
    if XenoSettings.Flying then
        if not root then return end
        local bv = Instance.new("BodyVelocity", root)
        bv.Name = "XenoFlyVelocity"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0,0,0)
        
        local bg = Instance.new("BodyGyro", root)
        bg.Name = "XenoFlyGyro"
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.P = 10000
        bg.D = 100
        
        SendNotif("XenoHub", "Uçuş Aktif! Hız: " .. XenoSettings.FlySpeed)
        
        task.spawn(function()
            while XenoSettings.Flying and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") do
                local cam = Workspace.CurrentCamera
                local move = Vector3.new()
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0,1,0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.new(0,1,0) end
                bv.Velocity = move * XenoSettings.FlySpeed
                bg.CFrame = cam.CFrame
                RunService.RenderStepped:Wait()
            end
            if root:FindFirstChild("XenoFlyVelocity") then root.XenoFlyVelocity:Destroy() end
            if root:FindFirstChild("XenoFlyGyro") then root.XenoFlyGyro:Destroy() end
        end)
    else
        SendNotif("XenoHub", "Uçuş Kapalı.")
        if root then
            if root:FindFirstChild("XenoFlyVelocity") then root.XenoFlyVelocity:Destroy() end
            if root:FindFirstChild("XenoFlyGyro") then root.XenoFlyGyro:Destroy() end
        end
    end
end

-- Noclip
RunService.Stepped:Connect(function()
    if XenoSettings.Noclip and lp.Character then
        for _, v in pairs(lp.Character:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end
end)

-- SpinBot
RunService.RenderStepped:Connect(function()
    if XenoSettings.SpinBot and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
        lp.Character.HumanoidRootPart.CFrame = lp.Character.HumanoidRootPart.CFrame * CFrame.Angles(0, math.rad(20), 0)
    end
end)

-- ESP & Spectate
local function UpdateESP()
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= lp and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
            if XenoSettings.EspEnabled then
                if not v.Character.HumanoidRootPart:FindFirstChild("XenoESP") then
                    local hl = Instance.new("Highlight", v.Character)
                    hl.Name = "XenoESP"
                    hl.FillColor = Color3.fromRGB(145, 90, 230)
                    hl.OutlineColor = Color3.new(1,1,1)
                end
            else
                if v.Character:FindFirstChild("XenoESP") then v.Character.XenoESP:Destroy() end
            end
        end
    end
    -- Spectate Logic
    if XenoSettings.Spectating then
        Workspace.CurrentCamera.CameraSubject = XenoSettings.Spectating.Character and XenoSettings.Spectating.Character:FindFirstChild("Humanoid")
    else
        Workspace.CurrentCamera.CameraSubject = lp.Character and lp.Character:FindFirstChild("Humanoid")
    end
end
RunService.RenderStepped:Connect(UpdateESP)

-- Kasa Bulucu
local function GetSafes()
    local safes = {}
    for _, v in pairs(Workspace:GetDescendants()) do
        if v.Name == "Safe" and v:IsA("Model") then table.insert(safes, v) end
    end
    return safes
end

