    if lp and lp.Character and lp.Character:FindFirstChild("Humanoid") then
        lp.Character.Humanoid.WalkSpeed = 100
        SendNotif("XenoHub", "WalkSpeed 100 olarak ayarlandı (local).")
    end
end, Color3.fromRGB(145, 90, 230))

AddBtn(PlayerTab, "🚀 Jump (150)", function()
    if lp and lp.Character and lp.Character:FindFirstChild("Humanoid") then
        lp.Character.Humanoid.JumpPower = 150
        SendNotif("XenoHub", "JumpPower 150 olarak ayarlandı (local).")
    end
end, Color3.fromRGB(145, 90, 230))

AddBtn(PlayerTab, "🧼 Reset Speed/Jump (Default)", function()
    if lp and lp.Character and lp.Character:FindFirstChild("Humanoid") then
        lp.Character.Humanoid.WalkSpeed = 16
        lp.Character.Humanoid.JumpPower = 50
        SendNotif("XenoHub", "Speed/Jump varsayılana döndü.")
    end
end, Color3.fromRGB(100, 100, 100))

-- === 5) ITEMS (GÜVENLİ TUR) ===
local function SafeTriggerToolLocal(toolName)
    -- Sunucuya doğrudan hile amaçlı tetikleme yapmıyoruz; sadece deneme ve bilgi
    pcall(function()
        local re = ReplicatedStorage:FindFirstChild("RE") or ReplicatedStorage:FindFirstChild("Remotes")
        if re then
            SendNotif("XenoHub", "Tool tetikleme denemesi yapıldı (gönderilmedi): " .. tostring(toolName))
        else
            SendNotif("XenoHub", "Remotes bulunamadı; tetikleme atlandı.")
        end
    end)
end

