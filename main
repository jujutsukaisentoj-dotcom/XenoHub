Instance.new("UICorner", Tgl).CornerRadius = UDim.new(1, 0)
Tgl.MouseButton1Click:Connect(function() Main.Visible = not Main.Visible end)

Notify("XenoHub V19 Loaded", "Hoşgeldin, " .. lp.Name .. "! Panel aktif.")
