-- ============================================================================== --
-- 1. ANALİZ EDİLEN MODÜL SİMÜLASYONLARI (GAMEPASS & ADS)
-- ============================================================================== --

local XenoSettings = {
    ApiKey = "", -- Gemini API Key (Otomatik atanır)
    EspActive = false,
    SpectateTarget = nil,
    BypassReady = false
}

local function FullBypass()
    pcall(function()
        -- GamepassUnlockController.txt içindeki mantığı bypass etme
        local GamepassModule = require(ReplicatedStorage.Modules.Client.UI.Gamepass.GamepassController)
        local UnlockModule = require(ReplicatedStorage.Modules.Client.UI.GamepassUnlockController)
        
        -- Tüm gamepass'leri "True" yapma
        GamepassModule.OwnsGamepass = function() return true end
        UnlockModule.OwnsGamepass = function() return true end
        
        -- AllGamepasses.txt listesindeki tüm değerleri simüle etme
        local GamepassData = require(ReplicatedStorage.Modules.Shared.PlayerData.Gamepasses)
        if GamepassData and GamepassData.All then
            for key, val in pairs(GamepassData.All) do
                val.__GAMEPASS = true
            end
        end

        -- Yetki Kontrolleri (Staff/Admin)
        local Perms = ReplicatedStorage:FindFirstChild("Permissions", true)
        if Perms then
            local PermModule = require(Perms)
            PermModule.hasAdminAccess = function() return true end
            PermModule.hasStaffAccess = function() return true end
        end
        
        XenoSettings.BypassReady = true
        StarterGui:SetCore("SendNotification", {
            Title = "XenoHub";
            Text = "Tüm Gamepass ve Reklam Kilitleri Kaldırıldı!";
            Duration = 5;
        })
    end)
end

-- ============================================================================== --
-- 2. XENOAI PRO SCRIPTING ENGINE
-- ============================================================================== --

local function AskAI(question, callback)
    task.spawn(function()
        local sysPrompt = "Sen Brookhaven uzmanı bir exploitsin. Luau dilini ve Brookhaven remote eventlerini (Ads, Lot, Gamepass) biliyorsun. Kullanıcıya kod yazarken Brookhaven dosyalarındaki gibi (Decompiled style) örnekler ver."
        local payload = {
            contents = {{ parts = {{ text = question }} }},
            systemInstruction = { parts = {{ text = sysPrompt }} }
        }
        
        local success, result
        pcall(function()
            result = HttpService:PostAsync(
                "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=" .. XenoSettings.ApiKey,
                HttpService:JSONEncode(payload)
            )
        end)

        if result then
            local data = HttpService:JSONDecode(result)
            callback(data.candidates[1].content.parts[1].text)
        else
            callback("Hata: AI şu an bağlantı kuramıyor. API anahtarını kontrol et.")
        end
    end)
end

