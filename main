-- ================================
-- FULL BYPASS MANTIĞI
-- ================================
local function ApplyBypass()
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        
        -- Ölüm veya atılma kontrollerini manipüle et
        if method == "Kick" or method == "kick" then
            return nil
        end
        
        -- Gereksiz raporlama ve veri takibini engelle
        if not checkcaller() and (method == "FireServer" or method == "InvokeServer") then
            local name = tostring(self)
            if name:find("Report") or name:find("Cheat") or name:find("Detection") then
                return nil
            end
        end

        return oldNamecall(self, ...)
    end)

    setreadonly(mt, true)
    
    -- Karakter resetlendiğinde bypass'ı koru
    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(1)
        if noclipActive then noclipActive = true end
    end)
end

ApplyBypass()

-- ================================
-- Fonksiyonlar
-- ================================
local function ClearMap()
    pcall(function()
        local stages = Workspace:WaitForChild("BoatStages"):WaitForChild("NormalStages")
        for _, stage in pairs(stages:GetChildren()) do
            if stage:FindFirstChild("DarknessPart") then
                stage.DarknessPart:Destroy()
            end
        end
    end)
end

RunService.Stepped:Connect(function()
    if noclipActive and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

-- ================================
-- Farm Mantığı
-- ================================
local function StartFarm()
    task.spawn(function()
        while farming do
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.CharacterAdded:Wait()
                task.wait(1.5)
                char = LocalPlayer.Character
            end

            local root = char:WaitForChild("HumanoidRootPart")
            ClearMap()
            
            local bv = Instance.new("BodyVelocity")
            bv.Name = "FarmVelocity"
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Parent = root

            local endZone = Workspace.BoatStages.NormalStages.TheEnd.GoldenChest.Trigger
            
            -- Stage Checkpoints
            local path = {
                CFrame.new(-55, 80, 1500),
                CFrame.new(-55, 80, 4500),
                CFrame.new(-55, 80, 7500),
                CFrame.new(-55, 80, 9450),
                endZone.CFrame
            }

            for _, targetCF in ipairs(path) do
                if not farming then break end
                local dist = (root.Position - targetCF.Position).Magnitude
                local tween = TweenService:Create(root, TweenInfo.new(dist / 300, Enum.EasingStyle.Linear), {CFrame = targetCF})
                tween:Play()
                tween.Completed:Wait()
            end

            if farming then
                root.CFrame = endZone.CFrame
                task.wait(10)
                bv:Destroy()
                char:BreakJoints()
                task.wait(5)
            end
        end
    end)
end

-- ================================
-- Arayüz Sayfaları
-- ================================
local MainTab = Window:MakeTab({Name = "Ana Menü", Icon = "rbxassetid://4483345998"})
local PlayerTab = Window:MakeTab({Name = "Karakter", Icon = "rbxassetid://4483345998"})
local ShopTab = Window:MakeTab({Name = "Market", Icon = "rbxassetid://4483345998"})

MainTab:AddToggle({
	Name = "Otomatik Altın Kas (Farm)",
	Default = false,
	Callback = function(Value)
		farming = Value
		if farming then StartFarm() end
	end    
})

MainTab:AddButton({
	Name = "Haritayı Temizle (Bypass)",
	Callback = function() ClearMap() end
})

PlayerTab:AddSlider({
	Name = "Hız Ayarı",
	Min = 16,
	Max = 400,
	Default = 16,
	Callback = function(v) walkSpeed = v end    
})

PlayerTab:AddSlider({
	Name = "Zıplama Ayarı",
	Min = 50,
	Max = 800,
	Default = 50,
	Callback = function(v) jumpPower = v end    
})

PlayerTab:AddSlider({
	Name = "Yerçekimi",
	Min = 0,
	Max = 500,
	Default = 196,
	Callback = function(v) workspace.Gravity = v end    
})

PlayerTab:AddToggle({
	Name = "Noclip (Duvarlardan Geçme)",
	Default = false,
	Callback = function(v) noclipActive = v end    
})

RunService.RenderStepped:Connect(function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = walkSpeed
        LocalPlayer.Character.Humanoid.JumpPower = jumpPower
    end
end)

ShopTab:AddDropdown({
	Name = "Sandık Türü",
	Default = "None",
	Options = {"None", "Common Chest", "Uncommon Chest", "Rare Chest", "Epic Chest", "Legendary Chest"},
	Callback = function(v) autoBuyType = v end    
})

task.spawn(function()
    while true do
        if autoBuyType ~= "None" then
            workspace.ItemBoughtFromShop:FireServer(autoBuyType, 1)
        end
        task.wait(1.5)
    end
end)

-- Anti-AFK
local vu = game:GetService("VirtualUser")
LocalPlayer.Idled:Connect(function()
    vu:Button2Down(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
    task.wait(1)
    vu:Button2Up(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
end)

OrionLib:Init()
