        local controller = require(ReplicatedStorage.Modules.Client.UI.GamepassUnlockController)
        controller.OwnsGamepass = function() return true end
        SendNotif("Başarılı", "Tüm kilitler açıldı!")
    end)
end)

local PlayerTab = CreateTab("🏃 Oyuncu")
