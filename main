-- ======= CMDR Permission Bypass (Sınırlı; güvenli sarmalayıcı) =======
local function ApplyCmdrBypass()
    pcall(function()
        local CmdrPermPath = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Shared") and ReplicatedStorage.Modules.Shared:FindFirstChild("Cmdr") and ReplicatedStorage.Modules.Shared.Cmdr:FindFirstChild("CmdrPermissions")
        local MainPermPath = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Shared") and ReplicatedStorage.Modules.Shared:FindFirstChild("Permissions")

        if CmdrPermPath then
            local CmdrPermissions = safeRequire(CmdrPermPath)
            if CmdrPermissions then
                if type(CmdrPermissions.hasCmdrAccess) == "function" then CmdrPermissions.hasCmdrAccess = function() return true end end
                if type(CmdrPermissions.hasCommandAccess) == "function" then CmdrPermissions.hasCommandAccess = function() return true end end
            end
        end

        if MainPermPath then
            local MainPermissions = safeRequire(MainPermPath)
            if MainPermissions then
                local perms = {"hasAdminAccess", "hasContentCreatorAccess", "hasModeratorAccess", "hasStaffAccess"}
                for _, func in pairs(perms) do
                    if type(MainPermissions[func]) == "function" then
                        MainPermissions[func] = function() return true end
                    end
                end
            end
        end

        -- Cmdr client yüklemesi
        local CmdrClient = ReplicatedStorage:FindFirstChild("CmdrClient")
        if CmdrClient then
            local InstanceLoadingUtil = safeRequire(safeFind(ReplicatedStorage, "InstanceLoadingUtil") or ReplicatedStorage:FindFirstChild("InstanceLoadingUtil", true))
            local Promise = safeRequire(ReplicatedStorage:FindFirstChild("Packages") and ReplicatedStorage.Packages:FindFirstChild("Promise") or nil)
            if InstanceLoadingUtil and Promise and CmdrClient:FindFirstChild("Commands") and CmdrClient:FindFirstChild("Types") then
                -- try to ensure descendants loaded
                pcall(function()
                    InstanceLoadingUtil.waitForDescendantsToLoad(CmdrClient.Commands, 4)
                    InstanceLoadingUtil.waitForDescendantsToLoad(CmdrClient.Types, 4)
                end)
                local Cmdr = safeRequire(CmdrClient)
                if Cmdr and type(Cmdr.SetActivationKeys) == "function" then
                    Cmdr:SetActivationKeys({XenoSettings.MenuKey})
                    if type(Cmdr.Toggle) == "function" then pcall(function() Cmdr:Toggle() end) end
                    SendNotif("XenoHub", "FULL BYPASS: Tüm Admin Yetkileri Tanımlandı! (F2)")
                end
            end
        end
    end)
end

AddBtn(Home, "⚡ CMDR FULL BYPASS (F2)", ApplyCmdrBypass, XenoSettings.ThemeColor)

