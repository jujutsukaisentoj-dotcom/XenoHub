local Home = NewTab("🏠 Ana Sayfa")
local Farm = NewTab("💰 Auto-Farm")
local Player = NewTab("🏃 Oyuncu")
local Items = NewTab("🎒 Eşyalar")

-- HOME
AddBtn(Home, "⚡ CMDR FULL ADMIN (F2)", function()
    pcall(function()
        InjectBypasses()
        local Cmdr = require(ReplicatedStorage.CmdrClient)
        Cmdr:SetActivationKeys({Enum.KeyCode.F2})
        Cmdr:Toggle()
    end)
end, Color3.fromRGB(145, 90, 230))

AddBtn(Home, "🔓 PREMIUM & GAMEPASS AKTİF", InjectBypasses, Color3.fromRGB(145, 90, 230))

-- FARM (Yeni Bölüm)
AddBtn(Farm, "💎 OTOMATİK SOYGUN MODU: KAPALI", function(btn)
    XenoSettings.AutoRob = not XenoSettings.AutoRob
    btn.Text = "💎 OTOMATİK SOYGUN MODU: " .. (XenoSettings.AutoRob and "AÇIK" or "KAPALI")
    btn.BackgroundColor3 = XenoSettings.AutoRob and Color3.fromRGB(34, 139, 34) or Color3.fromRGB(25, 25, 30)
    if XenoSettings.AutoRob then SendNotif("XenoHub", "Kasa avı başladı!") end
end)

AddBtn(Farm, "🔍 TÜM KASALARI TESPİT ET", function()
    local s = GetSafes()
    SendNotif("XenoHub", "Haritada " .. #s .. " adet aktif kasa bulundu!")
end, Color3.fromRGB(0, 120, 200))

AddBtn(Farm, "🚀 EN YAKIN KASAYA IŞINLAN", function()
    local safes = GetSafes()
    if #safes > 0 then
        RobSafe(safes[1])
    else
        SendNotif("XenoHub", "Kasa bulunamadı!")
    end
end)

-- PLAYER
AddBtn(Player, "⚡ Hız (100)", function() lp.Character.Humanoid.WalkSpeed = 100 end)
AddBtn(Player, "🚀 Zıplama (150)", function() lp.Character.Humanoid.JumpPower = 150 end)

-- ITEMS
