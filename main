--[[ 
    XENOHUB - BUILD A BOAT FOR TREASURE (OFFICIAL GOLD FARM)
    Bu script paylaştığınız linkteki 'Gold-Farming' mantığı ile optimize edilmiştir.
    Özellikler: Sürekli Bypass, Hızlı Altın, Otomatik Reset, Menü Gizleme (F).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local lp = Players.LocalPlayer
local targetParent = (gethui and gethui()) or CoreGui

-- ============================================================================== --
-- AYARLAR VE DURUM
-- ============================================================================== --
_G.AutoFarm = false
local Config = {
    FarmSpeed = 0.4, -- Bölümler arası hız
    AutoChest = true,
    AntiAfk = true
}

local Stages = workspace:WaitForChild("BoatStages"):WaitForChild("NormalStages")
local ClaimRemote = workspace:WaitForChild("ClaimRiverResultsGold")
local OtherData = lp:WaitForChild("OtherData")

-- ============================================================================== --
-- CORE BYPASS VE FARM MANTIĞI
-- ============================================================================== --

local function GetHRP(Char)
    return Char:WaitForChild("HumanoidRootPart", 5)
end

-- Sürekli Bypass: Karakterin fiziksel verilerini temizleyerek kicklenmeyi önler
local function BypassPhysics(Char)
    local hrp = GetHRP(Char)
    if hrp then
        hrp.Velocity = Vector3.new(0, 0, 0)
        hrp.RotVelocity = Vector3.new(0, 0, 0)
    end
end

local function StartMasterFarm()
    task.spawn(function()
        while _G.AutoFarm do
            local Char = lp.Character or lp.CharacterAdded:Wait()
            local Root = GetHRP(Char)
            local Hum = Char:WaitForChild("Humanoid")
            
            if not Root or not Hum then task.wait() continue end
            
            -- Ölüm Kontrolü
            local dead = false
            local dConn = Hum.Died:Connect(function() dead = true end)

            -- Bölüm Döngüsü (Stage 1-10)
            for i = 1, 10 do
                if not _G.AutoFarm or dead then break end
                
                local stageName = "CaveStage" .. i
                local targetStage = Stages:FindFirstChild(stageName)
                
                if targetStage and targetStage:FindFirstChild("DarknessPart") then
                    local part = targetStage.DarknessPart
                    
                    -- Teleport (Bypass Destekli)
                    local tween = TweenService:Create(Root, TweenInfo.new(Config.FarmSpeed, Enum.EasingStyle.Linear), {
                        CFrame = part.CFrame * CFrame.new(0, 50, 0)
                    })
                    
                    -- Hareket halindeyken sürekli bypass
                    local isMoving = true
                    task.spawn(function()
                        while isMoving and not dead do
                            BypassPhysics(Char)
                            task.wait()
                        end
                    end)

                    tween:Play()
                    tween.Completed:Wait()
                    isMoving = false

                    -- Altın Claim
                    ClaimRemote:FireServer()
                    
                    -- Stage Doğrulaması (Dex Sync)
                    local timeout = 0
                    repeat
                        task.wait(0.1)
                        timeout = timeout + 1
                    until (OtherData:FindFirstChild("Stage"..i) and OtherData["Stage"..i].Value ~= "") or dead or timeout > 20
                end
            end

            -- Hazine Odası Sonu
            if _G.AutoFarm and not dead then
                if Config.AutoChest then
                    local chest = Stages:FindFirstChild("TheEnd")
                    if chest and chest:FindFirstChild("GoldenChest") then
                        Root.CFrame = chest.GoldenChest.Trigger.CFrame
                        task.wait(0.5)
                    end
                end
                
                -- Karakteri resetle ve döngüyü yeniden başlat
                task.wait(1)
                Char:BreakJoints()
            end

            dConn:Disconnect()
            repeat task.wait() until lp.Character and GetHRP(lp.Character)
            task.wait(2) -- Spawn bekleme
        end
    end)
end

-- ============================================================================== --
-- MODERN HUB ARAYÜZÜ (UI)
-- ============================================================================== --

if targetParent:FindFirstChild("XenoHub_Gold") then targetParent.XenoHub_Gold:Destroy() end

local ScreenGui = Instance.new("ScreenGui", targetParent)
ScreenGui.Name = "XenoHub_Gold"

local Main = Instance.new("Frame", ScreenGui)
Main.Name = "Main"
Main.Size = UDim2.new(0, 250, 0, 280)
Main.Position = UDim2.new(0.5, -125, 0.5, -140)
Main.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
Main.BorderSizePixel = 0
Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 10)

local Header = Instance.new("Frame", Main)
Header.Size = UDim2.new(1, 0, 0, 40)
Header.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
Header.BorderSizePixel = 0
Instance.new("UICorner", Header)

local Title = Instance.new("TextLabel", Header)
Title.Size = UDim2.new(1, 0, 1, 0)
Title.BackgroundTransparency = 1
Title.Text = "XENOHUB GOLD FARMER"
Title.TextColor3 = Color3.fromRGB(0, 200, 255)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 14

local Container = Instance.new("ScrollingFrame", Main)
Container.Position = UDim2.new(0, 10, 0, 50)
Container.Size = UDim2.new(1, -20, 1, -60)
Container.BackgroundTransparency = 1
Container.CanvasSize = UDim2.new(0, 0, 0, 300)
Container.ScrollBarThickness = 2

local Layout = Instance.new("UIListLayout", Container)
Layout.Padding = UDim.new(0, 8)

local function NewButton(text, callback)
    local b = Instance.new("TextButton", Container)
    b.Size = UDim2.new(1, 0, 0, 40)
    b.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
    b.Text = text .. ": KAPALI"
    b.TextColor3 = Color3.new(0.8, 0.8, 0.8)
    b.Font = Enum.Font.Gotham
    b.TextSize = 12
    Instance.new("UICorner", b)
    
    local state = false
    b.MouseButton1Click:Connect(function()
        state = not state
        b.Text = text .. ": " .. (state and "AÇIK" or "KAPALI")
        b.TextColor3 = state and Color3.fromRGB(0, 255, 150) or Color3.new(0.8, 0.8, 0.8)
        b.BackgroundColor3 = state and Color3.fromRGB(40, 50, 45) or Color3.fromRGB(35, 35, 50)
        callback(state)
    end)
end

NewButton("Auto Farm (Gold)", function(s)
    _G.AutoFarm = s
    if s then StartMasterFarm() end
end)

NewButton("Hazineyi Otomatik Al", function(s)
    Config.AutoChest = s
end)

local ResetBtn = Instance.new("TextButton", Container)
ResetBtn.Size = UDim2.new(1, 0, 0, 40)
ResetBtn.BackgroundColor3 = Color3.fromRGB(70, 30, 30)
ResetBtn.Text = "Karakter Resetle"
ResetBtn.TextColor3 = Color3.new(1, 0.5, 0.5)
ResetBtn.Font = Enum.Font.GothamBold
ResetBtn.TextSize = 12
Instance.new("UICorner", ResetBtn)
ResetBtn.MouseButton1Click:Connect(function() if lp.Character then lp.Character:BreakJoints() end end)

-- UI Kontrolleri
Main.Active = true
Main.Draggable = true

UserInputService.InputBegan:Connect(function(i, p)
    if not p and i.KeyCode == Enum.KeyCode.F then
        Main.Visible = not Main.Visible
    end
end)

-- Anti-AFK Aktif Et
if Config.AntiAfk then
    lp.Idled:Connect(function()
        game:GetService("VirtualUser"):Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
        task.wait(1)
        game:GetService("VirtualUser"):Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    end)
end

game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "XenoHub Yüklendi",
    Text = "Menü için 'F' tuşuna basın.",
    Duration = 5
})
