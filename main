-- ===============================================================
-- 👑 GEMINI HUB V12 - GOD MODE & INFINITE FARM
-- 🚀 ALL GAMEPASS BYPASS + 999+ SIMULATOR + ALL MORPHS
-- ===============================================================

local Settings = {
    FarmEnabled = false,
    DoubleGold = true,
    AntiWater = true,
    AutoGoldBlock = true,
    WalkSpeed = 16,
    JumpPower = 50,
    MaxStages = 10,
    ChestStage = 11,
    TeleportSpeed = 0.05,
    AutoClaim = true
}

-- Servisler
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Data = LocalPlayer:WaitForChild("OtherData")
local Claim = Workspace:WaitForChild("ClaimRiverResultsGold")
local Stages = Workspace:WaitForChild("BoatStages"):WaitForChild("NormalStages")

-- [ TÜM GAMEPASS & MORPH BYPASS SİSTEMİ ]
-- Ekran görüntülerindeki tüm ürünleri (2x Gold, Penguin, Fox, Chicken vb.) kapsar
local function TriggerAllGamepassBypass()
    pcall(function()
        -- 1. Double Gold Bypass (Dex & Server)
        if Data:FindFirstChild("DoubleGold") then
            Data.DoubleGold.Value = true
        end
        if ReplicatedStorage:FindFirstChild("DoubleGoldGamepass") then
            ReplicatedStorage.DoubleGoldGamepass:FireServer(true)
        end

        -- 2. Morph & Transformation Bypass (Ekran görüntüsündeki Penguin, Fox, Chicken)
        local MorphList = {"Penguin", "Fox", "Chicken", "PenguinMorph", "FoxMorph", "ChickenMorph"}
        for _, morph in pairs(MorphList) do
            if Data:FindFirstChild(morph) then
                Data[morph].Value = true
            end
        end

        -- 3. Diğer Gamepass Değerlerini Dex'te True Yapma
        local PassList = {"DoubleMoney", "ExtraHealth", "RoyalMember", "MegaMember"}
        for _, pass in pairs(PassList) do
            if Data:FindFirstChild(pass) then
                Data[pass].Value = true
            end
        end

        -- 4. Sunucu Kontrolü Bypass
        if ReplicatedStorage:FindFirstChild("CheckGamepasses") then
            ReplicatedStorage.CheckGamepasses:InvokeServer()
        end
    end)
end

-- [ GUI OLUŞTURMA ]
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "Gemini_V12_Ultimate"
ScreenGui.Parent = (gethui and gethui()) or (game:GetService("CoreGui")) or LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 15)
MainFrame.Size = UDim2.new(0, 250, 0, 380) -- Boyut biraz artırıldı
MainFrame.Position = UDim2.new(0.05, 0, 0.2, 0)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 15)
UICorner.Parent = MainFrame

local Title = Instance.new("TextLabel")
Title.Parent = MainFrame
Title.Size = UDim2.new(1, 0, 0, 50)
Title.Text = "GEMINI ULTIMATE V12 👑"
Title.TextColor3 = Color3.fromRGB(255, 215, 0)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 18
Title.BackgroundColor3 = Color3.fromRGB(25, 25, 35)

local Corner2 = Instance.new("UICorner")
Corner2.CornerRadius = UDim.new(0, 15)
Corner2.Parent = Title

-- [ BUTON OLUŞTURUCU ]
local function CreateButton(name, pos, text, callback)
    local Btn = Instance.new("TextButton")
    Btn.Name = name
    Btn.Parent = MainFrame
    Btn.Position = pos
    Btn.Size = UDim2.new(0.9, 0, 0, 32)
    Btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    Btn.Text = text
    Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    Btn.Font = Enum.Font.GothamMedium
    Btn.TextSize = 11
    Btn.BorderSizePixel = 0
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = Btn
    
    Btn.Activated:Connect(function()
        callback(Btn)
    end)
    return Btn
end

-- Özellik Butonları
local FarmBtn = CreateButton("FarmBtn", UDim2.new(0.05, 0, 0.15, 0), "OTOMATİK FARM: KAPALI", function(self)
    Settings.FarmEnabled = not Settings.FarmEnabled
    self.Text = Settings.FarmEnabled and "OTOMATİK FARM: AÇIK" or "OTOMATİK FARM: KAPALI"
    self.BackgroundColor3 = Settings.FarmEnabled and Color3.fromRGB(0, 180, 80) or Color3.fromRGB(35, 35, 45)
end)

local PassBtn = CreateButton("PassBtn", UDim2.new(0.05, 0, 0.25, 0), "TÜM GAMEPASS'LERİ VER: AKTİF", function(self)
    TriggerAllGamepassBypass()
    self.Text = "GAMEPASS'LER VERİLDİ! ✅"
    self.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
end)
PassBtn.BackgroundColor3 = Color3.fromRGB(200, 150, 0)

CreateButton("WaterBtn", UDim2.new(0.05, 0, 0.35, 0), "ANTİ-SU HASARI: AÇIK", function(self)
    Settings.AntiWater = not Settings.AntiWater
    self.Text = Settings.AntiWater and "ANTİ-SU HASARI: AÇIK" or "ANTİ-SU HASARI: KAPALI"
end)

CreateButton("GoldBlockBtn", UDim2.new(0.05, 0, 0.45, 0), "ALTIN BLOĞU FARMI: AKTİF", function(self)
    Settings.AutoGoldBlock = not Settings.AutoGoldBlock
    self.Text = Settings.AutoGoldBlock and "ALTIN BLOĞU FARMI: AKTİF" or "ALTIN BLOĞU FARMI: PASİF"
end)

CreateButton("MorphBtn", UDim2.new(0.05, 0, 0.55, 0), "PENGUEN/FOX/CHICKEN AÇ", function(self)
    TriggerAllGamepassBypass()
    print("Dönüşüm özellikleri Dex üzerinde true yapıldı.")
end)

CreateButton("SpeedBtn", UDim2.new(0.05, 0, 0.65, 0), "HIZI ARTIR (100)", function()
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
    if hum then hum.WalkSpeed = 100 end
end)

CreateButton("ResetBtn", UDim2.new(0.05, 0, 0.75, 0), "KARAKTERİ SIFIRLA", function()
    if LocalPlayer.Character then LocalPlayer.Character:BreakJoints() end
end)

-- [ ANA SİSTEM FONKSİYONLARI ]

local function HasStage(Num)
    local val = Data:FindFirstChild(`Stage{Num}`)
    return val and val.Value ~= "" and val.Value
end

local function ClaimStage(Num)
    if not Settings.AutoClaim then return end
    task.spawn(function()
        local Value = Data:FindFirstChild(`Stage{Num}`)
        if Value and Value.Value == "" then
            Value:GetPropertyChangedSignal("Value"):Wait()
        end
        Claim:FireServer()
    end)
end

local function FarmLoop()
    while true do
        if Settings.FarmEnabled then
            local Char = LocalPlayer.Character
            local Root = Char and Char:FindFirstChild("HumanoidRootPart")
            
            if Root then
                TriggerAllGamepassBypass()
                
                local NewChar = false
                local charConn = LocalPlayer.CharacterAdded:Once(function() NewChar = true end)

                local BV = Instance.new("BodyVelocity", Root)
                BV.Velocity = Vector3.zero
                
                -- 10 BÖLGE SIRALI GEÇİŞ
                for i = 1, Settings.MaxStages do
                    if not Settings.FarmEnabled or NewChar then break end
                    
                    local StageFolder = Stages:FindFirstChild(`CaveStage{i}`)
                    if StageFolder and StageFolder:FindFirstChild("DarknessPart") then
                        local Target = StageFolder.DarknessPart
                        local Teleporting = true
                        
                        task.spawn(function()
                            while Teleporting and Settings.FarmEnabled and not NewChar do
                                Root.CFrame = Target.CFrame
                                Root.Velocity = Vector3.zero
                                task.wait()
                            end
                        end)
                        
                        ClaimStage(i)
                        
                        local timeout = tick()
                        repeat task.wait() until HasStage(i) or NewChar or not Settings.FarmEnabled or (tick() - timeout > 5)
                        
                        Teleporting = false
                        task.wait(Settings.TeleportSpeed)
                    end
                end
                
                -- 11. AŞAMA: SANDIK VE ALTIN BLOĞU
                if Settings.FarmEnabled and not NewChar then
                    local EndStage = Stages:FindFirstChild("TheEnd")
                    if EndStage and EndStage:FindFirstChild("GoldenChest") then
                        local Chest = EndStage.GoldenChest.Trigger
                        
                        local OldCFrame = Chest.CFrame
                        Chest.CFrame = Root.CFrame
                        
                        if firetouchinterest then
                            firetouchinterest(Root, Chest, 0)
                            task.wait(0.1)
                            firetouchinterest(Root, Chest, 1)
                        end
                        
                        task.wait(0.5)
                        Chest.CFrame = OldCFrame
                        
                        Claim:FireServer()
                        task.wait(2)
                        Char:BreakJoints()
                    end
                end
                
                if BV then BV:Destroy() end
                if charConn then charConn:Disconnect() end
            end
        end
        task.wait(1)
    end
end

-- Su hasarını engelleme
RunService.Stepped:Connect(function()
    if Settings.AntiWater and LocalPlayer.Character then
        pcall(function()
            for _, v in pairs(LocalPlayer.Character:GetChildren()) do
                if v:IsA("BasePart") then v.CanTouch = false end
            end
        end)
    end
end)

-- İlk Çalıştırma
TriggerAllGamepassBypass()
task.spawn(FarmLoop)
print("🚀 Gemini HUB V12 - All Pass Bypass Aktif!")
