local function SendNotif(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title;
            Text = text;
            Duration = 5;
        })
    end)
end

-- ============================================================================== --
-- 2. FULL GAMEPASS & PREMIUM BYPASS (Decompiled Verilere Göre)
-- ============================================================================== --

local function BypassAllGamepasses()
    pcall(function()
        -- GamepassUnlockController Hooking
        local GamepassUnlockController = require(ReplicatedStorage.Modules.Client.UI.GamepassUnlockController)
        local GamepassController = require(ReplicatedStorage.Modules.Client.PlayerData.GamepassController)
        local GamepassesModule = require(ReplicatedStorage.Modules.Shared.PlayerData.Gamepasses)

        -- 1. Gamepass Sahip mi Kontrolü Bypass
        GamepassController.PlayerOwnsGamepass = function() return true end
        GamepassController.OwnsGamepass = function() return true end
        
        -- 2. Unlock Controller Bypass
        GamepassUnlockController.OwnsGamepass = function() return true end
        GamepassUnlockController.IsPremium = function() return true end
        
        -- 3. Gamepasses.All tablosundaki her şeyi mülkiyet olarak işaretle
        if GamepassesModule and GamepassesModule.All then
            for passName, data in pairs(GamepassesModule.All) do
                if typeof(data) == "table" then
                    data.__OWNED = true -- İç işaretleme
                end
            end
        end

        SendNotif("XenoHub", "Tüm Gamepassler Açıldı! ✅")
    end)
end

-- ============================================================================== --
-- 3. SINIRSIZ ADSTORE & REKLAM SİSTEMİ (Infinite Ads Bypass)
-- ============================================================================== --

local function TriggerInfiniteAds()
    pcall(function()
        local AdsController = require(ReplicatedStorage.Modules.Client.Ads.AdvertisementsController)
        local AdJoinController = require(ReplicatedStorage.Modules.Client.Ads.AdvertisementJoinController)
        local PanelController = require(ReplicatedStorage.Modules.Client.UI.PanelController)
        
        -- Reklam Hazırlık Durumu Bypass (Her zaman hazır gösterir)
        AdsController.IsAdAvailable = function() return true end
        AdsController.GetRemainingCooldown = function() return 0 end
        AdsController.CanWatchVideoAd = function() return true end

        -- AdStore UI Tetikleme
        local MainGUI = PlayerGui:FindFirstChild("MainGUIHandler")
        if MainGUI then
            local adStore = MainGUI:FindFirstChild("AdStore", true)
            if adStore then
                adStore.Visible = true
                adStore.Active = true
                -- "Watch Video" butonlarını ve timer'ları zorla aktif et
                for _, v in pairs(adStore:GetDescendants()) do
                    if v.Name:find("Timer") or v.Name:find("Waiting") then v.Visible = false end
                    if v:IsA("GuiButton") then v.Visible = true v.Active = true end
                end
            end
        end

        -- Reklam İsteği Gönder (Video İzlemiş Gibi Ödül Verir)
        AdsController.RequestRewardedVideoAd("XenoInfinite", "rbxassetid://0", 0, "Infinite Reward", "Success", false, false)
        
        SendNotif("XenoHub", "Reklamlar Sınırsız & Beklemesiz! 📺")
    end)
end

-- ============================================================================== --
-- 4. RGB NAME/BIO & HAREKET SİSTEMİ
-- ============================================================================== --

RunService.RenderStepped:Connect(function()
    if XenoSettings.RGBEnabled then
        local hue = tick() * XenoSettings.RGBSpeed % 1
        local color = Color3.fromHSV(hue, 1, 1)
        local hex = color:ToHex()
        
        pcall(function()
            local remote = ReplicatedStorage:FindFirstChild("RE"):FindFirstChild("1Plr1Name1Chan1ge")
            if remote then
                remote:FireServer("UpdateName", lp.Name, hex)
                remote:FireServer("UpdateBio", "XenoHub | "..lp.Name, hex)
            end
        end)
    end
end)

-- Fly & Noclip Logic
RunService.Stepped:Connect(function()
    if XenoSettings.Noclip and lp.Character then
        for _, part in pairs(lp.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
end)

