local Settings = NewTab("⚙️ Ayarlar")

-- HOME PAGE
AddSection(Home, "ANA SİSTEMLER")
AddBtn(Home, "⚡ CMDR FULL BYPASS (F2)", function()
    pcall(function()
        local CmdrPermissions = require(ReplicatedStorage.Modules.Shared.Cmdr.CmdrPermissions)
        local MainPermissions = require(ReplicatedStorage.Modules.Shared.Permissions)
        CmdrPermissions.hasCmdrAccess = function() return true end
        CmdrPermissions.hasCommandAccess = function() return true end
        local perms = {"hasAdminAccess", "hasContentCreatorAccess", "hasModeratorAccess", "hasStaffAccess"}
        for _, func in pairs(perms) do MainPermissions[func] = function() return true end end
        local Cmdr = require(ReplicatedStorage:WaitForChild("CmdrClient"))
        Cmdr:SetActivationKeys({Enum.KeyCode.F2})
        Cmdr:Toggle()
        SendNotif("XenoHub", "Tüm Admin İzinleri Açıldı!")
    end)
end, Color3.fromRGB(145, 90, 230))

AddBtn(Home, "📺 FULL ADSTORE TETIKLE", TriggerFullADStore, Color3.fromRGB(0, 162, 255))

AddBtn(Home, "🔓 PREMIUM UNLOCK", function()
    pcall(function()
        local gpc = require(ReplicatedStorage.Modules.Client.UI.GamepassUnlockController)
        gpc.OwnsGamepass = function() return true end
        gpc.IsPremium = function() return true end
        SendNotif("XenoHub", "Premium Dex Aktif!")
    end)
end, Color3.fromRGB(145, 90, 230))

