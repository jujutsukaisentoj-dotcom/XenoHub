-- === TEMEL FONKSİYONLAR === --
local function SendNotif(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = 5
        })
    end)
end

-- === ADSTORE & REKLAM SİSTEMİ (BOZULMADAN AKTARILDI) === --
local function TriggerAdSystems()
    pcall(function()
        local re = ReplicatedStorage:FindFirstChild("RE")
        if re then
            -- ModalFireAsk & VideoAd Trigger
            local modalEvent = re:FindFirstChild("1Modal1Fire1Ask")
            local videoEvent = re:FindFirstChild("1Video1Ad1Even1t")
            
            if modalEvent then modalEvent:FireServer("Accepted", "VideoAd") end
            if videoEvent then videoEvent:FireServer("Finished") end
            
            -- ADStore Entegrasyonu
            local adStore = re:FindFirstChild("1AD1Stor1e")
            if adStore then
                adStore:FireServer("VideoReward", "PremiumUnlock")
            end
        end
    end)
end

