local PremiumPage = CreateTab("⭐ Premium")
AddButton(PremiumPage, "🔓 FULL PREMIUM UNLOCK", Color3.fromRGB(145, 90, 230), function()
    pcall(function()
        local GC = require(ReplicatedStorage.Modules.Client.UI.GamepassUnlockController)
        GC.OwnsGamepass = function() return true end
    end)
    SendNotif("Başarılı", "Premium kilitleri kaldırıldı!")
end)

-- MODAL TETİKLEYİCİ BUTON
AddButton(PremiumPage, "🔥 House Fire Kontrol", Color3.fromRGB(46, 204, 113), function()
    FireModal.Visible = not FireModal.Visible
end)

local ItemsPage = CreateTab("🎒 Eşyalar")
AddButton(ItemsPage, "💸 Money Gun", Color3.fromRGB(46, 204, 113), function() GetBrookhavenItem("MoneyGun") end)
AddButton(ItemsPage, "🆔 Ajan Kartı", nil, function() GetBrookhavenItem("AgencyCard") end)
AddButton(ItemsPage, "🚫 Ban Hammer", nil, function() GetBrookhavenItem("BanHammer") end)

local PlayerPage = CreateTab("🏃 Oyuncu")
AddButton(PlayerPage, "⚡ Speed 100", nil, function() if lp.Character then lp.Character.Humanoid.WalkSpeed = 100 end end)
AddButton(PlayerPage, "👻 Noclip", nil, function()
    RunService.Stepped:Connect(function()
        if lp.Character then
            for _, v in pairs(lp.Character:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
        end
    end)
end)

local TPPage = CreateTab("📍 Işınlanma")
local locs = {{"Spawn", CFrame.new(0, 10, 0)}, {"Banka", CFrame.new(21, 16, 35)}}
for _, v in ipairs(locs) do
    AddButton(TPPage, "✈️ " .. v[1], nil, function() TeleportTo(v[2]) end)
end

