    local lotC = require(ReplicatedStorage.Modules.Client.Lot.LotController)
    lotC.GetExtendableItems = function() return { {icon = "rbxassetid://0"} } end
    SendNotif("XenoHub", "Ev modülleri tetiklendi.")
end)
AddBtn(HouseTab, "🚫 EV BANINI KALDIR (Unban Me)", UnbanFromAllHouses, Color3.fromRGB(200, 50, 50))

local Settings = NewTab("⚙️ Ayarlar")
AddBtn(Settings, "🌈 RGB HIZI (+)", function() XenoSettings.RGBSpeed = XenoSettings.RGBSpeed + 0.5 end)
AddBtn(Settings, "🌈 RGB HIZI (-)", function() XenoSettings.RGBSpeed = math.max(0.1, XenoSettings.RGBSpeed - 0.5) end)
AddBtn(Settings, "❌ SCRIPTI KAPAT", function() XenoGui:Destroy() end, Color3.fromRGB(100, 20, 20))

-- TOGGLE BUTTON
local TButton = Instance.new("TextButton")
TButton.Size = UDim2.new(0, 60, 0, 60)
TButton.Position = UDim2.new(0, 40, 0.5, -30)
TButton.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
TButton.Text = "X"
TButton.TextColor3 = Color3.fromRGB(145, 90, 230)
TButton.Font = Enum.Font.GothamBlack
TButton.TextSize = 25
TButton.Parent = XenoGui
Instance.new("UICorner", TButton).CornerRadius = UDim.new(1, 0)
Instance.new("UIStroke", TButton).Color = Color3.fromRGB(145, 90, 230)
MakeDraggable(TButton)
TButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
    TButton.Text = MainFrame.Visible and "X" or "O"
end)

SendNotif("XenoHub ULTIMATE", "RGB, Car & House Bypass Yüklendi! 🚀")
