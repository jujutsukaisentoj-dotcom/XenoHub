--[[
    XENOHUB SAFE EDITION - BROOKHAVEN (CLEAN & STABLE)
    Rev: assistant (safe)
    Not: This script intentionally DOES NOT include server-side bypasses, gamepass/permission hacks,
         or any exploit that attempts to override paid/permissioned server logic.
    What it does:
      - Stable UI with tabs and buttons
      - Safe client-side attempts to open game panels (if the game's client controllers exist)
      - Local-only features: speed/jump change, local emote playback for emotes present in ReplicatedStorage.Emotes
      - Toggle UI, cleanup routine, debouncing, notifications
    Usage: Paste into a LocalScript (e.g., StarterPlayerScripts) or run with your executor.
]]

-- Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local lp = Players.LocalPlayer
local PlayerGui = lp:WaitForChild("PlayerGui")
local ParentFolder = (gethui and gethui()) or CoreGui

-- Safety flag to avoid double-loading
_G.XENO_SAFE_LOADED = _G.XENO_SAFE_LOADED or false
if _G.XENO_SAFE_LOADED then
    warn("XenoHub Safe Edition already loaded. Aborting duplicate load.")
    return
end
_G.XENO_SAFE_LOADED = true

-- Helper: safe notification
local function SendNotif(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title or "XenoHub (Safe)",
            Text = text or "",
            Duration = duration or 3
        })
    end)
end

-- Debounce helper
local Debounces = {}
local function SafeCall(key, fn, delay)
    if Debounces[key] then return end
    Debounces[key] = true
    task.spawn(function()
        local ok, err = pcall(fn)
        if not ok then warn("SafeCall error for", key, err) end
        task.wait(delay or 0.25)
        Debounces[key] = false
    end)
end

-- Create main GUI
if ParentFolder:FindFirstChild("XenoHubSafe") then
    ParentFolder.XenoHubSafe:Destroy()
end

local XenoGui = Instance.new("ScreenGui")
XenoGui.Name = "XenoHubSafe"
XenoGui.ResetOnSpawn = false
XenoGui.Parent = ParentFolder

local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Size = UDim2.new(0, 680, 0, 460)
MainFrame.Position = UDim2.new(0.5, -340, 0.5, -230)
MainFrame.BackgroundColor3 = Color3.fromRGB(18,18,20)
MainFrame.Parent = XenoGui
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 10)

local function MakeDraggable(frame)
    local dragging, dragInput, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)
    RunService.RenderStepped:Connect(function()
        if dragging and dragInput then
            local delta = dragInput.Position - dragStart
            pcall(function()
                frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end)
        end
    end)
end
MakeDraggable(MainFrame)

-- Sidebar + content area
local SideBar = Instance.new("Frame", MainFrame)
SideBar.Size = UDim2.new(0, 170, 1, 0)
SideBar.Position = UDim2.new(0, 8, 0, 8)
SideBar.BackgroundColor3 = Color3.fromRGB(14,14,16)
local SideCorner = Instance.new("UICorner", SideBar)
SideCorner.CornerRadius = UDim.new(0,8)

local Content = Instance.new("Frame", MainFrame)
Content.Size = UDim2.new(1, -190, 1, -16)
Content.Position = UDim2.new(0, 182, 0, 8)
Content.BackgroundTransparency = 1

local pages = {}
local function NewTab(name)
    local index = #pages
    local btn = Instance.new("TextButton", SideBar)
    btn.Size = UDim2.new(0.9, 0, 0, 36)
    btn.Position = UDim2.new(0.05, 0, 0, 20 + (index * 44))
    btn.BackgroundColor3 = Color3.fromRGB(24,24,26)
    btn.Text = "  " .. name
    btn.Font = Enum.Font.GothamBold
    btn.TextColor3 = Color3.fromRGB(220,220,220)
    btn.TextSize = 13
    local corner = Instance.new("UICorner", btn); corner.CornerRadius = UDim.new(0,6)
    local page = Instance.new("ScrollingFrame", Content)
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ScrollBarThickness = 6
    Instance.new("UIListLayout", page).Padding = UDim.new(0,8)
    btn.MouseButton1Click:Connect(function()
        for _, p in pairs(pages) do p.page.Visible = false p.btn.BackgroundColor3 = Color3.fromRGB(24,24,26) p.btn.TextColor3 = Color3.fromRGB(220,220,220) end
        page.Visible = true
        btn.BackgroundColor3 = Color3.fromRGB(35,24,60)
        btn.TextColor3 = Color3.fromRGB(180,150,255)
    end)
    if index == 0 then
        page.Visible = true
        btn.BackgroundColor3 = Color3.fromRGB(35,24,60)
        btn.TextColor3 = Color3.fromRGB(180,150,255)
    end
    table.insert(pages, {btn = btn, page = page})
    return page
end

local function AddBtn(parent, text, cb, color)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(0.96, 0, 0, 40)
    b.BackgroundColor3 = color or Color3.fromRGB(30,30,34)
    b.Text = text
    b.Font = Enum.Font.GothamBold
    b.TextColor3 = Color3.fromRGB(1,1,1)
    local c = Instance.new("UICorner", b); c.CornerRadius = UDim.new(0,6)
    b.MouseButton1Click:Connect(function() SafeCall(text, cb) end)
    return b
end

-- Tabs
local Home = NewTab("Ana Sayfa")
local PlayerTab = NewTab("Player")
local EmotesTab = NewTab("Emotes")
local Settings = NewTab("Ayarlar")

-- Home content
AddBtn(Home, "AdStore (Client UI open)", function()
    -- attempt to open AdStore via PanelController if present (client-only)
    pcall(function()
        local ok, PanelController = pcall(function()
            return ReplicatedStorage:FindFirstChild("Modules") and require(ReplicatedStorage.Modules.Client.UI.PanelController)
        end)
        if ok and PanelController and type(PanelController.OpenPanelByContext) == "function" then
            PanelController.OpenPanelByContext("MainGUIHandler", "AdStore")
            SendNotif("XenoHub (Safe)", "Tried to open AdStore panel (client-side).")
        else
            SendNotif("XenoHub (Safe)", "PanelController not found (client).")
        end
    end)
end, Color3.fromRGB(0,162,255))

AddBtn(Home, "Open ModalFireAsk (client)", function()
    -- reveal ModalFireAsk frame if present (client only)
    pcall(function()
        local found = nil
        for _,v in pairs(PlayerGui:GetDescendants()) do
            if v.Name == "ModalFireAsk" and (v:IsA("Frame") or v:IsA("ImageLabel")) then
                found = v; break
            end
        end
        if found then
            found.Visible = true
            SendNotif("XenoHub (Safe)", "ModalFireAsk revealed (client).")
        else
            SendNotif("XenoHub (Safe)", "ModalFireAsk not found.")
        end
    end)
end, Color3.fromRGB(255,120,0))

-- Player tab buttons (local only)
AddBtn(PlayerTab, "Speed: + (100)", function()
    if lp.Character and lp.Character:FindFirstChild("Humanoid") then
        lp.Character.Humanoid.WalkSpeed = 100
        SendNotif("XenoHub (Safe)", "WalkSpeed set to 100 (local).")
    end
end, Color3.fromRGB(145,90,230))

AddBtn(PlayerTab, "Reset Speed/Jump", function()
    if lp.Character and lp.Character:FindFirstChild("Humanoid") then
        lp.Character.Humanoid.WalkSpeed = 16
        lp.Character.Humanoid.JumpPower = 50
        SendNotif("XenoHub (Safe)", "Speed and Jump reset (local).")
    end
end, Color3.fromRGB(100,100,100))

AddBtn(PlayerTab, "Jump: + (150)", function()
    if lp.Character and lp.Character:FindFirstChild("Humanoid") then
        lp.Character.Humanoid.JumpPower = 150
        SendNotif("XenoHub (Safe)", "JumpPower set to 150 (local).")
    end
end, Color3.fromRGB(145,90,230))

-- Emotes tab (local playback for emotes present in ReplicatedStorage.Emotes)
AddBtn(EmotesTab, "Play Emote 6 (local)", function()
    pcall(function()
        local emotes = ReplicatedStorage:FindFirstChild("Emotes")
        if not emotes then SendNotif("XenoHub (Safe)", "Emotes folder not found.") return end
        local e = emotes:FindFirstChild("6")
        if not e then SendNotif("XenoHub (Safe)", "Emote '6' not present in Emotes.") return end
        local anim = e:FindFirstChildWhichIsA("Animation", true)
        if not anim then SendNotif("XenoHub (Safe)", "Animation not found in Emote 6.") return end
        local char = lp.Character or lp.CharacterAdded:Wait()
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then SendNotif("XenoHub (Safe)", "Humanoid not found.") return end
        local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
        local track = animator:LoadAnimation(anim)
        track.Priority = Enum.AnimationPriority.Action
        track.Looped = true
        track:Play()
        SendNotif("XenoHub (Safe)", "Playing Emote 6 (local).")
    end)
end, Color3.fromRGB(40,170,90))

AddBtn(EmotesTab, "Play Emote 7 (local)", function()
    pcall(function()
        local emotes = ReplicatedStorage:FindFirstChild("Emotes")
        if not emotes then SendNotif("XenoHub (Safe)", "Emotes folder not found.") return end
        local e = emotes:FindFirstChild("7")
        if not e then SendNotif("XenoHub (Safe)", "Emote '7' not present in Emotes.") return end
        local anim = e:FindFirstChildWhichIsA("Animation", true)
        if not anim then SendNotif("XenoHub (Safe)", "Animation not found in Emote 7.") return end
        local char = lp.Character or lp.CharacterAdded:Wait()
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then SendNotif("XenoHub (Safe)", "Humanoid not found.") return end
        local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
        local track = animator:LoadAnimation(anim)
        track.Priority = Enum.AnimationPriority.Action
        track.Looped = true
        track:Play()
        SendNotif("XenoHub (Safe)", "Playing Emote 7 (local).")
    end)
end, Color3.fromRGB(40,170,90))

-- Settings
AddBtn(Settings, "Cleanup & Unload", function()
    pcall(function()
        if XenoGui then XenoGui:Destroy() end
        _G.XENO_SAFE_LOADED = false
        SendNotif("XenoHub (Safe)", "Cleaned up UI and unloaded.")
    end)
end, Color3.fromRGB(200,50,50))

-- Small toggle button
local ToggleBtn = Instance.new("TextButton", ParentFolder == CoreGui and CoreGui or PlayerGui)
ToggleBtn.Size = UDim2.new(0, 60, 0, 60)
ToggleBtn.Position = UDim2.new(0, 40, 0.5, -30)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(20,20,24)
ToggleBtn.Text = "X"
ToggleBtn.TextColor3 = Color3.fromRGB(180,150,255)
ToggleBtn.Font = Enum.Font.GothamBlack
ToggleBtn.TextSize = 22
Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(1,0)
ToggleBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
    ToggleBtn.Text = MainFrame.Visible and "X" or "O"
end)

-- Status label
local Status = Instance.new("TextLabel", MainFrame)
Status.Size = UDim2.new(0, 300, 0, 22)
Status.Position = UDim2.new(1, -320, 1, -36)
Status.BackgroundTransparency = 1
Status.TextColor3 = Color3.fromRGB(180,180,180)
Status.Font = Enum.Font.Gotham
Status.TextSize = 12

RunService:BindToRenderStep("XenoSafeStatus", Enum.RenderPriority.UI.Value, function()
    Status.Text = "Safe UI Loaded | Client-only features available"
end)

SendNotif("XenoHub (Safe)", "Safe edition loaded. No bypass functions included.", 4)

-- Expose cleanup for manual UNLOAD
_G.XenoSafeCleanup = function()
    pcall(function()
        if XenoGui then XenoGui:Destroy() end
        if ToggleBtn then ToggleBtn:Destroy() end
        _G.XENO_SAFE_LOADED = false
    end)
end

