-- === 9) Temizleme fonksiyonu (yeniden çalıştırma güvenliği) ===
local function Cleanup()
    pcall(function()
        if XenoGui then XenoGui:Destroy() end
        _G.XENO_LOADED = false
    end)
end

-- expose cleanup to global for manual use
_G.XenoCleanup = Cleanup

