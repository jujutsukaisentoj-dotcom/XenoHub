-- ===============================================================
-- 👑 GEMINI HUB V8 - ULTIMATE BUILD A BOAT FARM
-- 🚀 10 STAGE + 11. SANDIK + 2X GOLD MAX BYPASS
-- ===============================================================

local Settings = {
    FarmEnabled = false,
    DoubleGold = true,
    AntiWater = true,
    MaxStages = 10, -- 10 bölge geçilecek
    ChestStage = 11, -- 11. sandık alınacak
    TeleportSpeed = 0.01,
    AutoClaim = true
}

-- Servisler
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Data = LocalPlayer:WaitForChild("OtherData")
local Claim = Workspace:WaitForChild("ClaimRiverResultsGold")
local Stages = Workspace:WaitForChild("BoatStages"):WaitForChild("NormalStages")

-- [ 2X GOLD & DATA BYPASS ]
-- Oyunun çarpan sistemini ve Dex üzerinden görünen değerleri manipüle eder
local function EnableDoubleGold()
    if Settings.DoubleGold then
        pcall(function()
            -- Veri klasöründeki çarpanı zorla aktif et
            if Data:FindFirstChild("DoubleGold") then
                Data.DoubleGold.Value = true
            end
            -- ReplicatedStorage üzerinden 2x tetikleyici sinyallerini gönder
            if ReplicatedStorage:FindFirstChild("DoubleGoldGamepass") then
                ReplicatedStorage.DoubleGoldGamepass:FireServer(true)
            end
        end)
    end
end

-- [ GUI OLUŞTURMA ]
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "Gemini_V8"
ScreenGui.Parent = (gethui and gethui()) or (game:GetService("CoreGui")) or LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
MainFrame.Size = UDim2.new(0, 220, 0, 260)
MainFrame.Position = UDim2.new(0.05, 0, 0.3, 0)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 12)
UICorner.Parent = MainFrame

local Title = Instance.new("TextLabel")
Title.Parent = MainFrame
Title.Size = UDim2.new(1, 0, 0, 45)
Title.Text = "GEMINI HUB V8 👑"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 16
Title.BackgroundColor3 = Color3.fromRGB(30, 0, 100)

local Corner2 = Instance.new("UICorner")
Corner2.CornerRadius = UDim.new(0, 12)
Corner2.Parent = Title

-- [ BUTONLAR ]
local function CreateButton(name, pos, text, callback)
    local Btn = Instance.new("TextButton")
    Btn.Name = name
    Btn.Parent = MainFrame
    Btn.Position = pos
    Btn.Size = UDim2.new(0.9, 0, 0, 38)
    Btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    Btn.Text = text
    Btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    Btn.Font = Enum.Font.GothamMedium
    Btn.TextSize = 13
    Btn.BorderSizePixel = 0
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = Btn
    
    Btn.Activated:Connect(function()
        callback(Btn)
    end)
    return Btn
end

-- Farm Butonu
local FarmBtn = CreateButton("FarmBtn", UDim2.new(0.05, 0, 0.22, 0), "AUTO FARM: KAPALI", function(self)
    Settings.FarmEnabled = not Settings.FarmEnabled
    if Settings.FarmEnabled then
        self.Text = "AUTO FARM: AÇIK"
        self.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        self.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        self.Text = "AUTO FARM: KAPALI"
        self.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        self.TextColor3 = Color3.fromRGB(220, 220, 220)
    end
end)

-- Double Gold Butonu
local GoldBtn = CreateButton("GoldBtn", UDim2.new(0.05, 0, 0.40, 0), "2X GOLD: AKTİF (BYPASS)", function(self)
    Settings.DoubleGold = not Settings.DoubleGold
    if Settings.DoubleGold then
        self.Text = "2X GOLD: AKTİF (BYPASS)"
        self.BackgroundColor3 = Color3.fromRGB(220, 160, 0)
        EnableDoubleGold()
    else
        self.Text = "2X GOLD: PASİF"
        self.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    end
end)
GoldBtn.BackgroundColor3 = Color3.fromRGB(220, 160, 0)

-- Anti Water Butonu
CreateButton("WaterBtn", UDim2.new(0.05, 0, 0.58, 0), "ANTİ-SU HASARI: AÇIK", function(self)
    Settings.AntiWater = not Settings.AntiWater
    self.Text = Settings.AntiWater and "ANTİ-SU HASARI: AÇIK" or "ANTİ-SU HASARI: KAPALI"
end)

-- [ FONKSİYONLAR ]

local function HasStage(Num)
    local val = Data:FindFirstChild(`Stage{Num}`)
    return val and val.Value ~= "" and val.Value
end

local function FarmLoop()
    while true do
        if Settings.FarmEnabled then
            local Char = LocalPlayer.Character
            local Root = Char and Char:FindFirstChild("HumanoidRootPart")
            
            if Root then
                EnableDoubleGold()
                
                -- Karakteri sabitle
                local BV = Instance.new("BodyVelocity", Root)
                BV.Velocity = Vector3.new(0,0,0)
                
                -- 10 Bölgeyi Hızla Geç
                for i = 1, Settings.MaxStages do
                    if not Settings.FarmEnabled then break end
                    
                    local Stage = Stages:FindFirstChild(`CaveStage{i}`)
                    if Stage and Stage:FindFirstChild("DarknessPart") then
                        Root.CFrame = Stage.DarknessPart.CFrame
                        -- Her stage'de altın alımını tetikle
                        Claim:FireServer()
                        task.wait(Settings.TeleportSpeed)
                    end
                end
                
                -- 11. Stage: Sandık Sonu
                if Settings.FarmEnabled then
                    local EndStage = Stages:FindFirstChild("TheEnd")
                    if EndStage and EndStage:FindFirstChild("GoldenChest") then
                        local Chest = EndStage.GoldenChest.Trigger
                        Root.CFrame = Chest.CFrame
                        
                        -- Sandık dokunma bypass (Firetouch veya CFrame)
                        if firetouchinterest then
                            firetouchinterest(Root, Chest, 0)
                            task.wait(0.1)
                            firetouchinterest(Root, Chest, 1)
                        else
                            Chest.CFrame = Root.CFrame
                            task.wait(0.2)
                        end
                        
                        -- Ekstra kazanç tetikleyici
                        Claim:FireServer()
                        task.wait(1.2)
                        Char:BreakJoints()
                    end
                end
                if BV then BV:Destroy() end
            end
        end
        task.wait(1)
    end
end

-- Anti Water (Su Hasarını Kapatma)
RunService.Stepped:Connect(function()
    if Settings.AntiWater and LocalPlayer.Character then
        pcall(function()
            for _, v in pairs(LocalPlayer.Character:GetChildren()) do
                if v:IsA("BasePart") then v.CanTouch = false end
            end
        end)
    end
end)

-- Başlatma Sinyali
task.spawn(FarmLoop)
print("🚀 Gemini Hub V8 - 2X Gold Simulator & Auto Farm Aktif!")
