local function SafeTriggerTool(toolName)
    pcall(function()
        local re = ReplicatedStorage:FindFirstChild("RE") or ReplicatedStorage:FindFirstChild("RemoteEvents") or ReplicatedStorage
        -- Olası isim varyasyonlarını kontrol et
        for _, candidate in pairs(re:GetDescendants()) do
            if candidate.Name:lower():find(toolName:lower()) and candidate:IsA("RemoteEvent") then
                pcall(function() candidate:FireServer(lp) end)
                return
            end
        end

        -- Fallback: ortak bir event adı varsa gönder
        local common = re:FindFirstChild("1Playe1rTrigge1rEven1t") or re:FindFirstChild("GetItem")
        if common and common:IsA("RemoteEvent") then
            pcall(function() common:FireServer("AcceptedToolToServer", toolName, lp) end)
        end
    end)
end

for _, item in pairs(items_list) do
    AddBtn(Items, "🛠️ Get: " .. item[2], function() SafeTriggerTool(item[1]) end)
end

