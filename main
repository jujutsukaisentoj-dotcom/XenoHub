-- ============================================================================== --
-- 3. ÖZEL SİSTEMLER (MODAL & HOUSE FIRE)
-- ============================================================================== --

local function CreateFireModal()
    local ModalFrame = Instance.new("Frame")
    ModalFrame.Name = "ModalFireAsk"
    ModalFrame.Size = UDim2.new(0, 300, 0, 180)
    ModalFrame.Position = UDim2.new(0.5, -150, 0.5, -90)
    ModalFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    ModalFrame.BorderSizePixel = 0
    ModalFrame.Parent = XenoGui
    ModalFrame.Visible = false
    ModalFrame.ZIndex = 10

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = ModalFrame

    local ModalTitle = Instance.new("TextLabel")
    ModalTitle.Size = UDim2.new(1, 0, 0, 50)
    ModalTitle.BackgroundTransparency = 1
    ModalTitle.Text = "Yangın Kontrolü"
    ModalTitle.TextColor3 = Color3.new(1, 1, 1)
    ModalTitle.Font = Enum.Font.GothamBold
    ModalTitle.TextSize = 18
    ModalTitle.Parent = ModalFrame

    local Desc = Instance.new("TextLabel")
    Desc.Size = UDim2.new(1, 0, 0, 40)
    Desc.Position = UDim2.new(0, 0, 0, 45)
    Desc.BackgroundTransparency = 1
    Desc.Text = "Evleri yakmak mı yoksa söndürmek mi istersiniz?"
    Desc.TextColor3 = Color3.fromRGB(200, 200, 200)
    Desc.Font = Enum.Font.GothamMedium
    Desc.TextSize = 12
    Desc.TextWrapped = true
    Desc.Parent = ModalFrame

    -- Yeşim Buton (YAK)
    local BurnBtn = Instance.new("TextButton")
    BurnBtn.Size = UDim2.new(0, 120, 0, 40)
    BurnBtn.Position = UDim2.new(0.08, 0, 0.65, 0)
    BurnBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
    BurnBtn.Text = "YAK 🔥"
    BurnBtn.TextColor3 = Color3.new(1, 1, 1)
    BurnBtn.Font = Enum.Font.GothamBold
    BurnBtn.Parent = ModalFrame
    Instance.new("UICorner", BurnBtn).CornerRadius = UDim.new(0, 6)

    -- Kırmızı Buton (DURDUR)
    local StopBtn = Instance.new("TextButton")
    StopBtn.Size = UDim2.new(0, 120, 0, 40)
    StopBtn.Position = UDim2.new(0.55, 0, 0.65, 0)
    StopBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
    StopBtn.Text = "SÖNDÜR 💧"
    StopBtn.TextColor3 = Color3.new(1, 1, 1)
    StopBtn.Font = Enum.Font.GothamBold
    StopBtn.Parent = ModalFrame
    Instance.new("UICorner", StopBtn).CornerRadius = UDim.new(0, 6)

    local function ExecuteFire(state)
        local re = ReplicatedStorage:FindFirstChild("RE") or ReplicatedStorage:FindFirstChild("Remotes")
        if not re then return end
        
        local msg = state and "Evler yakılıyor..." or "Yangınlar söndürülüyor..."
        SendNotif("XenoHub", msg, 2)

        for i = 1, 30 do
            task.spawn(function()
                pcall(function()
                    re.RemoteEvent:FireServer("HouseSettings", "Fire", state)
                    if state then
                        SendNotif("Bilgi", "Ev No: " .. tostring(i) .. " yaniyor! 🔥", 1)
                    end
                end)
            end)
            task.wait(0.02)
        end
        ModalFrame.Visible = false
    end

    BurnBtn.MouseButton1Click:Connect(function() ExecuteFire(true) end)
    StopBtn.MouseButton1Click:Connect(function() ExecuteFire(false) end)

    return ModalFrame
end

local FireModal = CreateFireModal()

local function GetBrookhavenItem(itemName)
    local rep = game:GetService("ReplicatedStorage")
    local ok, err = pcall(function()
        local re = rep:FindFirstChild("RE") or rep:FindFirstChild("Remotes") or rep
        local trigger = re:FindFirstChild("1Playe1rTrigge1rEven1t")
        if trigger then
            trigger:FireServer("AcceptedToolToServer", itemName, lp)
            SendNotif("Envanter", itemName.." başarıyla alındı! 🎒")
        end
    end)
end

local function TeleportTo(cframe)
    if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
        lp.Character.HumanoidRootPart.CFrame = cframe
    end
end

-- ============================================================================== --
-- 4. TAB & COMPONENT SİSTEMİ
-- ============================================================================== --

local tabs = {}
local function CreateTab(name)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(0.9, 0, 0, 38)
    tabBtn.Position = UDim2.new(0.05, 0, 0, 70 + (#tabs * 42))
    tabBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
    tabBtn.BackgroundTransparency = 1
    tabBtn.Text = "  " .. name
    tabBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextSize = 13
    tabBtn.TextXAlignment = Enum.TextXAlignment.Left
    tabBtn.Parent = SideBar
    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 6)

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.ScrollBarThickness = 2
    page.Visible = false
    page.Parent = TabContainer
    
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 10)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = page
    
    tabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.page.Visible = false
            t.btn.BackgroundTransparency = 1
            t.btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
        page.Visible = true
        tabBtn.BackgroundTransparency = 0.8
        tabBtn.TextColor3 = Color3.fromRGB(145, 90, 230)
    end)
    
    if #tabs == 0 then 
        page.Visible = true 
        tabBtn.BackgroundTransparency = 0.8
        tabBtn.TextColor3 = Color3.fromRGB(145, 90, 230)
    end
    table.insert(tabs, {btn = tabBtn, page = page})
    return page
end

local function AddButton(parent, text, color, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.98, 0, 0, 42)
    btn.BackgroundColor3 = color or Color3.fromRGB(30, 30, 35)
    btn.Text = text
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 14
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    btn.MouseButton1Click:Connect(function() pcall(callback) end)
end

