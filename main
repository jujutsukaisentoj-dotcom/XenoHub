--[[ 
    XENOHUB - BUILD A BOAT FOR TREASURE (PRO LOOP EDITION)
    Entegre Edilen Mantık: rqccc's scripts
    Özellikler: Auto Farm (Stages 1-11), Auto Chest, Anti-Die, Auto Loop.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local lp = Players.LocalPlayer

-- ============================================================================== --
-- AYARLAR VE DEĞİŞKENLER
-- ============================================================================== --
local Config = {
    AutoFarm = true,
    TouchChest = true,
    AutoClaim = true,
    ChestStage = 10, -- 10. aşama genellikle hazine öncesi sondur
}

local Stages = workspace:WaitForChild("BoatStages"):WaitForChild("NormalStages")
local ClaimRemote = workspace:WaitForChild("ClaimRiverResultsGold")
local GoldenChestTrigger = Stages:WaitForChild("TheEnd"):WaitForChild("GoldenChest"):WaitForChild("Trigger")
local OtherData = lp:WaitForChild("OtherData")

-- ============================================================================== --
-- YARDIMCI FONKSİYONLAR (RQCCC LOGIC)
-- ============================================================================== --

local function HasStage(Num)
    local stageVal = OtherData:FindFirstChild("Stage" .. Num)
    return stageVal and stageVal.Value ~= "" and stageVal.Value
end

local function ClaimStageReward()
    if not Config.AutoClaim then return end
    ClaimRemote:FireServer()
end

local function Notify(title, text)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = title;
        Text = text;
        Duration = 3;
    })
end

-- ============================================================================== --
-- ANA FARM DÖNGÜSÜ
-- ============================================================================== --

local function StartFarm()
    local Char = lp.Character or lp.CharacterAdded:Wait()
    local Root = Char:WaitForChild("HumanoidRootPart")
    
    Notify("XenoHub", "Farm Başlatıldı - Hazineye Gidiliyor...")

    local isNewChar = false
    local conn
    conn = lp.CharacterAdded:Connect(function()
        isNewChar = true
        conn:Disconnect()
    end)

    -- 1'den 10'a kadar olan tüm aşamaları (Stages) geç
    for i = 1, 10 do
        if not Config.AutoFarm or isNewChar then break end
        
        local stageName = "CaveStage" .. i
        local targetStage = Stages:FindFirstChild(stageName)
        
        if targetStage and targetStage:FindFirstChild("DarknessPart") then
            local targetPart = targetStage.DarknessPart
            local teleporting = true

            -- Teleport Mantığı (Hız Kesme Dahil)
            task.spawn(function()
                while teleporting and not isNewChar do
                    Root.CFrame = targetPart.CFrame
                    for _, part in pairs(Char:GetChildren()) do
                        if part:IsA("BasePart") then
                            part.Velocity = Vector3.new(0,0,0)
                            part.RotVelocity = Vector3.new(0,0,0)
                        end
                    end
                    task.wait()
                end
            end)

            -- Hazine Kontrolü
            if i == Config.ChestStage and Config.TouchChest then
                task.spawn(function()
                    -- Hazineyi karakterin yanına çek (Xeno Bypass)
                    local oldCFrame = GoldenChestTrigger.CFrame
                    GoldenChestTrigger.CFrame = Root.CFrame
                    task.wait(0.5)
                    GoldenChestTrigger.CFrame = oldCFrame
                    
                    ClaimStageReward()
                    Notify("Başarılı", i .. ". Bölüm ve Hazine Alındı!")
                end)
            else
                ClaimStageReward()
            end

            -- Bölümün sunucu tarafından onaylanmasını bekle (Anti-Ban/Anti-Cheat)
            if i < 10 then
                repeat task.wait() until HasStage(i) or isNewChar
            end
            
            teleporting = false
            task.wait(0.1) -- Küçük bir bekleme (Stabilite için)
        end
    end

    -- Döngü Sonu: Karakteri sıfırla ki yeni tur başlasın
    if Config.AutoFarm and not isNewChar then
        task.wait(2)
        Notify("XenoHub", "Tur Tamamlandı. Yeniden Başlatılıyor...")
        if lp.Character then
            lp.Character:BreakJoints() -- Reset
        end
    end
end

-- ============================================================================== --
-- OTOMATİK BAŞLATMA
-- ============================================================================== --

lp.CharacterAdded:Connect(function()
    if Config.AutoFarm then
        task.wait(1) -- Spawn koruması bekleme
        StartFarm()
    end
end)

-- İlk çalıştırma
if Config.AutoFarm then
    StartFarm()
end

-- UI Paneli (Gerekirse Kapatabilirsin)
Notify("XenoHub V20", "Build A Boat Farm Aktif!")
