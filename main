-- =========================================================
-- BABFT GOD MODE + rqccc ULTRA FARM (V12 FINAL)
-- =========================================================

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("BABFT - God & Farm Hub", "Midnight")

-- SERVICES
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Data = LocalPlayer:WaitForChild("OtherData")
local Claim = workspace:WaitForChild("ClaimRiverResultsGold")
local Stages = workspace.BoatStages.NormalStages
local GoldenChest = Stages.TheEnd.GoldenChest.Trigger

-- SETTINGS
local AutoFarmActive = false
local GodModeActive = false
local WaterWalkActive = false
local NoClipActive = false
local WalkSpeedValue = 16
local JumpPowerValue = 50

-- DEX TRUE & NOTIFICATION
local function ApplyUltimateDex()
    local passes = {"GoldPass", "VIP", "Member", "DoubleGold", "DoubleMoney", "ExtraBoatSlot"}
    for _, name in pairs(passes) do
        if not LocalPlayer:FindFirstChild(name) then
            local val = Instance.new("BoolValue", LocalPlayer)
            val.Name = name
            val.Value = true
        end
    end
    Library:Notify("SİSTEM", "Tüm özelliklere sahipsin! Dex: True Aktif.", "Success")
end

-- TABS
local FarmTab = Window:NewTab("Auto Farm")
local PlayerTab = Window:NewTab("Player Mods")
local FarmSection = FarmTab:NewSection("rqccc Pro Farm")
local ModSection = PlayerTab:NewSection("God & Movement")

-- [PLAYER MODS] - SUDA YÜRÜME VE HASARSIZLIK
task.spawn(function()
    RunService.Stepped:Connect(function()
        local Char = LocalPlayer.Character
        if not Char then return end
        
        -- Suda Yürüme & Hasar Engelleme (Water Walk/God Mode)
        if WaterWalkActive or GodModeActive then
            if workspace:FindFirstChild("Water") then
                workspace.Water.CanCollide = WaterWalkActive
                workspace.Water.Size = WaterWalkActive and Vector3.new(1000, 20, 1000) or Vector3.new(0,0,0) -- Suyu platform yapar
            end
            if Char:FindFirstChild("Humanoid") then
                Char.Humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, not WaterWalkActive)
            end
        end

        -- NoClip (Hoclip)
        if NoClipActive then
            for _, Part in pairs(Char:GetChildren()) do
                if Part:IsA("BasePart") then
                    Part.CanCollide = false
                end
            end
        end

        -- Hız ve Zıplama Güncelleme
        if Char:FindFirstChild("Humanoid") then
            Char.Humanoid.WalkSpeed = WalkSpeedValue
            Char.Humanoid.JumpPower = JumpPowerValue
        end
    end)
end)

-- [FARM LOGIC]
local function HasStage(Num)
    return Data[`Stage{Num}`].Value ~= "" and Data[`Stage{Num}`].Value
end

local function ClaimStage(Num)
    task.spawn(function()
        local Value = Data[`Stage{Num}`]
        if not Value then Value:GetPropertyChangedSignal("Value"):Wait() end
        Claim:FireServer()
    end)
end

local function StartFarm()
    while AutoFarmActive do
        local Char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local Root = Char:WaitForChild("HumanoidRootPart")
        local NewChar = false
        local conn = LocalPlayer.CharacterAdded:Once(function() NewChar = true end)

        for i = 1, 10 do
            if not AutoFarmActive or NewChar then break end
            local TargetPart = Stages[`CaveStage{i}`].DarknessPart
            local Teleporting = true

            task.spawn(function()
                while Teleporting and AutoFarmActive do
                    Root.CFrame = TargetPart.CFrame
                    Root.Velocity = Vector3.zero
                    Root.RotVelocity = Vector3.zero
                    task.wait()
                end
            end)

            task.wait(4.5) 
            ClaimStage(i)
            repeat task.wait(0.5) until HasStage(i) or NewChar or not AutoFarmActive
            Teleporting = false
        end

        if AutoFarmActive and not NewChar then
            Root.CFrame = GoldenChest.CFrame
            task.wait(1)
            GoldenChest.CFrame = Root.CFrame
            task.wait(2)
            Char:BreakJoints()
            task.wait(8)
        end
        if conn then conn:Disconnect() end
    end
end

-- [UI CONTROLS]
FarmSection:NewToggle("AUTO FARM BAŞLAT", "rqccc Pro Farm + Dex True", function(state)
    AutoFarmActive = state
    if state then
        ApplyUltimateDex()
        task.spawn(StartFarm)
    end
end)

ModSection:NewToggle("Suda Yürüme (Jesus Mode)", "Su üstünde yürürsün", function(state) WaterWalkActive = state end)
ModSection:NewToggle("NoClip (Hoclip)", "Duvarların içinden geçersin", function(state) NoClipActive = state end)
ModSection:NewSlider("WalkSpeed (Hız)", "Karakter hızını ayarla", 500, 16, function(s) WalkSpeedValue = s end)
ModSection:NewSlider("JumpPower (Zıplama)", "Zıplama gücünü ayarla", 500, 50, function(s) JumpPowerValue = s end)

ModSection:NewButton("God Mode (Hasar Engelleme)", "Suda ve engellerde hasar almazsın", function()
    local Char = LocalPlayer.Character
    if Char and Char:FindFirstChild("Humanoid") then
        Char.Humanoid.MaxHealth = 999999
        Char.Humanoid.Health = 999999
        Library:Notify("God Mode", "Canın Maksimum Yapıldı!", "Success")
    end
end)

-- MOBILE TOGGLE
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local Btn = Instance.new("TextButton", ScreenGui)
Btn.Size, Btn.Position = UDim2.new(0,80,0,35), UDim2.new(0,20,0,200)
Btn.Text = "MENU"
Btn.BackgroundColor3 = Color3.fromRGB(0, 255, 150)
Btn.Draggable = true
Btn.MouseButton1Click:Connect(function() Library:ToggleUI() end)
