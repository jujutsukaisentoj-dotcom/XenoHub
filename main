-- ============================================================================== --
-- 7. NEW ADAPTIVE TOGGLE BUTTON (MOBILE & PC)
-- ============================================================================== --

local function CreateXenoToggle()
    local isMobile = UserInputService.TouchEnabled
    
    local ToggleButton = Instance.new("TextButton")
    ToggleButton.Name = "XenoToggle"
    ToggleButton.Parent = XenoGui
    ToggleButton.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    ToggleButton.BorderSizePixel = 0
    -- Mobil ise daha büyük, PC ise orta boy
    ToggleButton.Size = isMobile and UDim2.new(0, 65, 0, 65) or UDim2.new(0, 50, 0, 50)
    ToggleButton.Position = isMobile and UDim2.new(0.02, 0, 0.45, 0) or UDim2.new(0.01, 0, 0.5, -25)
    ToggleButton.Text = "" -- Logo gelecek
    ToggleButton.ZIndex = 10

    local ToggleCorner = Instance.new("UICorner", ToggleButton)
    ToggleCorner.CornerRadius = UDim.new(1, 0)

    local ToggleStroke = Instance.new("UIStroke", ToggleButton)
    ToggleStroke.Color = Color3.fromRGB(145, 90, 230)
    ToggleStroke.Thickness = 2
    ToggleStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    -- Parlama Efekti (ImageLabel ile Soft Glow)
    local Glow = Instance.new("ImageLabel")
    Glow.Name = "Glow"
    Glow.BackgroundTransparency = 1
    Glow.Position = UDim2.new(-0.5, 0, -0.5, 0)
    Glow.Size = UDim2.new(2, 0, 2, 0)
    Glow.Image = "rbxassetid://5028857084"
    Glow.ImageColor3 = Color3.fromRGB(145, 90, 230)
    Glow.ImageTransparency = 0.6
    Glow.ZIndex = 9
    Glow.Parent = ToggleButton

    -- X Logo / Icon
    local Icon = Instance.new("TextLabel")
    Icon.Size = UDim2.new(1, 0, 1, 0)
    Icon.BackgroundTransparency = 1
    Icon.Text = "X"
    Icon.TextColor3 = Color3.new(1, 1, 1)
    Icon.Font = Enum.Font.GothamBlack
    Icon.TextSize = isMobile and 30 or 22
    Icon.ZIndex = 11
    Icon.Parent = ToggleButton

    -- Animasyonlar
    ToggleButton.MouseEnter:Connect(function()
        TweenService:Create(ToggleButton, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(30, 30, 40)}):Play()
        TweenService:Create(ToggleStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(180, 140, 255)}):Play()
    end)
    ToggleButton.MouseLeave:Connect(function()
        TweenService:Create(ToggleButton, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(15, 15, 20)}):Play()
        TweenService:Create(ToggleStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(145, 90, 230)}):Play()
    end)

    ToggleButton.MouseButton1Click:Connect(function()
        MainFrame.Visible = not MainFrame.Visible
        -- Click Animasyonu
        local push = TweenService:Create(ToggleButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true), {Size = ToggleButton.Size - UDim2.new(0,5,0,5)})
        push:Play()
        Icon.Text = MainFrame.Visible and "X" or "X"
    end)

    MakeDraggable(ToggleButton)
end

CreateXenoToggle()
SendNotif("XenoHub v9.5", "Sistem Yüklendi! Menü Butonu Sol Tarafta.")
