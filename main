-- ============================================================================== --
-- RUNTIME LOOPS
-- ============================================================================== --

RunService.RenderStepped:Connect(function()
    -- ESP Loop
    if Config.EspActive then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= lp and p.Character then
                local h = p.Character:FindFirstChild("XenoHighlight") or Instance.new("Highlight", p.Character)
                h.Name = "XenoHighlight"
                h.FillColor = Config.Theme
                h.OutlineColor = Color3.new(1,1,1)
            end
        end
    else
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("XenoHighlight") then
                p.Character.XenoHighlight:Destroy()
            end
        end
    end
end)

-- Sürükleme (Drag) Logic
local dragging, dragInput, dragStart, startPos
Main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)
Main.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)
RunService.Heartbeat:Connect(function()
    if dragging and dragInput then
        local delta = dragInput.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Toggle Button
