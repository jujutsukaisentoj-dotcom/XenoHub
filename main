-- === SAFE HELPERS (SUNUCUYA MÜDAHALE YOK) ===
local function SafeInvokeRemote(remote, ...)
    -- Güvenlik: burada sadece pcall ile çağırma yapılır; bypass yok.
    pcall(function()
        if remote and type(remote.FireServer) == "function" then
            remote:FireServer(...)
        end
    end)
end

-- === 1) ADSTORE TRIGGER (GÜVENLİ) ===
local function TriggerFullADStoreSafe()
    -- Bu fonksiyon client-side UI'ı açmaya ve client kontrollerine "Check" isteği göndermeye çalışır.
    -- NOT: Sunucuya premium/unlock talimatı göndermeye çalışmıyoruz.
    pcall(function()
        local ok, AdsController = pcall(function() return require(ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules.Client and ReplicatedStorage.Modules.Client.Ads and ReplicatedStorage.Modules.Client.Ads.AdvertisementsController) end)
        local ok2, PanelController = pcall(function() return require(ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules.Client and ReplicatedStorage.Modules.Client.UI and ReplicatedStorage.Modules.Client.UI.PanelController) end)

        -- yalnızca client-side panel açma
        if ok2 and PanelController and type(PanelController.OpenPanelByContext) == "function" then
            pcall(function() PanelController.OpenPanelByContext("MainGUIHandler", "AdStore") end)
            XenoCore.Status.Ads = true
            SendNotif("XenoHub", "AdStore paneli açıldı (client).")
        else
            SendNotif("XenoHub", "AdStore paneli açılamadı (PanelController bulunamadı).")
        end

        -- Eğer AdsController varsa, denemek için sadece client-side check çağırıyoruz (sunucu bypass yok)
        if ok and AdsController and type(AdsController.CheckAd) == "function" then
            pcall(function() AdsController.CheckAd() end)
            SendNotif("XenoHub", "AdController: Check ad çalıştırıldı (client-side attempt).")
        end
    end)
end

-- === 2) Modal Fire (GÜVENLİ) ===
local function OpenOriginalFireModalSafe()
    pcall(function()
        local found = nil
        for _,v in pairs(PlayerGui:GetDescendants()) do
            if v.Name == "ModalFireAsk" and (v:IsA("Frame") or v:IsA("ImageLabel")) then
                found = v
                break
            end
        end

        if found then
            found.Visible = true
            found.Active = true
            SendNotif("XenoHub", "ModalFireAsk açıldı (client).")
            -- Butonlara bağlama (sadece client-side event)
            for _,btn in pairs(found:GetDescendants()) do
                if btn:IsA("GuiButton") then
                    if btn.Name:lower():find("yes") or (btn.BackgroundColor3 == Color3.fromRGB(34,139,34)) then
                        btn.MouseButton1Click:Connect(function()
                            SendNotif("XenoHub", "Modal içinden 'Yes' tıklandı (client). Sunucuya doğrudan tetikleme yapılmadı).")
                        end)
                    end
                end
            end
        else
            SendNotif("XenoHub", "ModalFireAsk bulunamadı (client).")
        end
    end)
end

-- === 3) CMDR SAFE (CLIENT-ONLY VISUAL) ===
local function SetupCmdrSafe()
    pcall(function()
        -- Deneme: CmdrClient'ı yükle (sadece toggle UI client-side)
        local ok, CmdrClient = pcall(function() return ReplicatedStorage:FindFirstChild("CmdrClient") and require(ReplicatedStorage:FindFirstChild("CmdrClient")) end)
        if ok and CmdrClient then
            XenoCore.Status.Cmdr = true
            SendNotif("XenoHub", "Cmdr client yüklendi (viewer).")
            -- Note: gerçek izin fonksiyonlarına müdahale etmiyoruz.
        else
            SendNotif("XenoHub", "Cmdr client yüklenemedi.")
        end
    end)
end

