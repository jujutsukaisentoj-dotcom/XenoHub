    {"MoneyGun",   "Money Gun 💸🔫 (Para Tabancası)"},
    {"Glider",     "Glider 🪂 (Planör)"},
    {"Chainsaw",   "Chainsaw 🪚 (Testere)"},
}
for _, item in pairs(items_list) do
    AddBtn(ItemsTab, "🛠️ Get: " .. item[2], function() SafeTriggerToolLocal(item[1]) end)
end

