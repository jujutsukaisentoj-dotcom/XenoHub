-- =========================================================
-- rqccc TETİKLİ (STEP-BY-STEP) FARM & DEX: TRUE
-- =========================================================

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("BABFT - rqccc Tetikli Panel", "Midnight")

-- SERVICES & DATA
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Data = LocalPlayer:WaitForChild("OtherData")
local Claim = workspace:WaitForChild("ClaimRiverResultsGold")
local Stages = workspace.BoatStages.NormalStages
local GoldenChest = Stages.TheEnd.GoldenChest.Trigger

-- STATS
local StartGold = LocalPlayer.Data.Gold.Value
local ChestCount = 0
local FarmingInProgress = false

-- DEX TRUE ENJECTOR
local function ApplyDexTrue()
    local passes = {"GoldPass", "VIP", "Member", "DoubleGold", "DoubleMoney"}
    for _, name in pairs(passes) do
        local val = Instance.new("BoolValue", LocalPlayer)
        val.Name = name
        val.Value = true
    end
    Library:Notify("SİSTEM", "Tüm özelliklere sahipsin! (Dex: True)", "Success")
end

-- UI SETUP
local MainTab = Window:NewTab("Farm")
local Section = MainTab:NewSection("Bölüm Bölüm Tetikleyici")

local goldLabel = Section:NewLabel("Mevcut Altın: " .. StartGold)
local chestLabel = Section:NewLabel("Sandık Sayısı: 0")
local statusLabel = Section:NewLabel("Statü: Beklemede...")

-- rqccc FUNCTIONS
local function HasStage(Num)
    return Data[`Stage{Num}`].Value ~= "" and Data[`Stage{Num}`].Value
end

local function ClaimStage(Num)
    task.spawn(function()
        local Value = Data[`Stage{Num}`]
        if not Value then Value:GetPropertyChangedSignal("Value"):Wait() end
        Claim:FireServer()
    end)
end

-- STEP BY STEP FARM (TETİKLİ)
local function StartTetikliFarm()
    if FarmingInProgress then return end
    FarmingInProgress = true
    
    local Char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local Root = Char:WaitForChild("HumanoidRootPart")

    -- 1'DEN 10'A KADAR SIRAYLA (HER BÖLÜM BEKLEYEREK)
    for i = 1, 10 do
        statusLabel:UpdateLabel("Durum: Bölüm " .. i .. " Geçiliyor...")
        
        local TargetPart = Stages[`CaveStage{i}`].DarknessPart
        local Teleporting = true

        -- rqccc Velocity Bypass Loop
        task.spawn(function()
            while Teleporting do
                Root.CFrame = TargetPart.CFrame
                for _, Part in Char:GetChildren() do
                    if Part:IsA("BasePart") then
                        Part.Velocity = Vector3.zero
                        Part.RotVelocity = Vector3.zero
                    end
                end
                task.wait()
            end
        end)

        -- BÖLÜM ARASI BEKLEME (TETİKLEME SÜRESİ)
        task.wait(5) 
        ClaimStage(i)
        
        -- Sunucu Onayı Bekle
        repeat task.wait(0.5) until HasStage(i)
        Teleporting = false
        statusLabel:UpdateLabel("Durum: Bölüm " .. i .. " Tamam!")
        task.wait(1)
    end

    -- 11. BÖLÜM (SON SANDIK)
    statusLabel:UpdateLabel("Durum: SON SANDIK ALINIYOR...")
    Root.CFrame = GoldenChest.CFrame
    task.wait(1)
    GoldenChest.CFrame = Root.CFrame
    task.wait(2)
    
    ChestCount = ChestCount + 1
    chestLabel:UpdateLabel("Sandık Sayısı: " .. ChestCount)
    statusLabel:UpdateLabel("Durum: Tur Bitti!")
    
    task.wait(2)
    Char:BreakJoints()
    FarmingInProgress = false
end

-- UI BUTTONS
Section:NewButton("FARM BAŞLAT (1-11 Sırayla)", "Basınca bölümleri sırayla geçer", function()
    ApplyDexTrue()
    task.spawn(StartTetikliFarm)
end)

-- STATS UPDATER
task.spawn(function()
    while task.wait(1) do
        goldLabel:UpdateLabel("Mevcut Altın: " .. LocalPlayer.Data.Gold.Value)
    end
end)

-- MOBILE MENU
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local Btn = Instance.new("TextButton", ScreenGui)
Btn.Size, Btn.Position = UDim2.new(0,80,0,35), UDim2.new(0,10,0,150)
Btn.Text = "MENU"
Btn.BackgroundColor3 = Color3.fromRGB(255, 85, 0)
Btn.TextColor3 = Color3.new(1,1,1)
Btn.MouseButton1Click:Connect(function() Library:ToggleUI() end)
