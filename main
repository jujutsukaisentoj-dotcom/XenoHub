local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local lp = Players.LocalPlayer
local PlayerGui = lp:WaitForChild("PlayerGui")
local ParentFolder = (gethui and gethui()) or CoreGui

-- ============================================================================== --
-- 1. İTEM ALMA & FIRESERVER FONKSİYONU (BOZULMADI, GÜÇLENDİRİLDİ)
-- ============================================================================== --
local function SafeTriggerTool(tool)
    pcall(function()
        local re = ReplicatedStorage:FindFirstChild("RE")
        local event = re and re:FindFirstChild("1Playe1rTrigge1rEven1t")
        if event then 
            -- Sunucuya itemi aldığımızı zorla kabul ettiriyoruz
            event:FireServer("AcceptedToolToServer", tool, lp) 
            StarterGui:SetCore("SendNotification", {Title = "Xeno", Text = tool .. " Alındı!", Duration = 2})
        end
    end)
end

local function LaunchDex()
    pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/infyiff/backup/main/dex.lua"))() end)
end

-- ============================================================================== --
-- 2. MASTER TRIGGER (PASSES & ADS & REWARDS)
-- ============================================================================== --
local function MasterTrigger()
    pcall(function()
        local GpassUnlock = require(ReplicatedStorage.Modules.Client.UI.GamepassUnlockController)
        local GpassController = require(ReplicatedStorage.Modules.Client.PlayerData.GamepassController)
        local Ads = require(ReplicatedStorage.Modules.Client.Ads.AdvertisementsController)
        
        -- Kökten Bypass
        GpassController.OwnsGamepass = function() return true end
        GpassController.PlayerOwnsGamepass = function() return true end
        GpassUnlock.IsPremium = function() return true end
        Ads.IsAdAvailable = function() return true end
        Ads.CanWatchVideoAd = function() return true end
        Ads.GetRemainingCooldown = function() return 0 end

        -- SÜREKLİ FIRESERVER DÖNGÜSÜ (Arka Planda Tetikler)
        task.spawn(function()
            while task.wait(2) do
                local re = ReplicatedStorage:FindFirstChild("RE")
                if re then
                    -- Reklam ve Ödül Sinvallerini Gönder
                    if re:FindFirstChild("1Ads1Even1t") then
                        re["1Ads1Even1t"]:FireServer("RewardedVideoComplete", "Xeno_Reward")
                    end
                    -- Hız ve Araba Sinvallerini Gönder
                    if re:FindFirstChild("1Vehi1cleEven1t") then
                        re["1Vehi1cleEven1t"]:FireServer("UpdateVehicleSpeed", 250)
                    end
                end
            end
        end)
        
        StarterGui:SetCore("SendNotification", {Title = "XenoHub", Text = "FireServer & Passler Aktif!", Duration = 3})
    end)
end

-- ============================================================================== --
-- 3. UI TASARIMI (GÜNCELLENDİ VE İTEMLER EKLENDİ)
-- ============================================================================== --
if ParentFolder:FindFirstChild("XenoBrookhaven") then ParentFolder.XenoBrookhaven:Destroy() end

local XenoGui = Instance.new("ScreenGui")
XenoGui.Name = "XenoBrookhaven"
XenoGui.Parent = ParentFolder
XenoGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 600, 0, 480)
MainFrame.Position = UDim2.new(0.5, -300, 0.5, -240)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
MainFrame.Parent = XenoGui
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 10)
Instance.new("UIStroke", MainFrame).Color = Color3.fromRGB(130, 0, 255)

-- Sidebar
local Sidebar = Instance.new("Frame")
Sidebar.Size = UDim2.new(0, 180, 1, 0)
Sidebar.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
Sidebar.Parent = MainFrame
Instance.new("UICorner", Sidebar).CornerRadius = UDim.new(0, 10)

local TabContainer = Instance.new("Frame")
TabContainer.Size = UDim2.new(1, -190, 1, -10)
TabContainer.Position = UDim2.new(0, 185, 0, 5)
TabContainer.BackgroundTransparency = 1
TabContainer.Parent = MainFrame

local pages = {}
local function NewTab(name)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 40)
    btn.Position = UDim2.new(0.05, 0, 0, 50 + (#pages * 45))
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    btn.Text = name
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.Parent = Sidebar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local pg = Instance.new("ScrollingFrame")
    pg.Size = UDim2.new(1, 0, 1, 0)
    pg.BackgroundTransparency = 1
    pg.Visible = false
    pg.ScrollBarThickness = 2
    pg.Parent = TabContainer
    Instance.new("UIListLayout", pg).Padding = UDim.new(0, 8)

    btn.MouseButton1Click:Connect(function()
        for _, p in pairs(pages) do p.pg.Visible = false end
        pg.Visible = true
    end)
    if #pages == 0 then pg.Visible = true end
    table.insert(pages, {btn = btn, pg = pg})
    return pg
end

local function AddBtn(p, text, cb, color)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0.95, 0, 0, 42)
    b.BackgroundColor3 = color or Color3.fromRGB(30, 30, 35)
    b.Text = text
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.Parent = p
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.MouseButton1Click:Connect(cb)
end

-- SAYFALARI OLUŞTUR
local MainTab = NewTab("🔥 ANA MENÜ")
AddBtn(MainTab, "🚀 MASTER TRIGGER & FIRESERVER", MasterTrigger, Color3.fromRGB(130, 0, 255))
AddBtn(MainTab, "📂 DEX EXPLORER AÇ", LaunchDex, Color3.fromRGB(0, 120, 255))

local ItemTab = NewTab("🛠️ İTEMLER (TRIGGER)")
local items = {
    {"MoneyGun", "Money Gun 💸"},
    {"Glider", "Glider 🪂"},
    {"Chainsaw", "Chainsaw 🪚"},
    {"Scythe", "Scythe ☠️"},
    {"UraniumRod", "Uranium ☢️"},
    {"AgencyBook", "Agency Book 📘"}
}
for _, item in pairs(items) do
    AddBtn(ItemTab, "GET: " .. item[2], function() SafeTriggerTool(item[1]) end)
end

local PlayerTab = NewTab("🏃 OYUNCU")
AddBtn(PlayerTab, "⚡ WalkSpeed 100", function() lp.Character.Humanoid.WalkSpeed = 100 end)
AddBtn(PlayerTab, "🚀 Fly Modu", function() loadstring(game:HttpGet("https://raw.githubusercontent.com/XNEOFF/FlyGui/main/FlyGui.lua"))() end)

-- DRAGGABLE ICON
local TButton = Instance.new("TextButton")
TButton.Size = UDim2.new(0, 55, 0, 55)
TButton.Position = UDim2.new(0, 20, 0.5, -27)
TButton.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
TButton.Text = "X"
TButton.TextColor3 = Color3.fromRGB(130, 0, 255)
TButton.Font = Enum.Font.GothamBold
TButton.TextSize = 25
TButton.Parent = XenoGui
Instance.new("UICorner", TButton).CornerRadius = UDim.new(1, 0)

TButton.MouseButton1Click:Connect(function() MainFrame.Visible = not MainFrame.Visible end)

-- UI Draggable
local d = false
local s, p
TButton.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then d = true s = i.Position p = TButton.Position end end)
UserInputService.InputChanged:Connect(function(i) if d and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then local delta = i.Position - s TButton.Position = UDim2.new(p.X.Scale, p.X.Offset + delta.X, p.Y.Scale, p.Y.Offset + delta.Y) end end)
UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then d = false end end)

StarterGui:SetCore("SendNotification", {Title = "XenoHub V19", Text = "İtemler ve Triggerlar Hazır!", Duration = 4})
