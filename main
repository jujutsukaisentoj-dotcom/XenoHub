-- === BYPASS LOGIC === --
AddButton(BypassTab, "☢️ CMDR FULL BYPASS", Color3.fromRGB(120, 50, 200), function()
    pcall(function()
        local CmdrClient = ReplicatedStorage:WaitForChild("CmdrClient")
        local Commands = CmdrClient:WaitForChild("Commands")
        local Perms = require(ReplicatedStorage.Modules.Shared.Cmdr.CmdrPermissions)
        Perms.AllPassesFetched = false
        Perms.hasCmdrAccess = function() return true end
        for _, m in pairs(Commands:GetDescendants()) do
            if m:IsA("ModuleScript") then
                local d = require(m)
                if type(d) == "table" then d.Patched = false d.Enabled = true end
            end
        end
        require(CmdrClient):SetActivationKeys({Enum.KeyCode.F2})
        SendNotif("XenoHub", "Cmdr Bypass Başarılı! (F2)")
    end)
end)

-- === ITEM LOGIC === --
local function SafeTrigger(tool)
    pcall(function()
        local re = ReplicatedStorage:FindFirstChild("RE")
        local event = re and re:FindFirstChild("1Playe1rTrigge1rEven1t")
        if event then event:FireServer("AcceptedToolToServer", tool, lp) end
    end)
end

