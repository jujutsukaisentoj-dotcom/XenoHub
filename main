local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")

local lp = Players.LocalPlayer

-- ============================================================================== --
-- 1. ARAYÜZ TEMİZLİĞİ & HAZIRLIK
-- ============================================================================== --

if CoreGui:FindFirstChild("XenoBrookhaven") then
    CoreGui.XenoBrookhaven:Destroy()
end

local XenoGui = Instance.new("ScreenGui")
XenoGui.Name = "XenoBrookhaven"
XenoGui.Parent = CoreGui
XenoGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- Blur Effect
local blur = Instance.new("BlurEffect")
blur.Size = 0
blur.Parent = game:GetService("Lighting")
TweenService:Create(blur, TweenInfo.new(0.5), {Size = 15}):Play()

-- Bildirim Sistemi
function SendNotif(title, text, duration)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = title;
        Text = text;
        Duration = duration or 3;
    })
end

-- ============================================================================== --
-- 2. ANA PANEL (DRAGGABLE)
-- ============================================================================== --

local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Size = UDim2.new(0, 550, 0, 380)
MainFrame.Position = UDim2.new(0.5, -275, 0.5, -190)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
MainFrame.BorderSizePixel = 0
MainFrame.ClipsDescendants = true
MainFrame.Parent = XenoGui

Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 12)

-- Sürükleme Mantığı
local dragging, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)
MainFrame.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)

-- SideBar & Content
local SideBar = Instance.new("Frame")
SideBar.Size = UDim2.new(0, 140, 1, 0)
SideBar.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
SideBar.Parent = MainFrame
Instance.new("UICorner", SideBar).CornerRadius = UDim.new(0, 12)

local TabContainer = Instance.new("Frame")
TabContainer.Size = UDim2.new(1, -160, 1, -20)
TabContainer.Position = UDim2.new(0, 150, 0, 10)
TabContainer.BackgroundTransparency = 1
TabContainer.Parent = MainFrame

local Title = Instance.new("TextLabel")
Title.Text = "XENOHUB"
Title.Size = UDim2.new(1, 0, 0, 50)
Title.BackgroundTransparency = 1
Title.TextColor3 = Color3.fromRGB(145, 90, 230)
Title.Font = Enum.Font.GothamBlack
Title.TextSize = 24
Title.Parent = SideBar

-- ============================================================================== --
-- 3. MODAL FIRE ASK SİSTEMİ (FULL TRIGGER & BYPASS)
-- ============================================================================== --

local function CreateFireModal()
    local ModalFrame = Instance.new("Frame")
    ModalFrame.Name = "ModalFireAsk"
    ModalFrame.Size = UDim2.new(0, 320, 0, 200)
    ModalFrame.Position = UDim2.new(0.5, -160, 0.5, -100)
    ModalFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    ModalFrame.BorderSizePixel = 0
    ModalFrame.Parent = XenoGui
    ModalFrame.Visible = false -- Başlangıçta kapalı
    ModalFrame.ZIndex = 100

    Instance.new("UICorner", ModalFrame).CornerRadius = UDim.new(0, 15)
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(145, 90, 230)
    stroke.Thickness = 2
    stroke.Parent = ModalFrame

    local ModalTitle = Instance.new("TextLabel")
    ModalTitle.Size = UDim2.new(1, 0, 0, 50)
    ModalTitle.BackgroundTransparency = 1
    ModalTitle.Text = "🔥 House Fire System"
    ModalTitle.TextColor3 = Color3.new(1, 1, 1)
    ModalTitle.Font = Enum.Font.GothamBold
    ModalTitle.TextSize = 20
    ModalTitle.Parent = ModalFrame

    local Desc = Instance.new("TextLabel")
    Desc.Size = UDim2.new(0.9, 0, 0, 60)
    Desc.Position = UDim2.new(0.05, 0, 0, 50)
    Desc.BackgroundTransparency = 1
    Desc.Text = "Tüm evleri yakmak için YEŞİL, söndürmek için KIRMIZI butona basınız."
    Desc.TextColor3 = Color3.fromRGB(200, 200, 200)
    Desc.Font = Enum.Font.GothamMedium
    Desc.TextSize = 13
    Desc.TextWrapped = true
    Desc.Parent = ModalFrame

    -- Yeşim Buton (YAK & TRIGGER & BYPASS)
    local BurnBtn = Instance.new("TextButton")
    BurnBtn.Size = UDim2.new(0, 130, 0, 45)
    BurnBtn.Position = UDim2.new(0.07, 0, 0.7, 0)
    BurnBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
    BurnBtn.Text = "YAK"
    BurnBtn.TextColor3 = Color3.new(1, 1, 1)
    BurnBtn.Font = Enum.Font.GothamBold
    BurnBtn.TextSize = 16
    BurnBtn.Parent = ModalFrame
    Instance.new("UICorner", BurnBtn).CornerRadius = UDim.new(0, 8)

    -- Kırmızı Buton (STOP & BYPASS)
    local StopBtn = Instance.new("TextButton")
    StopBtn.Size = UDim2.new(0, 130, 0, 45)
    StopBtn.Position = UDim2.new(0.53, 0, 0.7, 0)
    StopBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
    StopBtn.Text = "DURDUR"
    StopBtn.TextColor3 = Color3.new(1, 1, 1)
    StopBtn.Font = Enum.Font.GothamBold
    StopBtn.TextSize = 16
    StopBtn.Parent = ModalFrame
    Instance.new("UICorner", StopBtn).CornerRadius = UDim.new(0, 8)

    -- Bypass ve Remote Fonksiyonu
    local function ExecuteFullFire(state)
        local RE = ReplicatedStorage:FindFirstChild("RE") or ReplicatedStorage:FindFirstChild("Remotes")
        local Trigger = RE:FindFirstChild("1Playe1rTrigge1rEven1t") or RE:FindFirstChild("1Playe1rTrigge1rEven1t")
        
        if not RE then return end
        
        SendNotif("XenoHub", state and "Yangın tetikleniyor..." or "Söndürme sinyali gönderiliyor...", 2)

        for i = 1, 35 do
            task.spawn(function()
                pcall(function()
                    -- Protokol 1: Standart Remote
                    RE.RemoteEvent:FireServer("HouseSettings", "Fire", state)
                    
                    -- Protokol 2: Trigger Bypass (Cevrimdışı evleri de zorlar)
                    if Trigger then
                        Trigger:FireServer("HouseSettings", "Fire", state)
                    end

                    if state then
                        SendNotif("Alarm", "No " .. tostring(i) .. " yaniyor! 🔥", 1)
                    end
                end)
            end)
            task.wait(0.01)
        end
        ModalFrame.Visible = false
    end

    BurnBtn.MouseButton1Click:Connect(function() ExecuteFullFire(true) end)
    StopBtn.MouseButton1Click:Connect(function() ExecuteFullFire(false) end)

    return ModalFrame
end

local FireModal = CreateFireModal()

-- ============================================================================== --
-- 4. SAYFA YÖNETİMİ
-- ============================================================================== --

local tabs = {}
local function CreateTab(name)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(0.9, 0, 0, 38)
    tabBtn.Position = UDim2.new(0.05, 0, 0, 70 + (#tabs * 42))
    tabBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
    tabBtn.BackgroundTransparency = 1
    tabBtn.Text = "  " .. name
    tabBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextSize = 13
    tabBtn.TextXAlignment = Enum.TextXAlignment.Left
    tabBtn.Parent = SideBar
    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 6)

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.Parent = TabContainer
    Instance.new("UIListLayout", page).Padding = UDim.new(0, 10)
    
    tabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do t.page.Visible = false t.btn.BackgroundTransparency = 1 end
        page.Visible = true
        tabBtn.BackgroundTransparency = 0.8
    end)
    
    if #tabs == 0 then page.Visible = true tabBtn.BackgroundTransparency = 0.8 end
    table.insert(tabs, {btn = tabBtn, page = page})
    return page
end

local function AddButton(parent, text, color, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.98, 0, 0, 42)
    btn.BackgroundColor3 = color or Color3.fromRGB(30, 30, 35)
    btn.Text = text
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamMedium
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    btn.MouseButton1Click:Connect(callback)
end

-- Sayfa İçerikleri
local PremTab = CreateTab("⭐ Premium")

-- ANA TETİKLEYİCİ
AddButton(PremTab, "🔥 House Fire (Modal Aç)", Color3.fromRGB(46, 204, 113), function()
    FireModal.Visible = true -- Modal'ı true yapıyoruz
end)

AddButton(PremTab, "🔓 Premium Unlock", Color3.fromRGB(145, 90, 230), function()
    pcall(function()
        require(ReplicatedStorage.Modules.Client.UI.GamepassUnlockController).OwnsGamepass = function() return true end
        SendNotif("Başarılı", "Premium kilitleri açıldı!")
    end)
end)

local PlayerTab = CreateTab("🏃 Oyuncu")
AddButton(PlayerTab, "⚡ Speed 100", nil, function() lp.Character.Humanoid.WalkSpeed = 100 end)

SendNotif("XenoHub", "Sistem Hazır! Modal Aktif.", 5)
