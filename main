CreateButton("InvisibleBtn", UDim2.new(0.05, 0, 0.39, 0), "GÖRÜNMEZLİK: KAPALI", function(self)
    Settings.Invisibility = not Settings.Invisibility
    self.Text = Settings.Invisibility and "GÖRÜNMEZLİK: AÇIK" or "GÖRÜNMEZLİK: KAPALI"
    if LocalPlayer.Character then
        for _, v in pairs(LocalPlayer.Character:GetChildren()) do
            if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                v.Transparency = Settings.Invisibility and 1 or 0
            end
            if v:IsA("Accessory") and v:FindFirstChild("Handle") then
                v.Handle.Transparency = Settings.Invisibility and 1 or 0
            end
        end
    end
end)

