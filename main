end)

-- [ ANA SİSTEM FONKSİYONLARI ]

local function HasStage(Num)
    local val = Data:FindFirstChild(`Stage{Num}`)
    return val and val.Value ~= "" and val.Value
end

local function ClaimStage(Num)
    if not Settings.AutoClaim then return end
    task.spawn(function()
        local Value = Data:FindFirstChild(`Stage{Num}`)
        if Value and Value.Value == "" then
            Value:GetPropertyChangedSignal("Value"):Wait()
        end
        Claim:FireServer()
    end)
end

local function FarmLoop()
    while true do
        if Settings.FarmEnabled then
            local Char = LocalPlayer.Character
            local Root = Char and Char:FindFirstChild("HumanoidRootPart")
            
            if Root then
                TriggerAllGamepassBypass()
                
                local NewChar = false
                local charConn = LocalPlayer.CharacterAdded:Once(function() NewChar = true end)

                local BV = Instance.new("BodyVelocity", Root)
                BV.Velocity = Vector3.zero
                
                -- 10 BÖLGE SIRALI GEÇİŞ
                for i = 1, Settings.MaxStages do
                    if not Settings.FarmEnabled or NewChar then break end
                    
                    local StageFolder = Stages:FindFirstChild(`CaveStage{i}`)
                    if StageFolder and StageFolder:FindFirstChild("DarknessPart") then
                        local Target = StageFolder.DarknessPart
                        local Teleporting = true
                        
                        task.spawn(function()
                            while Teleporting and Settings.FarmEnabled and not NewChar do
                                Root.CFrame = Target.CFrame
                                Root.Velocity = Vector3.zero
                                task.wait()
                            end
                        end)
                        
                        ClaimStage(i)
                        
                        local timeout = tick()
                        repeat task.wait() until HasStage(i) or NewChar or not Settings.FarmEnabled or (tick() - timeout > 5)
                        
                        Teleporting = false
                        task.wait(Settings.TeleportSpeed)
                    end
                end
                
                -- 11. AŞAMA: SANDIK VE ALTIN BLOĞU
                if Settings.FarmEnabled and not NewChar then
                    local EndStage = Stages:FindFirstChild("TheEnd")
                    if EndStage and EndStage:FindFirstChild("GoldenChest") then
                        local Chest = EndStage.GoldenChest.Trigger
                        
                        local OldCFrame = Chest.CFrame
                        Chest.CFrame = Root.CFrame
                        
                        if firetouchinterest then
                            firetouchinterest(Root, Chest, 0)
                            task.wait(0.1)
                            firetouchinterest(Root, Chest, 1)
                        end
                        
                        task.wait(0.5)
                        Chest.CFrame = OldCFrame
                        
                        Claim:FireServer()
                        task.wait(2)
                        Char:BreakJoints()
                    end
                end
                
                if BV then BV:Destroy() end
                if charConn then charConn:Disconnect() end
            end
        end
        task.wait(1)
    end
end

-- Su hasarını ve yürümesini kontrol etme
RunService.Stepped:Connect(function()
    if LocalPlayer.Character then
        pcall(function()
            for _, v in pairs(LocalPlayer.Character:GetChildren()) do
                if v:IsA("BasePart") then
                    if Settings.AntiWater then
                        v.CanTouch = false
                    end
                end
            end
            -- Suda yürüme mekaniği
            if Settings.WaterWalk and LocalPlayer.Character:FindFirstChild("Humanoid") then
                if Workspace:FindFirstChild("Water") then
                    local water = Workspace.Water
                    if (LocalPlayer.Character.HumanoidRootPart.Position.Y - water.Position.Y) < 2 then
                        LocalPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(LocalPlayer.Character.HumanoidRootPart.Velocity.X, 0, LocalPlayer.Character.HumanoidRootPart.Velocity.Z)
                    end
                end
            end
        end)
    end
end)

-- İlk Çalıştırma
TriggerAllGamepassBypass()
task.spawn(FarmLoop)
print("🚀 Gemini HUB V12 - Ultimate Edition Aktif!")
