--[[
    W31rd.Hub - Gold Farming V1.2 (FIXED)
    Oyun: Build A Boat For Treasure
    Özellikler: Otomatik Altın Kasma, UI Takibi, Bypass Entegrasyonu
]]

-- UI'ı yerleştirecek en güvenli yeri bul
local targetParent = nil
local success, err = pcall(function()
    targetParent = game:GetService("CoreGui")
end)
if not success or not targetParent then
    targetParent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
end

-- Mevcut UI'ı temizle
if targetParent:FindFirstChild("W31rdHubGui") then
    targetParent.W31rdHubGui:Destroy()
end

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

-- Global Değişkenler
_G.AutoFarm = true
local ChestsCollected = 0
local StartGold = 0
local StartTime = os.time()

-- Oyun verilerinin yüklenmesini bekle
repeat task.wait() until LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("gold")
StartGold = LocalPlayer.Data.gold.Value

-- UI Oluşturma
local ScreenGui = Instance.new("ScreenGui")
local MainFrame = Instance.new("Frame")
local UIStroke = Instance.new("UIStroke")
local Title = Instance.new("TextLabel")
local Divider = Instance.new("Frame")
local CurrentGoldLabel = Instance.new("TextLabel")
local GainedGoldLabel = Instance.new("TextLabel")
local ChestsLabel = Instance.new("TextLabel")
local TimeLabel = Instance.new("TextLabel")
local WebhookLink = Instance.new("TextLabel")
local DiscordBtn = Instance.new("TextButton")

-- UI Ayarları
ScreenGui.Name = "W31rdHubGui"
ScreenGui.Parent = targetParent
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true -- Ekranın en üstüne kadar çıkabilmesi için

MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
MainFrame.Position = UDim2.new(0.5, -130, 0.5, -160) -- İlk açılışta ekranın tam ortasında olması için
MainFrame.Size = UDim2.new(0, 260, 0, 320)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = MainFrame

UIStroke.Parent = MainFrame
UIStroke.Thickness = 2
UIStroke.Color = Color3.fromRGB(80, 160, 255)
UIStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

Title.Parent = MainFrame
Title.Size = UDim2.new(1, 0, 0, 45)
Title.Text = "W31rd.Hub • Gold Farming • V1.2"
Title.TextColor3 = Color3.fromRGB(80, 160, 255)
Title.BackgroundTransparency = 1
Title.TextSize = 15
Title.Font = Enum.Font.GothamBold

Divider.Parent = MainFrame
Divider.Size = UDim2.new(0.9, 0, 0, 1)
Divider.Position = UDim2.new(0.05, 0, 0, 45)
Divider.BackgroundColor3 = Color3.fromRGB(80, 160, 255)
Divider.BorderSizePixel = 0

-- Veri Güncelleme Fonksiyonu
local function updateLabels()
    local currentGold = LocalPlayer.Data.gold.Value
    CurrentGoldLabel.Text = "Current Gold: " .. string.format("%, d", currentGold)
    GainedGoldLabel.Text = "Gained Gold: " .. string.format("%, d", currentGold - StartGold)
    ChestsLabel.Text = "Chests Collected: " .. tostring(ChestsCollected)
    
    local diff = os.difftime(os.time(), StartTime)
    local hours = math.floor(diff / 3600)
    local mins = math.floor((diff % 3600) / 60)
    local secs = diff % 60
    TimeLabel.Text = string.format("Total Time Farming: %02d:%02d:%02d", hours, mins, secs)
end

-- Label Oluşturucu
local function createLabel(text, color, pos)
    local lbl = Instance.new("TextLabel")
    lbl.Parent = MainFrame
    lbl.Position = pos
    lbl.Size = UDim2.new(1, -30, 0, 35)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = color
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 17
    return lbl
end

CurrentGoldLabel = createLabel("Current Gold: 0", Color3.fromRGB(255, 215, 0), UDim2.new(0, 15, 0, 60))
GainedGoldLabel = createLabel("Gained Gold: 0", Color3.fromRGB(50, 255, 100), UDim2.new(0, 15, 0, 100))
ChestsLabel = createLabel("Chests Collected: 0", Color3.fromRGB(255, 165, 0), UDim2.new(0, 15, 0, 140))
TimeLabel = createLabel("Total Time Farming: 00:00:00", Color3.fromRGB(120, 210, 255), UDim2.new(0, 15, 0, 180))

WebhookLink.Parent = MainFrame
WebhookLink.Position = UDim2.new(0, 15, 0, 225)
WebhookLink.Size = UDim2.new(1, -30, 0, 20)
WebhookLink.Text = "Webhook: https://discord.gg/bQnXYAYTzF"
WebhookLink.TextColor3 = Color3.fromRGB(255, 80, 80)
WebhookLink.TextSize = 11
WebhookLink.BackgroundTransparency = 1
WebhookLink.Font = Enum.Font.SourceSans
WebhookLink.TextXAlignment = Enum.TextXAlignment.Center

DiscordBtn.Parent = MainFrame
DiscordBtn.Position = UDim2.new(0.05, 0, 0.82, 0)
DiscordBtn.Size = UDim2.new(0.9, 0, 0, 45)
DiscordBtn.BackgroundColor3 = Color3.fromRGB(60, 130, 255)
DiscordBtn.Text = "Copy Discord Link"
DiscordBtn.TextColor3 = Color3.new(1, 1, 1)
DiscordBtn.Font = Enum.Font.GothamBold
DiscordBtn.TextSize = 18
DiscordBtn.AutoButtonColor = true

local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 8)
btnCorner.Parent = DiscordBtn

DiscordBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard("https://discord.gg/bQnXYAYTzF")
        DiscordBtn.Text = "Copied!"
        task.wait(2)
        DiscordBtn.Text = "Copy Discord Link"
    end
end)

-- Teleport Fonksiyonu
local function teleportTo(targetPos)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LocalPlayer.Character.HumanoidRootPart
    local tween = TweenService:Create(hrp, TweenInfo.new(1.2, Enum.EasingStyle.Linear), {CFrame = targetPos})
    tween:Play()
    tween.Completed:Wait()
end

-- Otomatik Farm Döngüsü
task.spawn(function()
    while _G.AutoFarm do
        pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = LocalPlayer.Character.HumanoidRootPart
                hrp.Anchored = true
                
                local stagesFolder = workspace:FindFirstChild("BoatStages")
                if stagesFolder then
                    local normalStages = stagesFolder:FindFirstChild("NormalStages")
                    if normalStages then
                        for i = 1, 10 do
                            local stage = normalStages:FindFirstChild("CaveStage" .. i)
                            if stage then
                                local target = stage:FindFirstChild("DarknessPart")
                                if target then
                                    teleportTo(target.CFrame * CFrame.new(0, 70, 0))
                                    task.wait(0.05)
                                end
                            end
                        end
                    end
                    
                    local retardZone = stagesFolder:FindFirstChild("RetardZone")
                    if retardZone then
                        local finalPart = retardZone:FindFirstChild("FinalPart")
                        if finalPart then
                            teleportTo(finalPart.CFrame * CFrame.new(0, -15, 0))
                            task.wait(3.5)
                            ChestsCollected = ChestsCollected + 1
                        end
                    end
                end
                
                LocalPlayer.Character:BreakJoints()
                task.wait(5.5)
            end
        end)
        task.wait(0.5)
    end
end)

-- UI Güncelleme Döngüsü
RunService.RenderStepped:Connect(function()
    if MainFrame.Visible then
        updateLabels()
    end
end)

print("W31rd.Hub (Arayüz Fixlendi) Başarıyla Çalıştırıldı!")
