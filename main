local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local lp = Players.LocalPlayer
local PlayerGui = lp:WaitForChild("PlayerGui")
local ParentFolder = (gethui and gethui()) or CoreGui

-- ============================================================================== --
-- 1. AYARLAR & DURUM DEĞİŞKENLERİ
-- ============================================================================== --

local XenoSettings = {
    AutoRob = false,
    PremiumEnabled = true,
    Speed = 16,
    Jump = 50,
}

local function SendNotif(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title;
            Text = text;
            Icon = "rbxassetid://6023426926";
            Duration = 4;
        })
    end)
end

-- ============================================================================== --
-- 2. AUTO-ROB & SAFE FINDER MANTIĞI (YENİ)
-- ============================================================================== --

local function GetSafes()
    local safes = {}
    for _, v in pairs(Workspace:GetDescendants()) do
        if v.Name == "Safe" and v:IsA("Model") then
            table.insert(safes, v)
        end
    end
    return safes
end

local function RobSafe(safeModel)
    pcall(function()
        local character = lp.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        
        -- Kasaya ışınlan
        local safePart = safeModel:FindFirstChild("Safe") or safeModel:FindFirstChildWhichIsA("BasePart")
        if safePart then
            character.HumanoidRootPart.CFrame = safePart.CFrame * CFrame.new(0, 0, 2)
            task.wait(0.5)
            
            -- Patlayıcıyı al ve yerleştir (Brookhaven Remote Logic)
            local re = ReplicatedStorage:FindFirstChild("RE")
            if re then
                -- C4 Etkinliği
                re:FindFirstChild("1Playe1rTrigge1rEven1t"):FireServer("AcceptedToolToServer", "C4", lp)
                task.wait(0.3)
                -- Kasayı Patlat ve Soy
                -- Not: Brookhaven'da kasa soyma işlemi genellikle 'ClickDetector' veya 'ProximityPrompt' tetiklemesiyle olur
                -- Bu script en yakın 'Grab' veya 'Open' remotesini zorlar
                fireclickdetector(safePart:FindFirstChildWhichIsA("ClickDetector"))
            end
        end
    end)
end

-- Otomatik Döngü
task.spawn(function()
    while task.wait(2) do
        if XenoSettings.AutoRob then
            local allSafes = GetSafes()
            if #allSafes > 0 then
                for _, s in pairs(allSafes) do
                    if not XenoSettings.AutoRob then break end
                    SendNotif("XenoHub", "Kasaya Gidiliyor: " .. s.Parent.Name)
                    RobSafe(s)
                    task.wait(3) -- Soygun ve kaçış süresi
                end
            else
                SendNotif("XenoHub", "Soyulacak kasa bulunamadı.")
                XenoSettings.AutoRob = false
            end
        end
    end
end)

-- ============================================================================== --
-- 3. CORE BYPASS & UI SETUP
-- ============================================================================== --

local function InjectBypasses()
    pcall(function()
        -- Premium & Gamepass Bypass
        local gpc = require(ReplicatedStorage.Modules.Client.UI.GamepassUnlockController)
        gpc.OwnsGamepass = function() return true end
        gpc.IsPremium = function() return true end
        
        -- Admin Permissions
        local MainPermPath = ReplicatedStorage:FindFirstChild("Permissions", true)
        if MainPermPath then
            local MainPermissions = require(MainPermPath)
            local funcs = {"hasAdminAccess", "hasContentCreatorAccess", "hasModeratorAccess", "hasStaffAccess"}
            for _, f in ipairs(funcs) do MainPermissions[f] = function() return true end end
        end
    end)
end

-- UI Tasarımı Başlangıcı
if ParentFolder:FindFirstChild("XenoBrookhaven") then ParentFolder.XenoBrookhaven:Destroy() end
local XenoGui = Instance.new("ScreenGui", ParentFolder)
XenoGui.Name = "XenoBrookhaven"

local MainFrame = Instance.new("Frame", XenoGui)
MainFrame.Size = UDim2.new(0, 680, 0, 450)
MainFrame.Position = UDim2.new(0.5, -340, 0.5, -225)
MainFrame.BackgroundColor3 = Color3.fromRGB(12, 12, 14)
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 12)
Instance.new("UIStroke", MainFrame).Color = Color3.fromRGB(145, 90, 230)

-- Sürükleme Sistemi
local function Drag(f)
    local d, i, s, p
    f.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then d = true s = input.Position p = f.Position end end)
    f.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement then i = input end end)
    RunService.RenderStepped:Connect(function() if d and i then local dl = i.Position - s f.Position = UDim2.new(p.X.Scale, p.X.Offset + dl.X, p.Y.Scale, p.Y.Offset + dl.Y) end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then d = false end end)
end
Drag(MainFrame)

-- Sidebar
local SideBar = Instance.new("Frame", MainFrame)
SideBar.Size = UDim2.new(0, 170, 1, 0)
SideBar.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
Instance.new("UICorner", SideBar).CornerRadius = UDim.new(0, 12)

local TabHolder = Instance.new("Frame", MainFrame)
TabHolder.Size = UDim2.new(1, -190, 1, -20)
TabHolder.Position = UDim2.new(0, 180, 0, 10)
TabHolder.BackgroundTransparency = 1

local pages = {}
local function NewTab(name)
    local tBtn = Instance.new("TextButton", SideBar)
    tBtn.Size = UDim2.new(0.9, 0, 0, 40)
    tBtn.Position = UDim2.new(0.05, 0, 0, 60 + (#pages * 45))
    tBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
    tBtn.BackgroundTransparency = 1
    tBtn.Text = "  " .. name
    tBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    tBtn.Font = Enum.Font.GothamBold
    tBtn.TextSize = 13
    tBtn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", tBtn).CornerRadius = UDim.new(0, 6)

    local page = Instance.new("ScrollingFrame", TabHolder)
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ScrollBarThickness = 0
    Instance.new("UIListLayout", page).Padding = UDim.new(0, 8)

    tBtn.MouseButton1Click:Connect(function()
        for _, p in pairs(pages) do p.p.Visible = false p.b.BackgroundTransparency = 1 p.b.TextColor3 = Color3.fromRGB(200, 200, 200) end
        page.Visible = true
        tBtn.BackgroundTransparency = 0.8
        tBtn.TextColor3 = Color3.fromRGB(145, 90, 230)
    end)

    if #pages == 0 then page.Visible = true tBtn.BackgroundTransparency = 0.8 tBtn.TextColor3 = Color3.fromRGB(145, 90, 230) end
    table.insert(pages, {b = tBtn, p = page})
    return page
end

local function AddBtn(parent, text, cb, color)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(0.96, 0, 0, 44)
    b.BackgroundColor3 = color or Color3.fromRGB(25, 25, 30)
    b.Text = text
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.MouseButton1Click:Connect(cb)
end

