-- İstatistik Satırları Fonksiyonu
local function CreateStatLabel(name, color, pos)
    local lbl = Instance.new("TextLabel", MainFrame)
    lbl.Position = UDim2.new(0, 15, 0, pos)
    lbl.Size = UDim2.new(1, -30, 0, 25)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextColor3 = color
    lbl.TextSize = 16
    lbl.BackgroundTransparency = 1
    return lbl
end

CurrentGoldLabel = CreateStatLabel("Current Gold: 0", Color3.fromRGB(255, 200, 0), 55)
GainedGoldLabel = CreateStatLabel("Gained Gold: 0", Color3.fromRGB(0, 255, 100), 85)
ChestsLabel = CreateStatLabel("Chests Collected: 0", Color3.fromRGB(255, 150, 0), 115)
TimeLabel = CreateStatLabel("Total Time: 00:00:00", Color3.fromRGB(120, 200, 255), 145)

DiscordBtn.Parent = MainFrame
DiscordBtn.Size = UDim2.new(1, -30, 0, 30)
DiscordBtn.Position = UDim2.new(0, 15, 1, -40)
