CarTab:AddSlider({
    Name = "Araç Hızı",
    Min = 50, Max = 400, Default = 50,
    Callback = function(v)
        for _, vehicle in pairs(workspace.Vehicles:GetChildren()) do
            if vehicle:FindFirstChild("Seats") and vehicle.Seats:FindFirstChild("VehicleSeat") then
                vehicle.Seats.VehicleSeat.MaxSpeed = v
            end
        end
    end
})

CarTab:AddToggle({
    Name = "🌈 RGB Araç Rengi",
    Default = false,
    Callback = function(v)
        _G.CarRGB = v
        spawn(function()
            while _G.CarRGB do
                local color = Color3.fromHSV(tick() % 5 / 5, 1, 1)
                pcall(function()
                    ReplicatedStorage.RE["1Player1sCa1r"]:FireServer("PickingCarColor", color)
                end)
                task.wait(0.1)
            end
        end)
    end
})

CarTab:AddButton({
    Title = "🔊 Korna Spam",
    Callback = function()
        for i=1, 20 do
            ReplicatedStorage.Remotes.PlayHorn:InvokeServer()
            task.wait(0.1)
        end
    end
})

