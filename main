-- 4. FONKSİYONLAR (CORE LOGIC)

-- Brookhaven Eşya Alma Mantığı (Senin verdiğin gelişmiş kod)
local function GetBrookhavenItem(itemName)
    local rep = game:GetService("ReplicatedStorage")
    local ok, err = pcall(function()
        -- 1. Yöntem: Standart Remote'lar
        local re = rep:FindFirstChild("RE") or rep:FindFirstChild("Remotes") or rep
        local candidates = {"GetItem", "GetTool", "GetToolToServer"}
        
        for _, name in ipairs(candidates) do
            local r = re:FindFirstChild(name)
            if r then
                if r:IsA("RemoteEvent") then r:FireServer(itemName)
                elseif r:IsA("RemoteFunction") then r:InvokeServer(itemName) end
            end
        end

        -- 2. Yöntem: Trigger Event (En Güçlüsü)
        local trigger = re:FindFirstChild("1Playe1rTrigge1rEven1t")
        if trigger then
            local args = {[1] = "AcceptedToolToServer", [2] = itemName, [3] = lp}
            if trigger:IsA("RemoteEvent") then trigger:FireServer(unpack(args))
            elseif trigger:IsA("RemoteFunction") then trigger:InvokeServer(unpack(args)) end
            SendNotif("XenoHub", itemName.." envanterine eklendi! 🎒", 3)
        end
    end)
    if not ok then SendNotif("Hata", "Eşya alınamadı!", 2) end
end

-- Teleport Fonksiyonu
local function TeleportTo(cframe)
    if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
        lp.Character.HumanoidRootPart.CFrame = cframe
    end
end

-- 5. TAB SİSTEMİ OLUŞTURUCU
local tabs = {}
local currentTab = nil

local function CreateTab(name)
    -- Tab Butonu
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(0.9, 0, 0, 35)
    tabBtn.Position = UDim2.new(0.05, 0, 0, 60 + (#tabs * 40))
    tabBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    tabBtn.BackgroundTransparency = 1
    tabBtn.Text = name
    tabBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextSize = 14
    tabBtn.TextXAlignment = Enum.TextXAlignment.Left
    tabBtn.Parent = SideBar
    
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 15)
    pad.Parent = tabBtn

    -- Sayfa (Page)
    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.ScrollBarThickness = 2
    page.Visible = false
    page.Parent = TabContainer
    
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = page
    
    -- Tab Geçiş Mantığı
    tabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.page.Visible = false
            t.btn.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
        page.Visible = true
        tabBtn.TextColor3 = Color3.fromRGB(88, 101, 242)
    end)
    
    if #tabs == 0 then -- İlk tab varsayılan açık
        page.Visible = true
        tabBtn.TextColor3 = Color3.fromRGB(88, 101, 242)
    end

    table.insert(tabs, {btn = tabBtn, page = page})
    return page
end

-- BUTON OLUŞTURUCU
local function AddButton(parent, text, color, callback)
    local btnFrame = Instance.new("Frame")
    btnFrame.Size = UDim2.new(1, 0, 0, 40)
    btnFrame.BackgroundTransparency = 1
    btnFrame.Parent = parent
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.98, 0, 0.9, 0)
    btn.BackgroundColor3 = color or Color3.fromRGB(45, 45, 50)
    btn.Text = text
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 14
    btn.Parent = btnFrame
    
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    btn.MouseButton1Click:Connect(function()
        pcall(callback)
        -- Tıklama Efekti
        local original = btn.BackgroundColor3
        btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        btn.BackgroundTransparency = 0.8
        task.wait(0.1)
        btn.BackgroundColor3 = original
        btn.BackgroundTransparency = 0
    end)
end

