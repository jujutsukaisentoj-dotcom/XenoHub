local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local StarterGui = game:GetService("StarterGui")

local lp = Players.LocalPlayer
local ParentFolder = (gethui and gethui()) or CoreGui

-- === DURUM DEĞİŞKENLERİ === --
local flying = false
local noclip = false
local flySpeed = 100
local flyKeys = {W = false, S = false, A = false, D = false, Q = false, E = false}
local noclipConn = nil
local uiVisible = true

-- === TEMEL FONKSİYONLAR === --
local function SendNotif(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = 3
        })
    end)
end

local function TriggerAdSystems()
    pcall(function()
        local re = ReplicatedStorage:FindFirstChild("RE")
        if re then
            local modalEvent = re:FindFirstChild("1Modal1Fire1Ask")
            local videoEvent = re:FindFirstChild("1Video1Ad1Even1t")
            if modalEvent then modalEvent:FireServer("Accepted", "VideoAd") end
            if videoEvent then videoEvent:FireServer("Finished") end
            local adStore = re:FindFirstChild("1AD1Stor1e")
            if adStore then adStore:FireServer("VideoReward", "PremiumUnlock") end
        end
    end)
end

-- === UI CREATION (REDZ STYLE) === --
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "XenoHub_Redz_V11"
ScreenGui.Parent = ParentFolder
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- Toggle Button (Açma/Kapama Logosu)
local ToggleButton = Instance.new("TextButton")
ToggleButton.Name = "XenoToggle"
ToggleButton.Size = UDim2.new(0, 50, 0, 50)
ToggleButton.Position = UDim2.new(0, 20, 0.5, -25)
ToggleButton.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
ToggleButton.Text = "X"
ToggleButton.TextColor3 = Color3.fromRGB(255, 40, 40)
ToggleButton.Font = Enum.Font.GothamBlack
ToggleButton.TextSize = 25
ToggleButton.Parent = ScreenGui

local TBCorner = Instance.new("UICorner")
TBCorner.CornerRadius = UDim.new(1, 0)
TBCorner.Parent = ToggleButton

local TBStroke = Instance.new("UIStroke")
TBStroke.Thickness = 2
TBStroke.Color = Color3.fromRGB(255, 40, 40)
TBStroke.Parent = ToggleButton

-- Main Frame
local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Size = UDim2.new(0, 550, 0, 360)
MainFrame.Position = UDim2.new(0.5, -275, 0.5, -180)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
MainFrame.BorderSizePixel = 0
MainFrame.ClipsDescendants = true
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 10)
UICorner.Parent = MainFrame

local UIStroke = Instance.new("UIStroke")
UIStroke.Thickness = 1.5
UIStroke.Color = Color3.fromRGB(40, 40, 45)
UIStroke.Parent = MainFrame

-- Top Bar (Close Button Section)
local TopBar = Instance.new("Frame")
TopBar.Size = UDim2.new(1, 0, 0, 40)
TopBar.BackgroundTransparency = 1
TopBar.Parent = MainFrame

local CloseBtn = Instance.new("TextButton")
CloseBtn.Name = "CloseBtn"
CloseBtn.Size = UDim2.new(0, 30, 0, 30)
CloseBtn.Position = UDim2.new(1, -35, 0, 5)
CloseBtn.BackgroundColor3 = Color3.fromRGB(255, 40, 40)
CloseBtn.Text = "X"
CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.TextSize = 14
CloseBtn.Parent = TopBar

local CBCorner = Instance.new("UICorner")
CBCorner.CornerRadius = UDim.new(0, 6)
CBCorner.Parent = CloseBtn

-- Sidebar
local Sidebar = Instance.new("Frame")
Sidebar.Size = UDim2.new(0, 160, 1, -40)
Sidebar.Position = UDim2.new(0, 0, 0, 40)
Sidebar.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
Sidebar.BorderSizePixel = 0
Sidebar.Parent = MainFrame

local TabList = Instance.new("ScrollingFrame")
TabList.Size = UDim2.new(1, -10, 1, -20)
TabList.Position = UDim2.new(0, 5, 0, 10)
TabList.BackgroundTransparency = 1
TabList.ScrollBarThickness = 0
TabList.Parent = Sidebar

local UIList = Instance.new("UIListLayout")
UIList.Padding = UDim.new(0, 5)
UIList.Parent = TabList

local Container = Instance.new("Frame")
Container.Name = "Container"
Container.Position = UDim2.new(0, 170, 0, 50)
Container.Size = UDim2.new(1, -180, 1, -60)
Container.BackgroundTransparency = 1
Container.Parent = MainFrame

local Pages = {}

-- UI Toggle Logic
ToggleButton.MouseButton1Click:Connect(function()
    uiVisible = not uiVisible
    MainFrame.Visible = uiVisible
    ToggleButton.Text = uiVisible and "X" or "XENO"
end)

CloseBtn.MouseButton1Click:Connect(function()
    uiVisible = false
    MainFrame.Visible = false
    ToggleButton.Text = "XENO"
end)

-- Sürükleme
local dragging, dragInput, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
MainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)

-- Tab & Button Creator
local function CreateTab(name)
    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.new(1, 0, 0, 40)
    TabBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    TabBtn.Text = name
    TabBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    TabBtn.Font = Enum.Font.GothamSemibold
    TabBtn.TextSize = 13
    TabBtn.AutoButtonColor = false
    TabBtn.Parent = TabList
    
    local TBC = Instance.new("UICorner")
    TBC.CornerRadius = UDim.new(0, 8)
    TBC.Parent = TabBtn

    local Page = Instance.new("ScrollingFrame")
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.BackgroundTransparency = 1
    Page.Visible = false
    Page.ScrollBarThickness = 3
    Page.ScrollBarImageColor3 = Color3.fromRGB(255, 40, 40)
    Page.Parent = Container
    
    local PL = Instance.new("UIListLayout")
    PL.Padding = UDim.new(0, 8)
    PL.Parent = Page

    TabBtn.MouseButton1Click:Connect(function()
        for _, p in pairs(Pages) do p.Visible = false end
        for _, b in pairs(TabList:GetChildren()) do 
            if b:IsA("TextButton") then b.TextColor3 = Color3.fromRGB(150, 150, 150) b.BackgroundColor3 = Color3.fromRGB(30, 30, 35) end
        end
        Page.Visible = true
        TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        TabBtn.BackgroundColor3 = Color3.fromRGB(255, 40, 40)
    end)

    table.insert(Pages, Page)
    return Page
end

local function AddButton(page, text, color, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, -10, 0, 42)
    Btn.BackgroundColor3 = color or Color3.fromRGB(25, 25, 30)
    Btn.Text = text
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.Font = Enum.Font.GothamMedium
    Btn.TextSize = 13
    Btn.Parent = page
    
    local BC = Instance.new("UICorner")
    BC.CornerRadius = UDim.new(0, 8)
    BC.Parent = Btn
    
    local BS = Instance.new("UIStroke")
    BS.Thickness = 1
    BS.Color = Color3.fromRGB(45, 45, 50)
    BS.Parent = Btn
    
    Btn.MouseButton1Click:Connect(function()
        pcall(callback)
        Btn.BackgroundColor3 = Color3.fromRGB(255, 40, 40)
        task.wait(0.1)
        Btn.BackgroundColor3 = color or Color3.fromRGB(25, 25, 30)
    end)
end

-- === SAYFALAR === --
local Home = CreateTab("🏠 Ana Menü")
local Player = CreateTab("👤 Oyuncu")
local Items = CreateTab("🎒 Eşyalar")
local Settings = CreateTab("⚙️ Ayarlar")

-- Home Section
AddButton(Home, "☢️ FULL BYPASS (ADSTORE/VIDEO)", Color3.fromRGB(40, 40, 45), function()
    TriggerAdSystems()
    SendNotif("XenoHub", "Tüm Reklam Sistemleri Devre Dışı!")
end)

AddButton(Home, "⚡ CMDR FULL UNLOCK (F2)", Color3.fromRGB(40, 40, 45), function()
    pcall(function()
        local Perms = require(ReplicatedStorage.Modules.Shared.Cmdr.CmdrPermissions)
        Perms.hasCmdrAccess = function() return true end
        require(ReplicatedStorage.CmdrClient):SetActivationKeys({Enum.KeyCode.F2})
        SendNotif("XenoHub", "Cmdr Açıldı! F2 Bas.")
    end)
end)

-- Player Section
AddButton(Player, "✈️ FLY (WASD+QE): AÇ/KAPAT", nil, function()
    flying = not flying
    local root = lp.Character:FindFirstChild("HumanoidRootPart")
    if flying and root then
        local bv = Instance.new("BodyVelocity", root)
        bv.Name = "XenoFly"
        bv.MaxForce = Vector3.new(1,1,1) * math.huge
        bv.Velocity = Vector3.new(0,0,0)
        local bg = Instance.new("BodyGyro", root)
        bg.Name = "XenoGyro"
        bg.MaxTorque = Vector3.new(1,1,1) * math.huge
        task.spawn(function()
            while flying do
                RunService.RenderStepped:Wait()
                bg.CFrame = workspace.CurrentCamera.CFrame
                local dir = Vector3.new(0,0,0)
                local cam = workspace.CurrentCamera.CFrame
                if flyKeys.W then dir = dir + cam.LookVector end
                if flyKeys.S then dir = dir - cam.LookVector end
                if flyKeys.A then dir = dir - cam.RightVector end
                if flyKeys.D then dir = dir + cam.RightVector end
                if flyKeys.Q then dir = dir + Vector3.new(0, 1, 0) end
                if flyKeys.E then dir = dir - Vector3.new(0, 1, 0) end
                bv.Velocity = dir * flySpeed
            end
            bv:Destroy() bg:Destroy()
        end)
    end
end)

AddButton(Player, "👻 NOCLIP: AÇ/KAPAT", nil, function()
    noclip = not noclip
    if noclipConn then noclipConn:Disconnect() end
    if noclip then
        noclipConn = RunService.Stepped:Connect(function()
            for _, v in pairs(lp.Character:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
        end)
    end
end)

-- Items Section
local function GetItem(name)
    pcall(function()
        ReplicatedStorage.RE["1Playe1rTrigge1rEven1t"]:FireServer("AcceptedToolToServer", name, lp)
    end)
end

AddButton(Items, "💸 Para Tabancası Al", nil, function() GetItem("MoneyGun") end)
AddButton(Items, "🪂 Planör Al", nil, function() GetItem("Glider") end)
AddButton(Items, "🪚 Testere Al", nil, function() GetItem("Chainsaw") end)
AddButton(Items, "☢️ Uranyum Çubuğu Al", nil, function() GetItem("UraniumRod") end)

-- Settings Section
AddButton(Settings, "🔴 SCRIPT'I TAMAMEN SİL", Color3.fromRGB(60, 20, 20), function()
    ScreenGui:Destroy()
end)

-- Fly Keybinds
UserInputService.InputBegan:Connect(function(i, g)
    if g then return end
    if flyKeys[i.KeyCode.Name] ~= nil then flyKeys[i.KeyCode.Name] = true end
end)
UserInputService.InputEnded:Connect(function(i)
    if flyKeys[i.KeyCode.Name] ~= nil then flyKeys[i.KeyCode.Name] = false end
end)

-- Init
Pages[1].Visible = true
TabList:GetChildren()[2].BackgroundColor3 = Color3.fromRGB(255, 40, 40)
TabList:GetChildren()[2].TextColor3 = Color3.fromRGB(255, 255, 255)
SendNotif("XenoHub V11", "Redz Style Yüklendi! 'X' Butonuna Bas.")
