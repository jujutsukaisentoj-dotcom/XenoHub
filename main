local Stages = Workspace:WaitForChild("BoatStages"):WaitForChild("NormalStages")

-- [ TÜM GÜNCEL KODLAR LİSTESİ ]
-- 2026 itibariyle çalışan ve aktif olan tüm Build A Boat kodları
local PromoCodes = {
    "hi",
    "Squid Army",
    "=D",
    "=P",
    "chillthrill709 was here",
    "fuzzy friend?",
    "Lurking Legend",
    "GGGOOOAAALLL",
    "Be a big f00t print",
    "1B",
    "voted code",
    "1M Likes"
}

-- [ KOD KULLANMA FONKSİYONU ]
local function RedeemAllCodes()
    pcall(function()
        local RedeemRemote = ReplicatedStorage:FindFirstChild("RedeemCode", true)
        if RedeemRemote and RedeemRemote:IsA("RemoteFunction") then
            for _, code in pairs(PromoCodes) do
                -- Sunucuyu yormamak ve ban riskini önlemek için küçük bekleme
                RedeemRemote:InvokeServer(code)
                task.wait(0.2)
            end
        end
    end)
end

-- [ TÜM GAMEPASS & MORPH BYPASS SİSTEMİ ]
local function TriggerAllGamepassBypass()
    pcall(function()
        -- 1. Double Gold Bypass (%100 Tetikleyici)
        if Data:FindFirstChild("DoubleGold") then
            Data.DoubleGold.Value = true
        end
        
        if ReplicatedStorage:FindFirstChild("DoubleGoldGamepass") then
            ReplicatedStorage.DoubleGoldGamepass:FireServer(true)
        end

        -- 2. Morph & Transformation Bypass
        local MorphList = {"Penguin", "Fox", "Chicken", "PenguinMorph", "FoxMorph", "ChickenMorph"}
        for _, morph in pairs(MorphList) do
            if Data:FindFirstChild(morph) then
                Data[morph].Value = true
            end
        end

        -- 3. Diğer Gamepass Değerlerini Dex'te True Yapma
        local PassList = {"DoubleMoney", "ExtraHealth", "RoyalMember", "MegaMember"}
        for _, pass in pairs(PassList) do
            if Data:FindFirstChild(pass) then
                Data[pass].Value = true
            end
        end

        -- 4. Sunucu Kontrolü Bypass
        if ReplicatedStorage:FindFirstChild("CheckGamepasses") then
            ReplicatedStorage.CheckGamepasses:InvokeServer()
        end
    end)
end

