local uiVisible = true

-- === TEMEL FONKSİYONLAR === --
local function SendNotif(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = 3
        })
    end)
end

-- === ADSTORE & REKLAM SİSTEMİ BYPASS (DOSYADAN AKTARILDI) === --
local function TriggerFullBypass()
    pcall(function()
        local re = ReplicatedStorage:FindFirstChild("RE")
        if re then
            -- ModalFireAsk & VideoAd Trigger
            local modalEvent = re:FindFirstChild("1Modal1Fire1Ask")
            local videoEvent = re:FindFirstChild("1Video1Ad1Even1t")
            if modalEvent then modalEvent:FireServer("Accepted", "VideoAd") end
            if videoEvent then videoEvent:FireServer("Finished") end
            
            -- ADStore Premium Unlock
            local adStore = re:FindFirstChild("1AD1Stor1e")
            if adStore then
                adStore:FireServer("VideoReward", "PremiumUnlock")
            end
            
            -- Ekstra Remote Triggerlar
            local remoteTrig = re:FindFirstChild("1Playe1rTrigge1rEven1t")
            if remoteTrig then
                remoteTrig:FireServer("AcceptedToolToServer", "PremiumPass", lp)
            end
            SendNotif("XenoHub", "Tüm Bypasslar ve Premium Aktif Edildi!")
        end
    end)
end

