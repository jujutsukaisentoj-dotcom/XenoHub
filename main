-- ===============================================================
-- 🚀 Geliştirilmiş Build A Boat Auto-Farm (Stabil & Hızlı)
-- ===============================================================

-- Ayarlar
local Config = {
    ChestStage = 10,       -- Kaçıncı stage'den sonra sandığa gitsin? (Genelde 10)
    AutoClickChest = true, -- Sandığa otomatik dokunsun mu?
    TweenSpeed = 0.5,      -- Stage geçiş hızı (Daha güvenli olması için eklendi)
    AntiFall = true        -- Düşmeyi engelleme
}

-- Servisler
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local ClaimRemote = Workspace:WaitForChild("ClaimRiverResultsGold")

-- Karakter Kontrolü
local function GetRoot()
    return LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
end

-- Stage Bilgisi Kontrolü
local function GetStageValue(num)
    local data = LocalPlayer:FindFirstChild("OtherData")
    if data then
        local stage = data:FindFirstChild("Stage" .. num)
        return stage and stage.Value ~= ""
    end
    return false
end

-- Hız Sıfırlama (Havada asılı kalırken titremeyi önler)
local function ResetVelocity(root)
    if root then
        root.Velocity = Vector3.new(0, 0, 0)
        root.RotVelocity = Vector3.new(0, 0, 0)
    end
end

-- Ana Farm Fonksiyonu
local function StartFarm()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    local stages = Workspace:WaitForChild("BoatStages"):WaitForChild("NormalStages")
    
    print("🚀 Farm Başlatıldı...")

    for i = 1, 10 do
        if not char or not char.Parent then break end
        
        local stageName = "CaveStage" .. i
        local targetStage = stages:FindFirstChild(stageName)
        
        if targetStage then
            local part = targetStage:FindFirstChild("DarknessPart")
            if part then
                -- Işınlanma ve Sabitleme
                local connection
                connection = RunService.Heartbeat:Connect(function()
                    if root and root.Parent then
                        root.CFrame = part.CFrame
                        ResetVelocity(root)
                    else
                        connection:Disconnect()
                    end
                end)

                -- Stage'in kaydedilmesini bekle
                repeat task.wait(0.1) until GetStageValue(i) or not char.Parent
                connection:Disconnect()
                
                -- Gold Claim Tetikleyici
                ClaimRemote:FireServer()
            end
        end

        -- Sandık Odasına Gelindiğinde
        if i == Config.ChestStage and Config.AutoClickChest then
            local chestTrigger = stages:WaitForChild("TheEnd"):WaitForChild("GoldenChest"):WaitForChild("Trigger")
            
            -- Eski scriptteki Chest CFrame'ini bozmak yerine karakteri ona götürmek daha güvenlidir
            task.wait(0.5)
            root.CFrame = chestTrigger.CFrame
            
            -- Alternatif dokunma metodu (Xeno ve diğer injectörler için stabil)
            if firetouchinterest then
                firetouchinterest(root, chestTrigger, 0)
                task.wait(0.1)
                firetouchinterest(root, chestTrigger, 1)
            end
            
            print("💰 Sandık Alındı!")
            task.wait(2) -- Sunucunun algılaması için kısa bekleme
            char:BreakJoints() -- Yeniden başlamak için karakteri sıfırla
            break
        end
    end
end

-- Otomatik Döngü Bağlantısı
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1) -- Karakterin tam yüklenmesi için
    StartFarm()
end)

-- İlk Çalıştırma
StartFarm()
