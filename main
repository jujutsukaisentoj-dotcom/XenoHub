--[[ 
    XENOHUB - BUILD A BOAT FOR TREASURE (V2 PRO LOOP)
    Özellikler: Dex Kontrollü Teleport, Tetikli Bypass, Modern UI, Auto-Farm.
    Kısayol: 'F' tuşu menüyü açar/kapatır.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local lp = Players.LocalPlayer
local targetParent = (gethui and gethui()) or CoreGui

-- ============================================================================== --
-- AYARLAR VE DURUM (CONFIG)
-- ============================================================================== --
local Config = {
    AutoFarm = false,
    TouchChest = true,
    ChestStage = 10,
    TeleportSpeed = 0.45, -- Daha düşük değer = Daha hızlı (Riskli)
    BypassActive = true,
    AntiAfk = true
}

local Stages = workspace:WaitForChild("BoatStages"):WaitForChild("NormalStages")
local ClaimRemote = workspace:WaitForChild("ClaimRiverResultsGold")
local GoldenChestTrigger = Stages:WaitForChild("TheEnd"):WaitForChild("GoldenChest"):WaitForChild("Trigger")
local OtherData = lp:WaitForChild("OtherData")

-- ============================================================================== --
-- YARDIMCI SİSTEMLER (BYPASS & TELEPORT)
-- ============================================================================== --

local function Notify(title, text)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = title;
        Text = text;
        Duration = 3;
    })
end

-- Dex Kontrolü: Bölümün geçilip geçilmediğini kontrol eder
local function HasStage(Num)
    local stageVal = OtherData:FindFirstChild("Stage" .. Num)
    return stageVal and stageVal.Value ~= "" and stageVal.Value
end

-- Tetikli Bypass: Karakterin fiziksel verilerini sıfırlayarak hile korumasını atlatır
local function ApplyBypass(Char)
    if not Config.BypassActive then return end
    local hrp = Char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Velocity = Vector3.new(0, 0, 0)
        hrp.RotVelocity = Vector3.new(0, 0, 0)
    end
    -- Karakter parçalarının hızını sıfırla
    for _, part in pairs(Char:GetChildren()) do
        if part:IsA("BasePart") then
            part.Velocity = Vector3.new(0, 0, 0)
        end
    end
end

-- ============================================================================== --
-- ANA FARM DÖNGÜSÜ (CORE LOGIC)
-- ============================================================================== --

local function StartFarm()
    task.spawn(function()
        while Config.AutoFarm do
            local Char = lp.Character or lp.CharacterAdded:Wait()
            local Root = Char:WaitForChild("HumanoidRootPart")
            local Hum = Char:WaitForChild("Humanoid")
            
            local isDead = false
            local deathConn
            deathConn = Hum.Died:Connect(function()
                isDead = true
                deathConn:Disconnect()
            end)

            for i = 1, 10 do
                if not Config.AutoFarm or isDead then break end
                
                local stageName = "CaveStage" .. i
                local targetStage = Stages:FindFirstChild(stageName)
                
                if targetStage and targetStage:FindFirstChild("DarknessPart") then
                    local targetPart = targetStage.DarknessPart
                    
                    -- Dex Kontrollü Teleport (Tween ile Yumuşak Geçiş)
                    local tween = TweenService:Create(Root, TweenInfo.new(Config.TeleportSpeed, Enum.EasingStyle.Linear), {
                        CFrame = targetPart.CFrame * CFrame.new(0, 55, 0)
                    })
                    
                    -- Teleport sırasında bypass tetikle (Döngüsel)
                    local tpActive = true
                    task.spawn(function()
                        while tpActive and not isDead do
                            ApplyBypass(Char)
                            task.wait()
                        end
                    end)

                    tween:Play()
                    tween.Completed:Wait()
                    tpActive = false

                    -- Claim ve Hazine Kontrolü
                    if i == Config.ChestStage and Config.TouchChest then
                        GoldenChestTrigger.CFrame = Root.CFrame
                        task.wait(0.25)
                        ClaimRemote:FireServer()
                    else
                        ClaimRemote:FireServer()
                    end

                    -- Bölüm Doğrulama (Dex Sync)
                    if i < 10 then
                        local timeout = 0
                        repeat 
                            task.wait(0.1) 
                            timeout = timeout + 1
                        until HasStage(i) or isDead or timeout > 20
                    end
                end
            end

            -- Tur Sonu İşlemleri
            if Config.AutoFarm and not isDead then
                task.wait(1)
                Char:BreakJoints()
            end
            
            repeat task.wait() until lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            task.wait(1.5) -- Spawn bekleme süresi
        end
    end)
end

-- ============================================================================== --
-- MODERN ARAYÜZ TASARIMI (UI)
-- ============================================================================== --

if targetParent:FindFirstChild("XenoHub_UI") then targetParent.XenoHub_UI:Destroy() end

local ScreenGui = Instance.new("ScreenGui", targetParent)
ScreenGui.Name = "XenoHub_UI"

local Main = Instance.new("Frame", ScreenGui)
Main.Name = "Main"
Main.Size = UDim2.new(0, 260, 0, 300)
Main.Position = UDim2.new(0.5, -130, 0.5, -150)
Main.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
Main.BorderSizePixel = 0
Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 12)

local Header = Instance.new("Frame", Main)
Header.Size = UDim2.new(1, 0, 0, 45)
Header.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
Header.BorderSizePixel = 0
Instance.new("UICorner", Header)

local Title = Instance.new("TextLabel", Header)
Title.Size = UDim2.new(1, 0, 1, 0)
Title.BackgroundTransparency = 1
Title.Text = "XENOHUB • BAB V2"
Title.TextColor3 = Color3.fromRGB(0, 180, 255)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 16

local Container = Instance.new("Frame", Main)
Container.Position = UDim2.new(0, 10, 0, 55)
Container.Size = UDim2.new(1, -20, 1, -65)
Container.BackgroundTransparency = 1

local UIList = Instance.new("UIListLayout", Container)
UIList.Padding = UDim.new(0, 8)
UIList.SortOrder = Enum.SortOrder.LayoutOrder

local function AddToggle(text, callback)
    local btn = Instance.new("TextButton", Container)
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    btn.Text = "  " .. text .. ": KAPALI"
    btn.TextColor3 = Color3.new(0.8, 0.8, 0.8)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", btn)
    
    local enabled = false
    btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        btn.Text = "  " .. text .. ": " .. (enabled and "AÇIK" or "KAPALI")
        btn.TextColor3 = enabled and Color3.fromRGB(0, 255, 150) or Color3.new(0.8, 0.8, 0.8)
        btn.BackgroundColor3 = enabled and Color3.fromRGB(35, 45, 40) or Color3.fromRGB(30, 30, 40)
        callback(enabled)
    end)
end

AddToggle("Otomatik Farm", function(v)
    Config.AutoFarm = v
    if v then StartFarm() end
end)

AddToggle("Bypass Sistemi", function(v)
    Config.BypassActive = v
end)

AddToggle("Hazineye Dokun", function(v)
    Config.TouchChest = v
end)

local ResetBtn = Instance.new("TextButton", Container)
ResetBtn.Size = UDim2.new(1, 0, 0, 40)
ResetBtn.BackgroundColor3 = Color3.fromRGB(60, 20, 20)
ResetBtn.Text = "Karakteri Sıfırla"
ResetBtn.TextColor3 = Color3.new(1, 0.4, 0.4)
ResetBtn.Font = Enum.Font.GothamBold
ResetBtn.TextSize = 13
Instance.new("UICorner", ResetBtn)
ResetBtn.MouseButton1Click:Connect(function() if lp.Character then lp.Character:BreakJoints() end end)

-- Sürükleme ve Kısayol
Main.Active = true
Main.Draggable = true

UserInputService.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.F then
        Main.Visible = not Main.Visible
    end
end)

-- Anti-AFK
if Config.AntiAfk then
    lp.Idled:Connect(function()
        game:GetService("VirtualUser"):Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
        task.wait(1)
        game:GetService("VirtualUser"):Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    end)
end

Notify("XenoHub V2", "Başarıyla Yüklendi! Kapatmak için 'F' basın.")
