-- 1. MEGA LOADING SCREEN (BAŞLANGIÇ)
-- ============================================================================== --

local function ShowLoading()
    local LoadGui = Instance.new("ScreenGui")
    LoadGui.Name = "XenoLoading"
    LoadGui.Parent = CoreGui
    
    local MainLoad = Instance.new("Frame")
    MainLoad.Size = UDim2.new(1, 0, 1, 0)
    MainLoad.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
    MainLoad.Parent = LoadGui
    
    local Logo = Instance.new("TextLabel")
    Logo.Text = "XENOHUB"
    Logo.Size = UDim2.new(0, 300, 0, 100)
    Logo.Position = UDim2.new(0.5, -150, 0.4, -50)
    Logo.BackgroundTransparency = 1
    Logo.TextColor3 = Color3.fromRGB(145, 90, 230)
    Logo.Font = Enum.Font.GothamBlack
    Logo.TextSize = 60
    Logo.Parent = MainLoad
    
    local BarBack = Instance.new("Frame")
    BarBack.Size = UDim2.new(0, 300, 0, 4)
    BarBack.Position = UDim2.new(0.5, -150, 0.55, 0)
    BarBack.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    BarBack.Parent = MainLoad
    Instance.new("UICorner", BarBack)
    
    local BarFill = Instance.new("Frame")
    BarFill.Size = UDim2.new(0, 0, 1, 0)
    BarFill.BackgroundColor3 = Color3.fromRGB(145, 90, 230)
    BarFill.Parent = BarBack
    Instance.new("UICorner", BarFill)
    
    local Status = Instance.new("TextLabel")
    Status.Text = "Sistemler Yükleniyor..."
    Status.Size = UDim2.new(0, 300, 0, 30)
    Status.Position = UDim2.new(0.5, -150, 0.6, 0)
    Status.BackgroundTransparency = 1
    Status.TextColor3 = Color3.fromRGB(200, 200, 200)
    Status.Font = Enum.Font.GothamMedium
    Status.TextSize = 14
    Status.Parent = MainLoad
    
    -- Animasyon
    task.wait(0.5)
    TweenService:Create(BarFill, TweenInfo.new(2, Enum.EasingStyle.Quart), {Size = UDim2.new(1, 0, 1, 0)}):Play()
    task.wait(0.5) Status.Text = "Bypass Modülleri Hazırlanıyor..."
    task.wait(0.5) Status.Text = "Brookhaven Protokolleri Aşılıyor..."
    task.wait(1)
    
    TweenService:Create(MainLoad, TweenInfo.new(0.8), {BackgroundTransparency = 1}):Play()
    TweenService:Create(Logo, TweenInfo.new(0.8), {TextTransparency = 1}):Play()
    task.wait(0.8)
    LoadGui:Destroy()
end

task.spawn(ShowLoading)

