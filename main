--[[
	ULTIMATE BUILD A BOAT FOR TREASURE - GOLD FARMING HUB (V5.0)
	- Görseldeki gibi İstatistik Paneli (Gold Farming Hub) eklendi.
	- İstatistik Takibi: Mevcut Altın, Kazanılan Altın, Sandık Sayısı, Geçen Süre.
	- Sol Alt Menü Tetikleyici Buton.
	- Gelişmiş Bypass & Noclip & Farm Hızı.
]]

local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()
local Window = OrionLib:MakeWindow({Name = "BaBft Ultimate - Pro Edition", HidePremium = false, SaveConfig = true, ConfigFolder = "BaBftUltimate"})

-- ================================
-- Değişkenler & İstatistikler
-- ================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local farming = false
local autoBuyType = "None"
local walkSpeed = 16
local jumpPower = 50
local noclipActive = false

-- İstatistik Verileri
local StartGold = LocalPlayer.Data.Gold.Value
local GainedGold = 0
local ChestsCollected = 0
local StartTime = os.time()

-- ================================
-- STAT BOARD (Görseldeki Panel)
-- ================================
local StatGui = Instance.new("ScreenGui")
local MainFrame = Instance.new("Frame")
local TitleLabel = Instance.new("TextLabel")
