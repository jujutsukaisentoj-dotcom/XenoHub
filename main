-- ============================================================================== --
-- 3. ÖZEL FONKSİYONLAR (REMOTE SCANNER & NOTIFY)
-- ============================================================================== --

local function Notify(title, text)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = title;
        Text = text;
        Duration = 3;
    })
end

-- SENİN İSTEDİĞİN GELİŞMİŞ ITEM ALMA MANTIĞI
local function GetBrookhavenItem(itemName)
    local rep = game:GetService("ReplicatedStorage")
    local ok, err = pcall(function()
        local re = rep:FindFirstChild("RE") or rep:FindFirstChild("Remotes") or rep
        
        -- 1. Tarama: Standart Remotes
        local candidates = {"GetItem", "GetTool", "GetToolToServer", "Getİtem"}
        for _, name in ipairs(candidates) do
            local r = re:FindFirstChild(name)
            if r then
                if r:IsA("RemoteEvent") then r:FireServer(itemName)
                elseif r:IsA("RemoteFunction") then r:InvokeServer(itemName) end
                Notify("Eşya", itemName.." istendi (Yöntem 1)")
            end
        end

        -- 2. Tarama: Gelişmiş Trigger (En güçlüsü)
        local trigger = re:FindFirstChild("1Playe1rTrigge1rEven1t") or rep:FindFirstChild("1Playe1rTrigge1rEven1t")
        if trigger then
            local args = {[1] = "AcceptedToolToServer", [2] = itemName, [3] = player}
            if trigger:IsA("RemoteEvent") then trigger:FireServer(unpack(args))
            elseif trigger:IsA("RemoteFunction") then trigger:InvokeServer(unpack(args)) end
            Notify("Başarılı", itemName.." Envantere Geldi! 🎒")
        end
    end)
    if not ok then Notify("Hata", "Eşya alınamadı: "..tostring(err)) end
end

