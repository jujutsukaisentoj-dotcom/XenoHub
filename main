-- 7. MODERN TOGGLE BUTTON (LOGO & GLOW)
-- ============================================================================== --

local function CreateXenoToggle()
    local isMobile = UserInputService.TouchEnabled
    
    local ToggleButton = Instance.new("TextButton")
    ToggleButton.Name = "XenoToggle"
    ToggleButton.Parent = XenoGui
    ToggleButton.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    ToggleButton.Size = isMobile and UDim2.new(0, 70, 0, 70) or UDim2.new(0, 55, 0, 55)
    ToggleButton.Position = isMobile and UDim2.new(0.02, 0, 0.4, 0) or UDim2.new(0.01, 0, 0.5, -25)
    ToggleButton.Text = ""
    ToggleButton.ZIndex = 10

    local ToggleCorner = Instance.new("UICorner", ToggleButton)
    ToggleCorner.CornerRadius = UDim.new(1, 0)

    local ToggleStroke = Instance.new("UIStroke", ToggleButton)
    ToggleStroke.Color = Color3.fromRGB(145, 90, 230)
    ToggleStroke.Thickness = 3
    
    local Glow = Instance.new("ImageLabel", ToggleButton)
    Glow.BackgroundTransparency = 1
    Glow.Position = UDim2.new(-0.6, 0, -0.6, 0)
    Glow.Size = UDim2.new(2.2, 0, 2.2, 0)
    Glow.Image = "rbxassetid://5028857084"
    Glow.ImageColor3 = Color3.fromRGB(145, 90, 230)
    Glow.ImageTransparency = 0.5
    Glow.ZIndex = 9

    local Icon = Instance.new("TextLabel", ToggleButton)
    Icon.Size = UDim2.new(1, 0, 1, 0)
    Icon.BackgroundTransparency = 1
    Icon.Text = "X"
    Icon.TextColor3 = Color3.new(1, 1, 1)
    Icon.Font = Enum.Font.GothamBlack
    Icon.TextSize = isMobile and 32 or 24
    Icon.ZIndex = 11

    ToggleButton.MouseButton1Click:Connect(function()
        MainFrame.Visible = not MainFrame.Visible
        local push = TweenService:Create(ToggleButton, TweenInfo.new(0.1, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, true), {Size = ToggleButton.Size - UDim2.new(0,8,0,8)})
        push:Play()
    end)

    MakeDraggable(ToggleButton)
end

CreateXenoToggle()
SendNotif("XenoHub v10", "XenoHub Ultimate Yüklendi! Kapatmak için Ayarlar'a bak.")
