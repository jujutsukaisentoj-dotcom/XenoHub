-- ADS & MAĞAZA SEKME (FULL ADS ÖZELLİKLERİ)
CreateToggle(AdsTab, "Otomatik Reklam Bypass", "Tüm video gereksinimlerini atlar.", function(s) Config.AdBypass = s end)
CreateButton(AdsTab, "Brookhaven AdStore Panelini Aç", function()
    pcall(function()
        require(ReplicatedStorage.Modules.Client.UI.PanelController).OpenPanelByContext("MainGUIHandler", "AdStore")
    end)
end)
CreateButton(AdsTab, "ExtendUnlock Panelini Zorla", function()
    pcall(function()
        require(ReplicatedStorage.Modules.Client.Ads.ExtendUnlockController).ShowExtendCurrentHousePanel(true)
    end)
end)

-- IŞINLANMA
CreateButton(TPTab, "Banka Kasası", function() TeleportTo(CFrame.new(-442, 23, -283)) end)
CreateButton(TPTab, "Göl Evi Gizli Giriş", function() TeleportTo(CFrame.new(-932, 12, -446)) end)
CreateButton(TPTab, "Polis Karakolu Hücre", function() TeleportTo(CFrame.new(-338, 25, -290)) end)

-- CMDR SEKME
CreateButton(CmdrTab, "Gizli CMDR Konsolunu Aç", function()
    pcall(function()
        -- Oyun içi CMDR sistemini tetikle (Eğer mevcutsa)
        local CmdrClient = ReplicatedStorage:FindFirstChild("CmdrClient", true)
        if CmdrClient then
            require(CmdrClient):HandleEvent("OpenConsole")
        else
            Notify("Hata", "CMDR sistemi bu sunucuda bulunamadı.")
        end
    end)
end)
CreateButton(CmdrTab, "Yönetici Komutlarını Simüle Et", function()
    Notify("Sistem", "Yönetici yetkileri simüle ediliyor... (Bypass Aktif)")
end)

-- ============================================================================== --
-- DÖNGÜLER VE SÜRÜKLEME
-- ============================================================================== --

UserInputService.JumpRequest:Connect(function()
    if Config.InfJump and lp.Character and lp.Character:FindFirstChild("Humanoid") then
        lp.Character.Humanoid:ChangeState(3)
    end
end)

RunService.RenderStepped:Connect(function()
    if Config.EspActive then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= lp and p.Character then
                local h = p.Character:FindFirstChild("XHighlight") or Instance.new("Highlight", p.Character)
                h.Name = "XHighlight"; h.FillColor = Config.Theme
            end
        end
    end
end)

-- Menü Sürükleme Mantığı
local dragging, dragInput, dragStart, startPos
Main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; dragStart = input.Position; startPos = Main.Position end
end)
Main.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)
RunService.Heartbeat:Connect(function()
    if dragging and dragInput then
        local delta = dragInput.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Menü Kapatma/Açma Butonu
local Tgl = Instance.new("TextButton", ScreenGui)
Tgl.Size = UDim2.new(0, 45, 0, 45); Tgl.Position = UDim2.new(0, 10, 0.5, -22)
Tgl.BackgroundColor3 = Config.Theme; Tgl.Text = "X"; Tgl.TextColor3 = Color3.new(1,1,1)
Tgl.Font = Enum.Font.GothamBlack; Tgl.TextSize = 18
Instance.new("UICorner", Tgl).CornerRadius = UDim.new(1, 0)
Tgl.MouseButton1Click:Connect(function() Main.Visible = not Main.Visible end)

Notify("XenoHub V19", "Tüm Ads ve CMDR özellikleri aktif edildi!")
